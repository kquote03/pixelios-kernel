diff --git a/bsd/dev/sweet_thermal.h b/bsd/dev/sweet_thermal.h
index 899743c..e187706 100644
--- a/bsd/dev/sweet_thermal.h
+++ b/bsd/dev/sweet_thermal.h
@@ -70,6 +70,39 @@ th_order_gaps(unsigned ncpu, const uint32_t *phys, unsigned nphys, uint32_t boot
 	return g;
 }
 
+/*
+ * Patch 0402 (oriole speed round 2026-11-19, plan step 1.4): the X1 drop with any cpu count / order. 0336's mask 0x18 is the A76 pair only under tools/xrun's cpus=5 X1-first order;
+ * with cpus=8 and the plain /cpus order (the oriole daily image) it left logical cpu3 (an A55) and cpu4 (an A76): two cores until <= 44 C (doc 56 Step 7, wlan-gpu-o-all2).
+ * th_hot_mask() returns the mask the drop uses instead: the boot mask without every logical cpu whose physical core is an X1 (gs101 MPIDR Aff1 6, 7: the cores the backstop is
+ * meant to take out), or 0 = keep 0336's (boot_mask & 0x18) when the topology is unknown, when 0336's order check is clean (cpus=5, xrun order: 0x18 IS the A76 pair), when no
+ * X1 is in the boot mask (nothing to drop), or when fewer than TH_HOT_MIN_CORES cores would stay (a two-core phone stalls the UI; user 2026-11-19: never drop to two cores).
+ * Pure function (host test tools/sweet_thermal_host_test.c, glue cases tools/sweet_thermal_glue_test.c).
+ */
+#define TH_HOT_MIN_CORES    3u
+
+static inline uint32_t
+th_hot_mask(unsigned ncpu, const uint32_t *phys, unsigned nphys, uint32_t boot_mask)
+{
+	uint32_t m = boot_mask;
+	unsigned i, n = 0;
+
+	if (phys == 0 || nphys == 0 || th_order_gaps(ncpu, phys, nphys, boot_mask) == 0) {
+		return 0;
+	}
+	for (i = 0; i < nphys && i < 32u; i++) {
+		if (phys[i] == 6u || phys[i] == 7u) {
+			m &= ~(1u << i);
+		}
+	}
+	if (m == boot_mask) {
+		return 0;
+	}
+	for (i = 0; i < 32u; i++) {
+		n += (m >> i) & 1u;
+	}
+	return n >= TH_HOT_MIN_CORES ? m : 0;
+}
+
 enum { TH_RD_OK = 0, TH_RD_NOTREADY = 1, TH_RD_BUSY = 2, TH_RD_FAIL = -1, TH_RD_DEAD = -2, TH_RD_NOENGINE = -3 };
 
 /* The three actuators. chg() returns 0 = done, 1 = nothing to do (lever not engaged), 2 = engine busy (asked again at the next sample), -1 = refused/failed (GAP already printed by the callee). */

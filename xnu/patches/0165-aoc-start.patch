+
+void
+sweet_tipc_run(void)
+{
+	static struct swtp_res r;
+
+	(void)swtp_go(NULL, 0, &r);
+}
+
+/* patch 0165 (plan A8, sweetaoc=3): GET_STATE, START (gated on LOADED in sweet_tipc.h), GET_STATE; called once per boot */
+int
+sweet_tipc_aoc_start(struct swtp_res *r)
+{
+	static const uint8_t seq[3] = { SWTP_AOC_GET_STATE, SWTP_AOC_START, SWTP_AOC_GET_STATE };
+
+	return swtp_go(seq, 3u, r);
 }

diff --git a/bsd/dev/sweet_audio_fifo.h b/bsd/dev/sweet_audio_fifo.h
index da19ef9..cf6c0a6 100644
--- a/bsd/dev/sweet_audio_fifo.h
+++ b/bsd/dev/sweet_audio_fifo.h
@@ -15,9 +15,12 @@
 #define SWAU_FIFO_FRAMES        8192u
 #define SWAU_START_FRAMES       960u
 #endif
-#define SWAU_MAX_GAIN_MDB       (-6000)         /* patch 0393: user decision 2026-11-18, max -6 dB, default -15 dB */
+/* patch 0394 (user decision 2026-11-18, polish pass: loudness first): max 0 dB, default -6 dB, and a hard clamp of every sample after the
+ * gain at SWAU_LIMIT = 23197 = 32767 * 10^(-3/20) (-3 dBFS), so no gain setting can drive the amps (DSP bypassed) above -3 dBFS */
+#define SWAU_MAX_GAIN_MDB       0
 #define SWAU_MIN_GAIN_MDB       (-96000)
-#define SWAU_DEF_GAIN_MDB       (-15000)
+#define SWAU_DEF_GAIN_MDB       (-6000)
+#define SWAU_LIMIT              23197
 
 struct swau_fifo {
 	uint32_t buf[SWAU_FIFO_FRAMES];
@@ -104,6 +107,8 @@ swau_scale_word(uint32_t w, uint32_t q)
 
 	l = (int32_t)(((int64_t)l * (int64_t)q) >> 16);
 	r = (int32_t)(((int64_t)r * (int64_t)q) >> 16);
+	l = l > SWAU_LIMIT ? SWAU_LIMIT : l < -SWAU_LIMIT ? -SWAU_LIMIT : l;     /* patch 0394: -3 dBFS clamp */
+	r = r > SWAU_LIMIT ? SWAU_LIMIT : r < -SWAU_LIMIT ? -SWAU_LIMIT : r;
 	return ((uint32_t)l & 0xFFFFu) | ((uint32_t)r & 0xFFFFu) << 16;
 }
 

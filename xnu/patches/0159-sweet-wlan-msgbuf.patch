+				rl = swm_r16(c + 12);
+				if (rl > SWM_L_RESP) {
+					printf("SWEET WLAN: W%u completion length %u above the buffer\n", x->row, rl);
+					return swl_stop(x, SWW_E_DMA);
+				}
+				got = 1;
+			} else if (typ == SWM_T_IOCTL_ACK) {
+				acks++;
+			} else {
+				x->f_other++;
+				printf("SWEET WLAN: W%u completion item type %#x ignored\n", x->row, typ);
+			}
+			x->f_r0 = (x->f_r0 + 1u) % swm_ring[SWM_NH2D].depth;
+			moved = 1;
+		}
+		if (moved) {
+			SWW_TRY(swl_bp_wr(x, x->f_dr, x->f_r0));
+		}
+		if (!got) {
+			swl_delay(x, SWM_POLL_US);
+		}
+	}
+	if (!got) {
+		swm_sync(x, swm_ring[SWM_NH2D].off, swm_ring[SWM_NH2D].depth * SWM_ITEM_D2H);
+		for (i = 0; i < swm_ring[SWM_NH2D].depth * SWM_ITEM_D2H; i++) {
+			nz |= x->pool[swm_ring[SWM_NH2D].off + i];
+		}
+		(void)swl_bp_rd(x, x->f_hr, &hr);
+		printf("SWEET WLAN: W%u no completion for '%s' in %u ms: h2d w %u fw r %u, d2h fw w %u r %u, acks %u; completion ring in the host pool %s\n", x->row, name, SWM_POLLS * (SWM_POLL_US / 1000u),
+		    x->f_w0, hr & 0xFFFFu, w, x->f_r0, acks, nz ? "has bytes" : "is untouched (no device-to-host write seen: DMA blocked or the firmware did not answer)");
+		return swl_stop(x, SWW_E_TMO);
+	}
+	if (st != 0) {
+		printf("SWEET WLAN: W%u '%s' completed with status %u\n", x->row, name, st);
+		return swl_stop(x, SWW_E_MSG);
+	}
+	swm_sync(x, SWM_O_RESP, SWM_L_RESP);
+	for (i = 0; i < rl && i < omax; i++) {
+		out[i] = x->pool[SWM_O_RESP + i];
+	}
+	*olen = rl;
+	printf("SWEET WLAN: W%u '%s' ok: %u bytes (acks %u)\n", x->row, name, rl, acks);
+	return 0;
+}

+/* ---- run F (patch 0159, sweetwlan=8, docs/research/51 s.4): rows W18..W25 ---- */
+
+static inline void
+swm_w16(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+}
+
+static inline void
+swm_w32(uint8_t *p, uint32_t v)
+{
+	swm_w16(p, v);
+	swm_w16(p + 2, v >> 16);
+}
+
+static inline uint32_t
+swm_r16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8;
+}
+
+static inline uint32_t
+swm_r32(const uint8_t *p)
+{
+	return swm_r16(p) | swm_r16(p + 2) << 16;
+}
+
+static inline void
+swm_fill(uint8_t *p, uint8_t v, uint32_t n)
+{
+	while (n--) {
+		*p++ = v;
+	}
+}
+
+/* clean + invalidate pool bytes: before the chip reads what the host wrote and before the host reads what the chip wrote (the RC is not cache coherent, docs/research/51 s.2) */
+static inline void
+swm_sync(struct swl_wx *x, uint32_t off, uint32_t len)
+{
+	if (swm_pa(x, off, len) != 0) {
+		x->b->sync(x->b->ctx, off, len);
+	}
+}
+
+/* the guard gaps between the used regions: fill != 0 writes SWM_GUARD into them and zeroes the used regions, fill == 0 counts gap bytes that are no longer SWM_GUARD (rule R9) */
+static inline uint32_t
+swm_guard(struct swl_wx *x, int fill)
+{
+	uint32_t i, j, at = 0, end, bad = 0;
+
+	for (i = 0; i <= sizeof swm_used / sizeof swm_used[0]; i++) {
+		end = i < sizeof swm_used / sizeof swm_used[0] ? swm_used[i].off : SWM_POOL_LEN;
+		for (j = at; j < end; j++) {
+			if (fill) {
+				x->pool[j] = SWM_GUARD;
+			} else if (x->pool[j] != SWM_GUARD) {
+				bad++;
+			}
+		}
+		if (i < sizeof swm_used / sizeof swm_used[0]) {
+			if (fill) {
+				swm_fill(x->pool + swm_used[i].off, 0, swm_used[i].len);
+			}
+			at = swm_used[i].off + swm_used[i].len;
+		}
+	}
+	return bad;
+}
+
+/* n bytes at backplane address a lie inside the RAM, word aligned */
+static inline int
+swl_f_inram(const struct swl_wx *x, uint32_t a, uint32_t n)
+{
+	return !(a & 3u) && n != 0u && a >= SWW_RAM_BASE && n <= x->ram_bytes && a - SWW_RAM_BASE <= x->ram_bytes - n;
+}
+
+/* One chip-RAM word by backplane address, STORED through the run F tuples (window handling as swl_bp_rd). The address is bounded to the RAM here; whether it is a run F word with this value
+ * is decided by swl_wr() / swl_f_kind(). 0 = stored and read back. */
+static inline int
+swl_bp_wr(struct swl_wx *x, uint32_t a, uint32_t v)
+{
+	uint32_t want;
+
+	if (!swl_f_inram(x, a, 4u)) {
+		printf("SWEET WLAN: W%u backplane %#x is not a RAM word, not stored\n", x->row, a);
+		return swl_stop(x, SWW_E_SHARED);
+	}
+	want = a >= SWW_TCM_BYTES ? SWW_WIN_TAIL : 0u;
+	if (x->w84 != want) {
+		SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_WIN2, want));
+		x->w84 = want;
+		if (want == 0u) {
+			x->armed &= ~SWW_RG_W84;
+		}
+	}
+	return swl_wr(x, SWW_BAR2, want, a - want, v);
+}
+
+/* W18 (reads only): the firmware speaks what run F speaks, the pool is usable, and every chip-RAM region run F will store into lies inside the RAM and overlaps no other one. */
+static inline int
+swl_w18(struct swl_wx *x)
+{
+	struct { uint32_t a, n; } rg[7];
+	uint32_t fl = x->sh[0], ri = x->sh[SWW_SH_RINGINFO], i, j, maxsub, maxcpl;
+
+	x->row = 18;
+	if ((fl & SWW_SH_VER_MASK) != SWM_SH_VERSION || !(fl & SWM_SH_FLAGS_HOSTRDY) || (fl & (SWM_SH_FLAGS_DAR | SWM_SH_FLAGS_2B_IDX))) {
+		printf("SWEET WLAN: W18 shared flags %#x: run F needs version %u, host-ready doorbell, no DAR, 4-byte indices\n", fl, SWM_SH_VERSION);
+		return swl_stop(x, SWW_E_MSG);
+	}
+	if (x->b->sync == NULL || swm_pa(x, 0, SWM_POOL_LEN) == 0 || (x->pool_pa & (SWM_POOL_ALIGN - 1u)) != 0 || x->pool_pa + SWM_POOL_LEN < x->pool_pa) {
+		printf("SWEET WLAN: W18 no usable host pool (len %#x)\n", x->pool_len);
+		return swl_stop(x, SWW_E_POOL);
+	}
+	if (!swl_f_inram(x, x->shared, SWM_SH_BYTES) || !swl_f_inram(x, ri, 4u * SWM_RI_WORDS)) {
+		printf("SWEET WLAN: W18 shared %#x or ring_info %#x outside RAM\n", x->shared, ri);
+		return swl_stop(x, SWW_E_SHARED);
+	}
+	for (i = 0; i < SWM_RI_WORDS; i++) {
+		SWW_TRY(swl_bp_rd(x, ri + 4u * i, &x->f_ri[i]));
+	}
+	x->f_ringmem = x->f_ri[SWM_RI_RINGMEM];
+	x->f_hw = x->f_ri[SWM_RI_H2D_W];
+	x->f_hr = x->f_ri[SWM_RI_H2D_R];
+	x->f_dw = x->f_ri[SWM_RI_D2H_W];
+	x->f_dr = x->f_ri[SWM_RI_D2H_R];
+	maxsub = SWM_RI_MAXSUB(x->f_ri);
+	maxcpl = SWM_RI_MAXCPL(x->f_ri);
+	printf("SWEET WLAN: W18 ring_info %#x: ringmem %#x h2d w %#x r %#x d2h w %#x r %#x max sub %u cpl %u\n", ri, x->f_ringmem, x->f_hw, x->f_hr, x->f_dw, x->f_dr, maxsub, maxcpl);
+	if (maxsub < SWM_NH2D || maxcpl < SWM_ND2H || maxsub > 1024u || maxcpl > 1024u) {
+		return swl_stop(x, SWW_E_MSG);
+	}
+	rg[0].a = x->shared;    rg[0].n = SWM_SH_BYTES;
+	rg[1].a = ri;           rg[1].n = 4u * SWM_RI_WORDS;
+	rg[2].a = x->f_ringmem; rg[2].n = SWM_RINGMEM_SZ * SWM_NRING;
+	rg[3].a = x->f_hw;      rg[3].n = 4u * maxsub;
+	rg[4].a = x->f_hr;      rg[4].n = 4u * maxsub;
+	rg[5].a = x->f_dw;      rg[5].n = 4u * maxcpl;
+	rg[6].a = x->f_dr;      rg[6].n = 4u * maxcpl;
+	for (i = 0; i < 7; i++) {
+		if (!swl_f_inram(x, rg[i].a, rg[i].n)) {
+			printf("SWEET WLAN: W18 region %u (%#x, %u bytes) outside RAM\n", i, rg[i].a, rg[i].n);
+			return swl_stop(x, SWW_E_SHARED);
+		}
+		for (j = 0; j < i; j++) {
+			if (rg[i].a < rg[j].a + rg[j].n && rg[j].a < rg[i].a + rg[i].n) {
+				printf("SWEET WLAN: W18 regions %u and %u overlap\n", j, i);
+				return swl_stop(x, SWW_E_SHARED);
+			}
+		}
+	}
+	(void)swm_guard(x, 1);
+	swm_sync(x, 0, SWM_POOL_LEN);
+	x->f_w0 = x->f_r0 = 0;
+	SWW_TRY(swl_w84_zero(x));
+	printf("SWEET WLAN: W18 ok: host pool %u KiB, guards set (no store yet)\n", SWM_POOL_LEN / 1024u);
+	return swl_done(x, SWF_W18);
+}
+
+/* W19: host_cap, host_cap2 (if_bwfm_pci.c:542-558) */
+static inline int
+swl_w19(struct swl_wx *x)
+{
+	x->row = 19;
+	SWW_TRY(swl_bp_wr(x, x->shared + SWM_SH_HOST_CAP, SWM_HOST_CAP));
+	SWW_TRY(swl_bp_wr(x, x->shared + SWM_SH_HOST_CAP2, 0u));
+	SWW_TRY(swl_w84_zero(x));
+	printf("SWEET WLAN: W19 host_cap %#x host_cap2 0\n", SWM_HOST_CAP);
+	return swl_done(x, SWF_W19);
+}
+
+/* W20: the five common rings in the order of if_bwfm_pci.c:669-694: both indices 0 (:1398-1399), then base low, base high, max_item | len_items (:1401-1414) */
+static inline int
+swl_w20(struct swl_wx *x)
+{
+	uint64_t a;
+	uint32_t i, e, k;
+
+	x->row = 20;
+	for (i = 0; i < SWM_NRING; i++) {
+		k = i < SWM_NH2D ? i : i - SWM_NH2D;
+		SWW_TRY(swl_bp_wr(x, (i < SWM_NH2D ? x->f_hr : x->f_dr) + 4u * k, 0u));
+		SWW_TRY(swl_bp_wr(x, (i < SWM_NH2D ? x->f_hw : x->f_dw) + 4u * k, 0u));
+		a = swm_pa(x, swm_ring[i].off, swm_ring[i].depth * swm_ring[i].item);
+		if (a == 0) {
+			return swl_stop(x, SWW_E_POOL);
+		}
+		e = x->f_ringmem + SWM_RINGMEM_SZ * i;
+		SWW_TRY(swl_bp_wr(x, e + 0x8u, (uint32_t)a));
+		SWW_TRY(swl_bp_wr(x, e + 0xCu, (uint32_t)(a >> 32)));
+		SWW_TRY(swl_bp_wr(x, e + 0x4u, swm_ring[i].depth | swm_ring[i].item << 16));
+	}
+	SWW_TRY(swl_w84_zero(x));
+	printf("SWEET WLAN: W20 %u rings set up in the host pool\n", SWM_NRING);
+	return swl_done(x, SWF_W20);
+}
+
+/* W21: the D2H scratch and ring-update buffers (if_bwfm_pci.c:705-730: address low, address high, length) */
+static inline int
+swl_w21(struct swl_wx *x)
+{
+	uint64_t a = swm_pa(x, SWM_O_SCRATCH, SWM_L_SCRATCH), b = swm_pa(x, SWM_O_RINGUPD, SWM_L_RINGUPD);
+
+	x->row = 21;
+	if (a == 0 || b == 0) {
+		return swl_stop(x, SWW_E_POOL);
+	}
+	SWW_TRY(swl_bp_wr(x, x->shared + SWM_SH_SCRATCH_LO, (uint32_t)a));
+	SWW_TRY(swl_bp_wr(x, x->shared + SWM_SH_SCRATCH_HI, (uint32_t)(a >> 32)));
+	SWW_TRY(swl_bp_wr(x, x->shared + SWM_SH_SCRATCH_LEN, SWM_L_SCRATCH));
+	SWW_TRY(swl_bp_wr(x, x->shared + SWM_SH_RINGUPD_LO, (uint32_t)b));
+	SWW_TRY(swl_bp_wr(x, x->shared + SWM_SH_RINGUPD_HI, (uint32_t)(b >> 32)));
+	SWW_TRY(swl_bp_wr(x, x->shared + SWM_SH_RINGUPD_LEN, SWM_L_RINGUPD));
+	SWW_TRY(swl_w84_zero(x));
+	return swl_done(x, SWF_W21);
+}
+
+/* the next free item of the H2D control submit ring, zeroed; refused when the ring is full (the firmware's read index, bounded) */
+static inline int
+swl_f_item(struct swl_wx *x, uint8_t **it)
+{
+	uint32_t hr = 0, nw = (x->f_w0 + 1u) % swm_ring[0].depth;
+
+	SWW_TRY(swl_bp_rd(x, x->f_hr, &hr));
+	hr &= 0xFFFFu;
+	if (hr >= swm_ring[0].depth) {
+		printf("SWEET WLAN: W%u firmware read index %u outside the ring\n", x->row, hr);
+		return swl_stop(x, SWW_E_DMA);
+	}
+	if (nw == hr) {
+		return swl_stop(x, SWW_E_MSG);
+	}
+	*it = x->pool + swm_ring[0].off + x->f_w0 * SWM_ITEM_H2D;
+	swm_fill(*it, 0, SWM_ITEM_H2D);
+	return 0;
+}
+
+/* publish the item swl_f_item() gave out: cache, write index (chip RAM), doorbell (if_bwfm_pci.c:1608-1616) */
+static inline int
+swl_f_commit(struct swl_wx *x)
+{
+	swm_sync(x, swm_ring[0].off + x->f_w0 * SWM_ITEM_H2D, SWM_ITEM_H2D);
+	x->f_w0 = (x->f_w0 + 1u) % swm_ring[0].depth;
+	SWW_TRY(swl_bp_wr(x, x->f_hw, x->f_w0));
+	return swl_wr(x, SWW_BAR0, SWW_WIN_PCIE, SWW_DB_H2D, 1u);
+}

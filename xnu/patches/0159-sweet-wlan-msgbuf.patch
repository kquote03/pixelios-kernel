+/* W22..W25, one row group so the bus-master restore stays armed from the first to the last store: bus master on, host ready, cur_etheraddr and ver, guard check, bus master off. */
+static inline int
+swl_w22(struct swl_wx *x)
+{
+	uint8_t mac[6], ver[SWM_VER_MAX + 1u];
+	char vt[SWM_VER_MAX + 1u];
+	uint32_t n = 0, i, k = 0, bad;
+
+	x->row = 22;
+	SWW_TRY(swl_w84_zero(x));
+	SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_CMD, SWW_CMD_MEM_BM));
+	printf("SWEET WLAN: W22 bus master ON (EP Command %#x)\n", SWW_CMD_MEM_BM);
+	x->row = 23;
+	SWW_TRY(swl_win(x, SWW_WIN_PCIE));
+	SWW_TRY(swl_wr(x, SWW_BAR0, SWW_WIN_PCIE, SWW_DB_HOSTRDY, 1u));
+	x->flags |= SWF_W23;
+	x->row = 24;
+	swm_fill(mac, 0, sizeof mac);
+	SWW_TRY(swl_f_iovar(x, "cur_etheraddr", 20u, mac, sizeof mac, &n));   /* name + NUL + 6 bytes, as bwfm_fwvar_var_get_data sizes it (dev/ic/bwfm.c:261) */
+	if (n < sizeof mac) {
+		printf("SWEET WLAN: W24 cur_etheraddr answer is %u bytes\n", n);
+		return swl_stop(x, SWW_E_MSG);
+	}
+	printf("SWEET WLAN: W24 device-to-host DMA works: the completion and the answer arrived in the host pool\n");
+	x->row = 25;
+	swm_fill(ver, 0, sizeof ver);
+	SWW_TRY(swl_f_iovar(x, "ver", 256u, ver, SWM_VER_MAX, &n));        /* a 256-byte request as brcmfmac's "ver" query; guess: the size is not critical */
+	for (i = 0; i < SWM_VER_MAX && i < n && ver[i] != 0 && ver[i] != '\n'; i++) {
+		if (ver[i] >= 0x20 && ver[i] < 0x7F) {
+			vt[k++] = (char)ver[i];
+		}
+	}
+	vt[k] = 0;
+	swm_sync(x, 0, SWM_POOL_LEN);
+	bad = swm_guard(x, 0);
+	if (bad) {
+		printf("SWEET WLAN: W25 DMA suspect: %u guard bytes of the host pool changed\n", bad);
+		return swl_stop(x, SWW_E_DMA);
+	}
+	SWW_TRY(swl_w84_zero(x));
+	SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_CMD, SWW_CMD_MEM));
+	printf("SWEET WLAN: W25 bus master off, guards intact; run F stored %u chip-RAM words, rang %u doorbells, ignored %u items\n", x->f_nstore, x->f_ndb, x->f_other);
+	printf("SWEET WLAN: fw version %s mac xx:xx:xx:xx:%02x:%02x\n", vt, mac[4], mac[5]);
+	return swl_done(x, 0);
+}

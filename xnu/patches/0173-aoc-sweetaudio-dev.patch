+/* ---- patch 0173 (sweetaoc=8): /dev/sweetaudio (contract sweetaudio_dev.h = audio/sweetaudio/sweetaudio_dev.h, doc 54 s.4). The 0172
+ * power-up runs once; then, instead of the tone window, swau_cb_serve feeds the AOC ring each ms from the FIFO (sweet_audio_fifo.h) until a
+ * software reset asks it to stop (sweet_restart.c sweet_audio_stop_hook) or the ring fails; then the 0172 power-down + restore. The node is
+ * made once the amps are on; open before that = ENOENT, after the path went down = ENXIO, write after = EIO. Kernel self-test right after
+ * the power-up through the same FIFO: 2 beeps (1 kHz, 0.5 s on / 0.5 s off, -10 dBFS PCM x the -20 dB default gain = -30 dBFS as 0172). ---- */
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <mach/mach_time.h>
+#include "sweetaudio_dev.h"
+#include "sweet_audio_fifo.h"
+
+extern void (*sweet_audio_stop_hook)(void);     /* sweet_restart.c (patch 0173) */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern void sweet_amp_serve_arm(unsigned (*serve)(void *));     /* sweet_amp.c (patch 0173) */
+#endif
+static LCK_GRP_DECLARE(swau_dev_grp, "sweetaudio");
+static LCK_MTX_DECLARE(swau_dev_mtx, &swau_dev_grp);
+static struct swau_fifo swau_ff;
+static int swau_dev_major = -1;
+static volatile int swau_dev_up, swau_dev_down, swau_stop_req, swau_amp_done;
+static int swau_dev_writer;                     /* 0 none, 1 a user writer, 2 the kernel self-test */
+static uint32_t swau_dev_opens;
+#define SWAU_ST_FRAMES  72000u                  /* self-test: beeps at [0, 24000) and [48000, 72000) */
+#define SWAU_STOP_WAIT_MS 1000u
+
+static uint32_t
+swau_selftest_word(uint32_t frame)
+{
+	uint16_t v;
+
+	if (frame >= SWAU_ST_FRAMES || ((frame / 24000u) & 1u)) {
+		return 0u;
+	}
+	v = (uint16_t)(int16_t)(swau_sine48[frame % 48u] * 10);  /* peak 10360 = -10.0 dBFS */
+	return (uint32_t)v | (uint32_t)v << 16;
+}
+
+static int
+swau_dev_open(__unused dev_t dev, int flags, __unused int devtype, struct proc *p)
+{
+	int e = 0;
+
+	if (!(flags & FWRITE)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&swau_dev_mtx);
+	if (!swau_dev_up || swau_dev_down) {
+		e = ENXIO;
+	} else if (swau_dev_writer) {
+		e = EBUSY;
+	} else {
+		swau_dev_writer = 1;
+		swau_fifo_reset(&swau_ff);
+		swau_dev_opens++;
+	}
+	lck_mtx_unlock(&swau_dev_mtx);
+	printf("SWEET AUDIO: dev open pid %d -> %d (open #%u)\n", p ? proc_pid(p) : -1, e, swau_dev_opens);
+	return e;
+}
+
+static int
+swau_dev_close(__unused dev_t dev, __unused int flags, __unused int devtype, struct proc *p)
+{
+	uint64_t played;
+	uint32_t un, ov, fill;
+
+	lck_mtx_lock(&swau_dev_mtx);
+	if (swau_dev_writer == 1) {
+		swau_dev_writer = 0;
+		swau_ff.closing = 1;
+	}
+	played = swau_ff.played;
+	un = swau_ff.underruns;
+	ov = swau_ff.overruns;
+	fill = swau_fifo_fill(&swau_ff);
+	lck_mtx_unlock(&swau_dev_mtx);
+	printf("SWEET AUDIO: dev close pid %d: played %llu frames, fifo %u, underruns %u, overruns %u, gain %d mdB\n", p ? proc_pid(p) : -1,
+	    played, fill, un, ov, swau_ff.gain_mdb);
+	return 0;
+}
+
+static int
+swau_dev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint32_t w[256];
+	int e = 0;
+
+	if (uio_resid(uio) % (user_ssize_t)SWAU_BYTES_PER_FRAME) {
+		return EINVAL;
+	}
+	while (uio_resid(uio) > 0) {
+		uint32_t n = (uint32_t)(uio_resid(uio) / SWAU_BYTES_PER_FRAME), room;
+
+		lck_mtx_lock(&swau_dev_mtx);
+		if (swau_dev_down || !swau_dev_up) {
+			lck_mtx_unlock(&swau_dev_mtx);
+			return EIO;
+		}
+		room = SWAU_FIFO_FRAMES - swau_fifo_fill(&swau_ff);
+		if (n > room) {
+			swau_ff.overruns += n - room;
+		}
+		lck_mtx_unlock(&swau_dev_mtx);
+		if (n > room) {
+			n = room;
+		}
+		if (n > 256u) {
+			n = 256u;
+		}
+		if (n == 0u) {
+			break;                          /* FIFO full: what was taken so far is the result (0 = full) */
+		}
+		e = uiomove((caddr_t)w, (int)(n * SWAU_BYTES_PER_FRAME), uio);
+		if (e) {
+			break;
+		}
+		lck_mtx_lock(&swau_dev_mtx);
+		(void)swau_fifo_push(&swau_ff, w, n);   /* the only writer and the feed only frees: room still holds */
+		lck_mtx_unlock(&swau_dev_mtx);
+	}
+	return e;
+}
+
+static int
+swau_dev_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	int e = 0;
+
+	lck_mtx_lock(&swau_dev_mtx);
+	switch (cmd) {
+	case SWAU_IOC_INFO: {
+		struct swau_info *in = (struct swau_info *)(void *)data;
+
+		bzero(in, sizeof(*in));
+		in->version = SWAU_VERSION;
+		in->rate = SWAU_RATE;
+		in->channels = SWAU_CHANNELS;
+		in->bits = 16;
+		in->fifo_frames = SWAU_FIFO_FRAMES;
+		in->start_frames = SWAU_START_FRAMES;
+		in->flags = swau_dev_up && !swau_dev_down ? SWAU_F_PATH_UP : 0u;
+		in->max_gain_mdb = SWAU_MAX_GAIN_MDB;
+		break;
+	}
+	case SWAU_IOC_POS: {
+		struct swau_pos *ps = (struct swau_pos *)(void *)data;
+
+		bzero(ps, sizeof(*ps));
+		ps->frames_played = swau_ff.played;
+		ps->host_time = mach_absolute_time();
+		ps->fifo_fill = swau_fifo_fill(&swau_ff);
+		ps->underruns = swau_ff.underruns;
+		ps->overruns = swau_ff.overruns;
+		break;
+	}
+	case SWAU_IOC_GAIN:
+		swau_fifo_set_gain(&swau_ff, *(int32_t *)(void *)data);
+		break;
+	case SWAU_IOC_FLUSH:
+		swau_fifo_flush(&swau_ff);
+		break;
+	default:
+		e = ENOTTY;
+		break;
+	}
+	lck_mtx_unlock(&swau_dev_mtx);
+	return e;
+}
+
+static const struct cdevsw swau_cdevsw = {
+	.d_open       = swau_dev_open,
+	.d_close      = swau_dev_close,
+	.d_read       = eno_rdwrt,
+	.d_write      = swau_dev_write,
+	.d_ioctl      = swau_dev_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* the AOC feed's PCM source (swau_feed, each ms) */
+static uint32_t
+swau_dev_pull(__unused void *ctx, uint32_t *w, uint32_t n)
+{
+	uint32_t got;
+
+	lck_mtx_lock(&swau_dev_mtx);
+	got = swau_fifo_pull(&swau_ff, w, n);
+	lck_mtx_unlock(&swau_dev_mtx);
+	return got;
+}
+
+/* sweet_restart.c, before a software reset: stop the feed, wait (bounded, counter only) for the 0172 power-down + restore */
+static void
+swau_stop_hook(void)
+{
+	uint64_t t0 = mach_absolute_time(), lim;
+
+	if (!swau_dev_up || swau_amp_done) {
+		return;
+	}
+	nanoseconds_to_absolutetime((uint64_t)SWAU_STOP_WAIT_MS * NSEC_PER_MSEC, &lim);
+	swau_stop_req = 1;
+	while (!swau_amp_done && mach_absolute_time() - t0 < lim) {
+	}
+	printf("SWEET AUDIO: stop hook: amps %s\n", swau_amp_done ? "off (power-down + restore done)" : "NOT confirmed off within 1 s");
+}
+
+static void
+swau_cb_notone(__unused void *ctx, __unused int on)
+{
+}
+
+/* the service loop (sweet_amp_pwr.h amp_pwr_serve): runs with both amps powered up and the stream running; returns the ms it ran */
+static unsigned
+swau_cb_serve(__unused void *ctx)
+{
+	static const struct swau_bus ab = { swas_ir32, swas_iw32, swas_isync, swau_doorbell, swas_sleep_ms, NULL, NULL };
+	uint64_t t0 = mach_absolute_time(), ns;
+	uint32_t st = 0, errs0 = swau_r.pb.feed_err, bad = 0, st_done = 0, rx0;
+	uint32_t w[256];
+
+	lck_mtx_lock(&swau_dev_mtx);
+	swau_fifo_reset(&swau_ff);
+	swau_dev_writer = 2;                    /* the self-test owns the FIFO first */
+	lck_mtx_unlock(&swau_dev_mtx);
+	swau_r.pb.pull = swau_dev_pull;
+	swau_r.pb.pull_ctx = NULL;
+	(void)swau_counters(&ab, &swau_r.pb.g);
+	rx0 = swau_r.pb.g.rx;
+	if (swau_dev_major < 0) {
+		swau_dev_major = cdevsw_add(-1, &swau_cdevsw);
+		if (swau_dev_major < 0 || devfs_make_node(makedev(swau_dev_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "sweetaudio") == NULL) {
+			printf("SWEET AUDIO: a11: /dev/sweetaudio NOT made (major %d); self-test only\n", swau_dev_major);
+		}
+	}
+	swau_dev_up = 1;
+	sweet_audio_stop_hook = swau_stop_hook;
+	printf("SWEET AUDIO: a11: /dev/sweetaudio up (major %d, 0666, 48 kHz 2 ch S16LE, fifo %u, start %u, gain %d mdB, max %d mdB); "
+	    "kernel self-test now: 2 beeps 1 kHz 0.5 s on / 0.5 s off\n", swau_dev_major, SWAU_FIFO_FRAMES, SWAU_START_FRAMES, SWAU_DEF_GAIN_MDB,
+	    SWAU_MAX_GAIN_MDB);
+	while (!swau_stop_req) {
+		swas_sleep_ms(NULL, 1u);
+		if (swau_dev_writer == 2 && st < SWAU_ST_FRAMES) {
+			uint32_t n, k;
+
+			lck_mtx_lock(&swau_dev_mtx);
+			n = SWAU_FIFO_FRAMES - swau_fifo_fill(&swau_ff);
+			n = n > 256u ? 256u : n;
+			n = n > SWAU_ST_FRAMES - st ? SWAU_ST_FRAMES - st : n;
+			for (k = 0; k < n; k++) {
+				w[k] = swau_selftest_word(st + k);
+			}
+			st += swau_fifo_push(&swau_ff, w, n);
+			if (st >= SWAU_ST_FRAMES) {
+				swau_dev_writer = 0;    /* user opens allowed from here (an open drops what is left of the test) */
+				swau_ff.closing = 1;
+			}
+			lck_mtx_unlock(&swau_dev_mtx);
+		}
+		swau_feed(&ab, &swau_r);
+		if (!st_done && st >= SWAU_ST_FRAMES && swau_dev_opens == 0u && swau_ff.played >= SWAU_ST_FRAMES) {
+			st_done = 1;
+			(void)swau_counters(&ab, &swau_r.pb.g);
+			printf("SWEET AUDIO: a11: self-test played %llu frames through the FIFO (pcm bytes into the ring %u, AOC consumed %u bytes since up, "
+			    "underruns %u)\n", swau_ff.played, swau_r.pb.pulled, swau_r.pb.g.rx - rx0, swau_ff.underruns);
+		}
+		if (swau_r.pb.feed_err != errs0) {
+			errs0 = swau_r.pb.feed_err;
+			if (++bad >= 100u) {
+				printf("SWEET AUDIO: a11: AOC ring feed failing (%u errors), path down\n", swau_r.pb.feed_err);
+				break;
+			}
+		} else {
+			bad = 0;
+		}
+	}
+	lck_mtx_lock(&swau_dev_mtx);
+	swau_dev_down = 1;
+	lck_mtx_unlock(&swau_dev_mtx);
+	swau_r.pb.pull = NULL;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	(void)swau_counters(&ab, &swau_r.pb.g);
+	printf("SWEET AUDIO: a11: serve end (%s) after %llu ms: pcm bytes %u, AOC consumed %u bytes, opens %u; power-down follows\n",
+	    swau_stop_req ? "stop request" : "ring failure", ns / NSEC_PER_MSEC, swau_r.pb.pulled, swau_r.pb.g.rx - rx0, swau_dev_opens);
+	return (unsigned)(ns / NSEC_PER_MSEC);
+}

diff --git a/bsd/dev/sweet_audio_fifo.h b/bsd/dev/sweet_audio_fifo.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_audio_fifo.h
@@ -0,0 +1,144 @@
+/*
+ * /dev/sweetaudio FIFO (patch 0173, sweetaoc=8): pure logic, no locks (the glue in sweet_aoc_start.c holds its mutex around every call).
+ * Contract: audio/sweetaudio/sweetaudio_dev.h and docs/research/54-ios-audio-path.md s.4 (48 kHz, 2 ch S16LE, 1 frame = one 32-bit word, L in
+ * the low half as the AOC EP0 ring of patch 0167/0172). 8192-frame FIFO; the drain starts at 960 queued frames and again after each underrun;
+ * an empty FIFO while draining = underrun (the feed pads with silence); after the writer closed, what is left plays out regardless of the start
+ * threshold. Gain: a software scale applied when frames leave the FIFO, in 1 dB steps, clamped to [-96 dB, SWAU_MAX_GAIN_MDB] (user decision
+ * 2026-11-18: <= -10 dBFS equivalent for now, default -20 dB). Host test: shim/audio_fifo_host_test.c.
+ */
+#ifndef SWEET_AUDIO_FIFO_H
+#define SWEET_AUDIO_FIFO_H
+
+#include <stdint.h>
+
+#ifndef SWAU_FIFO_FRAMES                /* the same values as audio/sweetaudio/sweetaudio_dev.h */
+#define SWAU_FIFO_FRAMES        8192u
+#define SWAU_START_FRAMES       960u
+#endif
+#define SWAU_MAX_GAIN_MDB       (-10000)
+#define SWAU_MIN_GAIN_MDB       (-96000)
+#define SWAU_DEF_GAIN_MDB       (-20000)
+
+struct swau_fifo {
+	uint32_t buf[SWAU_FIFO_FRAMES];
+	uint32_t rd, wr;                /* free-running frame counters; fill = wr - rd */
+	uint32_t draining, closing;     /* closing: the writer is gone, play out what is left */
+	uint64_t played;                /* frames taken out (silence not counted) */
+	uint32_t underruns, overruns;   /* overruns: frames refused */
+	int32_t gain_mdb;
+	uint32_t gain_q16;              /* linear factor * 65536 */
+};
+
+/* 65536 * 10^(-k / 20), k = 0..19 */
+static const uint32_t swau_db_q16[20] = {
+	65536, 58409, 52057, 46396, 41350, 36854, 32846, 29274, 26090, 23253,
+	20724, 18471, 16462, 14672, 13076, 11654, 10387, 9257, 8250, 7353,
+};
+
+static int32_t
+swau_gain_clamp(int32_t mdb)
+{
+	return mdb > SWAU_MAX_GAIN_MDB ? SWAU_MAX_GAIN_MDB : mdb < SWAU_MIN_GAIN_MDB ? SWAU_MIN_GAIN_MDB : mdb;
+}
+
+/* the factor of a clamped gain: rounded to whole dB; -96 dB = 0 (mute) */
+static uint32_t
+swau_gain_q16(int32_t mdb)
+{
+	uint32_t db = (uint32_t)(-(swau_gain_clamp(mdb) - 500) / 1000), q;
+
+	if (db >= 96u) {
+		return 0u;
+	}
+	q = swau_db_q16[db % 20u];
+	for (db /= 20u; db; db--) {
+		q /= 10u;
+	}
+	return q;
+}
+
+static void
+swau_fifo_set_gain(struct swau_fifo *f, int32_t mdb)
+{
+	f->gain_mdb = swau_gain_clamp(mdb);
+	f->gain_q16 = swau_gain_q16(f->gain_mdb);
+}
+
+static void
+swau_fifo_reset(struct swau_fifo *f)
+{
+	f->rd = f->wr = 0;
+	f->draining = f->closing = 0;
+	f->played = 0;
+	f->underruns = f->overruns = 0;
+	swau_fifo_set_gain(f, SWAU_DEF_GAIN_MDB);
+}
+
+static uint32_t
+swau_fifo_fill(const struct swau_fifo *f)
+{
+	return f->wr - f->rd;
+}
+
+/* the writer: copies min(n, free) frames, returns the count; never waits */
+static uint32_t
+swau_fifo_push(struct swau_fifo *f, const uint32_t *w, uint32_t n)
+{
+	uint32_t room = SWAU_FIFO_FRAMES - swau_fifo_fill(f), k;
+
+	if (n > room) {
+		f->overruns += n - room;
+		n = room;
+	}
+	for (k = 0; k < n; k++) {
+		f->buf[(f->wr + k) % SWAU_FIFO_FRAMES] = w[k];
+	}
+	f->wr += n;
+	return n;
+}
+
+static uint32_t
+swau_scale_word(uint32_t w, uint32_t q)
+{
+	int32_t l = (int16_t)(w & 0xFFFFu), r = (int16_t)(w >> 16);
+
+	l = (int32_t)(((int64_t)l * (int64_t)q) >> 16);
+	r = (int32_t)(((int64_t)r * (int64_t)q) >> 16);
+	return ((uint32_t)l & 0xFFFFu) | ((uint32_t)r & 0xFFFFu) << 16;
+}
+
+/* the AOC feed: up to n frames (gain applied) into out; returns the count (the caller pads the rest with silence) */
+static uint32_t
+swau_fifo_pull(struct swau_fifo *f, uint32_t *out, uint32_t n)
+{
+	uint32_t fill = swau_fifo_fill(f), k;
+
+	if (!f->draining) {
+		if (fill == 0u || (fill < SWAU_START_FRAMES && !f->closing)) {
+			return 0u;
+		}
+		f->draining = 1;
+	}
+	if (n > fill) {
+		n = fill;
+		f->draining = 0;                /* empty after this pull: wait for the start threshold again */
+		if (!f->closing) {
+			f->underruns++;
+		}
+	}
+	for (k = 0; k < n; k++) {
+		out[k] = swau_scale_word(f->buf[(f->rd + k) % SWAU_FIFO_FRAMES], f->gain_q16);
+	}
+	f->rd += n;
+	f->played += n;
+	return n;
+}
+
+static void
+swau_fifo_flush(struct swau_fifo *f)
+{
+	f->rd = f->wr;
+	f->draining = 0;
+}
+
+#endif /* SWEET_AUDIO_FIFO_H */
diff --git a/bsd/dev/sweetaudio_dev.h b/bsd/dev/sweetaudio_dev.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweetaudio_dev.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * PixOS /dev/sweetaudio: the kernel <-> userland PCM contract (docs/research/54-ios-audio-path.md).
+ * Shared by the kernel driver (copy this header next to the cdev), the SweetAudio.driver HAL plug-in and sweetaudio_tone.
+ *
+ * Format is fixed: 48000 Hz, 2 channels interleaved (L, R), signed 16-bit little endian. 1 frame = 4 bytes.
+ * open(O_WRONLY): attaches the one writer (second opener: EBUSY). ENXIO when the output path (AOC ring + amps) is not up.
+ * write(): whole frames only (len % 4 != 0: EINVAL). Never blocks: copies min(len, free) bytes into the kernel FIFO and
+ *          returns that count (0 = FIFO full, the caller drops). EIO if the path went down after open.
+ * close(): the FIFO plays out (bounded by its size), then the kernel feeds silence again.
+ */
+#ifndef SWEETAUDIO_DEV_H
+#define SWEETAUDIO_DEV_H
+
+#include <stdint.h>
+#include <sys/ioccom.h>
+
+#define SWAU_DEV_PATH        "/dev/sweetaudio"
+#define SWAU_VERSION         1u
+#define SWAU_RATE            48000u
+#define SWAU_CHANNELS        2u
+#define SWAU_BYTES_PER_FRAME 4u
+#define SWAU_FIFO_FRAMES     8192u   /* kernel FIFO capacity (170.7 ms) */
+#define SWAU_START_FRAMES    960u    /* the kernel starts draining once this much is queued (20 ms); refilled after an underrun */
+
+struct swau_info {                   /* SWAU_IOC_INFO */
+	uint32_t version;                /* SWAU_VERSION */
+	uint32_t rate;                   /* SWAU_RATE */
+	uint16_t channels;               /* SWAU_CHANNELS */
+	uint16_t bits;                   /* 16 */
+	uint32_t fifo_frames;            /* SWAU_FIFO_FRAMES */
+	uint32_t start_frames;           /* SWAU_START_FRAMES */
+	uint32_t flags;                  /* SWAU_F_* */
+	int32_t  max_gain_mdb;           /* kernel gain clamp in milli-dB (<= 0), plan rule A-3 */
+	uint32_t reserved[3];
+};
+#define SWAU_F_PATH_UP   0x1u        /* AOC playback ring + amps running */
+#define SWAU_F_SILENCED  0x2u        /* the kernel discards PCM (safety stop); writes still succeed */
+
+struct swau_pos {                    /* SWAU_IOC_POS */
+	uint64_t frames_played;          /* frames taken from the FIFO by the AOC feed since open (silence not counted) */
+	uint64_t host_time;              /* mach_absolute_time() when frames_played was sampled */
+	uint32_t fifo_fill;              /* frames queued now */
+	uint32_t underruns;              /* FIFO-empty events since open */
+	uint32_t overruns;               /* bytes refused (FIFO full) since open / 4 */
+	uint32_t reserved;
+};
+
+#define SWAU_IOC_INFO     _IOR('a', 1, struct swau_info)
+#define SWAU_IOC_POS      _IOR('a', 2, struct swau_pos)
+#define SWAU_IOC_GAIN     _IOW('a', 3, int32_t)      /* requested gain in milli-dB; clamped to [-96000, max_gain_mdb] */
+#define SWAU_IOC_FLUSH    _IO('a', 4)                /* drop what is queued (HAL StopIO) */
+
+#endif

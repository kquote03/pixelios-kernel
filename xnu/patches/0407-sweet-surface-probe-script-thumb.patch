+/*
+ * Patch 0407 (oriole Safari 2026-11-19, PixOS doc 57 s.7): boot-arg sweetsurfprobe=SEC (default off; 1..600) reads the PIXELS of every LARGE surface (the
+ * 0160 scan covers only <= 1200x1200 single-plane ones; WebKit's page backing stores are 'w30r' 1125x1905): every SEC seconds (60 rounds) per surface of at least
+ * 256x128 px (plane 0 of a planar one), on a 64 x 64 grid of 32-bit words inside width x height: how many are non-zero, how many differ from the first sample, and a
+ * 16-word fingerprint (4 x 4 grid). Logged on first sight and whenever these or the lock counts change, at most 48 lines per round:
+ * `SWEET SURFPROBE r R: id I WxH fmt F planes P bpr B creator C nonzero N/S differ D/S fp w0..w15 locks L wunlocks U locker K seed E`.
+ * It answers "did WebKit draw into its tiles?" (all zero / uniform = nothing drawn; varying = pixels there). READ ONLY: loads of surface memory the kernel
+ * already maps (kernelAddress()), under a retain; no store, no register.
+ */
+static thread_call_t sweet_surf_probe_tc;
+static uint32_t      sweet_surf_probe_secs, sweet_surf_probe_round;
+static uint64_t      sweet_surf_probe_last[SWEET_SURFACE_MAX_ID];
+
+static void
+sweet_surf_probe_fire(thread_call_param_t p0, thread_call_param_t p1)
+{
+	(void)p0;
+	(void)p1;
+	uint32_t round = ++sweet_surf_probe_round, logged = 0, skipped = 0, seen = 0;
+	for (uint32_t id = 1; id < SWEET_SURFACE_MAX_ID; id++) {
+		SweetSurface *s = sweet_surface_copy(id);
+		if (s == NULL) {
+			sweet_surf_probe_last[id] = 0;
+			continue;
+		}
+		uint32_t w = s->width, h = s->height, bpr = s->bytesPerRow, off = s->offset;
+		if (s->planeCount > 0) {
+			w = s->planes[0].width;
+			h = s->planes[0].height;
+			bpr = s->planes[0].bytesPerRow;
+			off = s->planes[0].offset;
+		}
+		uintptr_t va = (w >= 256 && h >= 128 && bpr >= 4 && s->memory != NULL) ? s->kernelAddress() : 0;
+		uint64_t len = s->memory != NULL ? s->memory->getLength() : 0;
+		if (va != 0 && (uint64_t)off + (uint64_t)h * bpr <= len) {
+			const uint8_t *base = (const uint8_t *)va + off;
+			uint32_t wpr = bpr / 4, ww = w <= wpr ? w : wpr;   /* words per row inside the image (4 B per px for the formats of interest) */
+			uint32_t nz = 0, diff = 0, n = 0, first = 0, fp[16];
+			for (uint32_t gy = 0; gy < 64; gy++) {
+				const uint32_t *row = (const uint32_t *)(base + (uint64_t)(h * (2 * gy + 1) / 128) * bpr);
+				for (uint32_t gx = 0; gx < 64; gx++) {
+					uint32_t v = row[ww * (2 * gx + 1) / 128];
+					if (n == 0) {
+						first = v;
+					}
+					n++;
+					nz += v != 0;
+					diff += v != first;
+				}
+			}
+			for (uint32_t k = 0; k < 16; k++) {
+				const uint32_t *row = (const uint32_t *)(base + (uint64_t)(h * (2 * (k / 4) + 1) / 8) * bpr);
+				fp[k] = row[ww * (2 * (k % 4) + 1) / 8];
+			}
+			uint64_t sig = 1469598103934665603ull;
+			for (uint32_t k = 0; k < 16; k++) {
+				sig = (sig ^ fp[k]) * 1099511628211ull;
+			}
+			sig = (sig ^ ((uint64_t)nz << 32 | diff)) * 1099511628211ull;
+			sig = (sig ^ ((uint64_t)sweet_surf_locks[id] << 32 | sweet_surf_wunlocks[id])) * 1099511628211ull;
+			sig |= 1;
+			seen++;
+			if (sweet_surf_probe_last[id] != sig) {
+				if (++logged > 48) {
+					skipped++;
+				} else {
+					sweet_surf_probe_last[id] = sig;
+					IOLog("SWEET SURFPROBE r %u: id %u %ux%u fmt 0x%x planes %u bpr %u creator %s nonzero %u/%u differ %u/%u fp %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x"
+					    " locks %u wunlocks %u locker %s seed %u\n", round, id, w, h, s->pixelFormat, s->planeCount, bpr, s->creator[0] ? s->creator : "-", nz, n, diff, n,
+					    fp[0], fp[1], fp[2], fp[3], fp[4], fp[5], fp[6], fp[7], fp[8], fp[9], fp[10], fp[11], fp[12], fp[13], fp[14], fp[15],
+					    sweet_surf_locks[id], sweet_surf_wunlocks[id], sweet_surf_locker[id][0] ? sweet_surf_locker[id] : "-", s->state != NULL ? sweet_surface_seed_peek(s) : 0);
+				}
+			}
+		}
+		s->release();
+	}
+	IOLog("SWEET SURFPROBE r %u: %u large surfaces, %u lines, %u not logged (next round)\n", round, seen, logged > 48 ? 48 : logged, skipped);
+	if (round < 60 && sweet_surf_probe_tc != NULL) {
+		uint64_t dl;
+		clock_interval_to_deadline(sweet_surf_probe_secs, NSEC_PER_SEC, &dl);
+		thread_call_enter_delayed(sweet_surf_probe_tc, dl);
+	}
+}
+
+static void
+sweet_surf_probe_start(void)
+{
+	static UInt32 started;
+	uint32_t secs = 0;
+	if (!OSCompareAndSwap(0, 1, &started)) {
+		return;
+	}
+	if (PE_parse_boot_argn("sweetsurfprobe", &secs, sizeof(secs)) && secs != 0) {
+		sweet_surf_probe_secs = secs > 600 ? 600 : secs;
+		sweet_surf_probe_tc = thread_call_allocate(sweet_surf_probe_fire, NULL);
+		if (sweet_surf_probe_tc != NULL) {
+			uint64_t dl;
+			clock_interval_to_deadline(sweet_surf_probe_secs, NSEC_PER_SEC, &dl);
+			thread_call_enter_delayed(sweet_surf_probe_tc, dl);
+			IOLog("SWEET SURFPROBE: large-surface pixel probe every %u s (60 rounds)\n", sweet_surf_probe_secs);
+		}
+	}
+}

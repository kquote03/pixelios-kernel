+/* Patch 0395: 1 = a plausible fuel-gauge read set exists (age in ms; the caller decides what is stale), 0 = none yet or the thread is off. */
+int
+sweet_batt_get(uint32_t *soc_centi, uint32_t *mv, int32_t *ma, uint32_t *age_ms)
+{
+	uint64_t t = __atomic_load_n(&th_b_ms, __ATOMIC_ACQUIRE);
+
+	if (t == 0) {
+		return 0;
+	}
+	*soc_centi = th_b_soc;
+	*mv = th_b_mv;
+	*ma = th_b_ma;
+	*age_ms = (uint32_t)(th_now_ms() - t);
+	return 1;
+}
+
+/* Patch 0395: after a good temperature sample, at most every TH_BATT_MS; an implausible set (VCell outside 2800..4600 mV, RepSOC above 102 %) is not published (GAP once). */
+static void
+th_batt_sample(uint64_t now, int32_t cur_uA)
+{
+	static uint64_t last_try;
+	static int said;
+	uint32_t soc = 0, mv = 0;
+	int rd;
+
+	if (last_try != 0 && now - last_try < TH_BATT_MS) {
+		return;
+	}
+	last_try = now;
+	rd = sweet_chg_fg_batt(&soc, &mv);
+	if (rd != TH_RD_OK) {
+		return;
+	}
+	if (mv < 2800u || mv > 4600u || soc > 10200u) {
+		if (!said) {
+			said = 1;
+			printf("SWEET BATTERY GAP: implausible fuel-gauge set (soc %u.%02u %% vcell %u mV): not published\n", soc / 100u, soc % 100u, mv);
+		}
+		return;
+	}
+	th_b_soc = soc > 10000u ? 10000u : soc;
+	th_b_mv = mv;
+	th_b_ma = cur_uA / 1000;
+	__atomic_store_n(&th_b_ms, now ? now : 1, __ATOMIC_RELEASE);
+}

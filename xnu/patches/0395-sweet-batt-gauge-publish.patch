+/*
+ * Patch 0395 (oriole battery publish, the old oriole 0153 re-seated): one state-of-charge read set for SweetBattery, called by the thermal thread every 30 s after a good
+ * sweet_chg_fg_sample(). FG 0x36 reg 0x06 RepSOC (LSB 1/256 %) and reg 0x09 VCell (LSB 78.125 uV): the registers and conversions mon_row (patch 0298/0307) and i2c_g_fg
+ * (patch 0284) already read, both on the i2c_rd_slave_ok allowlist. Reads only; same guards and return codes as sweet_chg_fg_sample (a failed read stops the bus).
+ */
+int
+sweet_chg_fg_batt(uint32_t *soc_centi, uint32_t *mv)
+{
+	uint8_t sc[2], vc[2];
+	int rc = 0;
+
+	if (!sweet_chg_enter()) {
+		return 2;
+	}
+	if (i2c_group < 9) {
+		rc = 1;
+	} else if (!i2c_loaded || !sweet_chg_gate_established()) {
+		rc = -3;
+	} else if (i2c_dead) {
+		rc = -2;
+	} else if (!i2c_gate(!i2c_xfer_seen)) {
+		rc = -1;
+	} else if (chg_i2c_read(0x36, 0x06, 2, sc) != 0 || chg_i2c_read(0x36, 0x09, 2, vc) != 0) {
+		(void)i2c_wr(I_INTEN, 0);
+		i2c_log("SWEET CHG GAP: BATT fuel-gauge read failed: bus stopped, no more battery samples this boot\n");
+		rc = -1;
+	} else {
+		(void)i2c_wr(I_INTEN, 0);
+		i2c_xfer_seen = 1;
+		*soc_centi = ((uint32_t)(sc[0] | ((uint32_t)sc[1] << 8)) * 100u) / 256u;
+		*mv = (uint32_t)(((uint64_t)(vc[0] | ((uint32_t)vc[1] << 8)) * 78125u) / 1000000u);
+	}
+	sweet_chg_leave();
+	return rc;
+}

+/*
+ * Patch 0395 (oriole battery publish): no PM6150 (gs101): publish the MAX77759 fuel-gauge set of the thermal thread (sweet_batt_get, every 30 s). Before the first set the
+ * static fallback (100 %, never 0 %) stays; once a set was published, a stale gauge keeps the last values (SweetBatteryStale) instead of jumping back to 100 %.
+ * External power / charging = FG Current > +50 mA (the old 0153 rule: the charger state bytes are not read here).
+ */
+void
+SweetBattery::pollGauge(void)
+{
+	uint32_t soc = 0, mv = 0, age = 0;
+	int32_t ma = 0;
+	bool have = sweet_batt_get(&soc, &mv, &ma, &age) != 0;
+
+	if (have && age <= SWEET_BATT_STALE_MS) {
+		fGaugePct = (soc + 50u) / 100u;
+		fGaugeMv = mv;
+		fGaugeMa = ma;
+		fGaugeSeen = true;
+		fGauge = true;
+		bool in = ma > 50;
+		putBool("SweetBatteryStale", false);
+		publish(fGaugePct, fGaugeMv, fGaugeMa, in, in, in, false, true, true);
+		return;
+	}
+	if (fGaugeSeen) {
+		fGauge = true;
+		putBool("SweetBatteryStale", true);
+		publish(fGaugePct, fGaugeMv, fGaugeMa, false, false, false, false, true, false);
+		return;
+	}
+	fGauge = false;
+	publish(100, 4200, 0, true, true, false, true, false, false);
+}

+/* ---- patch 0389 (sweetaoc=11, amp_pwr_diag 3): does PCM reach the amps? The CSPL firmware meters VMON / IMON from DSP1 RX3 / RX4 (reset
+ * defaults VMON 0x18 / IMON 0x19, AMP cs35l41-tables.c:81-82; sources v6.18 cs35l41.h:631-645). With the DAC fed from ASPRX1 (0x08, the DSP
+ * out of the speaker path, as pattern 5) RX3 and RX4 := ASPRX1, so SPK_OUTPUT_POWER / BDLOG_VMON_LOW_FLAG meter the received PCM instead of
+ * the speaker. Positive control first: RX3 / RX4 := VPMON 0x28 (the supply, never zero). Then: S (silence), pattern 6 = 2 beeps with the AOC
+ * as is (ASP on), pattern 7 = 3 beeps with the AOC speaker mixer ASP_BYPASS (2), pattern 8 = 4 beeps ASP_BYPASS with RX3 / RX4 back on VMON /
+ * IMON (the speaker itself); then the ASP mode read before, DAC source DSP, RX3 / RX4 VMON / IMON, snapshot end. ~31 s, ticks each ms. ---- */
+static void amp_pwr_d3_src(const struct amp_snap *s, uint32_t rx3, uint32_t rx4)
+{
+	int cs;
+
+	for (cs = 0; cs < 2; cs++) {
+		(void)amp_pwr_rmw(s, cs, 0x4C48u, 0x7Fu, rx3, NULL);
+		(void)amp_pwr_rmw(s, cs, 0x4C4Cu, 0x7Fu, rx4, NULL);
+	}
+}
+static void amp_pwr_d3_meter(const struct amp_snap *s, const char *tag)
+{
+	/* "d3" line: DSP1_RX3_SRC, DSP1_RX4_SRC, DAC_PCM1_SRC, VPBR_STATUS, VBBR_STATUS, VOL_STATUS_TO_DSP, NGATE1_SRC */
+	static const uint32_t aux[7] = { 0x4C48u, 0x4C4Cu, AMP_PWR_PCMSRC, 0x640Cu, 0x6410u, 0x6450u, 0x4C60u };
+	static const uint8_t mo[8] = { 4, 66, 67, 69, 71, 72, 74, 75 };
+	uint32_t m[8];
+	unsigned i;
+	int cs;
+
+	for (cs = 0; cs < 2; cs++) {
+		const struct amp_dsp_side *ds = &amp_dsp_res.a[cs];
+
+		for (i = 0; i < 8u; i++)
+			m[i] = ds->cd_xm ? ds->cd_xm + mo[i] : 0u;
+		amp_pwr_diag_line(s, cs, "d3 ", tag, aux, 7u, 0);
+		amp_pwr_diag_line(s, cs, "meter temp/maxt/maxexc/ovexc ", tag, m, 4u, 1);
+		amp_pwr_diag_line(s, cs, "meter vlow/rpwr/atten/spkpwr ", tag, m + 4, 4u, 1);
+	}
+}
+/* wait ms (ticks each ms), meter lines at at1 (tag1) and at2 (tag2, 0 = none) */
+static unsigned amp_pwr_d3_wait(const struct amp_snap *s, unsigned ms, unsigned at1, const char *tag1, unsigned at2, const char *tag2)
+{
+	unsigned i;
+
+	for (i = 0; i < ms; i++) {
+		if (wait_ms(1u))
+			break;
+		if (amp_a9_cb.tick)
+			amp_a9_cb.tick(amp_a9_cb.ctx);
+		if (i + 1u == at1)
+			amp_pwr_d3_meter(s, tag1);
+		if (at2 && i + 1u == at2)
+			amp_pwr_d3_meter(s, tag2);
+	}
+	return i;
+}
+static unsigned amp_pwr_diag3_run(const struct amp_snap *s)
+{
+	unsigned ms = 0;
+	int asp_set = 0;
+	int cs;
+
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, 0x08u, NULL);
+	amp_pwr_d3_src(s, 0x28u, 0x28u);
+	con_str("SWEET", "AUDIO: a10e: DAC src ASPRX1, DSP1 RX3/RX4 := VPMON (control V)");
+	ms += amp_pwr_d3_wait(s, 1500u, 1400u, "V", 0u, NULL);
+	amp_pwr_d3_src(s, 0x08u, 0x08u);
+	con_str("SWEET", "AUDIO: a10e: DSP1 RX3/RX4 := ASPRX1, silence (S)");
+	ms += amp_pwr_d3_wait(s, 1500u, 1400u, "S", 0u, NULL);
+	con_str("SWEET", "AUDIO: pattern 6 starts now (2 beeps, AOC ASP on, det ASPRX1)");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 6);
+	ms += amp_pwr_d3_wait(s, 6200u, 1000u, "D1", 2600u, "D0");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	if (amp_pwr_aocp) {
+		(void)amp_pwr_aocp(amp_a9_cb.ctx, 2u);	/* ASP_BYPASS; the glue reads back after the set and logs both */
+		asp_set = 1;
+	}
+	con_str("SWEET", "AUDIO: pattern 7 starts now (3 beeps, AOC ASP_BYPASS, det ASPRX1)");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 7);
+	ms += amp_pwr_d3_wait(s, 9200u, 1000u, "E1", 2600u, "E0");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	amp_pwr_d3_src(s, 0x18u, 0x19u);
+	con_str("SWEET", "AUDIO: pattern 8 starts now (4 beeps, AOC ASP_BYPASS, det VMON/IMON)");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 8);
+	ms += amp_pwr_d3_wait(s, 12200u, 1000u, "F1", 2600u, "F0");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	if (asp_set)	/* whatever the set reply was: the message may have reached the AOC */
+		(void)amp_pwr_aocp(amp_a9_cb.ctx, 1u);	/* back to ASP_ON, the value the 0386 query read on every run (a10b..a10d) */
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, AMP_PCMSRC_DSP, NULL);
+	amp_pwr_diag_snap(s, "end");
+	amp_pwr_d3_meter(s, "end");
+	return ms;
+}
 static unsigned amp_pwr_diag_run(const struct amp_snap *s)
 {
 	unsigned ms = 0;
 	int cs;
 
+	if (amp_pwr_diag == 3)
+		return amp_pwr_diag3_run(s);
 	if (amp_pwr_diag == 2)
 		return amp_pwr_diag2_run(s);
 

+/* patch 0389 (sweetaoc=11): "AoC Speaker Mixer ASP Mode" write + read back: CMD_AUDIO_OUTPUT_SET_PARAMETER 209 (aoc-interface-gs101.h:113,
+ * struct :1034-1040 = the GET layout: u8 block, u8 component, u32 key, u32 val, 18 bytes) block 16 component 2 key 0 := val (aoc_set_asp_mode
+ * aoc_alsa_hw.c:1039-1065; texts ASP_OFF 0, ASP_ON 1, ASP_BYPASS 2, ASP_GROUND 3, aoc_alsa_ctl.c:2434-2436), then GET_PARAMETER 211 of the same
+ * key. Returns the value read back (reply bytes 14..17), or -1 when either exchange failed. */
+#define SWAU_CMD_SET_PARAM      209u
+static int32_t
+swau_asp_mode(const struct swau_bus *b, struct swau_res *r, uint32_t val, int *set_rc)
+{
+	uint8_t m[18];
+	int rc, i;
+
+	for (i = 0; i < 2; i++) {
+		swau_hdr(m, r->cntr++, 18u, i ? SWAU_CMD_GET_PARAM : SWAU_CMD_SET_PARAM);
+		m[8] = 16u;
+		m[9] = 2u;
+		swau_put32(m + 10, 0u);
+		swau_put32(m + 14, i ? 0u : val);
+		rc = swau_cmd(b, r, m, 18u);
+		if (!i) {
+			*set_rc = rc;
+		}
+		if (rc != SWAU_OK) {
+			return -1;
+		}
+	}
+	{
+		const struct swau_x *x = &r->x[r->nx - 1u];
+
+		return (int32_t)((uint32_t)x->pay[6] | (uint32_t)x->pay[7] << 8 | (uint32_t)x->pay[8] << 16 | (uint32_t)x->pay[9] << 24);
+	}
+}

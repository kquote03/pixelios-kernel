+#define SWW_IMG_MAXW    ((SWW_IMG_MAX + 3u) / 4u)       /* 441023 words (row W10; 441005 before patch 0396) */
 #define SWW_IMG_END     (SWW_RAM_BASE + 4u * SWW_IMG_MAXW)      /* first backplane address after the image words */
 #define SWW_CHUNK_W     16384u          /* words per 64 KiB chunk: preconditions, window and the CRC read-back are checked per chunk (row W10, s.3 (4)) */
 #define SWW_LAST_HI_MAX (SWW_RAM_BASE + SWW_RAM_MAX - 4u - SWW_WIN_TAIL)        /* last RAM word when ram_end > 0x400000: BAR2 offset under window SWW_WIN_TAIL, ram_end <= 0x600000 */

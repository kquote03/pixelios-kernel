 /* Run C (patch 0131, docs/research/43 rows W11..W13, boot-arg sweetwlan=5): the tail below ram_end = NVRAM text, length token, rTLV (DHD: dhdpcie_bus_write_vars, dhdpcie_wrt_rnd) */
 #define SWW_NV_DHD_MAX  32768u          /* MAX_NVRAMBUF_SIZE (bcm4389-dhd.h:509): DHD downloads only 0 < len < this (dhd_pcie.c:4208) */
@@ -210,11 +210,37 @@ _Static_assert(SWW_WIN_TAIL >= SWW_IMG_END, "the tail window starts above the im
 /* Run D (patch 0132, docs/research/43a rows W14, X4; boot-arg sweetwlan=6): the reset vector. DHD stores the first dword of the firmware file as bus->resetinstr (dhd_pcie.c:3934-3936) and, for a CA7,
  * writes it at address 0 after the image, the vars and the rTLV (dhd_pcie.c:10198-10227); the image itself also goes to SWW_RAM_BASE. Firmware IDENTITY pinned for level 6 (not firmware bytes): the
  * container entry's length and CRC32 (observed run wd3, review 0130 finding 8). The NVRAM entry is NOT pinned: it is only CRC-checked against its container record (swl_nv_prep). */
-#define SWW_FW_LEN      1764018u
+#define SWW_FW_LEN      1764018u        /* bluejay vendor fw_bcmdhd.bin (run wd3) */
 #define SWW_FW_CRC      0x1153ccffu
+/* patch 0396: oriole vendor fw_bcmdhd.bin, container line 'FW length 1764091 crc32 0x92567396 ok' (run wlan-oriole-l4, observed); host zlib.crc32 of the extracted file (sha256 8a52ffe1).
+ * The identity is chosen per board by the ADT root model-number (swl_fw_ident); a check accepts only the length AND CRC32 of the chosen row. */
+#define SWW_FW_LEN_ORIOLE 1764091u
+#define SWW_FW_CRC_ORIOLE 0x92567396u
 #define SWW_SEC_SBOOT   0x2u            /* DAR_SEC_SBOOT_MASK, include_pcie_core.h:1161; tested on the word at bp 0 because PCIe core 0x83c rev 72 < 74 (dhd_pcie.c:11741, 10208-10222) */
 #define SWW_CORE_PCIE2  0x83c           /* PCIE2_CORE_ID, include_hndsoc.h:200; the core whose rev is DHD's buscorerev */
-_Static_assert(SWW_FW_LEN == SWW_IMG_MAX, "the pinned firmware is the largest accepted image");
+_Static_assert(SWW_FW_LEN_ORIOLE == SWW_IMG_MAX && SWW_FW_LEN < SWW_IMG_MAX, "the larger pinned firmware (oriole) is the largest accepted image");
+
+struct swl_fwid { const char *model; uint32_t len, crc; };
+static const struct swl_fwid swl_fwids[] = {
+	{ "bluejay", SWW_FW_LEN, SWW_FW_CRC },          /* row 0: also every other or missing model (the upstream pin, unchanged) */
+	{ "oriole", SWW_FW_LEN_ORIOLE, SWW_FW_CRC_ORIOLE },
+};
+
+/* patch 0396: the identity row for an ADT model-number property (bytes incl. the NUL, as SecureDTGetProperty returns it); an exact name match only, else row 0 */
+static inline const struct swl_fwid *
+swl_fw_ident(const char *model, unsigned msize)
+{
+	unsigned i, n;
+
+	for (i = 1; model != 0 && i < sizeof swl_fwids / sizeof swl_fwids[0]; i++) {
+		for (n = 0; swl_fwids[i].model[n] != 0; n++) {
+		}
+		if (msize == n + 1u && model[n] == 0 && memcmp(model, swl_fwids[i].model, n) == 0) {
+			return &swl_fwids[i];
+		}
+	}
+	return &swl_fwids[0];
+}
 

SWEET WLAN firmware identity per board (patch 0396, oriole upstream port Step 3; replaces our dropped old-oriole-0147). Upstream pinned ONE firmware identity for the W14 reset vector (SWW_FW_LEN 1764018 / SWW_FW_CRC 0x1153ccff,
bluejay vendor fw_bcmdhd.bin, run wd3) and bounded the copied image by SWW_RAM_MIN 1791226 (SWW_IMG_MAX 1764018), so oriole's vendor image (1764091 B, CRC32 0x92567396, sha256 8a52ffe1; observed container line of run
wlan-oriole-l4) stopped at W8/W10 ("no usable image") before any store.
(a) sweet_wlan_wr.h: a table swl_fwids[] {model, len, crc}: row 0 bluejay (the upstream pin, unchanged; also every other or missing model), row 1 oriole. swl_fw_ident(model, msize) picks the row by an exact match of the
    ADT root model-number (tools/mkadt.py writes the board codename there, as sweet_amp.c already relies on). struct swl_wx gets pin_len/pin_crc; swl_wr's SWT_RV check and swl_fw_pin compare against them (0 = no
    identity = stop), so a board accepts only its own row: bluejay never runs oriole's image and the reverse.
(b) SWW_RAM_MIN 1791226 -> 1791299 (raised exactly by 73 B, the oriole image's excess): SWW_IMG_MAX 1764091 B, 441023 words, SWW_IMG_END 0x3AEAFC < SWW_WIN_TAIL 0x400000; oriole RAM 2752512 B observed (run
    wlan-oriole-l3, ram_end 0x4a0000) and bluejay's identical chip RAM stay above RAM_MIN. The W10 copy still stores only image words (img_next, CRC read-back); a smaller image (bluejay) is unaffected.
(c) sweet_wlan.c sweet_wlan_stage3: sw_fw_ident() reads the ADT root model-number once per stage 3, prints `SWEET WLAN: firmware identity row <model>: <len> bytes crc <crc>`, sets x.pin_len/pin_crc and the glue's
    rv_ok from the same row. No new register, address, value or write kind; NVRAM (oriole 24552 B < SWW_NV_VARS_MAX) and CLM (15976 B <= 12 x 1400) need no change.
Tests: the upstream host test (shim/wlan_wr_host_test.c) and tools/test_wlan_wr_mutants.py are built from the header through patch 0174 and keep bluejay's pinned values unchanged; shim/wlan_fwid_host_test.c builds the
header with this patch on top and checks the oriole values (row choice, bounds, swl_fw_pin both ways). ORDER: after 0395.
diff --git a/bsd/dev/sweet_wlan.c b/bsd/dev/sweet_wlan.c
index eddc148..0879cc3 100644
--- a/bsd/dev/sweet_wlan.c
+++ b/bsd/dev/sweet_wlan.c
@@ -1058,11 +1058,31 @@ sw3_delay(void *ctx, unsigned us)
 
 static int sw_g2_hook(struct swl_wx *x, uint32_t sh);
 
+/* patch 0396: the firmware identity of this board, chosen by the ADT root model-number (tools/mkadt.py writes the board codename there); a missing or other model = bluejay's row (the upstream pin).
+ * One line per stage 3 names the chosen row; no bus access. */
+static const struct swl_fwid *
+sw_fw_ident(void)
+{
+	DTEntry root;
+	char const *model = NULL;
+	unsigned int msize = 0;
+	const struct swl_fwid *id;
+
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess || SecureDTGetProperty(root, "model-number", (void const **)&model, &msize) != kSuccess) {
+		model = NULL;
+		msize = 0;
+	}
+	id = swl_fw_ident(model, msize);
+	printf("SWEET WLAN: firmware identity row %s: %u bytes crc %#010x\n", id->model, id->len, id->crc);
+	return id;
+}
+
 static void
 sweet_wlan_stage3(struct sw_hw *hw, int level)
 {
 	struct swl_wbus wb;
 	struct swl_wx x;
+	const struct swl_fwid *fwid;
 
 	wb.rd = sw3_rd;
 	wb.wr = sw3_wr;
@@ -1074,7 +1094,10 @@ sweet_wlan_stage3(struct sw_hw *hw, int level)
 	x.b = &wb;
 	x.level = level;
 	hw->l3 = level;
-	hw->rv_ok = level >= 6 && sw_fw.p != NULL && sw_fw.len == SWW_FW_LEN && sw_fw.crc == SWW_FW_CRC;
+	fwid = sw_fw_ident();
+	x.pin_len = fwid->len;
+	x.pin_crc = fwid->crc;
+	hw->rv_ok = level >= 6 && sw_fw.p != NULL && sw_fw.len == x.pin_len && sw_fw.crc == x.pin_crc;
 	hw->rv_done = 0;
 	hw->rel = 0;
 	hw->rv = hw->rv_ok ? ((uint32_t)sw_fw.p[0] | (uint32_t)sw_fw.p[1] << 8 | (uint32_t)sw_fw.p[2] << 16 | (uint32_t)sw_fw.p[3] << 24) : 0;

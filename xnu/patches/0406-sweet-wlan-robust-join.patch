+/* patch 0406: the re-join of an OPEN network (patch 0400 boot join): the join payload and the four values of the boot join (wpa_auth 0, wsec 0, auth 0, mfp 0), no PMK and no RSNE.
+ * The machine is the WPA2 one minus the 4-way: JOINING -> (SET_SSID 0 + LINK up) -> UP. Every call it makes has an L25 whitelist row (join, the read-only GETs, wsec/auth/mfp SETs); wpa_auth
+ * is never SET (its row allows only the WPA2 value): a firmware that reads back another wpa_auth gets a GAP and the join is tried anyway. 0 = armed, -1 = something missing (a GAP) */
+static inline int
+swl25_rj_arm_open(struct swl25_rj *rj, struct swl25h *h, const struct swg_jcmd *jc, uint32_t njc)
+{
+	static const char *const nm[5] = { "wpa_auth", "wsec", "auth", "mfp", "join" };
+	uint32_t i, k, got = 0u, val[4] = { 0u, 0u, 0u, 0u };
+
+	swl25_wipe(rj, sizeof *rj);
+	for (i = 0; jc != NULL && i < njc; i++) {
+		for (k = 0; k < 5u; k++) {
+			const uint32_t nl = (uint32_t)strlen(nm[k]) + 1u;
+
+			if (jc[i].cmd != SWJ_WLC_SET_VAR || jc[i].len <= nl || memcmp(jc[i].buf, nm[k], nl) != 0) {
+				continue;
+			}
+			if (k < 4u && jc[i].len == nl + 4u) {
+				val[k] = swd4b_get32(jc[i].buf + nl);
+				got |= 1u << k;
+			} else if (k == 4u && jc[i].len == nl + SWJ_EXT_JOIN_V1_SIZE) {
+				memcpy(rj->join, jc[i].buf + nl, SWJ_EXT_JOIN_V1_SIZE);
+				got |= 1u << k;
+			}
+		}
+	}
+	if (got != 0x1Fu || val[0] != 0u || val[1] != 0u) {
+		swl_gap("keep", "open re-join not armed: join payload missing or not an open join", "high");
+		printf("WIFI GAP: keep rejoin: open network, not armed (got mask %#x): the link will stay DOWN after an AP loss\n", got);
+		swl25_wipe(rj, sizeof *rj);
+		return -1;
+	}
+	rj->v_wpa_auth = val[0]; rj->v_wsec = val[1]; rj->v_auth = val[2]; rj->v_mfp = val[3];
+	rj->open = 1u;
+	rj->h = h;
+	rj->armed = 1u;
+	printf("SWEET WLAN: keep rejoin: open network, join payload kept for re-joins (after an AP loss: join again, backoff 2..30 s)\n");
+	return 0;
+}
+

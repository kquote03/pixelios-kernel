diff -ruN a/bsd/dev/sweet_wlan_join_pick.h b/bsd/dev/sweet_wlan_join_pick.h
--- a/bsd/dev/sweet_wlan_join_pick.h	1970-01-01 04:00:00.000000000 +0400
+++ b/bsd/dev/sweet_wlan_join_pick.h	2026-11-19 16:39:50.292539215 +0400
@@ -0,0 +1,90 @@
+/*
+ * Patch 0406 (oriole 2026-11-19, user report on daily image 9: the boot join of the open guest network failed again): pure helpers of the
+ * robust boot join, no bus, no state (host test shim/wlan_join_pick_host_test.c).
+ *
+ * Why [observed, runs daily-verify11/12-full]: the boot escan was a broadcast scan; on a dense campus the firmware sent one ESCAN_RESULT event per
+ * heard beacon (the same BSS up to 9 times, 7 SSIDs), the 48-event cap of the boot run (SWG_E_MAX_CLM: ring 0 does not wrap at L21..L24) filled
+ * and the run stopped at L23 before the join. Speed runs at quieter moments got 19-30 records and joined.
+ * What:
+ *  1. directed boot scan: the escan carries the credentials' SSID in wl_scan_params.ssid (params +4: u32 SSID_len, 32 B SSID = escan arg +12 / +16;
+ *     offsets of the comment of swg_e_l23) and scan_type ACTIVE (0), as OpenBSD bwfm_scan_v2 does for a desired ESSID
+ *     [src research-src/openbsd-src/sys/dev/ic/bwfm.c:2232-2236: scan_type = BWFM_SCANTYPE_ACTIVE, ssid len + bytes]. That the firmware then
+ *     reports only BSSs of that SSID is [guess], the first boot's `L23 bss` lines settle it (a broadcast-sized record count = no filter).
+ *  2. strongest AP: with a wildcard join the L23 target was the FIRST record of the SSID; now a later record of the same SSID with a higher
+ *     RSSI takes over (band does not matter, whichever the firmware reports stronger).
+ *  3. join retries: a SET_SSID with a non-zero status (observed 3 of 10 boots: LINK up, then SET_SSID status 1 2.7 s later) or no join events
+ *     in the budget re-sends the same join (the firmware's join scans again) up to SWJP_JOIN_TRIES times, only while ring 0 and the event cap
+ *     keep room for a whole attempt.
+ */
+#ifndef SWEET_WLAN_JOIN_PICK_H
+#define SWEET_WLAN_JOIN_PICK_H
+
+#include <stdint.h>
+
+#define SWJP_JOIN_TRIES   3u    /* join attempts at boot (1 + 2 retries) [decision] */
+#define SWJP_RETRY_MS     1500u /* wait before a retry (events consumed meanwhile) [decision] */
+#define SWJP_R0_ROOM      10u   /* ring-0 items one attempt may need: request + response re-post + up to 8 event re-posts [decision: observed 2-3 events per attempt] */
+#define SWJP_EV_ROOM      6u    /* event items one attempt may consume [decision] */
+#define SWJP_R0_LIMIT     126u  /* the glue's ring-0 indices end at 127 (no wrap at L24, SWG_E_MAX_CLM comment) */
+
+/* the SSID out of the join command "join\0" + wl_extjoin_params_v1_t (SSID_len u32 at ext +4, SSID at ext +8; sweet_wlan_join_fw.h swj_join_ext_v1).
+ * 0 = *slen in 1..32 and ssid[0..*slen) set; -1 = not a join command of that form */
+static inline int
+swjp_ssid_from_join(const uint8_t *buf, uint32_t len, uint8_t ssid[32], uint32_t *slen)
+{
+	static const char nm[5] = { 'j', 'o', 'i', 'n', '\0' };
+	uint32_t i, n;
+
+	*slen = 0u;
+	if (buf == 0 || len < 5u + 8u) {
+		return -1;
+	}
+	for (i = 0; i < 5u; i++) {
+		if (buf[i] != (uint8_t)nm[i]) {
+			return -1;
+		}
+	}
+	n = (uint32_t)buf[9] | (uint32_t)buf[10] << 8 | (uint32_t)buf[11] << 16 | (uint32_t)buf[12] << 24;
+	if (n == 0u || n > 32u || len < 13u + n) {
+		return -1;
+	}
+	for (i = 0; i < n; i++) {
+		ssid[i] = buf[13u + i];
+	}
+	*slen = n;
+	return 0;
+}
+
+/* the directed form of an escan START built by swg_e_escan_arg (or the glue's restatement): SSID_len at arg +12, SSID at arg +16 (zero padded to 32 B),
+ * scan_type ACTIVE (0) at arg +56. slen 0 leaves the broadcast passive scan unchanged. */
+static inline void
+swjp_escan_ssid(uint8_t arg[96], const uint8_t *ssid, uint32_t slen)
+{
+	uint32_t i;
+
+	if (slen == 0u || slen > 32u) {
+		return;
+	}
+	arg[12] = (uint8_t)slen;
+	arg[13] = arg[14] = arg[15] = 0u;
+	for (i = 0; i < 32u; i++) {
+		arg[16u + i] = i < slen ? ssid[i] : 0u;
+	}
+	arg[56] = 0u;
+}
+
+/* a record of the target SSID with another BSSID replaces the current target when it is stronger (strictly higher RSSI, dBm) */
+static inline int
+swjp_stronger(int cur_rssi, int new_rssi)
+{
+	return new_rssi > cur_rssi;
+}
+
+/* 1 = another join attempt fits: attempts made so far < SWJP_JOIN_TRIES, ring-0 write slot + room <= the limit, events consumed + room <= the cap */
+static inline int
+swjp_retry_ok(uint32_t made, uint32_t r0wr, uint32_t evn, uint32_t emax)
+{
+	return made < SWJP_JOIN_TRIES && r0wr + SWJP_R0_ROOM <= SWJP_R0_LIMIT && evn + SWJP_EV_ROOM <= emax;
+}
+
+#endif /* SWEET_WLAN_JOIN_PICK_H */

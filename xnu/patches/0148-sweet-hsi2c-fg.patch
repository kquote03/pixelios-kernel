diff --git a/bsd/dev/sweet_hsi2c.c b/bsd/dev/sweet_hsi2c.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_hsi2c.c
@@ -0,0 +1,258 @@
+/*
+ * xnu patch 0148: READ-ONLY MAX77759 fuel-gauge reader over HSI2C12 (oriole), glue for bsd/dev/sweet_hsi2c_fg.h. Inert unless boot-arg
+ * sweetbatt=1 AND the ADT node /sweet-batt (tools/mkadt.py, boards whose board.json has an fg block): without both nothing is mapped and
+ * nothing is read. With them: four blocks mapped (the HSI2C12 controller, the I2C12 pad bank, the sysreg USI12 mode word, CMU_PERIC1; all
+ * addresses from the ADT), then a kernel thread runs one read set 20 s after start and then every 30 s (sfg_set: bounded, no lock held,
+ * preemption off only for one register transfer). The first refusal or failure stops it for the rest of the boot; no reset, no reconfiguration.
+ * The only store of this file is sb_wr32() into the HSI2C12 block, and the header calls it only from sfg_w32() behind its allowlist.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/cpu_data.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <stdint.h>
+#include "sweet_hsi2c_fg.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);   /* osfmk/arm/machine_routines.h, XNU-private */
+extern int hz;
+void sweet_batt_init(void);
+int sweet_batt_sample(uint32_t *soc_centi, uint32_t *mv, int32_t *ma, int32_t *t_deci);
+
+#define SB_COMPAT       "google,gs101-hsi2c-fg"
+#define SB_FIRST_S      20      /* the first read set, after the touch thread has started (sweet_ufs_init calls both) */
+#define SB_PERIOD_S     30      /* then every 30 s */
+
+static struct {
+	volatile uint32_t *i2c, *pad, *mode, *cmu;
+	DTEntry node;
+	struct sfg_cfg cfg;
+	struct sfg_ops ops;
+	struct sfg_state st;
+} sb;
+
+static int
+sb_rd32(void *ctx, int space, uint32_t off, uint32_t *v)
+{
+	volatile uint32_t *base = NULL;
+	uint64_t len = 0;
+
+	(void)ctx;
+	if (space == SFG_SP_I2C) {
+		base = sb.i2c;
+		len = sb.cfg.i2c_len;
+	} else if (space == SFG_SP_PAD) {
+		base = sb.pad;
+		len = sb.cfg.pad_len;
+	} else if (space == SFG_SP_MODE) {
+		base = sb.mode;
+		len = sb.cfg.mode_len;
+	} else if (space == SFG_SP_CMU) {
+		base = sb.cmu;
+		len = sb.cfg.cmu_len;
+	}
+	if (base == NULL || (off & 3u) || (uint64_t)off + 4u > len) {
+		return 0;
+	}
+	*v = base[off / 4u];
+	return 1;
+}
+
+/* THE store: HSI2C12 block only, bounded to the mapped length; dsb sy after it (osfmk/arm/atomic.h DSB_SY 0xf), as the shim's try_write32 */
+static int
+sb_wr32(void *ctx, uint32_t off, uint32_t v)
+{
+	(void)ctx;
+	if (sb.i2c == NULL || (off & 3u) || (uint64_t)off + 4u > sb.cfg.i2c_len) {
+		return 0;
+	}
+	sb.i2c[off / 4u] = v;
+	__builtin_arm_dsb(0xf);
+	return 1;
+}
+
+static uint64_t
+sb_now(void *ctx)
+{
+	(void)ctx;
+	return mach_absolute_time();
+}
+
+static void
+sb_crit(void *ctx, int enter)
+{
+	(void)ctx;
+	if (enter) {
+		disable_preemption();
+	} else {
+		enable_preemption();
+	}
+}
+
+static void
+sb_say(void *ctx, const char *line)
+{
+	(void)ctx;
+	printf("%s\n", line);
+}
+
+static int
+sb_prop_u32(void *ctx, const char *name, uint32_t *v, unsigned n)
+{
+	void const *p = NULL;
+	unsigned int sz = 0;
+
+	(void)ctx;
+	if (SecureDTGetProperty(sb.node, name, &p, &sz) != kSuccess || p == NULL || n == 0u || n > SFG_NREGS || sz != 4u * n) {
+		return 0;
+	}
+	memcpy(v, p, sz);
+	return 1;
+}
+
+static int
+sb_prop_pa(void *ctx, const char *name, uint64_t *pa, uint64_t *len)
+{
+	void const *p = NULL;
+	unsigned int sz = 0;
+
+	(void)ctx;
+	if (SecureDTGetProperty(sb.node, name, &p, &sz) != kSuccess || p == NULL || sz != 2u * sizeof(uint64_t)) {
+		return 0;
+	}
+	memcpy(pa, p, sizeof(uint64_t));
+	memcpy(len, (uint8_t const *)p + sizeof(uint64_t), sizeof(uint64_t));
+	return 1;
+}
+
+static volatile uint32_t *
+sb_map(uint64_t pa, uint64_t len)
+{
+	uint64_t mask = (uint64_t)PAGE_MASK, base = pa & ~mask, end;
+	vm_offset_t va;
+
+	if (len == 0u || pa + len < pa || pa + len > UINT64_MAX - mask) {
+		return NULL;
+	}
+	end = (pa + len + mask) & ~mask;
+	va = ml_io_map((vm_offset_t)base, (vm_size_t)(end - base));
+	if (va == 0) {
+		printf("SWEET BATTERY: ml_io_map(%#llx) failed\n", pa);
+		return NULL;
+	}
+	return (volatile uint32_t *)(va + (vm_offset_t)(pa - base));
+}
+
+static void
+sb_thread(void *arg, wait_result_t wr)
+{
+	static int chan;
+
+	(void)arg;
+	(void)wr;
+	(void)tsleep(&chan, PZERO, "sweetbat", SB_FIRST_S * hz);
+	while (sfg_set(&sb.st, &sb.ops, &sb.cfg) == 0) {
+		(void)tsleep(&chan, PZERO, "sweetbat", SB_PERIOD_S * hz);
+	}
+	printf("SWEET BATTERY: reader stopped, no further HSI2C12 access this boot\n");
+}
+
+void
+sweet_batt_init(void)
+{
+	static int started;
+	uint32_t on = 0;
+	DTEntry node;
+	char const *compat = NULL;
+	unsigned int csize = 0;
+	const char *why;
+	struct sfg_props props;
+	uint64_t f = 0;
+	thread_t t;
+
+	if (started) {
+		return;
+	}
+	started = 1;
+	if (!PE_parse_boot_argn("sweetbatt", &on, sizeof(on)) || on == 0) {
+		return;         /* default: no map, no read */
+	}
+	if (on != 1) {
+		printf("SWEET BATTERY: refused sweetbatt=%u (only 1 is defined), not touched\n", on);
+		return;
+	}
+	if (SecureDTLookupEntry(NULL, "/sweet-batt", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "compatible", (void const **)&compat, &csize) != kSuccess ||
+	    compat == NULL || csize < sizeof(SB_COMPAT) || strncmp(compat, SB_COMPAT, sizeof(SB_COMPAT)) != 0) {
+		printf("SWEET BATTERY: refused no usable /sweet-batt node, not touched\n");
+		return;
+	}
+	sb.node = node;
+	props.u32 = sb_prop_u32;
+	props.pa = sb_prop_pa;
+	props.ctx = NULL;
+	why = sfg_cfg_load(&sb.cfg, &props);
+	if (why != NULL) {
+		printf("SWEET BATTERY: refused /sweet-batt: %s, not touched\n", why);
+		return;
+	}
+	sb.i2c = sb_map(sb.cfg.i2c_pa, sb.cfg.i2c_len);
+	sb.pad = sb_map(sb.cfg.pad_pa, sb.cfg.pad_len);
+	sb.mode = sb_map(sb.cfg.mode_pa, sb.cfg.mode_len);
+	sb.cmu = sb_map(sb.cfg.cmu_pa, sb.cfg.cmu_len);
+	if (sb.i2c == NULL || sb.pad == NULL || sb.mode == NULL || sb.cmu == NULL) {
+		printf("SWEET BATTERY: refused a block could not be mapped, not touched\n");
+		return;
+	}
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &f);
+	sb.ops.rd32 = sb_rd32;
+	sb.ops.wr32 = sb_wr32;
+	sb.ops.now = sb_now;
+	sb.ops.crit = sb_crit;
+	sb.ops.say = sb_say;
+	sb.ops.freq_hz = f;
+	sb.ops.ctx = NULL;
+	sb.st.stopped = 0;
+	sb.st.sets = 0;
+	if (kernel_thread_start(sb_thread, NULL, &t) != KERN_SUCCESS) {
+		printf("SWEET BATTERY: refused no thread, not touched\n");
+		return;
+	}
+	thread_deallocate(t);
+	printf("SWEET BATTERY: reader armed (HSI2C12 %#llx, device 0x%x), first read set in %d s, then every %d s\n", sb.cfg.i2c_pa,
+	    SFG_DEV_ADDR7, SB_FIRST_S, SB_PERIOD_S);
+}
+
+/*
+ * C5 (plan oneshot-2): the last plausible read set for SweetBattery.cpp (iokit/Kernel/arm), memory only, no hardware access.
+ * 0 = the values are fresh from a set that passed sfg_plausible and the reader is still running; -1 = none (not armed, no set
+ * yet, implausible, stopped). The reader thread is the only writer: two copies with the same seq and valid = 1 are consistent.
+ */
+int
+sweet_batt_sample(uint32_t *soc_centi, uint32_t *mv, int32_t *ma, int32_t *t_deci)
+{
+	const struct sfg_sample *l = &sb.st.last;
+	struct sfg_sample a, b;
+
+	if (sb.i2c == NULL || __atomic_load_n(&sb.st.stopped, __ATOMIC_ACQUIRE))
+		return -1;
+#define SB_LD(x) __atomic_load_n(&l->x, __ATOMIC_ACQUIRE)
+	a.seq = SB_LD(seq); a.valid = SB_LD(valid); a.soc_centi = SB_LD(soc_centi); a.mv = SB_LD(mv); a.ma = SB_LD(ma); a.t_deci = SB_LD(t_deci);
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	b.seq = SB_LD(seq); b.valid = SB_LD(valid); b.soc_centi = SB_LD(soc_centi); b.mv = SB_LD(mv); b.ma = SB_LD(ma); b.t_deci = SB_LD(t_deci);
+#undef SB_LD
+	if (a.seq == 0u || a.seq != b.seq || !a.valid || !b.valid || a.soc_centi != b.soc_centi || a.mv != b.mv || a.ma != b.ma ||
+	    a.t_deci != b.t_deci)
+		return -1;
+	*soc_centi = a.soc_centi;
+	*mv = a.mv;
+	*ma = a.ma;
+	*t_deci = a.t_deci;
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_hsi2c_fg.h b/bsd/dev/sweet_hsi2c_fg.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_hsi2c_fg.h
@@ -0,0 +1,1026 @@
+/*
+ * sweet_hsi2c_fg.h - xnu patch 0148: READ-ONLY fuel-gauge reader over HSI2C12 (MAX77759 fuel gauge, 7-bit 0x36), boot-arg sweetbatt=1.
+ * Pure C: no MMIO, no kernel call. Every bus access goes through struct sfg_ops (bsd/dev/sweet_hsi2c.c maps the blocks); every store goes
+ * through sfg_w32() -> sfg_w32_allowed(), and ops->wr32 is called in sfg_w32() only. shim/hsi2c_fg_xnu_host_test.c replays this file
+ * (extracted from the patch by shim/build.sh) against a fake controller; tools/test_hsi2c_fg_audit.py pins the writer and the allowlist.
+ *
+ * Port of the reviewed shim --fg-read (branch wip/shim-fg-read, shim/fgread.c at 33304b6, review docs/reviews/fgread-review-fable-1.md: SAFE
+ * after F1-F4; observed in run oriole-fg1: VCell 3974 mV, RepSOC 62.42 %, 29.4 C, AvgCurrent -144.6 mA, restore=ok). The controller sequence,
+ * the seven writable registers, their values, their order, the preconditions, the bounded waits and the F1-F3 restore are the shim's.
+ * Differences, each listed: (1) seven register pointers instead of five (Current 0x0A and DevName 0x21 added, board.json notes.fg); (2) the
+ * live controller must ALSO equal the bootloader handoff words observed in runs oriole-peri1 / oriole-fg1 (board.json fg.handoff), because
+ * XNU runs much later than the shim; (3) all constants come from the ADT node /sweet-batt (tools/mkadt.py from soc.json hsi2c/peri and
+ * board.json fg), not from a generated header; (4) the first failure, refusal or failed restore stops the reader for the rest of the boot.
+ *
+ * Bus traffic per register: ONE combined transfer = the 1-byte register pointer written WITHOUT stop, then a repeated-start read of 2 bytes
+ * WITH stop (GKI drivers/base/regmap/regmap-i2c.c:172-198; reg_bits 8 / val_bits 16, BMS max_m5.c:1615-1618). The device is always
+ * SFG_DEV_ADDR7; a register is named by enum sfg_reg (the pointer byte is derived from it), so a write transfer carrying data bytes cannot be
+ * expressed: the only write message has length SFG_LEN_PTR = 1 and its one TX byte must be one of the seven pointers.
+ * Sources (cites at the use): SGS = Google soc/gs android-gs-raviole-6.1-android16 @2040787 drivers/i2c/busses/i2c-exynos5.c (polling path
+ * exynos5_i2c_xfer_msg :769-1034), LX = Linux v6.18 drivers/i2c/busses/i2c-exynos5.c, BMS = Google bms 183509a.
+ */
+#ifndef SWEET_HSI2C_FG_H
+#define SWEET_HSI2C_FG_H
+
+#include <stdint.h>
+
+#if defined(__clang__)
+#define SFG_NOINL __attribute__((noinline))
+#else
+#define SFG_NOINL __attribute__((noipa))
+#endif
+
+/* ---- the device allowlist: policy of this reader, checked against the ADT (fg-addr7, fg-regs) ---- */
+#define SFG_DEV_ADDR7	0x36u		/* MAX77759 fuel gauge, Google gs101-raviole-battery.dtsi:182-185 (board.json notes.fg) */
+#define SFG_REGS(X) X(REPSOC, 0x06u) X(TEMP, 0x08u) X(VCELL, 0x09u) X(CURRENT, 0x0Au) X(AVGCURRENT, 0x0Bu) X(FULLCAPREP, 0x35u) X(DEVNAME, 0x21u)
+#define SFG_LEN_PTR	1u		/* reg_bits 8: one pointer byte (BMS max_m5.c:1616) */
+#define SFG_VAL_BYTES	2u		/* val_bits 16 (BMS max_m5.c:1617) */
+
+_Static_assert(SFG_DEV_ADDR7 == 0x36u, "the device allowlist is exactly {0x36}");
+_Static_assert(SFG_DEV_ADDR7 != 0x69u && SFG_DEV_ADDR7 != 0x66u && SFG_DEV_ADDR7 != 0x25u && SFG_DEV_ADDR7 != 0x57u && SFG_DEV_ADDR7 != 0x35u,
+    "never the charger 0x69, the PMIC 0x66, the TCPC 0x25, the PCA9468 0x57 or the OVP 0x35 (board.json notes.fg)");
+#define SFG_RANGE(n, r) _Static_assert((r) <= 0x4Fu, #n " must lie in the plain readable range 0x00..0x4F of max_m5_is_reg (BMS max_m5.c:1595)");
+SFG_REGS(SFG_RANGE)
+#undef SFG_RANGE
+
+enum sfg_reg {
+#define SFG_ENUM(n, r) SFG_R_##n,
+	SFG_REGS(SFG_ENUM)
+#undef SFG_ENUM
+	SFG_NREGS
+};
+_Static_assert(SFG_NREGS == 7, "seven registers");
+
+/* the pointer byte of a register (0xFF = none: refused by the TX allowlist) */
+static uint32_t
+sfg_reg_ptr(unsigned i)
+{
+#define SFG_PTR(n, r) if (i == SFG_R_##n) return (r);
+	SFG_REGS(SFG_PTR)
+#undef SFG_PTR
+	return 0xFFu;
+}
+
+static int
+sfg_is_reg_ptr(uint32_t v)
+{
+#define SFG_ISPTR(n, r) if (v == (r)) return 1;
+	SFG_REGS(SFG_ISPTR)
+#undef SFG_ISPTR
+	return 0;
+}
+
+/* ---- bus spaces the glue maps; the header asks only for the words sfg_rd_ok() names ---- */
+#define SFG_SP_I2C	0	/* HSI2C12 controller block (ADT reg) */
+#define SFG_SP_PAD	1	/* the pad bank of the two I2C12 pins (ADT pad-bank), read only */
+#define SFG_SP_MODE	2	/* sysreg USI12 mode word (ADT usi-mode-reg), read only */
+#define SFG_SP_CMU	3	/* CMU_PERIC1 (ADT cmu-reg), read only: the three gate words */
+
+struct sfg_ops {
+	int (*rd32)(void *ctx, int space, uint32_t off, uint32_t *v);	/* 1 = read */
+	int (*wr32)(void *ctx, uint32_t off, uint32_t v);		/* HSI2C12 block only; 1 = written */
+	uint64_t (*now)(void *ctx);					/* free-running counter */
+	void (*crit)(void *ctx, int enter);				/* no preemption between enter and leave (one register transfer) */
+	void (*say)(void *ctx, const char *line);			/* one console line */
+	uint64_t freq_hz;						/* counter frequency */
+	void *ctx;
+};
+
+/* ---- the constants, all from the ADT node /sweet-batt (tools/mkadt.py) ---- */
+struct sfg_cfg {
+	uint64_t i2c_pa, i2c_len, pad_pa, pad_len, mode_pa, mode_len, cmu_pa, cmu_len;
+	uint32_t mode_val, mode_mask, cmu_ipclk, cmu_pclk, cmu_qch, cg_val_bit, qch_en_bit, qch_req_bit;
+	uint32_t pad_con, pad_dat, pin_scl, pin_sda;
+	uint32_t o_ctl, o_fifo_ctl, o_trail, o_int_en, o_int_st, o_err, o_fifo_st, o_tx, o_rx, o_conf, o_auto, o_tmo, o_trans, o_addr, o_usicon;
+	uint32_t b_master, b_rxchon, b_txchon, b_rxfifo_en, b_txfifo_en, b_tx_under, b_tx_over, b_rx_under, b_rx_over, b_done, b_abort, b_nodevack,
+	    b_nodev, b_timeout, b_tx_full, b_tx_empty, b_rx_full, b_rx_empty, b_hs, b_10bit, b_auto_mode, b_rw, b_stop, b_run, b_timeout_en,
+	    b_sbusy, b_mbusy, b_usi_reset;
+	uint32_t f_rx_trig, f_tx_trig, f_rx_lvl, f_lvl_mask, f_len_mask, f_mas_shift, f_addr_mask, f_st_mask, st_idle, st_init, st_no_ack,
+	    st_lose, trailing_count, tx_depth, pad_func;
+	uint32_t addr7, regs[SFG_NREGS], vcell_nv, repsoc_lsb, temp_lsb, curr_na;
+	uint32_t h_ctl, h_fifo, h_trail, h_int_en, h_conf, h_auto, h_tmo, h_addr, h_usicon;
+	/* derived once by sfg_cfg_load() (formulas in sfg_derive) */
+	uint32_t v_ctl_tx, v_ctl_rx, v_fifo_w, v_fifo_r, v_int_en, v_addr, v_auto_w, v_auto_r, v_run, ctl_ch, int_nack, int_errs, conf_modes,
+	    fs_fulls, tr_busy, addr_mas_mask;
+};
+
+/* the u32 properties: X(field, "name", count) */
+#define SFG_CFG_U32(X) \
+	X(mode_val, "usi-mode-val", 1) X(mode_mask, "usi-mode-mask", 1) X(cmu_ipclk, "cmu-gate-ipclk-off", 1) X(cmu_pclk, "cmu-gate-pclk-off", 1) \
+	X(cmu_qch, "cmu-qch-off", 1) X(cg_val_bit, "cmu-cg-val-bit", 1) X(qch_en_bit, "cmu-qch-enable-bit", 1) X(qch_req_bit, "cmu-qch-req-bit", 1) \
+	X(pad_con, "pad-con-off", 1) X(pad_dat, "pad-dat-off", 1) X(pin_scl, "pin-scl", 1) X(pin_sda, "pin-sda", 1) \
+	X(o_ctl, "off-ctl", 1) X(o_fifo_ctl, "off-fifo-ctl", 1) X(o_trail, "off-trailing-ctl", 1) X(o_int_en, "off-int-enable", 1) \
+	X(o_int_st, "off-int-status", 1) X(o_err, "off-err-status", 1) X(o_fifo_st, "off-fifo-status", 1) X(o_tx, "off-tx-data", 1) \
+	X(o_rx, "off-rx-data", 1) X(o_conf, "off-conf", 1) X(o_auto, "off-auto-conf", 1) X(o_tmo, "off-timeout", 1) X(o_trans, "off-trans-status", 1) \
+	X(o_addr, "off-addr", 1) X(o_usicon, "off-usi-con", 1) \
+	X(b_master, "bit-ctl-master", 1) X(b_rxchon, "bit-ctl-rxchon", 1) X(b_txchon, "bit-ctl-txchon", 1) X(b_rxfifo_en, "bit-fifo-rxfifo-en", 1) \
+	X(b_txfifo_en, "bit-fifo-txfifo-en", 1) X(b_tx_under, "bit-int-tx-underrun", 1) X(b_tx_over, "bit-int-tx-overrun", 1) \
+	X(b_rx_under, "bit-int-rx-underrun", 1) X(b_rx_over, "bit-int-rx-overrun", 1) X(b_done, "bit-int-trans-done", 1) \
+	X(b_abort, "bit-int-trans-abort", 1) X(b_nodevack, "bit-int-no-dev-ack", 1) X(b_nodev, "bit-int-no-dev", 1) X(b_timeout, "bit-int-timeout", 1) \
+	X(b_tx_full, "bit-fifo-tx-full", 1) X(b_tx_empty, "bit-fifo-tx-empty", 1) X(b_rx_full, "bit-fifo-rx-full", 1) X(b_rx_empty, "bit-fifo-rx-empty", 1) \
+	X(b_hs, "bit-conf-hs-mode", 1) X(b_10bit, "bit-conf-10bit-addr", 1) X(b_auto_mode, "bit-conf-auto-mode", 1) X(b_rw, "bit-auto-read-write", 1) \
+	X(b_stop, "bit-auto-stop-after-trans", 1) X(b_run, "bit-auto-master-run", 1) X(b_timeout_en, "bit-timeout-en", 1) \
+	X(b_sbusy, "bit-trans-slave-busy", 1) X(b_mbusy, "bit-trans-master-busy", 1) X(b_usi_reset, "bit-usi-con-reset", 1) \
+	X(f_rx_trig, "fld-fifo-rx-trig-shift", 1) X(f_tx_trig, "fld-fifo-tx-trig-shift", 1) X(f_rx_lvl, "fld-fifo-rx-lvl-shift", 1) \
+	X(f_lvl_mask, "fld-fifo-lvl-mask", 1) X(f_len_mask, "fld-auto-len-mask", 1) X(f_mas_shift, "fld-addr-mas-shift", 1) \
+	X(f_addr_mask, "fld-addr-field-mask", 1) X(f_st_mask, "fld-trans-st-mask", 1) X(st_idle, "fld-st-idle", 1) X(st_init, "fld-st-init", 1) \
+	X(st_no_ack, "fld-st-no-ack", 1) X(st_lose, "fld-st-lose", 1) X(trailing_count, "fld-trailing-count", 1) X(tx_depth, "fld-tx-fifo-depth", 1) \
+	X(pad_func, "fld-pad-func", 1) \
+	X(addr7, "fg-addr7", 1) X(regs[0], "fg-regs", SFG_NREGS) X(vcell_nv, "fg-vcell-nv-per-lsb", 1) X(repsoc_lsb, "fg-repsoc-lsb-per-pct", 1) \
+	X(temp_lsb, "fg-temp-lsb-per-c", 1) X(curr_na, "fg-curr-na-per-lsb", 1) \
+	X(h_ctl, "handoff-ctl", 1) X(h_fifo, "handoff-fifo-ctl", 1) X(h_trail, "handoff-trailing-ctl", 1) X(h_int_en, "handoff-int-enable", 1) \
+	X(h_conf, "handoff-conf", 1) X(h_auto, "handoff-auto-conf", 1) X(h_tmo, "handoff-timeout", 1) X(h_addr, "handoff-addr", 1) \
+	X(h_usicon, "handoff-usi-con", 1)
+
+/* the (pa, len) u64 pairs */
+#define SFG_CFG_PA(X) X(i2c_pa, i2c_len, "reg") X(pad_pa, pad_len, "pad-bank") X(mode_pa, mode_len, "usi-mode-reg") X(cmu_pa, cmu_len, "cmu-reg")
+
+struct sfg_props {
+	int (*u32)(void *ctx, const char *name, uint32_t *v, unsigned n);		/* exactly n u32 values; 1 = found */
+	int (*pa)(void *ctx, const char *name, uint64_t *pa, uint64_t *len);	/* one (pa, len) u64 pair; 1 = found */
+	void *ctx;
+};
+
+#define SFG_BIT(n)	(1u << (n))
+
+/* the audited derived values (each one what SGS computes from the handoff state; cites at the use in sfg_msg_start) */
+static void
+sfg_derive(struct sfg_cfg *c)
+{
+	c->v_ctl_tx = SFG_BIT(c->b_master) | SFG_BIT(c->b_txchon);
+	c->v_ctl_rx = SFG_BIT(c->b_master) | SFG_BIT(c->b_rxchon);
+	c->v_fifo_w = SFG_BIT(c->b_rxfifo_en) | SFG_BIT(c->b_txfifo_en) | (SFG_LEN_PTR << c->f_rx_trig) | (SFG_LEN_PTR << c->f_tx_trig);
+	c->v_fifo_r = SFG_BIT(c->b_rxfifo_en) | SFG_BIT(c->b_txfifo_en) | (SFG_VAL_BYTES << c->f_rx_trig) | (SFG_VAL_BYTES << c->f_tx_trig);
+	c->v_int_en = SFG_BIT(c->b_done);
+	c->v_addr = SFG_DEV_ADDR7 << c->f_mas_shift;
+	c->v_auto_w = SFG_LEN_PTR;
+	c->v_auto_r = SFG_BIT(c->b_rw) | SFG_BIT(c->b_stop) | SFG_VAL_BYTES;
+	c->v_run = SFG_BIT(c->b_run);
+	c->ctl_ch = SFG_BIT(c->b_txchon) | SFG_BIT(c->b_rxchon);
+	c->int_nack = SFG_BIT(c->b_nodevack) | SFG_BIT(c->b_nodev);
+	c->int_errs = SFG_BIT(c->b_tx_under) | SFG_BIT(c->b_tx_over) | SFG_BIT(c->b_rx_under) | SFG_BIT(c->b_rx_over) | SFG_BIT(c->b_abort) |
+	    SFG_BIT(c->b_timeout);
+	c->conf_modes = SFG_BIT(c->b_auto_mode) | SFG_BIT(c->b_10bit) | SFG_BIT(c->b_hs);
+	c->fs_fulls = SFG_BIT(c->b_rx_full) | SFG_BIT(c->b_tx_full);
+	c->tr_busy = SFG_BIT(c->b_mbusy) | SFG_BIT(c->b_sbusy);
+	c->addr_mas_mask = c->f_addr_mask << c->f_mas_shift;
+}
+
+static int
+sfg_bit_ok(uint32_t b)
+{
+	return b < 32u;
+}
+
+/* Load and check every property; NULL = usable. Structural checks only (the values themselves are tools/mkadt.py's, tested there). */
+static const char *
+sfg_cfg_load(struct sfg_cfg *c, const struct sfg_props *p)
+{
+	uint32_t offs[15], bits[28];
+	unsigned i, j;
+
+#define SFG_LD32(f, name, n) if (!p->u32(p->ctx, (name), &c->f, (n))) return "property " name " missing or not " #n " u32";
+	SFG_CFG_U32(SFG_LD32)
+#undef SFG_LD32
+#define SFG_LDPA(f, l, name) if (!p->pa(p->ctx, (name), &c->f, &c->l)) return "property " name " missing or not one u64 pair";
+	SFG_CFG_PA(SFG_LDPA)
+#undef SFG_LDPA
+	if (c->addr7 != SFG_DEV_ADDR7)
+		return "fg-addr7 is not the allowlisted device 0x36";
+	for (i = 0; i < SFG_NREGS; i++)
+		if (c->regs[i] != sfg_reg_ptr(i))
+			return "fg-regs is not the allowlisted register list";
+	offs[0] = c->o_ctl; offs[1] = c->o_fifo_ctl; offs[2] = c->o_trail; offs[3] = c->o_int_en; offs[4] = c->o_int_st; offs[5] = c->o_err;
+	offs[6] = c->o_fifo_st; offs[7] = c->o_tx; offs[8] = c->o_rx; offs[9] = c->o_conf; offs[10] = c->o_auto; offs[11] = c->o_tmo;
+	offs[12] = c->o_trans; offs[13] = c->o_addr; offs[14] = c->o_usicon;
+	for (i = 0; i < 15u; i++) {
+		if ((offs[i] & 3u) || (uint64_t)offs[i] + 4u > c->i2c_len)
+			return "a controller offset is unaligned or outside reg";
+		for (j = 0; j < i; j++)
+			if (offs[i] == offs[j])
+				return "two controller offsets are equal";
+	}
+	bits[0] = c->b_master; bits[1] = c->b_rxchon; bits[2] = c->b_txchon; bits[3] = c->b_rxfifo_en; bits[4] = c->b_txfifo_en;
+	bits[5] = c->b_tx_under; bits[6] = c->b_tx_over; bits[7] = c->b_rx_under; bits[8] = c->b_rx_over; bits[9] = c->b_done; bits[10] = c->b_abort;
+	bits[11] = c->b_nodevack; bits[12] = c->b_nodev; bits[13] = c->b_timeout; bits[14] = c->b_tx_full; bits[15] = c->b_tx_empty;
+	bits[16] = c->b_rx_full; bits[17] = c->b_rx_empty; bits[18] = c->b_hs; bits[19] = c->b_10bit; bits[20] = c->b_auto_mode; bits[21] = c->b_rw;
+	bits[22] = c->b_stop; bits[23] = c->b_run; bits[24] = c->b_timeout_en; bits[25] = c->b_sbusy; bits[26] = c->b_mbusy; bits[27] = c->b_usi_reset;
+	for (i = 0; i < 28u; i++)
+		if (!sfg_bit_ok(bits[i]))
+			return "a bit number is not 0..31";
+	if (!sfg_bit_ok(c->cg_val_bit) || !sfg_bit_ok(c->qch_en_bit) || !sfg_bit_ok(c->qch_req_bit))
+		return "a CMU bit number is not 0..31";
+	if (c->b_master == c->b_rxchon || c->b_master == c->b_txchon || c->b_rxchon == c->b_txchon || c->b_rw == c->b_stop || c->b_rw == c->b_run ||
+	    c->b_stop == c->b_run || c->b_done == c->b_nodevack || c->b_mbusy == c->b_sbusy)
+		return "two bits of one register are equal";
+	if (c->f_mas_shift >= 32u || c->f_addr_mask < SFG_DEV_ADDR7 || ((c->f_addr_mask << c->f_mas_shift) >> c->f_mas_shift) != c->f_addr_mask ||
+	    c->f_rx_trig > 24u || c->f_tx_trig > 24u || c->f_rx_lvl > 24u ||
+	    c->f_lvl_mask == 0u || c->f_lvl_mask > 0xFFu || c->tx_depth == 0u || c->tx_depth > c->f_lvl_mask || c->f_len_mask < SFG_VAL_BYTES ||
+	    c->f_st_mask == 0u || c->f_st_mask > 0xFFu)
+		return "a field is out of range";
+	if (c->b_run <= 15u || c->b_rw <= 15u || c->b_stop <= 15u || (c->f_len_mask & (SFG_BIT(c->b_run) | SFG_BIT(c->b_rw) | SFG_BIT(c->b_stop))))
+		return "AUTO_CONF length field overlaps its control bits";
+	if (c->pin_scl > 7u || c->pin_sda > 7u || c->pin_scl == c->pin_sda || (c->pad_con & 3u) || (c->pad_dat & 3u) ||
+	    (uint64_t)c->pad_con + 4u > c->pad_len || (uint64_t)c->pad_dat + 4u > c->pad_len || c->pad_func > 0xFu)
+		return "pad description out of range";
+	if ((c->cmu_ipclk & 3u) || (c->cmu_pclk & 3u) || (c->cmu_qch & 3u) || (uint64_t)c->cmu_ipclk + 4u > c->cmu_len ||
+	    (uint64_t)c->cmu_pclk + 4u > c->cmu_len || (uint64_t)c->cmu_qch + 4u > c->cmu_len || c->mode_len < 4u || c->mode_mask == 0u ||
+	    (c->mode_val & ~c->mode_mask))
+		return "gate description out of range";
+	if ((c->i2c_pa & 0xFFFu) || c->i2c_len == 0u || c->i2c_len > 0x1000u || (c->pad_pa & 3u) || (c->mode_pa & 3u) || (c->cmu_pa & 0xFFFu) ||
+	    c->pad_len == 0u || c->pad_len > 0x100u || c->mode_len > 0x100u || c->cmu_len == 0u || c->cmu_len > (64u << 10))
+		return "a block address or length is out of range";
+	if (c->vcell_nv == 0u || c->repsoc_lsb == 0u || c->temp_lsb == 0u || c->curr_na == 0u)
+		return "a unit scale is zero";
+	sfg_derive(c);
+	if ((c->h_addr & ~c->addr_mas_mask) || (c->h_auto & c->v_run) || (c->h_ctl & ~c->ctl_ch) != SFG_BIT(c->b_master))
+		return "the handoff words fail the controller preconditions";
+	return 0;
+}
+
+/* ---- text ---- */
+#define SFG_LINE	200u
+
+struct sfg_buf {
+	char s[SFG_LINE];
+	unsigned n;
+};
+
+static void
+sfg_txt(struct sfg_buf *b, const char *t)
+{
+	while (*t && b->n + 1u < SFG_LINE)
+		b->s[b->n++] = *t++;
+}
+
+static void
+sfg_hex(struct sfg_buf *b, uint32_t v, unsigned digits)
+{
+	unsigned i;
+
+	for (i = 0; i < digits && b->n + 1u < SFG_LINE; i++) {
+		uint32_t d = (v >> (4u * (digits - 1u - i))) & 0xFu;
+
+		b->s[b->n++] = (char)(d < 10u ? '0' + d : 'A' + d - 10u);
+	}
+}
+
+/* unsigned decimal, at least `min` digits */
+static void
+sfg_dec(struct sfg_buf *b, uint32_t v, unsigned min)
+{
+	char t[10];
+	unsigned n = 0;
+
+	while ((v || n < min) && n < sizeof(t)) {
+		t[n++] = (char)('0' + v % 10u);
+		v /= 10u;
+	}
+	if (!n)
+		t[n++] = '0';
+	while (n && b->n + 1u < SFG_LINE)
+		b->s[b->n++] = t[--n];
+}
+
+/* scaled / 10^frac with a sign: '-' if negative, '+' if plus (and not negative) */
+static void
+sfg_fix(struct sfg_buf *b, int32_t scaled, unsigned frac, int plus)
+{
+	uint32_t m = scaled < 0 ? (uint32_t)(-(int64_t)scaled) : (uint32_t)scaled, d = frac == 2u ? 100u : 10u;
+
+	if (scaled < 0)
+		sfg_txt(b, "-");
+	else if (plus)
+		sfg_txt(b, "+");
+	sfg_dec(b, m / d, 1);
+	sfg_txt(b, ".");
+	sfg_dec(b, m % d, frac);
+}
+
+static void
+sfg_emit(const struct sfg_ops *o, struct sfg_buf *b)
+{
+	b->s[b->n < SFG_LINE ? b->n : SFG_LINE - 1u] = 0;
+	o->say(o->ctx, b->s);
+}
+
+static void
+sfg_start(struct sfg_buf *b, const char *what)
+{
+	b->n = 0;
+	sfg_txt(b, "SWEET BATTERY: ");
+	sfg_txt(b, what);
+}
+
+static void
+sfg_say(const struct sfg_ops *o, const char *a, const char *c)
+{
+	struct sfg_buf b;
+
+	sfg_start(&b, a);
+	sfg_txt(&b, c);
+	sfg_emit(o, &b);
+}
+
+/* "<what> <n1>=XXXXXXXX <n2>=XXXXXXXX <n3>=XXXXXXXX" */
+static void
+sfg_three(const struct sfg_ops *o, const char *what, const char *n1, uint32_t v1, const char *n2, uint32_t v2, const char *n3, uint32_t v3)
+{
+	struct sfg_buf b;
+
+	sfg_start(&b, what);
+	sfg_txt(&b, " ");
+	sfg_txt(&b, n1);
+	sfg_txt(&b, "=");
+	sfg_hex(&b, v1, 8);
+	sfg_txt(&b, " ");
+	sfg_txt(&b, n2);
+	sfg_txt(&b, "=");
+	sfg_hex(&b, v2, 8);
+	sfg_txt(&b, " ");
+	sfg_txt(&b, n3);
+	sfg_txt(&b, "=");
+	sfg_hex(&b, v3, 8);
+	sfg_emit(o, &b);
+}
+
+/* ---- one read set ---- */
+enum { SFG_OK = 0, SFG_NACK, SFG_TIMEOUT, SFG_ERROR };
+enum { SFG_W_TXROOM = 0, SFG_W_TXDONE, SFG_W_RXBYTE, SFG_W_IDLE };
+
+#define SFG_XFER_MS	10u		/* per message; LX allows 100 ms (EXYNOS5_I2C_TIMEOUT :165), SGS at least 100 ms (:797-800); 3 bytes at 400 kHz ~70 us */
+#define SFG_POLLS	100000u		/* per wait, whatever the counter says */
+#define SFG_TICK_SPINS	1000u		/* reads of the counter to see it move */
+
+/* the controller words read before anything is written; the restore writes exactly these back */
+struct sfg_snap {
+	uint32_t ctl, fifo, trail, inten, ist, err, fstat, conf, aconf, tmo, trans, addr, usicon;
+};
+struct sfg_st {
+	uint32_t ist, fs, ts;
+};
+/*
+ * Review F5 (docs/reviews/0148-hsi2c-fg-review-fable-1.md): what the reader saw when a transfer failed. Plain memory, filled only from words
+ * the reader already read (sfg_poll) and from the counter it already reads (sfg_wait): no extra register access. NULL = not recorded.
+ */
+enum { SFG_D_NONE = 0, SFG_D_PTR_START, SFG_D_PTR_TXROOM, SFG_D_PTR_TX, SFG_D_PTR_TXDONE, SFG_D_PTR_CLEAR, SFG_D_RD_START, SFG_D_RD_BYTE0,
+       SFG_D_RD_POP0, SFG_D_RD_BYTE1, SFG_D_RD_POP1, SFG_D_RD_IDLE, SFG_D_RD_CLEAR, SFG_D_NSTAGES };
+enum { SFG_DW_NONE = 0, SFG_DW_UNREADABLE, SFG_DW_NACK_INT, SFG_DW_NACK_STATE, SFG_DW_INT_ERRS, SFG_DW_LOSE, SFG_DW_ERR_STATUS, SFG_DW_N };
+struct sfg_diag {
+	unsigned stage, why, polls;
+	uint32_t ist, fs, ts, err, dt, lim;
+};
+struct sfg_run {
+	const struct sfg_ops *o;
+	const struct sfg_cfg *c;
+	struct sfg_snap s;
+	struct sfg_diag *d;
+};
+
+/* the words a read may target; everything else is refused before the bus (RX_DATA only through sfg_rx_pop, TX_DATA never) */
+static SFG_NOINL int
+sfg_rd_ok(const struct sfg_cfg *c, int sp, uint32_t off)
+{
+	if (sp == SFG_SP_MODE)
+		return off == 0u;
+	if (sp == SFG_SP_CMU)
+		return off == c->cmu_ipclk || off == c->cmu_pclk || off == c->cmu_qch;
+	if (sp == SFG_SP_PAD)
+		return off == c->pad_con || off == c->pad_dat;
+	if (sp == SFG_SP_I2C)
+		return off == c->o_ctl || off == c->o_fifo_ctl || off == c->o_trail || off == c->o_int_en || off == c->o_int_st || off == c->o_err ||
+		       off == c->o_fifo_st || off == c->o_conf || off == c->o_auto || off == c->o_tmo || off == c->o_trans || off == c->o_addr ||
+		       off == c->o_usicon;
+	return 0;
+}
+
+static int
+sfg_r32(const struct sfg_run *r, int sp, uint32_t off, uint32_t *v)
+{
+	if (!sfg_rd_ok(r->c, sp, off))
+		return 0;
+	return r->o->rd32(r->o->ctx, sp, off, v);
+}
+
+/* RX_DATA pops the RX FIFO: read only after FIFO_STATUS said not empty (the one call site, sfg_xfer) */
+static int
+sfg_rx_pop(const struct sfg_run *r, uint32_t *v)
+{
+	return r->o->rd32(r->o->ctx, SFG_SP_I2C, r->c->o_rx, v);
+}
+
+/* The offsets a write may target: exactly the seven registers of the SGS polling path. 0 = not writable (sfg_w32 then does not even read). */
+static SFG_NOINL int
+sfg_reg_writable(const struct sfg_cfg *c, uint32_t off)
+{
+	return off == c->o_ctl || off == c->o_fifo_ctl || off == c->o_int_en || off == c->o_int_st || off == c->o_tx || off == c->o_auto ||
+	       off == c->o_addr;
+}
+
+/* the snapshot value of a register = the only value its restore may write (0 for INT_STATUS / TX_DATA, which are never restored to a value) */
+static uint32_t
+sfg_snap_of(const struct sfg_cfg *c, const struct sfg_snap *s, uint32_t off)
+{
+	return off == c->o_ctl ? s->ctl : off == c->o_fifo_ctl ? s->fifo : off == c->o_int_en ? s->inten : off == c->o_addr ? s->addr :
+	       off == c->o_auto ? s->aconf : 0u;
+}
+
+/*
+ * The allowlist: (register, value) pairs; a pure function of its arguments. old = the register read just before (for TX_DATA: FIFO_STATUS),
+ * addr = ADDR read just before (AUTO_CONF only), rv = the snapshot value (restore). The restore entries are the snapshot values, which passed
+ * the preconditions and equal the handoff words; a MASTER_RUN value is never a restore value, and a MASTER_RUN write needs ADDR = 0x36 << 10
+ * and the config write already in the register, so no transfer can start towards any other device.
+ */
+static SFG_NOINL int
+sfg_w32_allowed(const struct sfg_cfg *c, uint32_t off, uint32_t old, uint32_t v, uint32_t addr, uint32_t rv)
+{
+	if (off == c->o_ctl)
+		return v == c->v_ctl_tx || v == c->v_ctl_rx || (v == rv && (v & ~c->ctl_ch) == SFG_BIT(c->b_master));
+	if (off == c->o_fifo_ctl)
+		return v == c->v_fifo_w || v == c->v_fifo_r || v == rv;
+	if (off == c->o_int_en)
+		return v == c->v_int_en || v == rv;
+	if (off == c->o_addr)
+		return v == c->v_addr || (v == rv && (v & ~c->addr_mas_mask) == 0u);
+	if (off == c->o_auto)
+		return v == c->v_auto_w || v == c->v_auto_r || (v == rv && (v & c->v_run) == 0u) ||
+		       ((v == (c->v_auto_w | c->v_run) || v == (c->v_auto_r | c->v_run)) && addr == c->v_addr && old == (v & ~c->v_run));
+	if (off == c->o_int_st)
+		return v == old;		/* write-1-to-clear of exactly the bits read (SGS :369-373, LX :272-276) */
+	if (off == c->o_tx)
+		return sfg_is_reg_ptr(v) && (old & c->f_lvl_mask) < c->tx_depth;
+	return 0;
+}
+
+/* The ONLY writer. off = register offset in the HSI2C12 block; reads before it writes; 0 = written, -1 = fault, -2 = refused (nothing written). */
+static SFG_NOINL int
+sfg_w32(const struct sfg_run *r, uint32_t off, uint32_t v)
+{
+	const struct sfg_cfg *c = r->c;
+	uint32_t old = 0, addr = 0;
+
+	if (!sfg_reg_writable(c, off))
+		return -2;			/* not one of the seven registers: not even read */
+	if (!sfg_r32(r, SFG_SP_I2C, off == c->o_tx ? c->o_fifo_st : off, &old))
+		return -1;			/* TX_DATA: the TX FIFO level is read, never the data register */
+	if (off == c->o_auto && !sfg_r32(r, SFG_SP_I2C, c->o_addr, &addr))
+		return -1;
+	if (!sfg_w32_allowed(c, off, old, v, addr, sfg_snap_of(c, &r->s, off)))
+		return -2;
+	return r->o->wr32(r->o->ctx, off, v) ? 0 : -1;
+}
+
+/* one poll: the status words; SFG_OK = no error bit (the caller tests its own condition) */
+static int
+sfg_poll(const struct sfg_run *r, struct sfg_st *st)
+{
+	const struct sfg_cfg *c = r->c;
+	uint32_t err = 0;
+
+	int ok = sfg_r32(r, SFG_SP_I2C, c->o_int_st, &st->ist) && sfg_r32(r, SFG_SP_I2C, c->o_fifo_st, &st->fs) &&
+	    sfg_r32(r, SFG_SP_I2C, c->o_trans, &st->ts) && sfg_r32(r, SFG_SP_I2C, c->o_err, &err);
+	unsigned why = !ok ? SFG_DW_UNREADABLE : (st->ist & c->int_nack) ? SFG_DW_NACK_INT : (st->ts & c->f_st_mask) == c->st_no_ack ? SFG_DW_NACK_STATE :
+	    (st->ist & c->int_errs) ? SFG_DW_INT_ERRS : err ? SFG_DW_ERR_STATUS : SFG_DW_NONE;	/* no LOSE (0xC) check here: c4-batt3 saw it mid-read with data and no TRANS_ABORT; LX :521-541 decides on INT_STATUS only, LOSE only before a transfer :670-693 */
+
+	if (r->d) {			/* F5: the words of this poll, kept in memory for the failure line */
+		r->d->ist = st->ist;
+		r->d->fs = st->fs;
+		r->d->ts = st->ts;
+		r->d->err = err;
+		r->d->why = why;
+	}
+	if (!ok)
+		return SFG_ERROR;
+	if (why == SFG_DW_NACK_INT || why == SFG_DW_NACK_STATE)
+		return SFG_NACK;	/* LX :529-536 (NO_DEV_ACK / NO_DEV -> -ENXIO); state NO_ACK :154 */
+	if (why != SFG_DW_NONE)
+		return SFG_ERROR;	/* LX :525-528 (TRANS_ABORT = arbitration), :537-540 (TIMEOUT); SGS :103-106 under/overrun; state LOSE :155 */
+	return SFG_OK;
+}
+
+static uint64_t
+sfg_lim(const struct sfg_run *r)
+{
+	return r->o->freq_hz / 1000u * SFG_XFER_MS;
+}
+
+/* the counter check of sfg_wait; F5: keeps the ticks since t0 (low 32 bits) */
+static int
+sfg_late(const struct sfg_run *r, uint64_t t0, uint64_t lim)
+{
+	uint64_t dt = r->o->now(r->o->ctx) - t0;
+
+	if (r->d)
+		r->d->dt = (uint32_t)dt;
+	return dt > lim;
+}
+
+/* Bounded wait for `what`, counted from t0 (the start of the message): SFG_XFER_MS of counter AND SFG_POLLS polls. */
+static int
+sfg_wait(const struct sfg_run *r, uint64_t t0, unsigned what, struct sfg_st *st)
+{
+	const struct sfg_cfg *c = r->c;
+	uint64_t lim = sfg_lim(r);
+	unsigned i;
+
+	for (i = 0; i < SFG_POLLS; i++) {
+		int e = sfg_poll(r, st), ok;
+
+		if (r->d) {			/* F5: poll count of this wait and its counter bound */
+			r->d->polls = i + 1u;
+			r->d->lim = (uint32_t)lim;
+		}
+		if (e != SFG_OK)
+			return e;
+		ok = what == SFG_W_TXROOM ? (st->fs & c->f_lvl_mask) < c->tx_depth :					/* SGS :966-968 */
+		     what == SFG_W_TXDONE ? (st->ist & SFG_BIT(c->b_done)) && (st->fs & SFG_BIT(c->b_tx_empty)) :	/* SGS :973-977 */
+		     what == SFG_W_RXBYTE ? !(st->fs & SFG_BIT(c->b_rx_empty)) :					/* SGS :899-900 */
+		     !(st->ts & SFG_BIT(c->b_mbusy));								/* LX :635-637 */
+		if (ok)
+			return SFG_OK;
+		if (sfg_late(r, t0, lim))
+			break;
+	}
+	return SFG_TIMEOUT;
+}
+
+/* Start one message of the combined transfer: rd = 0 the pointer write (no STOP), 1 the 2-byte read (STOP). SGS exynos5_i2c_xfer_msg :769-892. */
+static int
+sfg_msg_start(const struct sfg_run *r, int rd)
+{
+	const struct sfg_cfg *c = r->c;
+	uint32_t ist = 0, a = 0;
+
+	if (sfg_w32(r, c->o_fifo_ctl, rd ? c->v_fifo_r : c->v_fifo_w))			/* ref: SGS :815-825 (trigger = len, both FIFOs enabled) */
+		return SFG_ERROR;
+	if (!sfg_r32(r, SFG_SP_I2C, c->o_int_st, &ist) || sfg_w32(r, c->o_int_st, ist))	/* ref: SGS :845 exynos5_i2c_clr_pend_irq, :369-373 */
+		return SFG_ERROR;
+	if (!sfg_r32(r, SFG_SP_I2C, c->o_int_st, &ist) || ist)				/* deviation: nothing may be pending when the transfer starts */
+		return SFG_ERROR;
+	if (sfg_w32(r, c->o_addr, c->v_addr))						/* ref: SGS :855-863 (MAS field = 0x36 << 10); LX :747-752 */
+		return SFG_ERROR;
+	if (sfg_w32(r, c->o_ctl, rd ? c->v_ctl_rx : c->v_ctl_tx))				/* ref: SGS :828-838, :865 */
+		return SFG_ERROR;
+	if (sfg_w32(r, c->o_int_en, c->v_int_en))						/* ref: SGS :883 (polling branch: TRANSFER_DONE only) */
+		return SFG_ERROR;
+	if (sfg_w32(r, c->o_auto, rd ? c->v_auto_r : c->v_auto_w))				/* ref: SGS :832/:840, :847-850, :886-888 length */
+		return SFG_ERROR;
+	if (!sfg_r32(r, SFG_SP_I2C, c->o_auto, &a) || a != (rd ? c->v_auto_r : c->v_auto_w))	/* ref: SGS :890 (reads it back before MASTER_RUN) */
+		return SFG_ERROR;
+	if (sfg_w32(r, c->o_auto, (rd ? c->v_auto_r : c->v_auto_w) | c->v_run))		/* ref: SGS :891-892 */
+		return SFG_ERROR;
+	return SFG_OK;
+}
+
+/* F5: the step of sfg_xfer about to run (memory only); always 1, so it can sit inside the && chains */
+static int
+sfg_stage(const struct sfg_run *r, unsigned stage)
+{
+	if (r->d) {
+		r->d->stage = stage;
+		r->d->why = SFG_DW_NONE;
+		r->d->polls = 0;
+	}
+	return 1;
+}
+
+static const char *
+sfg_stage_name(unsigned s)
+{
+	static const char *const n[SFG_D_NSTAGES] = { "none", "ptr-start", "ptr-txroom", "ptr-tx", "ptr-txdone", "ptr-clear", "rd-start", "rd-byte0",
+						      "rd-pop0", "rd-byte1", "rd-pop1", "rd-idle", "rd-clear" };
+
+	return s < SFG_D_NSTAGES ? n[s] : "?";
+}
+
+static const char *
+sfg_why_name(unsigned w)
+{
+	static const char *const n[SFG_DW_N] = { "none", "unreadable", "nack-int", "nack-state", "int-errs", "lose-state", "err-status" };
+
+	return w < SFG_DW_N ? n[w] : "?";
+}
+
+/* F5: the failure-time lines (memory only): the step, the poll condition, the last polled INT_STATUS / FIFO_STATUS / TRANS / ERR, timing */
+static void
+sfg_diag_lines(const struct sfg_ops *o, const struct sfg_diag *d)
+{
+	struct sfg_buf b;
+
+	sfg_start(&b, "fail at ");
+	sfg_txt(&b, sfg_stage_name(d->stage));
+	sfg_txt(&b, " why=");
+	sfg_txt(&b, sfg_why_name(d->why));
+	sfg_txt(&b, " ERR=");
+	sfg_hex(&b, d->err, 8);
+	sfg_emit(o, &b);
+	sfg_three(o, "fail", "INT_STATUS", d->ist, "FIFO_STATUS", d->fs, "TRANS", d->ts);
+	sfg_three(o, "fail", "POLLS", d->polls, "DT", d->dt, "LIM", d->lim);
+}
+
+/* One register: pointer write without STOP, repeated-start read of two bytes with STOP (GKI regmap-i2c.c:181-191). *raw = LSB first. */
+static int
+sfg_xfer(const struct sfg_run *r, enum sfg_reg reg, uint32_t *raw)
+{
+	const struct sfg_cfg *c = r->c;
+	struct sfg_st st = { 0, 0, 0 };
+	uint32_t b = 0, v = 0;
+	uint64_t t0 = r->o->now(r->o->ctx);
+	int e;
+	unsigned n;
+
+	sfg_stage(r, SFG_D_PTR_START);
+	e = sfg_msg_start(r, 0);
+	if (e == SFG_OK && sfg_stage(r, SFG_D_PTR_TXROOM))
+		e = sfg_wait(r, t0, SFG_W_TXROOM, &st);
+	if (e == SFG_OK && sfg_stage(r, SFG_D_PTR_TX) && sfg_w32(r, c->o_tx, sfg_reg_ptr(reg)))	/* ref: SGS :969-970 */
+		e = SFG_ERROR;
+	if (e == SFG_OK && sfg_stage(r, SFG_D_PTR_TXDONE))
+		e = sfg_wait(r, t0, SFG_W_TXDONE, &st);
+	if (e == SFG_OK && sfg_stage(r, SFG_D_PTR_CLEAR) &&
+	    (!sfg_r32(r, SFG_SP_I2C, c->o_int_st, &st.ist) || sfg_w32(r, c->o_int_st, st.ist)))	/* ref: SGS :974-979 (w1c), fresh (F2) */
+		e = SFG_ERROR;
+	if (e != SFG_OK)
+		return e;
+	t0 = r->o->now(r->o->ctx);
+	sfg_stage(r, SFG_D_RD_START);
+	e = sfg_msg_start(r, 1);
+	for (n = 0; e == SFG_OK && n < SFG_VAL_BYTES; n++) {
+		sfg_stage(r, SFG_D_RD_BYTE0 + 2u * n);
+		e = sfg_wait(r, t0, SFG_W_RXBYTE, &st);						/* SGS :897-905 */
+		if (e == SFG_OK && sfg_stage(r, SFG_D_RD_POP0 + 2u * n) && !sfg_rx_pop(r, &b))
+			e = SFG_ERROR;
+		v |= (b & 0xFFu) << (8u * n);								/* LSB first (REGMAP_ENDIAN_NATIVE, BMS max_m5.c:1618) */
+	}
+	if (e == SFG_OK && sfg_stage(r, SFG_D_RD_IDLE))
+		e = sfg_wait(r, t0, SFG_W_IDLE, &st);						/* LX :820-821 exynos5_i2c_wait_bus_idle */
+	if (e == SFG_OK && sfg_stage(r, SFG_D_RD_CLEAR) &&
+	    (!sfg_r32(r, SFG_SP_I2C, c->o_int_st, &st.ist) || sfg_w32(r, c->o_int_st, st.ist)))	/* deviation: clear what the read raised (LX :512-513) */
+		e = SFG_ERROR;
+	*raw = v;
+	return e;
+}
+
+/* the shim's preconditions (shim/fgread.c precondition()), then the handoff words of board.json fg.handoff */
+static const char *
+sfg_precondition(const struct sfg_cfg *c, const struct sfg_snap *s)
+{
+	if ((s->ctl & ~c->ctl_ch) != SFG_BIT(c->b_master))
+		return "CTL not a plain master (MASTER + channel bits only)";
+	if ((s->conf & c->conf_modes) != SFG_BIT(c->b_auto_mode))
+		return "CONF not 7-bit auto mode (AUTO_MODE set, 10BIT / HS clear)";
+	if (s->aconf & ~(SFG_BIT(c->b_rw) | SFG_BIT(c->b_stop) | c->f_len_mask))
+		return "AUTO_CONF has MASTER_RUN or unknown bits";
+	if (s->tmo & SFG_BIT(c->b_timeout_en))
+		return "TIMEOUT_EN set (Linux clears it)";
+	if (s->trail != c->trailing_count)
+		return "TRAILING_CTL not Linux's trailing count";
+	if (s->addr & ~c->addr_mas_mask)
+		return "ADDR has bits outside the master address";
+	if (s->trans & c->tr_busy)
+		return "bus busy (TRANS_STATUS MASTER_BUSY/SLAVE_BUSY)";
+	if ((s->trans & c->f_st_mask) != c->st_idle && (s->trans & c->f_st_mask) != c->st_init)
+		return "master state not idle/init";
+	if ((s->fstat & (SFG_BIT(c->b_rx_empty) | SFG_BIT(c->b_tx_empty))) != (SFG_BIT(c->b_rx_empty) | SFG_BIT(c->b_tx_empty)) ||
+	    (s->fstat & c->f_lvl_mask) || ((s->fstat >> c->f_rx_lvl) & c->f_lvl_mask) || (s->fstat & c->fs_fulls))
+		return "FIFO not empty";
+	if (s->ist)
+		return "INT_STATUS pending";
+	if (s->err)
+		return "ERR_STATUS nonzero";
+	if (s->usicon & SFG_BIT(c->b_usi_reset))
+		return "USI in reset (USI_CON bit 0)";
+	if (s->ctl != c->h_ctl)
+		return "handoff: CTL differs from the observed bootloader value";
+	if (s->fifo != c->h_fifo)
+		return "handoff: FIFO_CTL differs from the observed bootloader value";
+	if (s->trail != c->h_trail)
+		return "handoff: TRAILING_CTL differs from the observed bootloader value";
+	if (s->inten != c->h_int_en)
+		return "handoff: INT_ENABLE differs from the observed bootloader value";
+	if (s->conf != c->h_conf)
+		return "handoff: CONF differs from the observed bootloader value";
+	if (s->aconf != c->h_auto)
+		return "handoff: AUTO_CONF differs from the observed bootloader value";
+	if (s->tmo != c->h_tmo)
+		return "handoff: TIMEOUT differs from the observed bootloader value";
+	if (s->addr != c->h_addr)
+		return "handoff: ADDR differs from the observed bootloader value";
+	if (s->usicon != c->h_usicon)
+		return "handoff: USI_CON differs from the observed bootloader value";
+	return 0;
+}
+
+/* review F1: before the restore writes, a bounded wait for MASTER_BUSY = 0 (LX :635-637); reads only. 1 = idle seen. */
+static int
+sfg_idle_wait(const struct sfg_run *r)
+{
+	uint64_t t0 = r->o->now(r->o->ctx), lim = sfg_lim(r);
+	uint32_t ts = 0;
+	unsigned i;
+
+	for (i = 0; i < SFG_POLLS; i++) {
+		if (sfg_r32(r, SFG_SP_I2C, r->c->o_trans, &ts) && !(ts & SFG_BIT(r->c->b_mbusy)))
+			return 1;
+		if (r->o->now(r->o->ctx) - t0 > lim)
+			break;
+	}
+	return 0;
+}
+
+/* Put back what was read before, unconditionally, then read everything back. 1 = every write accepted, the five words equal, INT_STATUS 0,
+ * and (review F3) the bus left as found: MASTER_BUSY / SLAVE_BUSY clear, both FIFOs empty, ERR_STATUS 0. `loud` = print the read-back lines. */
+static int
+sfg_restore(const struct sfg_run *r, int loud)
+{
+	const struct sfg_cfg *c = r->c;
+	const struct sfg_snap *s = &r->s;
+	uint32_t ctl = 0, fifo = 0, inten = 0, addr = 0, aconf = 0, ist = 0, err = 0, fs = 0, ts = 0;
+	int e = 0, ok, bus, idle;
+
+	idle = sfg_idle_wait(r);
+	e |= sfg_w32(r, c->o_auto, s->aconf);				/* ref: SGS :886-888 (an AUTO_CONF write without MASTER_RUN only configures) */
+	e |= sfg_w32(r, c->o_addr, s->addr);				/* ref: SGS :863 */
+	e |= sfg_w32(r, c->o_ctl, s->ctl);				/* ref: SGS :865 */
+	e |= sfg_w32(r, c->o_fifo_ctl, s->fifo);			/* ref: SGS :825 */
+	e |= sfg_w32(r, c->o_int_en, s->inten);				/* ref: SGS :883 */
+	if (sfg_r32(r, SFG_SP_I2C, c->o_int_st, &ist))
+		e |= sfg_w32(r, c->o_int_st, ist);			/* ref: SGS :369-373 clr_pend_irq */
+	else
+		e = -1;
+	ok = sfg_r32(r, SFG_SP_I2C, c->o_ctl, &ctl) && sfg_r32(r, SFG_SP_I2C, c->o_fifo_ctl, &fifo) && sfg_r32(r, SFG_SP_I2C, c->o_int_en, &inten) &&
+	    sfg_r32(r, SFG_SP_I2C, c->o_addr, &addr) && sfg_r32(r, SFG_SP_I2C, c->o_auto, &aconf) && sfg_r32(r, SFG_SP_I2C, c->o_int_st, &ist);
+	bus = ok && sfg_r32(r, SFG_SP_I2C, c->o_err, &err) && sfg_r32(r, SFG_SP_I2C, c->o_fifo_st, &fs) && sfg_r32(r, SFG_SP_I2C, c->o_trans, &ts);
+	if (!ok) {
+		sfg_say(r->o, "restore: ", "read-back unreadable");
+		return 0;
+	}
+	bus = bus && err == 0u && !(ts & c->tr_busy) &&
+	    (fs & (SFG_BIT(c->b_rx_empty) | SFG_BIT(c->b_tx_empty))) == (SFG_BIT(c->b_rx_empty) | SFG_BIT(c->b_tx_empty)) &&
+	    !(fs & c->f_lvl_mask) && !((fs >> c->f_rx_lvl) & c->f_lvl_mask);
+	ok = e == 0 && ctl == s->ctl && fifo == s->fifo && inten == s->inten && addr == s->addr && aconf == s->aconf && ist == 0u && bus;
+	if (loud || !ok) {
+		sfg_say(r->o, "restore wait idle=", idle ? "1" : "0");
+		sfg_three(r->o, "restore", "CTL", ctl, "FIFO_CTL", fifo, "INT_EN", inten);
+		sfg_three(r->o, "restore", "ADDR", addr, "AUTO_CONF", aconf, "INT_STATUS", ist);
+		sfg_three(r->o, "after", "ERR", err, "FIFO_STATUS", fs, "TRANS", ts);
+	}
+	if (!bus)
+		sfg_say(r->o, "!!! BUS NOT IDLE: ", "MASTER_BUSY / a FIFO / ERR_STATUS after the restore (see the after line)");
+	return ok;
+}
+
+/* the gate of shim/periprobe.h peri_gate(): USI mode = I2C, IPCLK and PCLK CG_VAL, QCH ENABLE or CLOCK_REQ; reads only */
+static const char *
+sfg_gate(const struct sfg_run *r)
+{
+	const struct sfg_cfg *c = r->c;
+	uint32_t m = 0, ip = 0, pc = 0, q = 0;
+
+	if (!sfg_r32(r, SFG_SP_MODE, 0, &m))
+		return "i2c12 gate sysreg-unreadable, nothing written";
+	if ((m & c->mode_mask) != c->mode_val)
+		return "i2c12 gate mode-not-selected, nothing written";
+	if (!sfg_r32(r, SFG_SP_CMU, c->cmu_ipclk, &ip) || !sfg_r32(r, SFG_SP_CMU, c->cmu_pclk, &pc) || !sfg_r32(r, SFG_SP_CMU, c->cmu_qch, &q))
+		return "i2c12 gate cmu-unreadable, nothing written";
+	if (!(ip & SFG_BIT(c->cg_val_bit)))
+		return "i2c12 gate ipclk-gated, nothing written";
+	if (!(pc & SFG_BIT(c->cg_val_bit)))
+		return "i2c12 gate pclk-gated, nothing written";
+	if (!(q & (SFG_BIT(c->qch_en_bit) | SFG_BIT(c->qch_req_bit))))
+		return "i2c12 gate qch-no-clkreq, nothing written";
+	return 0;
+}
+
+/* review F4: both I2C12 pads in the I2C function and high (an idle bus) before the first write; reads only */
+static const char *
+sfg_pads(const struct sfg_run *r)
+{
+	const struct sfg_cfg *c = r->c;
+	uint32_t con = 0, dat = 0;
+
+	if (!sfg_r32(r, SFG_SP_PAD, c->pad_con, &con) || !sfg_r32(r, SFG_SP_PAD, c->pad_dat, &dat))
+		return "I2C12 pads unreadable, nothing written";
+	if (((con >> (4u * c->pin_scl)) & 0xFu) != c->pad_func || ((con >> (4u * c->pin_sda)) & 0xFu) != c->pad_func ||
+	    !((dat >> c->pin_scl) & 1u) || !((dat >> c->pin_sda) & 1u))
+		return "I2C12 pads not in the I2C function / a line low, nothing written";
+	return 0;
+}
+
+/* read the counter until it moves (bounded): 1 = running */
+static int
+sfg_counter_runs(const struct sfg_run *r)
+{
+	uint64_t t0 = r->o->now(r->o->ctx);
+	unsigned i;
+
+	for (i = 0; i < SFG_TICK_SPINS; i++)
+		if (r->o->now(r->o->ctx) != t0)
+			return 1;
+	return 0;
+}
+
+static const char *
+sfg_reg_name(unsigned i)
+{
+#define SFG_NAME(n, rg) if (i == SFG_R_##n) return #n;
+	SFG_REGS(SFG_NAME)
+#undef SFG_NAME
+	return "?";
+}
+
+/* the summary line: soc=NN.NN% v=NNNN mV i=+-N.N mA t=NN.N C src=fg (BMS maxfg_common.h:192-214, max1720x_battery.c:473-477, register sign) */
+static void
+sfg_battery_line(const struct sfg_run *r, const uint32_t *raw)
+{
+	const struct sfg_cfg *c = r->c;
+	struct sfg_buf b;
+	int32_t temp = (int32_t)(int16_t)(uint16_t)raw[SFG_R_TEMP], cur = (int32_t)(int16_t)(uint16_t)raw[SFG_R_AVGCURRENT];
+
+	sfg_start(&b, "soc=");
+	sfg_fix(&b, (int32_t)(raw[SFG_R_REPSOC] * 100u / c->repsoc_lsb), 2, 0);
+	sfg_txt(&b, "% v=");
+	sfg_dec(&b, (uint32_t)((uint64_t)raw[SFG_R_VCELL] * c->vcell_nv / 1000000u), 1);
+	sfg_txt(&b, " mV i=");
+	sfg_fix(&b, (int32_t)((int64_t)cur * (int64_t)c->curr_na / 100000), 1, 1);
+	sfg_txt(&b, " mA t=");
+	sfg_fix(&b, temp * 10 / (int32_t)c->temp_lsb, 1, 0);
+	sfg_txt(&b, " C src=fg");
+	sfg_emit(r->o, &b);
+}
+
+/* C5 (plan oneshot-2): the last read set as numbers, for the iOS power source (SweetBattery.cpp via sweet_batt_sample in sweet_hsi2c.c).
+ * Pure arithmetic on the raw words sfg_set already read; no hardware access. valid = 1 only when the set passes sfg_plausible
+ * (review 0148-3 H2: an implausible or changed-DevName set is logged but never published). */
+struct sfg_sample {
+	uint32_t valid;		/* 1: the fields below may be published */
+	uint32_t seq;		/* read sets that reached this point (written last; readers check it did not change) */
+	uint32_t soc_centi;	/* RepSOC, 0.01 % */
+	uint32_t mv;		/* VCell, mV */
+	int32_t ma;		/* AvgCurrent, mA, register sign: negative = discharging (max1720x_battery.c:1147,1152 report it negated) */
+	int32_t t_deci;		/* Temp, 0.1 C */
+	uint32_t devname;	/* DevName, latched from the first plausible set */
+};
+
+struct sfg_state {
+	int stopped;		/* latched: no hardware access ever again this boot */
+	unsigned sets;		/* read sets done */
+	struct sfg_sample last;	/* C5 */
+};
+
+/* soc 0..100 %, VCell 2800..4600 mV (a 1S Li-ion cell; the same bounds as the PM6150 path in SweetBattery.cpp), Temp -20..70 C */
+static int
+sfg_plausible(const struct sfg_sample *s)
+{
+	return s->soc_centi <= 10000u && s->mv >= 2800u && s->mv <= 4600u && s->t_deci >= -200 && s->t_deci <= 700;
+}
+
+static void
+sfg_sample_set(struct sfg_state *st, const struct sfg_ops *o, const struct sfg_cfg *c, const uint32_t *raw)
+{
+	struct sfg_sample s;
+	struct sfg_buf b;
+	int32_t temp = (int32_t)(int16_t)(uint16_t)raw[SFG_R_TEMP], cur = (int32_t)(int16_t)(uint16_t)raw[SFG_R_AVGCURRENT];
+
+	s.soc_centi = raw[SFG_R_REPSOC] * 100u / c->repsoc_lsb;		/* the summary line's formulas (sfg_battery_line) */
+	s.mv = (uint32_t)((uint64_t)raw[SFG_R_VCELL] * c->vcell_nv / 1000000u);
+	s.ma = (int32_t)((int64_t)cur * (int64_t)c->curr_na / 1000000);
+	s.t_deci = temp * 10 / (int32_t)c->temp_lsb;
+	s.devname = raw[SFG_R_DEVNAME] & 0xFFFFu;
+	s.valid = (uint32_t)sfg_plausible(&s);
+	if (s.valid && st->last.devname == 0u)
+		st->last.devname = s.devname;
+	if (s.valid && s.devname != st->last.devname) {
+		sfg_start(&b, "sample not published (DevName ");
+		sfg_hex(&b, s.devname, 4);
+		sfg_txt(&b, " != ");
+		sfg_hex(&b, st->last.devname, 4);
+		sfg_txt(&b, ")");
+		sfg_emit(o, &b);
+		s.valid = 0;
+	}
+	s.devname = st->last.devname;
+	s.seq = st->last.seq + 1u;
+	st->last.valid = 0;			/* the reader in another thread sees valid = 0 while the fields change */
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	st->last.soc_centi = s.soc_centi;
+	st->last.mv = s.mv;
+	st->last.ma = s.ma;
+	st->last.t_deci = s.t_deci;
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	st->last.valid = s.valid;
+	st->last.seq = s.seq;
+}
+
+static int
+sfg_refuse(struct sfg_state *st, const struct sfg_ops *o, const char *why)
+{
+	sfg_say(o, "refused ", why);
+	st->stopped = 1;
+	return 1;
+}
+
+/*
+ * One read set: counter, the i2c12 gate, the pads, the controller words, the preconditions (+ handoff), the seven reads (the first failure
+ * stops the rest), the unconditional restore. 0 = seven reads and a verified restore; 1 = refused or failed, and the reader is stopped.
+ */
+static int
+sfg_set(struct sfg_state *st, const struct sfg_ops *o, const struct sfg_cfg *c)
+{
+	struct sfg_run r;
+	struct sfg_diag dg = { 0, 0, 0, 0, 0, 0, 0, 0, 0 };
+	struct sfg_buf b;
+	uint32_t raw[SFG_NREGS];
+	const char *why;
+	unsigned i, failed = SFG_NREGS;
+	int e = SFG_OK, restored, first = st->sets == 0u;
+
+	if (st->stopped)
+		return 1;
+	r.o = o;
+	r.c = c;
+	r.d = &dg;
+	r.s.ctl = r.s.fifo = r.s.trail = r.s.inten = r.s.ist = r.s.err = r.s.fstat = r.s.conf = r.s.aconf = r.s.tmo = r.s.trans = r.s.addr = r.s.usicon = 0;
+	for (i = 0; i < SFG_NREGS; i++)
+		raw[i] = 0;
+	if (!o->freq_hz)
+		return sfg_refuse(st, o, "no timer, nothing written");
+	if (!sfg_counter_runs(&r))
+		return sfg_refuse(st, o, "counter not running, nothing written");
+	why = sfg_gate(&r);
+	if (why)
+		return sfg_refuse(st, o, why);
+	why = sfg_pads(&r);
+	if (why)
+		return sfg_refuse(st, o, why);
+	if (!sfg_r32(&r, SFG_SP_I2C, c->o_ctl, &r.s.ctl) || !sfg_r32(&r, SFG_SP_I2C, c->o_fifo_ctl, &r.s.fifo) ||
+	    !sfg_r32(&r, SFG_SP_I2C, c->o_trail, &r.s.trail) || !sfg_r32(&r, SFG_SP_I2C, c->o_int_en, &r.s.inten) ||
+	    !sfg_r32(&r, SFG_SP_I2C, c->o_int_st, &r.s.ist) || !sfg_r32(&r, SFG_SP_I2C, c->o_err, &r.s.err) ||
+	    !sfg_r32(&r, SFG_SP_I2C, c->o_fifo_st, &r.s.fstat) || !sfg_r32(&r, SFG_SP_I2C, c->o_conf, &r.s.conf) ||
+	    !sfg_r32(&r, SFG_SP_I2C, c->o_auto, &r.s.aconf) || !sfg_r32(&r, SFG_SP_I2C, c->o_tmo, &r.s.tmo) ||
+	    !sfg_r32(&r, SFG_SP_I2C, c->o_trans, &r.s.trans) || !sfg_r32(&r, SFG_SP_I2C, c->o_addr, &r.s.addr) ||
+	    !sfg_r32(&r, SFG_SP_I2C, c->o_usicon, &r.s.usicon))
+		return sfg_refuse(st, o, "controller unreadable, nothing written");
+	why = sfg_precondition(c, &r.s);
+	if (first || why) {
+		sfg_three(o, "before", "CTL", r.s.ctl, "FIFO_CTL", r.s.fifo, "INT_EN", r.s.inten);
+		sfg_three(o, "before", "ADDR", r.s.addr, "AUTO_CONF", r.s.aconf, "INT_STATUS", r.s.ist);
+		sfg_three(o, "before", "ERR", r.s.err, "FIFO_STATUS", r.s.fstat, "TRANS", r.s.trans);
+		sfg_three(o, "before", "CONF", r.s.conf, "TIMEOUT", r.s.tmo, "TRAILING", r.s.trail);
+	}
+	if (why)
+		return sfg_refuse(st, o, why);
+
+	/* the seven reads, in the allowlist order; the first failure stops everything; one register transfer at a time without preemption */
+	for (i = 0; i < SFG_NREGS && e == SFG_OK; i++) {
+		o->crit(o->ctx, 1);
+		e = sfg_xfer(&r, (enum sfg_reg)i, &raw[i]);
+		o->crit(o->ctx, 0);
+		if (e != SFG_OK)
+			failed = i;
+	}
+
+	/* ALWAYS put the controller back (a write was attempted on every path that reaches here) */
+	o->crit(o->ctx, 1);
+	restored = sfg_restore(&r, first || e != SFG_OK);
+	o->crit(o->ctx, 0);
+	st->sets++;
+	if (first || e != SFG_OK || !restored) {
+		sfg_start(&b, "raw");
+		for (i = 0; i < SFG_NREGS; i++) {
+			sfg_txt(&b, " ");
+			sfg_hex(&b, sfg_reg_ptr(i), 2);
+			sfg_txt(&b, "=");
+			if (i < failed)
+				sfg_hex(&b, raw[i], 4);
+			else
+				sfg_txt(&b, "----");
+		}
+		sfg_txt(&b, " restore=");
+		sfg_txt(&b, restored ? "ok" : "FAILED");
+		sfg_emit(o, &b);
+	}
+	if (!restored) {
+		sfg_say(o, "!!! RESTORE FAILED: ", "HSI2C12 registers differ from the handoff values (see the restore lines)");
+		sfg_say(o, "!!! RESTORE FAILED: ", "a reset clears it (guess: the controller state is lost on reset)");
+	}
+	if (e != SFG_OK) {
+		sfg_diag_lines(o, &dg);
+		sfg_start(&b, "refused ");
+		sfg_txt(&b, sfg_reg_name(failed));
+		sfg_txt(&b, " reg=0x");
+		sfg_hex(&b, sfg_reg_ptr(failed), 2);
+		sfg_txt(&b, e == SFG_NACK ? " nack" : e == SFG_TIMEOUT ? " timeout" : " error");
+		sfg_txt(&b, restored ? " restore=ok" : " restore=FAILED");
+		sfg_emit(o, &b);
+		st->stopped = 1;
+		return 1;
+	}
+	sfg_battery_line(&r, raw);
+	if (!restored)
+		return sfg_refuse(st, o, "restore=FAILED");
+	sfg_sample_set(st, o, c, raw);			/* C5: only after a verified restore */
+	return 0;
+}
+
+#endif /* SWEET_HSI2C_FG_H */

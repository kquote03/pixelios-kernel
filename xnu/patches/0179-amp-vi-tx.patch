+/* ---- patch 0179 (sweetaoc=13, amp_pwr_diag 5): run a10f found zeros in every ASPRX1 slot (0..7, width 32 and 16). Stock speaker playback
+ * also runs the amps' VI feedback on TDM_0_TX (mixer defaults "ASP TX1 Source" VMON, "ASP TX2 Source" IMON, "ASPTX1 Slot Position" 0 / R 1,
+ * "ASPTX2 Slot Position" 2 / R 3; path "hostless-ulC spk-vi" = NoHost1 TX Mixer TDM_0_TX, sends nothing to the AOC, aoc_alsa_hw.c:1640-1642).
+ * Here: SP_FRAME_TX_SLOT 0x4810 [0x3F3F] := L 0x0200 / R 0x0301, ASP_TX1/2_SRC left at the reset VMON 0x18 / IMON 0x19 (v6.18
+ * cs35l41-lib.c:40-41, read back), SP_TX_WL reset 24 (:37), SP_ENABLES 0x4800 ASPTX1 bit 0 + ASPTX2 bit 1 (cs35l41.c:553-554) on, a
+ * continuous tone (pattern 9), DAC + RX3/RX4 on ASPRX1 (the 0177 detector), meters every 2 s for 12 s (tags T1..T6); then the TX bits off,
+ * the TX slots back to the reset 0x0100, RX3/RX4 VMON/IMON, DAC source DSP. ---- */
+static unsigned amp_pwr_diag5_run(const struct amp_snap *s)
+{
+	static const char *tag[6] = { "T1", "T2", "T3", "T4", "T5", "T6" };
+	static const uint32_t tx[4] = { 0x4810u, 0x4C20u, 0x4C24u, AMP_PWR_SPE };
+	unsigned ms = 0, k;
+	int cs;
+
+	for (cs = 0; cs < 2; cs++) {
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, 0x08u, NULL);
+		(void)amp_pwr_rmw(s, cs, 0x4810u, 0x3F3Fu, cs ? 0x0301u : 0x0200u, NULL);
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_SPE, 0x3u, 0x3u, NULL);
+		amp_pwr_diag_line(s, cs, "vi txslot/tx1/tx2/spe ", "on", tx, 4u, 0);
+	}
+	amp_pwr_d3_src(s, 0x08u, 0x08u);
+	con_str("SWEET", "AUDIO: pattern 9 starts now (continuous tone, amp VI TX on, 12 s)");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 9);
+	for (k = 0; k < 6u; k++)
+		ms += amp_pwr_d3_wait(s, 2000u, 1900u, tag[k], 0u, NULL);
+	amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	for (cs = 0; cs < 2; cs++) {
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_SPE, 0x3u, 0u, NULL);
+		(void)amp_pwr_rmw(s, cs, 0x4810u, 0x3F3Fu, 0x0100u, NULL);
+	}
+	amp_pwr_d3_src(s, 0x18u, 0x19u);
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, AMP_PCMSRC_DSP, NULL);
+	amp_pwr_diag_snap(s, "end");
+	return ms;
+}

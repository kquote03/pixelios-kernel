+ * container layout, every length and every sha256 are checked (sweet_amp_dsp.h amp_dsp_container) before any amp is touched. Missing or
+ * wrong files: the DSP stage reports no-fw and writes nothing; the sweetaoc=5 part still runs. */
+static int sa_dsp;
+void sweet_amp_dsp_arm(void);
+void
+sweet_amp_dsp_arm(void)
+{
+	DTEntry mm;
+	void const *p = NULL;
+	unsigned int psize = 0;
+	uint64_t pa = 0, len = 0;
+	int rc;
+
+	sa_dsp = 1;

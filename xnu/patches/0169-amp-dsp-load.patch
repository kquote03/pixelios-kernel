+#define SWEET_AMP_DSP_H
+#include "sweet_cs_dsp.h"
+
+/* ---- the pinned files ---- */
+#define AMP_FW_N		3u
+static const uint32_t amp_fw_len[AMP_FW_N] = { 33988u, 3884u, 3820u };	/* cs35l41-dsp1-spk-prot.wmfw, .bin (L), R-...bin (R) */
+static const uint8_t amp_fw_sha[AMP_FW_N][32] = {

+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess || SecureDTGetProperty(mm, "AMPFW", &p, &psize) != kSuccess ||
+	    psize != 2 * sizeof(uint64_t)) {
+		printf("SWEET AMP DSP: no AMPFW (xrun --ampfw): no DSP write\n");
+		return;
+	}
+	memcpy(&pa, p, sizeof(pa));
+	memcpy(&len, (uint8_t const *)p + sizeof(pa), sizeof(len));
+	if (pa == 0 || len < 64u || len > 0x100000u || pa + len < pa) {
+		printf("SWEET AMP DSP: AMPFW <%#llx, %#llx> out of bounds: no DSP write\n", pa, len);
+		return;
+	}
+	rc = amp_dsp_container((const uint8_t *)ml_static_ptovirt((vm_offset_t)pa), (size_t)len, &amp_dsp_fw_in);
+	if (rc != 0) {
+		amp_dsp_fw_in = (struct amp_dsp_fw){ { 0 }, { 0 } };
+		printf("SWEET AMP DSP: AMPFW container code %d (layout / length / sha256 not the pinned files): no DSP write\n", rc);
+		return;
+	}
+	printf("SWEET AMP DSP: AMPFW at %#llx, %llu bytes: wmfw %u, bin L %u, bin R %u bytes, sha256 pinned\n", pa, len, amp_dsp_fw_in.n[0],
+	    amp_dsp_fw_in.n[1], amp_dsp_fw_in.n[2]);

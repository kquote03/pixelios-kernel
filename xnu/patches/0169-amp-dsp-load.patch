+/* both chip selects read high, then this one low + SLAVE_SEL auto (as amp_write); 0 = selected */
+static int amp_cs_take(const struct amp_snap *s, int cs)
+{
+	uintptr_t dat = cs ? DAT(AMP_PIN_CS1_BANK) : DAT(AMP_PIN_CS0_BANK), odat = cs ? DAT(AMP_PIN_CS0_BANK) : DAT(AMP_PIN_CS1_BANK);
+	uint32_t nr = cs ? AMP_PIN_CS1_NR : AMP_PIN_CS0_NR, onr = cs ? AMP_PIN_CS0_NR : AMP_PIN_CS1_NR, o = 0;
+
+	if (!r32(odat, &o) || !peri_pin_bit(o, onr) || !r32(dat, &o) || !peri_pin_bit(o, nr))
+		return AMP_ERROR;
+	if (pad_put(s, dat, nr, 1u, 0u) || w32(s, A_SLAVE, V_SLAVE_AUTO))
+		return AMP_ERROR;
+	return AMP_OK;
+}
+
+static int amp_cs_give(const struct amp_snap *s, int cs)
+{
+	return pad_put(s, cs ? DAT(AMP_PIN_CS1_BANK) : DAT(AMP_PIN_CS0_BANK), cs ? AMP_PIN_CS1_NR : AMP_PIN_CS0_NR, 1u, 1u) ? AMP_ERROR : AMP_OK;
+}
+
+/* n bytes of d to the registers from reg on (one transaction); only inside one DSP memory range */
+static int amp_wburst(const struct amp_snap *s, int cs, uint32_t reg, const uint8_t *d, uint32_t n)
+{
+	uint32_t off = 0, k;
+	int e, first = 1;
+
+	if (!d || !amp_dsp_mem_ok(reg, n))
+		return AMP_ERROR;
+	e = amp_cs_take(s, cs);
+	while (e == AMP_OK && off < n) {
+		k = n - off < (first ? AMP_FILL_HDR : AMP_FILL_MAX) ? n - off : (first ? AMP_FILL_HDR : AMP_FILL_MAX);
+		amp_arm = (struct amp_arm){ 3, reg, 0u, d, n, off, k + (first ? AMP_TX_BYTES : 0u), first };
+		e = xferb(s, 1, 0);
+		off += k;
+		first = 0;
+	}
+	amp_arm = (struct amp_arm){ 0 };
+	if (amp_cs_give(s, cs) != AMP_OK)
+		e = AMP_ERROR;
+	return e;
+}
+
+/* n bytes from the registers from reg on into buf (one transaction: the 6-byte read address frame, then RX fills) */
+static int amp_rburst(const struct amp_snap *s, int cs, uint32_t reg, uint8_t *buf, uint32_t n)
+{
+	uint32_t off = 0, k, dummy = 0;
+	int e;
+
+	if (!buf || !amp_dsp_mem_ok(reg, n))
+		return AMP_ERROR;
+	e = amp_cs_take(s, cs);
+	if (e == AMP_OK) {
+		amp_arm = (struct amp_arm){ 2, reg, 0u, 0, 0u, 0u, 0u, 0 };
+		e = xfer(s, reg, 1, &dummy);
+	}
+	while (e == AMP_OK && off < n) {
+		k = n - off < AMP_FILL_MAX ? n - off : AMP_FILL_MAX;
+		amp_arm = (struct amp_arm){ 4, reg, 0u, 0, n, off, k, 0 };
+		e = xferb(s, 0, buf + off);
+		off += k;
+	}
+	amp_arm = (struct amp_arm){ 0 };
+	if (amp_cs_give(s, cs) != AMP_OK)
+		e = AMP_ERROR;
+	return e;
+}

+/* one fill of the armed burst: tx = the armed bytes out (RX on, RX discarded, as xfer), else amp_arm.fill bytes in into buf */
+static int xferb(const struct amp_snap *s, int tx, uint8_t *buf)
+{
+	uint32_t ch = 0, pk = 0, b = 0, n = amp_arm.fill;
+	int e, f;
+
+	if (n == 0u || n > AMP_FILL_MAX || !r32(A_CH, &ch) || !r32(A_PKT, &pk))
+		return AMP_ERROR;
+	ch = (ch & ~CH_TX) | CH_RX;
+	if (w32(s, A_PKT, pk & ~PKT_EN) || w32(s, A_PKT, n) || w32(s, A_PKT, n | PKT_EN))
+		return AMP_ERROR;
+	for (uint32_t p = 0; tx && p < n; p++)
+		if (w32(s, A_TX, amp_burst_byte(p)))
+			return AMP_ERROR;
+	if (w32(s, A_CH, ch | (tx ? CH_TX : 0u)))
+		return AMP_ERROR;
+	e = wait_lvl(0, n);
+	for (uint32_t i = 0; e == AMP_OK && !tx && i < n; i++) {
+		if (!r32(A_RX, &b))
+			e = AMP_ERROR;
+		buf[i] = (uint8_t)b;
+	}
+	f = flush(s);
+	return e != AMP_OK ? e : f;
+}

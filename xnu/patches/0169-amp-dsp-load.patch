+	  0x21, 0x58, 0x7a, 0xcf, 0x67, 0x10, 0x04, 0x49, 0x21, 0x7b, 0x7b, 0xf2, 0x29, 0xf3, 0x62, 0x52  },
+	{ 0xd6, 0xbc, 0x07, 0xfb, 0xa5, 0x42, 0xc1, 0xc6, 0x82, 0x62, 0xc9, 0x53, 0xf6, 0xa3, 0x07, 0x0b,
+	  0xf4, 0x56, 0x1b, 0x1b, 0x76, 0xe6, 0xe1, 0xcb, 0xad, 0x1a, 0xf8, 0x68, 0x94, 0xc6, 0x51, 0x54  },
+};
+static const char amp_fw_tag[AMP_FW_N][5] = { "WMFW", "BINL", "BINR" };
+
+/* ---- SHA-256 (FIPS 180-4) ---- */
+struct amp_sha { uint32_t h[8]; uint64_t n; uint8_t b[64]; };
+static const uint32_t amp_sha_k[64] = {
+	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+	0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+	0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+	0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+};
+#define AMP_ROR(x, r)	(((x) >> (r)) | ((x) << (32u - (r))))
+static void amp_sha_block(struct amp_sha *s, const uint8_t *p)
+{
+	uint32_t w[64], a, b, c, d, e, f, g, h, t1, t2;
+	unsigned i;
+
+	for (i = 0; i < 16u; i++)
+		w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 | (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];
+	for (; i < 64u; i++)
+		w[i] = w[i - 16] + (AMP_ROR(w[i - 15], 7u) ^ AMP_ROR(w[i - 15], 18u) ^ (w[i - 15] >> 3)) + w[i - 7] +
+		       (AMP_ROR(w[i - 2], 17u) ^ AMP_ROR(w[i - 2], 19u) ^ (w[i - 2] >> 10));
+	a = s->h[0]; b = s->h[1]; c = s->h[2]; d = s->h[3]; e = s->h[4]; f = s->h[5]; g = s->h[6]; h = s->h[7];
+	for (i = 0; i < 64u; i++) {
+		t1 = h + (AMP_ROR(e, 6u) ^ AMP_ROR(e, 11u) ^ AMP_ROR(e, 25u)) + ((e & f) ^ (~e & g)) + amp_sha_k[i] + w[i];
+		t2 = (AMP_ROR(a, 2u) ^ AMP_ROR(a, 13u) ^ AMP_ROR(a, 22u)) + ((a & b) ^ (a & c) ^ (b & c));
+		h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+	}
+	s->h[0] += a; s->h[1] += b; s->h[2] += c; s->h[3] += d; s->h[4] += e; s->h[5] += f; s->h[6] += g; s->h[7] += h;
+}
+static void amp_sha256(const uint8_t *p, size_t n, uint8_t out[32])
+{
+	static const uint32_t iv[8] = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 };
+	struct amp_sha s;
+	size_t i, r;
+
+	for (i = 0; i < 8u; i++)
+		s.h[i] = iv[i];
+	s.n = (uint64_t)n * 8u;
+	for (i = 0; i + 64u <= n; i += 64u)
+		amp_sha_block(&s, p + i);
+	r = n - i;
+	for (size_t k = 0; k < 64u; k++)
+		s.b[k] = k < r ? p[i + k] : 0u;
+	s.b[r] = 0x80u;
+	if (r >= 56u) {
+		amp_sha_block(&s, s.b);
+		for (size_t k = 0; k < 64u; k++)
+			s.b[k] = 0u;
+	}
+	for (i = 0; i < 8u; i++)
+		s.b[56 + i] = (uint8_t)(s.n >> (56u - 8u * i));
+	amp_sha_block(&s, s.b);
+	for (i = 0; i < 32u; i++)
+		out[i] = (uint8_t)(s.h[i / 4u] >> (24u - 8u * (i % 4u)));
+}
+
+/* ---- the AMPFW container (tools/pack_ampfw.py; layout of tools/pack_wlanfw.py: "AMPFWV01", u32 version 1, u32 count 3, then
+ * { tag[4], u32 length, u32 offset (8-aligned), u32 crc32 } x 3 in the order WMFW, BINL, BINR) ---- */
+struct amp_dsp_fw { const uint8_t *d[AMP_FW_N]; uint32_t n[AMP_FW_N]; };
+static uint32_t amp_le32(const uint8_t *p) { return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24; }
+/* 0 = every entry present with the pinned length and sha256; < 0 = the first problem */
+static int amp_dsp_container(const uint8_t *buf, size_t len, struct amp_dsp_fw *fw)
+{
+	static const uint8_t magic[8] = { 'A', 'M', 'P', 'F', 'W', 'V', '0', '1' };
+	uint8_t sha[32];
+	uint32_t i, k, l, o;
+
+	*fw = (struct amp_dsp_fw){ { 0 }, { 0 } };
+	if (!buf || len < 16u + 16u * AMP_FW_N || len > 0x100000u)
+		return -1;
+	for (k = 0; k < 8u; k++)
+		if (buf[k] != magic[k])
+			return -2;
+	if (amp_le32(buf + 8) != 1u || amp_le32(buf + 12) != AMP_FW_N)
+		return -3;
+	for (i = 0; i < AMP_FW_N; i++) {
+		const uint8_t *e = buf + 16u + 16u * i;
+
+		for (k = 0; k < 4u; k++)
+			if (e[k] != (uint8_t)amp_fw_tag[i][k])
+				return -4;
+		l = amp_le32(e + 4);
+		o = amp_le32(e + 8);
+		if ((o & 7u) || o < 16u + 16u * AMP_FW_N || o > len || l > len - o || l != amp_fw_len[i])
+			return -5;
+		amp_sha256(buf + o, l, sha);
+		for (k = 0; k < 32u; k++)
+			if (sha[k] != amp_fw_sha[i][k])
+				return -6;
+	}
+	for (i = 0; i < AMP_FW_N; i++) {
+		fw->d[i] = buf + amp_le32(buf + 24u + 16u * i);
+		fw->n[i] = amp_fw_len[i];
+	}
+	return 0;
+}
+
+/* ---- the loader ---- */
+#define AMP_DSP_XM_UNP		0x02800000u
+#define AMP_DSP_YM_UNP		0x03400000u
+#define AMP_DSP_XM_WORDS	4094u		/* XMEM_UNPACK24_0..4093 */
+#define AMP_DSP_YM_WORDS	2046u		/* YMEM_UNPACK24_0..2045 */
+#define AMP_DSP_FW_ID		0x400a4u	/* FIRMWARE_HALO_CSPL: the algorithm id of the wmfw ALGORITHM_DATA region = the id header id */
+#define AMP_DSP_CSPL_ALG	0xcdu		/* CSPL: the algorithm both .bin files address */
+#define AMP_DSP_HB_OFF		1u		/* HALO_HEARTBEAT, coefficient offset of FIRMWARE_HALO_CSPL (XM) */
+#define AMP_DSP_STATE_OFF	0u		/* HALO_STATE */
+#define AMP_DSP_CSPL_STATE_OFF	2u		/* CSPL_STATE of CSPL (XM) */
+#define AMP_DSP_MAXALG		8u
+#define AMP_DSP_TERM		0xbedeadu	/* AMP wm_adsp.c:2153-2162 */
+#define AMP_DSP_HB_POLLS	100u		/* x 1 ms per window */
+#define AMP_DSP_RB		1024u		/* read-back chunk */
+
+enum { DS_NOTRUN = 0, DS_NOFW, DS_PRE, DS_INIT, DS_WMFW, DS_HDR, DS_BIN, DS_LOADED, DS_MPU, DS_START, DS_NOHB, DS_RUN, DS_ERR, DS_N };
+static const char *const amp_dsp_stage_name[DS_N] = { "not-run", "no-fw", "pre-check", "init-writes", "wmfw-region", "alg-header", "bin-block",
+						      "loaded-not-started", "mpu", "start", "no-heartbeat", "running", "error-after-start" };
+struct amp_dsp_side {
+	int stage; unsigned item;			/* item: the failing wmfw region / bin block index */
+	uint32_t fw_id, fw_ver, n_algs, fw_xm, cd_xm, cd_ym, cd_ysz, hb_reg;
+	uint32_t regions, blocks, bytes;
+	uint32_t ccm, mbox2, clk, hb0, hb, hstate, cspl, st1, pwr1, wdt, scratch[4];
+	unsigned polls; int win;			/* win: 1 = moved before the AOC stream, 2 = after it, 0 = never */
+	int started, stopped, stop_ok;
+};
+static struct amp_dsp_res { int ran; struct amp_dsp_side a[2]; } amp_dsp_res;
+static struct amp_dsp_fw amp_dsp_fw_in;		/* set by the glue from AMPFW (container checked); all 0 = no files */
+static struct swcd_file amp_dsp_pf;
+static uint8_t amp_dsp_rb[AMP_DSP_RB];
+
+static uint32_t amp_be32(const uint8_t *p) { return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3]; }
+
+/* one control write (an allowlisted pair) and its read-back */
+static int amp_dsp_w1(const struct amp_snap *s, int cs, uint32_t reg, uint32_t val, int check)
+{
+	uint32_t rb = 0;
+	int e = amp_write(s, cs, reg, val);
+
+	if (e == AMP_OK && check) {
+		e = amp_read(s, cs, reg, &rb);
+		if (e == AMP_OK && rb != val)
+			e = AMP_ERROR;
+	}
+	return e;
+}
+
+/* regmap_update_bits of the CCM / WDT row: read, write only if it changes, read back into *rb */
+static int amp_dsp_rmw(const struct amp_snap *s, int cs, uint32_t reg, uint32_t mask, uint32_t field, uint32_t *rb)
+{
+	uint32_t old = 0;
+	int e = amp_read(s, cs, reg, &old);
+
+	*rb = old;
+	if (e != AMP_OK || ((old & ~mask) | field) == old)
+		return e;
+	amp_dsp_row.on = 1;
+	amp_dsp_row.reg = reg;
+	amp_dsp_row.mask = mask;
+	amp_dsp_row.field = field;
+	amp_dsp_row.old = old;
+	e = amp_write(s, cs, reg, (old & ~mask) | field);
+	amp_dsp_row.on = 0;
+	amp_dsp_row.reg = amp_dsp_row.mask = amp_dsp_row.field = amp_dsp_row.old = 0;
+	if (e == AMP_OK)
+		e = amp_read(s, cs, reg, rb);
+	return e;
+}
+
+/* write n bytes at reg and read them all back (unp24: compare the low 24 bits of each word only) */
+static int amp_dsp_put(const struct amp_snap *s, int cs, uint32_t reg, const uint8_t *d, uint32_t n, int unp24)
+{
+	int e = amp_wburst(s, cs, reg, d, n);
+
+	for (uint32_t off = 0; e == AMP_OK && off < n; off += AMP_DSP_RB) {
+		uint32_t k = n - off < AMP_DSP_RB ? n - off : AMP_DSP_RB;
+
+		e = amp_rburst(s, cs, reg + off, amp_dsp_rb, k);
+		for (uint32_t i = 0; e == AMP_OK && i < k; i++)
+			if ((!unp24 || (i & 3u)) && amp_dsp_rb[i] != d[off + i])
+				e = AMP_ERROR;
+	}
+	return e;
+}
+
+/* the register of an algorithm-relative .bin block (AMP wm_adsp.c:2690-2712): region_to_reg(type, base) + offset; 0 = refused (outside the
+ * algorithm's region or the memory range, odd length) */
+static uint32_t amp_dsp_bin_reg(uint32_t type, uint32_t base, uint32_t size, uint32_t off, uint32_t len)
+{
+	uint32_t r0 = swcd_region_to_reg(type, base), r1 = swcd_region_to_reg(type, base + size), reg = r0 + off;
+
+	if (r0 == 0u || off > 0xFFFFu || (len & 3u) || reg < r0 || reg + len > r1 || reg + len < reg || !amp_dsp_mem_ok(reg, len))
+		return 0u;
+	return reg;
+}
+
+static int amp_dsp_load(const struct amp_snap *s, int cs, struct amp_dsp_side *d)
+{
+	const struct amp_dsp_fw *fw = &amp_dsp_fw_in;
+	uint8_t hdr[4u * (10u + 6u * AMP_DSP_MAXALG + 1u)];
+	uint32_t w[10u + 6u * AMP_DSP_MAXALG + 1u], rb = 0, i;
+	int e, cd = -1;
+
+	if (!fw->d[0] || !fw->d[1 + cs]) {
+		d->stage = DS_NOFW;
+		return AMP_ERROR;
+	}
+	/* pre: no error bit, GLOBAL_EN 0, core off (0158 wrote CCM := 0) */
+	d->stage = DS_PRE;
+	e = amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_REG_PWR_CTRL1, &d->pwr1);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_DSP_CCM, &d->ccm);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_DSP_CLK_CTRL, &d->clk);
+	if (e != AMP_OK || (d->st1 & AMP_ERR_BITS) || (d->pwr1 & AMP_GLOBAL_EN) || (d->ccm & AMP_DSP_CORE_EN))
+		return AMP_ERROR;
+	/* probe-time cs35l41_dsp_init writes */
+	d->stage = DS_INIT;
+	for (i = 0; e == AMP_OK && i < 8u; i++)
+		e = amp_dsp_w1(s, cs, 0x02B80080u + 8u * i, 1u, 1);
+	for (i = 0; e == AMP_OK && i < 8u; i++)
+		e = amp_dsp_w1(s, cs, 0x02B80280u + 8u * i, 1u, 1);
+#define AMP_DSP_RX_DO(r, v) if (e == AMP_OK) e = amp_dsp_w1(s, cs, (r), (v), 1);
+	AMP_DSP_RXSRC(AMP_DSP_RX_DO)
+#undef AMP_DSP_RX_DO
+	if (e != AMP_OK)
+		return e;
+	/* the wmfw: memory regions only (no ABSOLUTE), each inside one range, written and read back */
+	d->stage = DS_WMFW;
+	if (swcd_wmfw(fw->d[0], fw->n[0], &amp_dsp_pf) != SWCD_OK)
+		return AMP_ERROR;
+	for (i = 0; e == AMP_OK && i < amp_dsp_pf.nitems; i++) {
+		const struct swcd_item *it = &amp_dsp_pf.it[i];
+
+		if (it->type == SWCD_ABSOLUTE) {
+			d->item = i;
+			return AMP_ERROR;
+		}
+		if (!it->reg)
+			continue;	/* text / algorithm data */
+		d->item = i;
+		if (!amp_dsp_mem_ok(it->reg, it->len))
+			return AMP_ERROR;
+		e = amp_dsp_put(s, cs, it->reg, fw->d[0] + it->pos + 8u, it->len, it->type == SWCD_ADSP2_XM || it->type == SWCD_ADSP2_YM);
+		d->regions++;
+		d->bytes += it->len;
+	}
+	if (e != AMP_OK)
+		return e;
+	/* wm_halo_setup_algs: the id header, then the list + terminator, from XM unpacked */
+	d->stage = DS_HDR;
+	e = amp_rburst(s, cs, AMP_DSP_XM_UNP, hdr, 40u);
+	for (i = 0; e == AMP_OK && i < 10u; i++)
+		w[i] = amp_be32(hdr + 4u * i) & 0xFFFFFFu;
+	if (e != AMP_OK)
+		return e;
+	d->fw_id = w[3];
+	d->fw_ver = w[4];
+	d->fw_xm = w[5];
+	d->n_algs = w[9];
+	if (d->fw_id != AMP_DSP_FW_ID || d->n_algs == 0u || d->n_algs > AMP_DSP_MAXALG || d->fw_xm + AMP_DSP_HB_OFF >= AMP_DSP_XM_WORDS)
+		return AMP_ERROR;
+	e = amp_rburst(s, cs, AMP_DSP_XM_UNP + 40u, hdr + 40u, 4u * (6u * d->n_algs + 1u));
+	for (i = 10u; e == AMP_OK && i < 10u + 6u * d->n_algs + 1u; i++)
+		w[i] = amp_be32(hdr + 4u * i) & 0xFFFFFFu;
+	if (e != AMP_OK || w[10u + 6u * d->n_algs] != AMP_DSP_TERM)
+		return AMP_ERROR;
+	for (i = 0; i < d->n_algs; i++) {
+		const uint32_t *a = &w[10u + 6u * i];	/* id, ver, xm_base, xm_size, ym_base, ym_size */
+
+		if (a[2] + a[3] > AMP_DSP_XM_WORDS || a[4] + a[5] > AMP_DSP_YM_WORDS)
+			return AMP_ERROR;
+		if (a[0] == AMP_DSP_CSPL_ALG)
+			cd = (int)i;
+	}
+	if (cd < 0)
+		return AMP_ERROR;
+	d->cd_xm = w[10u + 6u * (uint32_t)cd + 2u];
+	d->cd_ym = w[10u + 6u * (uint32_t)cd + 4u];
+	d->cd_ysz = w[10u + 6u * (uint32_t)cd + 5u];
+	d->hb_reg = AMP_DSP_XM_UNP + 4u * (d->fw_xm + AMP_DSP_HB_OFF);
+	/* the .bin of this amp: XM / YM blocks relative to a listed algorithm, nothing absolute */
+	d->stage = DS_BIN;
+	if (swcd_bin(fw->d[1 + cs], fw->n[1 + cs], &amp_dsp_pf) != SWCD_OK || (amp_dsp_pf.rev & 0xFFu) != 1u)
+		return AMP_ERROR;
+	for (i = 0; e == AMP_OK && i < amp_dsp_pf.nitems; i++) {
+		const struct swcd_item *it = &amp_dsp_pf.it[i];
+		uint32_t t = it->type, reg = 0u, k;
+
+		if (t == SWCD_NAME_TEXT << 8 || t == SWCD_INFO_TEXT << 8 || t == SWCD_METADATA << 8)
+			continue;
+		d->item = i;
+		if (t != SWCD_ADSP2_XM && t != SWCD_ADSP2_YM && t != SWCD_XM_PACKED && t != SWCD_YM_PACKED)
+			return AMP_ERROR;
+		for (k = 0; k < d->n_algs && !reg; k++) {
+			const uint32_t *a = &w[10u + 6u * k];
+
+			if (a[0] == it->id)
+				reg = (t == SWCD_ADSP2_XM || t == SWCD_XM_PACKED) ? amp_dsp_bin_reg(t, a[2], a[3], it->offset, it->len) :
+				      amp_dsp_bin_reg(t, a[4], a[5], it->offset, it->len);
+		}
+		if (!reg)
+			return AMP_ERROR;
+		e = amp_dsp_put(s, cs, reg, fw->d[1 + cs] + it->pos + 20u, it->len, t == SWCD_ADSP2_XM || t == SWCD_ADSP2_YM);
+		d->blocks++;
+		d->bytes += it->len;
+	}
+	if (e != AMP_OK)
+		return e;
+	e = amp_read(s, cs, AMP_DSP_CCM, &rb);
+	if (e != AMP_OK || (rb & AMP_DSP_CORE_EN))
+		return AMP_ERROR;
+	d->stage = DS_LOADED;
+	return AMP_OK;
+}
+
+/* wm_halo_configure_mpu, then wm_halo_start_core; d->started is set before the CCM write is attempted (the stop then runs on every path) */
+static int amp_dsp_start(const struct amp_snap *s, int cs, struct amp_dsp_side *d)
+{
+	uint32_t rb = 0, i;
+	int e;
+
+	d->stage = DS_MPU;
+	e = amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_REG_PWR_CTRL1, &d->pwr1);
+	if (e != AMP_OK || (d->st1 & AMP_ERR_BITS) || (d->pwr1 & AMP_GLOBAL_EN))
+		return AMP_ERROR;
+	e = amp_dsp_w1(s, cs, AMP_DSP_MPU_LOCK, 0x5555u, 0);
+	if (e == AMP_OK)
+		e = amp_dsp_w1(s, cs, AMP_DSP_MPU_LOCK, 0xAAAAu, 0);
+	for (i = 0; e == AMP_OK && i < 20u; i++)
+		e = amp_dsp_w1(s, cs, AMP_DSP_MPU_BASE + amp_dsp_mpu_off[i], 0xFFFFFFFFu, 0);
+	if (e == AMP_OK)
+		e = amp_dsp_w1(s, cs, AMP_DSP_MPU_LOCK, 0u, 0);
+	for (i = 0; e == AMP_OK && i < 20u; i++) {
+		e = amp_read(s, cs, AMP_DSP_MPU_BASE + amp_dsp_mpu_off[i], &rb);
+		if (e == AMP_OK && rb != 0xFFFFFFFFu)
+			e = AMP_ERROR;
+	}
+	if (e != AMP_OK)
+		return e;
+	d->stage = DS_START;
+	d->started = 1;
+	e = amp_dsp_rmw(s, cs, AMP_DSP_CCM, AMP_DSP_CORE_RESET | AMP_DSP_CORE_EN, AMP_DSP_CORE_RESET | AMP_DSP_CORE_EN, &d->ccm);
+	if (e == AMP_OK && !(d->ccm & AMP_DSP_CORE_EN))
+		e = AMP_ERROR;
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_DSP_MBOX2, &d->mbox2);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, d->hb_reg, &d->hb0);
+	d->hb = d->hb0;
+	if (e == AMP_OK)
+		d->stage = DS_NOHB;
+	return e;
+}
+
+/* one heartbeat window on both started amps: <= AMP_DSP_HB_POLLS x 1 ms (tick each ms if given), stops once every started amp moved */
+static void amp_dsp_window(const struct amp_snap *s, int win, void (*tick)(void *), void *ctx)
+{
+	unsigned p;
+	int cs, more;
+
+	for (p = 0; p < AMP_DSP_HB_POLLS; p++) {
+		more = 0;
+		for (cs = 0; cs < 2; cs++)
+			more |= amp_dsp_res.a[cs].stage == DS_NOHB;
+		if (!more || wait_ms(1u))
+			break;
+		if (tick)
+			tick(ctx);
+		for (cs = 0; cs < 2; cs++) {
+			struct amp_dsp_side *d = &amp_dsp_res.a[cs];
+
+			if (d->stage != DS_NOHB)
+				continue;
+			d->polls++;
+			if (amp_read(s, cs, d->hb_reg, &d->hb) != AMP_OK) {
+				d->stage = DS_ERR;
+				continue;
+			}
+			if (d->hb != d->hb0) {
+				d->stage = DS_RUN;
+				d->win = win;
+			}
+		}
+	}
+	for (cs = 0; cs < 2; cs++) {	/* after the window: no error bit, GLOBAL_EN still 0 */
+		struct amp_dsp_side *d = &amp_dsp_res.a[cs];
+
+		if (!d->started || d->stage == DS_ERR)
+			continue;
+		if (amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1) != AMP_OK || amp_read(s, cs, AMP_REG_PWR_CTRL1, &d->pwr1) != AMP_OK ||
+		    (d->st1 & AMP_ERR_BITS) || (d->pwr1 & AMP_GLOBAL_EN))
+			d->stage = DS_ERR;
+	}
+}
+
+/* wm_adsp_event PRE_PMD for a started amp: watchdog off, SCRATCH1..4, core EN off, read back */
+static void amp_dsp_stop(const struct amp_snap *s, int cs, struct amp_dsp_side *d)
+{
+	uint32_t rb = 0;
+	int e;
+
+	if (!d->started || d->stopped)
+		return;
+	d->stopped = 1;
+	(void)amp_read(s, cs, AMP_DSP_XM_UNP + 4u * (d->fw_xm + AMP_DSP_STATE_OFF), &d->hstate);
+	(void)amp_read(s, cs, AMP_DSP_XM_UNP + 4u * (d->cd_xm + AMP_DSP_CSPL_STATE_OFF), &d->cspl);
+	e = amp_dsp_rmw(s, cs, AMP_DSP_WDT, 0x1u, 0u, &d->wdt);
+	for (uint32_t i = 0; i < 4u; i++)
+		(void)amp_read(s, cs, AMP_DSP_SCRATCH1 + 8u * i, &d->scratch[i]);
+	if (amp_dsp_rmw(s, cs, AMP_DSP_CCM, AMP_DSP_CORE_EN, 0u, &rb) != AMP_OK)
+		e = AMP_ERROR;
+	d->ccm = rb;
+	d->stop_ok = e == AMP_OK && !(rb & AMP_DSP_CORE_EN);
+}
+
+static void amp_dsp_line(const char *name, const struct amp_dsp_side *d)
+{
+	char line[RAMLOG_LINE_MAX];
+	unsigned p = put_txt(line, sizeof(line), 0, name);
+
+	p = put_txt(line, sizeof(line), p, " dsp ");
+	p = put_txt(line, sizeof(line), p, amp_dsp_stage_name[d->stage]);
+	p = put_txt(line, sizeof(line), p, " #");
+	p = put_dec(line, sizeof(line), p, d->item);
+	p = put_txt(line, sizeof(line), p, " rg=");
+	p = put_dec(line, sizeof(line), p, d->regions);
+	p = put_txt(line, sizeof(line), p, " bl=");
+	p = put_dec(line, sizeof(line), p, d->blocks);
+	p = put_txt(line, sizeof(line), p, " B=");
+	p = put_dec(line, sizeof(line), p, d->bytes);
+	p = put_txt(line, sizeof(line), p, " id=");
+	p = put_hexmin(line, sizeof(line), p, d->fw_id);
+	p = put_txt(line, sizeof(line), p, " v=");
+	p = put_hexmin(line, sizeof(line), p, d->fw_ver);
+	p = put_txt(line, sizeof(line), p, " algs=");
+	p = put_dec(line, sizeof(line), p, d->n_algs);
+	p = put_txt(line, sizeof(line), p, " clk=");
+	p = put_hexmin(line, sizeof(line), p, d->clk);
+	emit("AMP", line, p);
+	p = put_txt(line, sizeof(line), 0, name);
+	p = put_txt(line, sizeof(line), p, " dsp ccm=");
+	p = put_hexmin(line, sizeof(line), p, d->ccm);
+	p = put_txt(line, sizeof(line), p, " mbox2=");
+	p = put_hexmin(line, sizeof(line), p, d->mbox2);
+	p = put_txt(line, sizeof(line), p, " hb ");
+	p = put_hexmin(line, sizeof(line), p, d->hb0);
+	p = put_txt(line, sizeof(line), p, "->");
+	p = put_hexmin(line, sizeof(line), p, d->hb);
+	p = put_txt(line, sizeof(line), p, " win=");
+	p = put_dec(line, sizeof(line), p, (uint32_t)d->win);
+	p = put_txt(line, sizeof(line), p, " polls=");
+	p = put_dec(line, sizeof(line), p, d->polls);
+	p = put_txt(line, sizeof(line), p, " st=");
+	p = put_hexmin(line, sizeof(line), p, d->hstate);
+	p = put_txt(line, sizeof(line), p, " cspl=");
+	p = put_hexmin(line, sizeof(line), p, d->cspl);
+	p = put_txt(line, sizeof(line), p, " st1=");
+	p = put_hexmin(line, sizeof(line), p, d->st1);
+	emit("AMP", line, p);
+	p = put_txt(line, sizeof(line), 0, name);
+	p = put_txt(line, sizeof(line), p, " dsp stop ");
+	p = put_txt(line, sizeof(line), p, !d->started ? "n/a" : d->stop_ok ? "ok" : "FAILED");
+	p = put_txt(line, sizeof(line), p, " wdt=");
+	p = put_hexmin(line, sizeof(line), p, d->wdt);
+	for (uint32_t i = 0; i < 4u; i++) {
+		p = put_txt(line, sizeof(line), p, i ? "," : " scratch=");
+		p = put_hexmin(line, sizeof(line), p, d->scratch[i]);
+	}
+	emit("AMP", line, p);
+}
+
+/* the one verdict line (after the restore): pass only if both loaded, both ran, both stopped and the restore is ok */
+static void amp_dsp_verdict(int restored)
+{
+	const struct amp_dsp_side *l = &amp_dsp_res.a[0], *r = &amp_dsp_res.a[1];
+	char line[RAMLOG_LINE_MAX];
+	unsigned p;
+
+	amp_dsp_line("L", l);
+	amp_dsp_line("R", r);
+	if (l->stage == DS_RUN && r->stage == DS_RUN && l->stop_ok && r->stop_ok && restored && l->fw_id == r->fw_id && l->fw_ver == r->fw_ver) {
+		p = put_txt(line, sizeof(line), 0, "AMP DSP: fw loaded l,r (id ");
+		p = put_hexmin(line, sizeof(line), p, l->fw_id);
+		p = put_txt(line, sizeof(line), p, " rev ");
+		p = put_hexmin(line, sizeof(line), p, l->fw_ver);
+		p = put_txt(line, sizeof(line), p, "), halo running l,r");
+		emit("SWEET", line, p);
+		return;
+	}
+	p = put_txt(line, sizeof(line), 0, "AMP DSP: stopped l=");
+	p = put_txt(line, sizeof(line), p, amp_dsp_stage_name[l->stage]);
+	if (l->stage == DS_WMFW || l->stage == DS_BIN) {
+		p = put_txt(line, sizeof(line), p, "#");
+		p = put_dec(line, sizeof(line), p, l->item);
+	}
+	p = put_txt(line, sizeof(line), p, " r=");
+	p = put_txt(line, sizeof(line), p, amp_dsp_stage_name[r->stage]);
+	if (r->stage == DS_WMFW || r->stage == DS_BIN) {
+		p = put_txt(line, sizeof(line), p, "#");
+		p = put_dec(line, sizeof(line), p, r->item);
+	}
+	p = put_txt(line, sizeof(line), p, " stop ");
+	p = put_txt(line, sizeof(line), p, !l->started ? "-" : l->stop_ok ? "ok" : "FAIL");
+	p = put_txt(line, sizeof(line), p, "/");
+	p = put_txt(line, sizeof(line), p, !r->started ? "-" : r->stop_ok ? "ok" : "FAIL");
+	p = put_txt(line, sizeof(line), p, restored ? " restore ok" : " restore FAILED");
+	emit("SWEET", line, p);
+}
+
+#endif /* SWEET_AMP_DSP_H */

+}
+
+/* One RAM word by backplane address, READ only: a must be a word inside [SWW_RAM_BASE, ram_end - 4] (bwfm's range rule, if_bwfm_pci.c:876-877; DHD :13698-13699); window 0 below SWW_TCM_BYTES,
+ * SWW_WIN_TAIL above (DHD_BUS_BAR1_BPWIN). cfg 0x84 is moved only through the two run E tuples, and only when the word needs the other window. 0 = read. */
+static inline int
+swl_bp_rd(struct swl_wx *x, uint32_t a, uint32_t *v)
+{
+	uint32_t want;
+
+	if ((a & 3u) || x->ram_bytes < 4u || a < SWW_RAM_BASE || a - SWW_RAM_BASE > x->ram_bytes - 4u) {
+		printf("SWEET WLAN: W%u backplane %#x is not a RAM word, not read\n", x->row, a);
+		return swl_stop(x, SWW_E_SHARED);
+	}
+	want = a >= SWW_TCM_BYTES ? SWW_WIN_TAIL : 0u;
+	if (x->w84 != want) {
+		SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_WIN2, want));
+		x->w84 = want;
+		if (want == 0u) {
+			x->armed &= ~SWW_RG_W84;
+		}
+	}
+	SWW_RD(x, SWW_BAR2, want, a - want, *v);
+	return 0;
+}
+
+/* back to window 0 (the state every other row expects) */
+static inline int
+swl_w84_zero(struct swl_wx *x)
+{
+	if (x->w84 != 0u) {
+		SWW_TRY(swl_wr(x, SWW_CFG, 0, SWW_CFG_WIN2, 0u));
+		x->w84 = 0;
+		x->armed &= ~SWW_RG_W84;
+	}
+	return 0;
+}
+
+/* W16: poll the last RAM word (it holds the length token since W12) until the firmware writes the shared-area address there: DHD dhdpcie_readshared (dhd_pcie.c:13636-13705: loop while addr is
+ * 0 or the token, 5 s; then all-ones, 0, the token, below the RAM base or above the word itself = not ready), bwfm (if_bwfm_pci.c:868-881). Every poll first re-checks the RC-local link precondition
+ * (no TLP to a link that left L0). Bounded: SWW_FWUP_POLLS reads, SWW_FWUP_US apart. */
+static inline int
+swl_w16(struct swl_wx *x)
+{
+	uint32_t last = SWW_RAM_BASE + x->ram_bytes - 4u, v = x->tok, io = 0, ctl = 0;
+	unsigned i;
+
+	x->row = 16;
+	if (x->tok == 0u || x->ram_bytes < SWW_RAM_MIN) {
+		return swl_stop(x, SWW_E_STATE);
+	}
+	for (i = 0; i < SWW_FWUP_POLLS; i++) {
+		if (swl_lpre(x)) {
+			printf("SWEET WLAN: W16 link precondition lost after the release (poll %u)\n", i);
+			return swl_stop(x, SWW_E_PRE);
+		}
+		SWW_TRY(swl_bp_rd(x, last, &v));
+		if (v != x->tok && v != 0u) {
+			break;
+		}
+		swl_delay(x, SWW_FWUP_US);
+	}
+	x->fwup_polls = i;
+	printf("SWEET WLAN: W16 last RAM word %#x = %#010x after %u polls of %u ms (token %#010x)\n", last, v, i, SWW_FWUP_US / 1000u, x->tok);
+	if (v == x->tok || v == 0u) {
+		/* DHD logs the CA7 wrapper here (dhd_pcie.c:13700-13705): read only, the window select is the run A tuple */
+		if (!swl_w84_zero(x) && !swl_win(x, SWW_WIN_CA7WRAP) && !swl_rd(x, SWW_BAR0, SWW_WIN_CA7WRAP, SWL_AGENT_IOCTL, &io) &&
+		    !swl_rd(x, SWW_BAR0, SWW_WIN_CA7WRAP, SWL_AGENT_RESET_CTL, &ctl)) {
+			printf("SWEET WLAN: W16 firmware not up: ca7 ioctl %#x reset_ctl %#x\n", io, ctl);
+		}
+		return swl_stop(x, SWW_E_FWUP);
+	}
+	if (v == 0xFFFFFFFFu) {
+		return swl_stop(x, SWW_E_DEAD);
+	}
+	if ((v & 3u) || v < SWW_RAM_BASE || v > last - 4u * SWW_SH_WORDS) {
+		printf("SWEET WLAN: W16 shared pointer %#x outside RAM %#x..%#x, not followed\n", v, SWW_RAM_BASE, last - 4u * SWW_SH_WORDS);
+		return swl_stop(x, SWW_E_SHARED);
+	}
+	x->shared = v;
+	return swl_done(x, SWF_W16);
+}
+
+/* printable console bytes from the ring [buf, buf + size): `n` bytes ending at write index `e` (e < size), oldest first, \r dropped, \n ends a line, other non-printables dropped (hnd_log_t ring as
+ * bwfm_pci_debug_console reads it, if_bwfm_pci.c:2321-2338). One word read per 4 bytes. 0 = done. */
+static inline int
+swl_con_out(struct swl_wx *x, uint32_t e, uint32_t n)
+{
+	char line[SWW_CON_LINE + 1];
+	uint32_t i, p, a, w = 0, wa = 1u;       /* wa: the address of the word in w (1 = none, never word aligned) */
+	unsigned len = 0;
+	char ch;
+
+	p = (e + x->con_size - n) % x->con_size;
+	for (i = 0; i < n; i++) {
+		a = x->con_buf + p;
+		if ((a & ~3u) != wa) {
+			wa = a & ~3u;
+			if (swl_bp_rd(x, wa, &w)) {
+				return -SWW_E_SHARED;
+			}
+		}
+		ch = (char)((w >> (8u * (a & 3u))) & 0xFFu);
+		if (ch == '\n' || len == SWW_CON_LINE) {
+			line[len] = 0;
+			if (len) {
+				printf("SWEET WLAN: fwcon: %s\n", line);
+			}
+			len = 0;
+		}
+		if (ch >= 0x20 && ch < 0x7F) {
+			line[len++] = ch;
+		}
+		p = p + 1u == x->con_size ? 0u : p + 1u;
+	}
+	line[len] = 0;
+	if (len) {
+		printf("SWEET WLAN: fwcon: %s\n", line);
+	}
+	x->con_bytes += n;
+	return 0;
+}
+
+/* W17: READ-ONLY dump: the first 0x40 bytes of pciedev_shared_t, its version, then the console header and up to SWW_CON_MAX bytes of its log (now and SWW_CON_SETTLE_US later, new bytes only).
+ * The console pointer, buffer, size and index come from the chip: each is checked against the RAM (and the index against the size) before anything is read through it. Ends on window 0. */
+static inline int
+swl_w17(struct swl_wx *x)
+{
+	uint32_t i, last = SWW_RAM_BASE + x->ram_bytes - 4u, ver, e0 = 0, e1 = 0, n;
+
+	x->row = 17;
+	for (i = 0; i < SWW_SH_WORDS; i++) {
+		SWW_TRY(swl_bp_rd(x, x->shared + 4u * i, &x->sh[i]));
+	}
+	ver = x->sh[0] & SWW_SH_VER_MASK;
+	printf("SWEET WLAN: fw ready shared=%#x ver=%u flags=%#x console=%#x fwid=%#x ring_info=%#x\n", x->shared, ver, x->sh[0], x->sh[SWW_SH_CONSOLE], x->sh[SWW_SH_FWID], x->sh[SWW_SH_RINGINFO]);
+	printf("SWEET WLAN: W17 shared[0..7] %#x %#x %#x %#x %#x %#x %#x %#x\n", x->sh[0], x->sh[1], x->sh[2], x->sh[3], x->sh[4], x->sh[5], x->sh[6], x->sh[7]);
+	printf("SWEET WLAN: W17 shared[8..15] %#x %#x %#x %#x %#x %#x %#x %#x\n", x->sh[8], x->sh[9], x->sh[10], x->sh[11], x->sh[12], x->sh[13], x->sh[14], x->sh[15]);
+	if (ver < SWW_SH_VER_MIN || ver > SWW_SH_VER_MAX) {
+		printf("SWEET WLAN: W17 shared version %u outside %u..%u (recorded, not used)\n", ver, SWW_SH_VER_MIN, SWW_SH_VER_MAX);
+	}
+	x->con = x->sh[SWW_SH_CONSOLE];
+	if ((x->con & 3u) || x->con < SWW_RAM_BASE || x->con > last - SWW_CON_IDX) {
+		printf("SWEET WLAN: W17 console pointer %#x outside RAM, console not read\n", x->con);
+		SWW_TRY(swl_w84_zero(x));
+		return swl_done(x, SWF_W17);
+	}
+	SWW_TRY(swl_bp_rd(x, x->con + SWW_CON_BUF, &x->con_buf));
+	SWW_TRY(swl_bp_rd(x, x->con + SWW_CON_SIZE, &x->con_size));
+	SWW_TRY(swl_bp_rd(x, x->con + SWW_CON_IDX, &e0));
+	printf("SWEET WLAN: W17 console %#x buf %#x size %u idx %u\n", x->con, x->con_buf, x->con_size, e0);
+	if (x->con_buf < SWW_RAM_BASE || x->con_buf > last || x->con_size == 0u || x->con_size > last - x->con_buf || e0 >= x->con_size) {
+		printf("SWEET WLAN: W17 console buffer outside RAM or index outside it, console not read\n");
+		SWW_TRY(swl_w84_zero(x));
+		return swl_done(x, SWF_W17);
+	}
+	n = e0 < SWW_CON_MAX ? e0 : SWW_CON_MAX;        /* first look: the bytes before the index (a fresh boot has not wrapped; if it has, the older part is simply not shown) */
+	SWW_TRY(swl_con_out(x, e0, n));
+	swl_delay(x, SWW_CON_SETTLE_US);
+	if (!swl_lpre(x)) {
+		SWW_TRY(swl_bp_rd(x, x->con + SWW_CON_IDX, &e1));
+		if (e1 < x->con_size) {
+			n = e1 >= e0 ? e1 - e0 : x->con_size - e0 + e1;
+			n = n < SWW_CON_MAX - x->con_bytes ? n : SWW_CON_MAX - x->con_bytes;
+			printf("SWEET WLAN: W17 console idx %u after %u ms, %u new bytes shown\n", e1, SWW_CON_SETTLE_US / 1000u, n);
+			if (n) {
+				SWW_TRY(swl_con_out(x, e1, n));
+			}
+		} else {
+			printf("SWEET WLAN: W17 console idx %u outside the buffer, second look skipped\n", e1);
+		}
+	} else {
+		printf("SWEET WLAN: W17 link precondition lost before the second console look, skipped\n");
+		return swl_stop(x, SWW_E_PRE);
+	}
+	SWW_TRY(swl_w84_zero(x));
+	printf("SWEET WLAN: W17 done, %u console bytes, cfg84 back at 0, bus master untouched\n", x->con_bytes);
+	return swl_done(x, SWF_W17);
+}

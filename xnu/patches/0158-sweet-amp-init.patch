+/*
+ * xnu patch 0158 (plan oneshot-2 step A7): the CS35L41 amp init of bsd/dev/sweet_amp.h, glue. Inert unless boot-arg sweetamp=1 AND the ADT root
+ * model-number is "oriole" (tools/mkadt.py writes the board codename there, tools/test_mkadt_board_identity.py): without both nothing is mapped and
+ * nothing is read. With them: seven pinned windows mapped (SPI13, the PERIC1 sysreg page, CMU_PERIC1, the PERIC1 / PERIC0 pad pages, and the ALIVE /
+ * FAR_ALIVE pad pages for the IRQ pads, read only), then ONE run of amp_init_run() synchronously, from sweet_ufs_init BEFORE the touch and battery
+ * threads start (gpp23 is shared with the touch chip select and the I2C12 pads; no other read-modify-write of those words can interleave).
+ * The run takes about 0.3 s when both amps answer, about 9.3 s in the worst case (every wait at its bound, review F8), and always ends with both
+ * resets low and every word back (the header's restore). The only stores of this file are in sa_wr32(), called only through the header's w32().
+ * Difference to the shim: XNU has no fault-guarded read; a read of an unclocked block is guarded only by the header's sysreg / CMU gate reads, which
+ * come first (the same order as the shim, whose run must pass before this one runs: plan A7 needs A1 PASS).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <stdint.h>
+#include <string.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);   /* osfmk/arm/machine_routines.h, XNU-private */
+void sweet_amp_init(void);
+
+#define SA_NWIN 7
+/* the windows: page-aligned physical ranges; ro = read only (the IRQ pad banks) */
+static struct { uint64_t pa, len; int ro; volatile uint32_t *va; } sa_win[SA_NWIN] = {
+	{ 0x10D60000ull, 0x1000, 0, NULL },	/* SPI13 (AMP_SPI_BASE): controller words + USI_CON */
+	{ 0x10C21000ull, 0x1000, 0, NULL },	/* sysreg_peric1: the USI13 mode word +0x14 */
+	{ 0x10C00000ull, 0x4000, 0, NULL },	/* CMU_PERIC1: user mux +0x660, div +0x1814, gates +0x2034 / +0x2054, QCH +0x3034 */
+	{ 0x10C40000ull, 0x1000, 0, NULL },	/* PERIC1 pinctrl: gpp23 +0x60, gpp25 +0xA0 */
+	{ 0x10840000ull, 0x1000, 0, NULL },	/* PERIC0 pinctrl: gpp1 +0x20, gpp16 +0x200 */
+	{ 0x174D0000ull, 0x1000, 1, NULL },	/* ALIVE pinctrl: gpa9 +0xC0 (AMP_R_IRQ, read only) */
+	{ 0x174E0000ull, 0x1000, 1, NULL },	/* FAR_ALIVE pinctrl: gpa6 +0x0 (AMP_L_IRQ, read only) */
+};
+static uint64_t sa_freq;
+
+static volatile uint32_t *
+sa_va(uintptr_t pa, int write)
+{
+	unsigned i;
+
+	if (pa & 3u) {
+		return NULL;
+	}
+	for (i = 0; i < SA_NWIN; i++) {
+		if (sa_win[i].va != NULL && pa >= sa_win[i].pa && pa - sa_win[i].pa < sa_win[i].len) {
+			if (write && sa_win[i].ro) {
+				return NULL;
+			}
+			return sa_win[i].va + (pa - sa_win[i].pa) / 4u;
+		}
+	}
+	return NULL;
+}
+
+static int
+try_read32(uintptr_t pa, uint32_t *v)
+{
+	volatile uint32_t *p = sa_va(pa, 0);
+
+	if (p == NULL) {
+		return 0;
+	}
+	*v = *p;
+	return 1;
+}
+
+/* THE store: only inside a writable window, bounded to its length; dsb sy after it (osfmk/arm/atomic.h DSB_SY 0xf), as the shim's try_write32 */
+static int
+try_write32(uintptr_t pa, uint32_t v)
+{
+	volatile uint32_t *p = sa_va(pa, 1);
+
+	if (p == NULL) {
+		return 0;
+	}
+	*p = v;
+	__builtin_arm_dsb(0xf);
+	return 1;
+}
+
+static uint64_t
+counter_freq(void)
+{
+	return sa_freq;
+}
+
+static uint64_t
+touch_ticks(void)
+{
+	return mach_absolute_time();
+}
+
+static void
+con_str(const char *label, const char *s)
+{
+	if (strcmp(label, "SWEET") == 0) {
+		printf("SWEET %s\n", s);
+	} else {
+		printf("SWEET AMP: %s\n", s);
+	}
+}
+
+#include "sweet_amp.h"
+
+void
+sweet_amp_init(void)
+{
+	static int started;
+	uint32_t on = 0;
+	DTEntry root;
+	char const *model = NULL;
+	unsigned int msize = 0, i;
+	vm_offset_t va;
+
+	if (started) {
+		return;
+	}
+	started = 1;
+	if (!PE_parse_boot_argn("sweetamp", &on, sizeof(on)) || on == 0) {
+		return;         /* default: no map, no read */
+	}
+	if (on != 1) {
+		printf("SWEET AMP: refused sweetamp=%u (only 1 is defined), not touched\n", on);
+		return;
+	}
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "model-number", (void const **)&model, &msize) != kSuccess ||
+	    model == NULL || msize != sizeof("oriole") || strncmp(model, "oriole", sizeof("oriole")) != 0) {
+		printf("SWEET AMP: refused not an oriole ADT (model-number), not touched\n");
+		return;
+	}
+	for (i = 0; i < SA_NWIN; i++) {
+		va = ml_io_map((vm_offset_t)sa_win[i].pa, (vm_size_t)sa_win[i].len);
+		if (va == 0) {
+			printf("SWEET AMP: refused ml_io_map(%#llx) failed, not touched\n", sa_win[i].pa);
+			return;
+		}
+		sa_win[i].va = (volatile uint32_t *)va;
+	}
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sa_freq);
+	printf("SWEET AMP: init run (sweetamp=1), timebase %llu Hz\n", sa_freq);
+	printf("SWEET AMP: verdict %s\n", amp_init_run() == 0 ? "PASS (A7 partial: no otp unpack)" : "FAIL (see the AMP lines)");	/* review F1: the return value */
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */

+/* zlib allocator (the kernel zlib has no default one, libkern/zlib/zutil.h NO_ZCFUNCS); inflate asks for ~7 KiB + 32 KiB window. */
+static voidpf
+sd_zalloc(voidpf op __unused, uInt items, uInt size)
+{
+	uint64_t t = (uint64_t)items * size + 16;
+	if (t > (1u << 20)) {
+		return Z_NULL;
+	}
+	uint64_t *p = kalloc_data((vm_size_t)t, Z_WAITOK | Z_ZERO);
+	if (!p) {
+		return Z_NULL;
+	}
+	p[0] = t;
+	return p + 2;
+}
+
+static void
+sd_zfree(voidpf op __unused, voidpf ptr)
+{
+	uint64_t *p = (uint64_t *)ptr - 2;
+	kfree_data(p, (vm_size_t)p[0]);
+}
+#define SD_ZALLOC sd_zalloc
+#define SD_ZFREE  sd_zfree

+/* sd_stream sink: does the existing file hold these bytes at off? 0 yes, 1 differs/unreadable. */
+static int
+sd_sink_cmp(void *ctx, const uint8_t *p, uint32_t n, uint64_t off)
+{
+	struct sd_cmp *c = ctx;
+	int resid = 0;
+	if (vn_rdwr(UIO_READ, c->vp, (caddr_t)c->rb, (int)n, (off_t)off, UIO_SYSSPACE, IO_NOAUTH,
+	    vfs_context_ucred(sd_ctx), &resid, vfs_context_proc(sd_ctx)) || resid || memcmp(c->rb, p, n)) {
+		return 1;
+	}
+	return 0;

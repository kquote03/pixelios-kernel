+typedef int (*sd_sink_fn)(void *ctx, const uint8_t *p, uint32_t n, uint64_t off);
+
+/*
+ * Feed the entry's UNCOMPRESSED bytes to sink in pieces of at most cap bytes (stored: straight from the archive;
+ * zlib: inflated into buf[cap]). 0 only if exactly usize bytes came out, a zlib stream ended exactly at the end of
+ * the stored bytes and the crc matches. -1 and *why for a bad entry; never more than usize bytes reach the sink.
+ * Otherwise the sink's nonzero return. Bounded: inflate returns Z_OK only after consuming input or producing output
+ * (no progress is Z_BUF_ERROR), input is size bytes and output is cut off at usize.
+ */
+static int
+sd_stream(const struct sd_ent *e, uint8_t *buf, uint32_t cap, sd_sink_fn sink, void *ctx, const char **why)
+{
+	uint32_t c = 0xffffffffu;
+	uint64_t out = 0;
+	int rc = 0;
+	*why = NULL;
+	if (e->flags == 0) {
+		while (out < e->size) {
+			uint32_t n = (uint32_t)MIN(e->size - out, (uint64_t)cap);
+			c = sd_crc_upd(c, e->data + out, n);
+			if ((rc = sink(ctx, e->data + out, n, out)) != 0) {
+				return rc;
+			}
+			out += n;
+		}
+	} else {
+		z_stream z;
+		uint64_t in = 0;
+		int zr = Z_OK;
+		memset(&z, 0, sizeof(z));
+		z.zalloc = SD_ZALLOC;
+		z.zfree = SD_ZFREE;
+		if (inflateInit(&z) != Z_OK) {
+			*why = "inflateInit failed";
+			return -1;
+		}
+		while (zr != Z_STREAM_END) {
+			if (z.avail_in == 0 && in < e->size) {
+				uint32_t n = (uint32_t)MIN(e->size - in, (uint64_t)SD_ZIN);
+				z.next_in = (Bytef *)(uintptr_t)(e->data + in);
+				z.avail_in = n;
+				in += n;
+			}
+			z.next_out = buf;
+			z.avail_out = cap;
+			zr = inflate(&z, Z_NO_FLUSH);
+			uint32_t got = cap - z.avail_out;
+			if (zr != Z_OK && zr != Z_STREAM_END) {
+				*why = zr == Z_BUF_ERROR ? "zlib stream truncated" : "bad zlib stream";
+				rc = -1;
+				break;
+			}
+			if (got > e->usize - out) {
+				*why = "inflates past its declared size";
+				rc = -1;
+				break;
+			}
+			c = sd_crc_upd(c, buf, got);
+			if (got && (rc = sink(ctx, buf, got, out)) != 0) {
+				break;
+			}
+			out += got;
+		}
+		if (rc == 0 && (in != e->size || z.avail_in != 0)) {
+			*why = "data after the zlib stream";
+			rc = -1;
+		}
+		inflateEnd(&z);
+		if (rc) {
+			return rc;
+		}
+	}
+	if (out != e->usize) {
+		*why = "uncompressed length mismatch";
+		return -1;
+	}
+	if (~c != e->crc) {
+		*why = "crc mismatch";
+		return -1;
 	}
 	return 0;
 }

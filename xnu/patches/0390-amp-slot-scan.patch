+/* ---- patch 0390 (sweetaoc=12, amp_pwr_diag 4): run a10e found no PCM on ASPRX1 (the 0389 detector moved with VPMON, not with the tone). Scan
+ * where the AOC puts it: a continuous tone (pattern 9, -12 dBFS), DAC and DSP1 RX3 / RX4 on ASPRX1, then ASP_WIDTH_RX (SP_FORMAT 0x4808
+ * [0xFF000000]) 32 / 16 with ASP_RX_WL (SP_RX_WL 0x4840 [0x3F]) 24 / 16, and per width the ASPRX1 slot (SP_FRAME_RX_SLOT 0x4820 [0x3F],
+ * v6.18 cs35l41.h:84, :625-630) 0..7 on both amps, 1 s each, meter lines at 0.9 s (tag w<width>s<slot>). Then the 0388 words back (32 / 24,
+ * L slots 0/1, R 1/0), RX3 / RX4 VMON / IMON, DAC source DSP. ~17 s. ---- */
+static unsigned amp_pwr_diag4_run(const struct amp_snap *s)
+{
+	static const char *tag[16] = { "w32s0", "w32s1", "w32s2", "w32s3", "w32s4", "w32s5", "w32s6", "w32s7",
+	    "w16s0", "w16s1", "w16s2", "w16s3", "w16s4", "w16s5", "w16s6", "w16s7" };
+	unsigned ms = 0, k;
+	int cs;
+
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, 0x08u, NULL);
+	amp_pwr_d3_src(s, 0x08u, 0x08u);
+	con_str("SWEET", "AUDIO: pattern 9 starts now (continuous tone, slot scan, 1 s per step)");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 9);
+	for (k = 0; k < 16u; k++) {
+		for (cs = 0; cs < 2; cs++) {
+			if (k == 0u || k == 8u) {
+				(void)amp_pwr_rmw(s, cs, 0x4808u, 0xFF000000u, k ? 0x10000000u : 0x20000000u, NULL);
+				(void)amp_pwr_rmw(s, cs, 0x4840u, 0x3Fu, k ? 16u : 24u, NULL);
+			}
+			(void)amp_pwr_rmw(s, cs, 0x4820u, 0x3Fu, k & 7u, NULL);
+		}
+		ms += amp_pwr_d3_wait(s, 1000u, 900u, tag[k], 0u, NULL);
+	}
+	amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	for (cs = 0; cs < 2; cs++) {
+		(void)amp_pwr_rmw(s, cs, 0x4808u, 0xFF000000u, 0x20000000u, NULL);
+		(void)amp_pwr_rmw(s, cs, 0x4840u, 0x3Fu, 24u, NULL);
+		(void)amp_pwr_rmw(s, cs, 0x4820u, 0x3F3Fu, cs ? 0x0001u : 0x0100u, NULL);
+	}
+	amp_pwr_d3_src(s, 0x18u, 0x19u);
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, AMP_PCMSRC_DSP, NULL);
+	amp_pwr_diag_snap(s, "end");
+	return ms;
+}

+	}
+	s = ((int32_t)swau_sine48[frame % 48u] + (int32_t)swau_sine48[(frame / 2u) % 48u]) * 31 / 8;
+	if (f == 1u) {
+		return (uint32_t)s << 16;
+	}
+	if (f == 2u) {
+		return swau_f32(s);
+	}
+	return ((uint32_t)s & 0xFFFFu) | (uint32_t)s << 16;
+}

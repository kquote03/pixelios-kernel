+ * 3.5 s with the meter line at 3.4 s, temperature L/R compared with S ("moved" / "flat"), aocp(0x100) (tone off, consumed line). The first
+ * PCM probe (aocp bit 0) that moved is played again as 4 x 2 s beeps (-12.2 dBFS) with the DAC on ASPRX1 (0x08, as pattern 5/6). Then
+ * aocp(0x200) (the 0167 baseline), RX3 / RX4 VMON / IMON, DAC source DSP, snapshot end. ---- */
+static uint32_t amp_pwr_temp(const struct amp_snap *s, int cs)
+{
+	const struct amp_dsp_side *ds = &amp_dsp_res.a[cs];
+	uint32_t v = 0xFFFFFFFFu;

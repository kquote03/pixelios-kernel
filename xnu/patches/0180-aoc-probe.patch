+	uint32_t s0[2], t[2], first = 0, k;
+	unsigned ms = 0, p;
+	int32_t rc;
+	int cs;
+
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, 0x00u, NULL);
+	amp_pwr_d3_src(s, 0x08u, 0x08u);
+	ms += amp_pwr_d3_wait(s, 1500u, 1400u, "S", 0u, NULL);
+	s0[0] = amp_pwr_temp(s, 0);
+	s0[1] = amp_pwr_temp(s, 1);
+	for (k = 1; k <= 16u && amp_pwr_aocp; k++) {
+		int moved;
+
+		rc = amp_pwr_aocp(amp_a9_cb.ctx, k);
+		if (rc == -2)
+			break;
+		ms += amp_pwr_d3_wait(s, 3500u, 3400u, tag[k - 1u], 0u, NULL);
+		t[0] = amp_pwr_temp(s, 0);
+		t[1] = amp_pwr_temp(s, 1);
+		(void)amp_pwr_aocp(amp_a9_cb.ctx, 0x100u);
+		moved = t[0] != s0[0] || t[1] != s0[1];
+		p = put_txt(line, sizeof(line), 0, "AUDIO: a10h ");
+		p = put_txt(line, sizeof(line), p, tag[k - 1u]);
+		p = put_txt(line, sizeof(line), p, " temp L ");
+		p = put_hexmin(line, sizeof(line), p, t[0]);
+		p = put_txt(line, sizeof(line), p, " R ");
+		p = put_hexmin(line, sizeof(line), p, t[1]);
+		p = put_txt(line, sizeof(line), p, " (S ");
+		p = put_hexmin(line, sizeof(line), p, s0[0]);
+		p = put_txt(line, sizeof(line), p, "/");
+		p = put_hexmin(line, sizeof(line), p, s0[1]);
+		p = put_txt(line, sizeof(line), p, rc < 0 ? ") cfg FAILED" : moved ? ") MOVED" : ") flat");
+		emit("SWEET", line, p);
+		if (rc >= 0 && (rc & 1) && moved && !first)
+			first = k;
+	}
+	if (first && amp_pwr_aocp) {
+		for (cs = 0; cs < 2; cs++)
+			(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, 0x08u, NULL);
+		con_str("SWEET", "AUDIO: a10h: AUDIBLE pattern starts now: 4 x 2 s beeps (1 kHz + 500 Hz, -12 dBFS), 1 s gaps, both speakers");
+		if (amp_pwr_aocp(amp_a9_cb.ctx, 0x300u | first) >= 0)
+			ms += amp_pwr_d3_wait(s, 12500u, 1000u, "A1", 2500u, "A0");
+		(void)amp_pwr_aocp(amp_a9_cb.ctx, 0x100u);
+		con_str("SWEET", "AUDIO: a10h: audible pattern ended");
+		for (cs = 0; cs < 2; cs++)
+			(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, 0x00u, NULL);
+	} else {
+		con_str("SWEET", "AUDIO: a10h: no PCM probe moved the detector, no audible pattern");
+	}
+	if (amp_pwr_aocp)
+		(void)amp_pwr_aocp(amp_a9_cb.ctx, 0x200u);
+	amp_pwr_d3_src(s, 0x18u, 0x19u);
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, AMP_PCMSRC_DSP, NULL);
+	amp_pwr_diag_snap(s, "end");
+	return ms;
+}

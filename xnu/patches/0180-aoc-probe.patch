+/* s / 32768 as an IEEE-754 single (|s| < 32768), integer only */
+static uint32_t
+swau_f32(int32_t s)
+{
+	uint32_t sign = s < 0 ? 0x80000000u : 0u, m = (uint32_t)(s < 0 ? -s : s), e = 0;
+
+	if (m == 0u) {
+		return 0u;
+	}
+	while (!(m & 0x8000u)) {
+		m <<= 1;
+		e++;
+	}
+	return sign | (127u - e) << 23 | (m & 0x7FFFu) << 8;
+}
+/* probe tones: 30 + f = continuous, 40 + f = 4 beeps of 2 s on / 1 s off; f = 0 S16 pairs (one word per frame), 1 S32 (two words per
+ * frame, the S16 sample << 16), 2 float32 (two words per frame). The sample is the pattern 4 two-tone (1 kHz + 500 Hz), peak 8029 = -12.2 dBFS. */
+static uint32_t
+swau_probe_word(uint32_t pat, uint32_t wi)
+{
+	uint32_t f = pat % 10u, frame = f ? wi / 2u : wi;

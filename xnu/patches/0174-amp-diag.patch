+/* patch 0174 (sweetaoc=9): the long diagnostic patterns, louder: 1 kHz + 500 Hz (4 x sine48 each, peak 8288 = -11.9 dBFS), beeps of 1.5 s
+ * on / 1 s off; pattern 2 = 3 beeps (the DSP path), pattern 3 = 2 beeps (the DSP bypassed: DAC source ASPRX1). */
+#define SWAU_DIAG_ON    72000u
+#define SWAU_DIAG_PER   120000u
+static uint32_t
+swau_diag_word(uint32_t pat, uint32_t frame)
+{
+	uint32_t n = pat == 2u ? 3u : 2u;
+	int32_t s;
+	uint16_t v;
+
+	if (frame >= n * SWAU_DIAG_PER || frame % SWAU_DIAG_PER >= SWAU_DIAG_ON) {
+		return 0u;
+	}
+	s = 4 * ((int32_t)swau_sine48[frame % 48u] + (int32_t)swau_sine48[(frame / 2u) % 48u]);
+	v = (uint16_t)(int16_t)s;
+	return (uint32_t)v | (uint32_t)v << 16;
+}

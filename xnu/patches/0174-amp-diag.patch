+ * power-up), the glue's pattern 2 (3 long beeps, 7.5 s); 2 s silence; phase B: DAC_PCM1_SRC = ASPRX1 (0x08 = CS35L41_INPUT_SRC_ASPRX1,
+ * Linux v6.18 cs35l41.h:645; the reset default, AMP cs35l41-tables.c:74), the DSP bypassed, pattern 3 (2 long beeps, 5 s); then back to 0x32.
+ * In the middle of the first beep of each phase and at the end: IRQ1_STATUS1..4 (0x10010..0x1001C) and IRQ1_RAW_STATUS1..4 (0x10090..0x1009C,
+ * v6.18 cs35l41.h:118-131), DSP MBOX_2, DAC_PCM1_SRC of both amps. Ticks each ms; no other amp access. ---- */
+static int amp_pwr_diag;
+#define AMP_DIAG_A_MS	7600u
+#define AMP_DIAG_GAP_MS	2000u
+#define AMP_DIAG_B_MS	5100u
+static void amp_pwr_diag_snap(const struct amp_snap *s, const char *tag)
+{
+	static const uint32_t regs[10] = { 0x10010u, 0x10014u, 0x10018u, 0x1001Cu, 0x10090u, 0x10094u, 0x10098u, 0x1009Cu, AMP_DSP_MBOX2, AMP_PWR_PCMSRC };
+	char line[RAMLOG_LINE_MAX];
+	unsigned p, i;
+	int cs;
+
+	for (cs = 0; cs < 2; cs++) {
+		p = put_txt(line, sizeof(line), 0, cs ? "R diag " : "L diag ");
+		p = put_txt(line, sizeof(line), p, tag);
+		p = put_txt(line, sizeof(line), p, " st1-4");
+		for (i = 0; i < 10u; i++) {
+			uint32_t v = 0;
+
+			if (i == 4u)
+				p = put_txt(line, sizeof(line), p, " raw1-4");
+			if (i == 8u)
+				p = put_txt(line, sizeof(line), p, " mbox2/pcmsrc");
+			p = put_txt(line, sizeof(line), p, " ");
+			p = amp_read(s, cs, regs[i], &v) == AMP_OK ? put_hexmin(line, sizeof(line), p, v) : put_txt(line, sizeof(line), p, "rd-err");
+		}
+		emit("AMP", line, p);
+	}
+}
+static unsigned amp_pwr_diag_wait(unsigned ms, const struct amp_snap *s, const char *tag, unsigned snap_at)
+{
+	unsigned i;
+
+	for (i = 0; i < ms; i++) {
+		if (wait_ms(1u))
+			break;
+		if (amp_a9_cb.tick)
+			amp_a9_cb.tick(amp_a9_cb.ctx);
+		if (tag && i + 1u == snap_at)
+			amp_pwr_diag_snap(s, tag);
+	}
+	return i;
+}
+static unsigned amp_pwr_diag_run(const struct amp_snap *s)
+{
+	unsigned ms = 0;
+	int cs;
+
+	say("a10 diag: ", "phase A (DSP path, PCM src 0x32): 3 long beeps 1 kHz + 500 Hz, -12 dBFS, now");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 2);
+	ms += amp_pwr_diag_wait(AMP_DIAG_A_MS, s, "A", 750u);
+	amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	ms += amp_pwr_diag_wait(AMP_DIAG_GAP_MS, s, NULL, 0u);
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, 0x08u, NULL);
+	say("a10 diag: ", "phase B (DSP bypassed, PCM src 0x08 ASPRX1): 2 long beeps, now");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 3);
+	ms += amp_pwr_diag_wait(AMP_DIAG_B_MS, s, "B", 750u);
+	amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, AMP_PCMSRC_DSP, NULL);
+	amp_pwr_diag_snap(s, "end");
+	return ms;
+}

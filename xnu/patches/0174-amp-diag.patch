+/* patch 0174: read-only AOC queries (stock getters, aoc_alsa_hw.c; ids/structs aoc-interface-gs101.h): GET_DSP_STATE 233 (:1199), GET_SINK_
+ * PROCESSING_STATE 234 sink 0 (:1215, aoc_get_sink_state :1159), GET_SINKS_BITMAPS 245 (:1605, 5 x u16), GET_PARAMETER 211 (:1007) block 16
+ * (speaker sink, AOC_AUDIO_SINK_BLOCK_ID_BASE aoc_alsa.h:95) component 0 key 0 = the EP0 volume (aoc_audio_volume_set :329-357) and component 2
+ * key 0 = "AoC Speaker Mixer ASP Mode" (aoc_alsa_ctl.c:2436, :1593-1610). Each reply is logged by the glue (pay[]). */
+#define SWAU_CMD_GET_SINK_STATE 234u
+#define SWAU_CMD_GET_BITMAPS    245u
+#define SWAU_CMD_GET_PARAM      211u
+static void
+swau_query(const struct swau_bus *b, struct swau_res *r)
+{
+	uint8_t m[18];
+	uint32_t i;
+
+	(void)swau_get_dsp_state(b, r);
+	swau_hdr(m, r->cntr++, 10u, SWAU_CMD_GET_SINK_STATE);
+	m[8] = 0u;
+	m[9] = 0u;
+	(void)swau_cmd(b, r, m, 10u);
+	swau_hdr(m, r->cntr++, 18u, SWAU_CMD_GET_BITMAPS);
+	for (i = 8; i < 18u; i++) {
+		m[i] = 0u;
+	}
+	(void)swau_cmd(b, r, m, 18u);
+	for (i = 0; i < 2u; i++) {
+		swau_hdr(m, r->cntr++, 18u, SWAU_CMD_GET_PARAM);
+		m[8] = 16u;
+		m[9] = i ? 2u : 0u;
+		swau_put32(m + 10, 0u);
+		swau_put32(m + 14, 0u);
+		(void)swau_cmd(b, r, m, 18u);
+	}
+}

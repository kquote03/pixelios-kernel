+static void amp_a9_pll2(const struct amp_snap *s)
+{
+	unsigned n = amp_a9_cb.polls < AMP_A9_PLL_POLLS_MAX ? amp_a9_cb.polls : AMP_A9_PLL_POLLS_MAX, p, k;
+	int e[2] = { AMP_OK, AMP_OK }, cs;
+
+	for (p = 0; p < n && !(amp_a9_res.a[0].locked && amp_a9_res.a[1].locked) && (e[0] == AMP_OK || e[1] == AMP_OK); p++) {
+		if (wait_ms(1u)) {
+			e[0] = e[1] = AMP_TIMEOUT;
+			break;
+		}
+		if (amp_a9_cb.tick)
+			amp_a9_cb.tick(amp_a9_cb.ctx);
+		for (cs = 0; cs < 2; cs++) {
+			struct amp_a9_side *d = &amp_a9_res.a[cs];
+
+			if (e[cs] != AMP_OK || d->locked)
+				continue;
+			e[cs] = amp_read(s, cs, AMP_REG_IRQ1_STATUS3, &d->st3);

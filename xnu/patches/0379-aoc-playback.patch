+/* zero the whole AOC_DOWN data area, then the stock write-pointer reset */
+static int
+swau_ring_prime(const struct swau_bus *b, struct swau_ring *p)
+{
+	struct swau_region *g = &p->g;
+	uint32_t i, rem;
+
+	for (i = 0; i < g->size; i += 4u) {
+		if (!b->iw32(b->ctx, g->offset + i, 0u)) {
+			return SWAU_E_WRITE;
+		}
+	}
+	b->isync(b->ctx);
+	p->zeroed = 1;
+	if (!swau_counters(b, g)) {
+		return SWAU_E_READ;
+	}
+	if (g->wp >= g->size || (g->wp & 3u)) {
+		return SWAU_E_CORRUPT;
+	}
+	rem = g->size - g->wp;
+	if (!b->iw32(b->ctx, g->base + 12u, g->tx + rem) || !b->iw32(b->ctx, g->base + 20u, (g->wp + rem) % g->size)) {
+		return SWAU_E_WRITE;
+	}
+	b->isync(b->ctx);
+	p->reset = 1;
+	p->rx0 = g->rx;

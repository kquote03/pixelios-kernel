+/* one feed of ZEROS: what the AOC consumed since, at most SWAU_FEED_MAX bytes; no wait. Called each poll ms while the stream runs. */
+static void
+swau_feed(const struct swau_bus *b, struct swau_res *r)
+{
+	struct swau_ring *p = &r->pb;
+	struct swau_region *g = &p->g;
+	uint32_t used, n, k;

+	if (!r->started || r->stopped) {
+		return;
+	}
+	if (!swau_counters(b, g) || g->wp >= g->size || (g->wp & 3u)) {
+		p->feed_err++;
+		return;
+	}
+	used = g->tx - g->rx;
+	if (used > g->size) {
+		used = g->size;
+	}
+	n = g->size - used;
+	if (n > SWAU_FEED_MAX) {
+		n = SWAU_FEED_MAX;
+	}
+	n &= ~3u;
+	if (n == 0u) {
+		return;
+	}
+	for (k = 0; k < n; k += 4u) {
+		if (!b->iw32(b->ctx, g->offset + (g->wp + k) % g->size, 0u)) {
+			p->feed_err++;
+			return;         /* tx not advanced: the AOC sees nothing new */
+		}
+	}
+	b->isync(b->ctx);
+	if (!b->iw32(b->ctx, g->base + 12u, g->tx + n) || !b->iw32(b->ctx, g->base + 20u, (g->wp + n) % g->size)) {
+		p->feed_err++;
+		return;
+	}
+	b->isync(b->ctx);
+	if ((p->flags & SWAU_RING_PUSH) && !b->doorbell(b->ctx, p->irq)) {
+		p->feed_err++;
+	}
+	p->fed += n;
+	p->feeds++;

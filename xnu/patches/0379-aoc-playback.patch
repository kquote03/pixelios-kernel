+/* patch 0379: the after-poll reads of one amp (IRQ1_STATUS1, PWR_CTRL1), its line and the st3 snapshot line */
+static void amp_a9_after(const struct amp_snap *s, int cs, const char *name, struct amp_a9_side *d, int e)
+{
+	char line[RAMLOG_LINE_MAX];
+	unsigned p, k;

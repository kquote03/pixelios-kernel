From: PixeliOS <noreply@example.invalid>
Subject: [PATCH] sweet: gs101 touch, opt-in stock-probe order (sweettouchrstfirst)

Oriole (shim fff52f1, run oriole-rstfirst1, 2026-11-14): with the reset pulse BEFORE the SPI pads get their function, then the
ready event and Sense ON, the shim read 3002 touch events on the irq; the same frames with the old order got none.
Stock order, read from source (fts_touch f87fd67 ftm5/): fts_set_gpio pulses reset (fts.c:6241-6283) before fts_pinctrl_setup
(fts.c:6674-6680); observed in the oriole recovery dmesg (SET GPIOS 25.0147 s, SET Pinctrl 25.0248 s). A reset with the SPI pads
active leaves the IC answering 65 6E FF .. (observed under the stock driver too).
sweettouchrstfirst=1: after the mux check and before the clock / SPI setup, CS high and the reset pulse; after the SPI setup,
pulls off and wait for the ready event without a second pulse (stop if none); the DCHIP_ID identify is skipped (it reads ff / 20
under the stock driver once the firmware runs); then phase 2 as before (Sense ON, FIFO polling). Default 0: 0095/0145 paths and
bluejay unchanged. Same pads and registers as the existing reset path; no new SoC register.

---
diff --git a/bsd/dev/sweet_touch_gs101.c b/bsd/dev/sweet_touch_gs101.c
index d5f74ad..ae9ba46 100644
--- a/bsd/dev/sweet_touch_gs101.c
+++ b/bsd/dev/sweet_touch_gs101.c
@@ -184,6 +184,7 @@ static struct {
 	uint32_t last_st, last_ch;   /* STATUS / CH_CFG at the last burst timeout */
 	int mode, mux_force;
 	int spi4, sysinfo, idretry;   /* patch 0145 boot-args, 0 = off */
+	int rstfirst;                 /* patch 0146 boot-arg sweettouchrstfirst, 0 = off */
 	uint32_t idwait_ms;
 	uint32_t delay_s;
 	int sleep_chan;
@@ -1167,15 +1168,11 @@ tg_drain(unsigned *logged)
 
 /* fts_system_reset (fts_lib/ftsCore.c:66-108) with a reset gpio: low, 10 ms, high, wait for CONTROLLER_READY. */
 static bool
-tg_reset_and_ready(unsigned *logged)
+tg_wait_ready(unsigned *logged)
 {
 	static const uint8_t cmd[1] = { FTM5_CMD_FIFO_READ };
 	uint64_t t0;
 
-	tg_pin_put(&tg.reset, 0);
-	tg_pin_set_func(&tg.reset, PIN_FUNC_OUTPUT);
-	tg_sleep_ms(10);
-	tg_pin_put(&tg.reset, 1);
 	t0 = tg_now_us();
 	while (tg_now_us() - t0 < 1500000u) {   /* GENERAL_TIMEOUT is not known: 1.5 s, GUESS */
 		uint8_t e[FTM5_EVENT_SIZE];
@@ -1196,6 +1193,39 @@ tg_reset_and_ready(unsigned *logged)
 	return false;
 }
 
+static void
+tg_reset_pulse(void)
+{
+	tg_pin_put(&tg.reset, 0);
+	tg_pin_set_func(&tg.reset, PIN_FUNC_OUTPUT);
+	tg_sleep_ms(10);
+	tg_pin_put(&tg.reset, 1);
+}
+
+static bool
+tg_reset_and_ready(unsigned *logged)
+{
+	tg_reset_pulse();
+	return tg_wait_ready(logged);
+}
+
+/* Patch 0146 (sweettouchrstfirst=1): the stock probe's order. fts_set_gpio pulses reset (0, 10 ms, 1; fts.c:6241-6283) BEFORE
+ * fts_pinctrl_setup gives the SPI pads their function (fts.c:6674-6680; oriole recovery dmesg 2026-11-14: SET GPIOS 25.0147 s,
+ * SET Pinctrl 25.0248 s), so at reset release CLK/MOSI/MISO are still what the ABL left (inputs, pull-down) and CS is high.
+ * A reset with the SPI pads already active left the IC in a state that answers 65 6E FF .. (observed under the stock driver
+ * too). With this order the shim got 3002 touch events (shim fff52f1, run oriole-rstfirst1). Called before tg_cmu_enable. */
+static void
+tg_rstfirst_pulse(void)
+{
+	uint32_t fc = tg_pin_func(&tg.clk), fo = tg_pin_func(&tg.mosi), fi = tg_pin_func(&tg.miso);
+
+	tg_pin_put(&tg.cs, 1);    /* cs-gpios: inactive high before it becomes an output, as tg_spi_setup */
+	tg_pin_set_func(&tg.cs, PIN_FUNC_OUTPUT);
+	tg_reset_pulse();
+	printf("SWEET TOUCH: sweettouchrstfirst=1: reset pulsed before the SPI pads get their function (clk/mosi/miso func "
+	    "%x/%x/%x, cs out high), as fts_set_gpio before fts_pinctrl_setup\n", fc, fo, fi);
+}
+
 /* setScanMode(SCAN_MODE_ACTIVE, 0xFF), fts_lib/ftsCore.c:339-366: first a write whose meaning the downstream
  * source does not explain (cmd1, repeated in setFeatures and writeSysCmd), then the scan-mode command. */
 static bool
@@ -1228,13 +1258,28 @@ tg_run(void)
 		}
 		return;
 	}
+	if (tg.rstfirst) {
+		tg_rstfirst_pulse();
+	}
 	(void)tg_cmu_enable();    /* an aborted sequence is reported; the identify below shows whether it mattered */
 	tg_poke_run();            /* sweettouchpoke, if given: after the driver's own clock writes, before the SPI setup */
 	if (!tg_spi_setup()) {
 		return;
 	}
 	tg_spi_diag("after setup");
-	if (tg.cs_abl) {   /* run touch1: the chip answered after PUD := 0 and the reset pulse, so that comes first */
+	if (tg.rstfirst) {   /* patch 0146: pulls off as the DT pinctrl (PULL_NONE), then only wait: no second pulse */
+		tg_pin_set_pud(&tg.clk, 0);
+		tg_pin_set_pud(&tg.mosi, 0);
+		tg_pin_set_pud(&tg.miso, 0);
+		tg_pin_set_pud(&tg.cs, 0);
+		tg_pin_set_pud(&tg.reset, 0);
+		tg.reset_done = tg_wait_ready(&logged);
+		printf("SWEET TOUCH: sweettouchrstfirst=1: %s\n", tg.reset_done ? "controller-ready event seen" :
+		    "no ready event; stopping (a second reset with the SPI pads active is what breaks the IC)");
+		if (!tg.reset_done) {
+			return;
+		}
+	} else if (tg.cs_abl) {   /* run touch1: the chip answered after PUD := 0 and the reset pulse, so that comes first */
 		tg_pin_set_pud(&tg.clk, 0);
 		tg_pin_set_pud(&tg.mosi, 0);
 		tg_pin_set_pud(&tg.miso, 0);
@@ -1255,7 +1300,12 @@ tg_run(void)
 			tg_spi4();
 		}
 	}
-	ok = tg_identify_try(0);
+	if (tg.rstfirst) {   /* DCHIP_ID reads ff / 20 under the stock driver once the firmware runs (oriole recovery 2026-11-14) */
+		printf("SWEET TOUCH: sweettouchrstfirst=1: identify skipped (DCHIP_ID is not readable while the firmware runs)\n");
+		ok = true;
+	} else {
+		ok = tg_identify_try(0);
+	}
 	for (int r = 1; !ok && r <= tg.idretry; r++) {
 		ok = tg_identify_try(r);
 	}
@@ -1318,7 +1368,7 @@ sweet_touch_gs101_init(void)
 	char const *compat = NULL;
 	unsigned int csize = 0;
 	int mode = 2, delay_s = 45, mux = 0, clk = 0, var = 0, cs = 0;
-	int spi4 = 0, sysinfo = 0, idwait = 0, idretry = 0;
+	int spi4 = 0, sysinfo = 0, idwait = 0, idretry = 0, rstfirst = 0;
 	thread_t thread;
 
 	if (started) {
@@ -1347,6 +1397,7 @@ sweet_touch_gs101_init(void)
 	(void)PE_parse_boot_argn("sweettouchsysinfo", &sysinfo, sizeof(sysinfo));
 	(void)PE_parse_boot_argn("sweettouchidwait", &idwait, sizeof(idwait));
 	(void)PE_parse_boot_argn("sweettouchidretry", &idretry, sizeof(idretry));
+	(void)PE_parse_boot_argn("sweettouchrstfirst", &rstfirst, sizeof(rstfirst));
 	(void)PE_parse_boot_argn("sweettouchpoke", tg.poke, sizeof(tg.poke));   /* longer values are cut: poke_parse then sees > 240 chars */
 	if (delay_s < 0 || delay_s > 3600) {
 		delay_s = 45;
@@ -1367,6 +1418,7 @@ sweet_touch_gs101_init(void)
 	tg.sysinfo = sysinfo;
 	tg.idwait_ms = (uint32_t)idwait;
 	tg.idretry = idretry;
+	tg.rstfirst = rstfirst == 1;
 	tg.clk_mode = clk < 0 ? 0 : clk > 3 ? 3 : clk;
 	tg.mode = mode;
 	tg.delay_s = (uint32_t)delay_s;

+#if defined(SWEET)
+/* Patch 0157 (docs/research/35 s.8): SPI attach for drivers (allowlist in sweet_spi.h: INTID 452/453 only) and the safety net sleh_irq calls.
+ * The net is armed by the first attach: before that sweet_spi_irq() returns 0 and sleh_irq behaves exactly as before. Once armed, an SPI with
+ * no attached handler is masked (GICD_ICENABLER) and counted instead of being EOId and re-taken forever (review M2, doc 35 s.4).
+ * Single caller of attach/detach: sweet_mali_init and the Mali completion thread (thread context, never concurrently). */
+#include "sweet_spi.h"
+
+static struct sweet_spi_table sweet_spi_tab;
+static volatile int sweet_spi_net;
+
+#define SWEET_SPI_RWP_SPINS 1000000u
+
+static int
+sweet_spi_rwp_wait(void)
+{
+	for (uint32_t i = 0; i < SWEET_SPI_RWP_SPINS; i++) {
+		if (!(gicd_read32(SSPI_CTLR) & SSPI_CTLR_RWP)) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* IRQ context, from sleh_irq: 1 = this SPI was dispatched or masked by the net (the caller only EOIs), 0 = not handled here */
+int sweet_spi_irq(uint32_t intid);
+int
+sweet_spi_irq(uint32_t intid)
+{
+	uint32_t off, bit;
+	int r;
+
+	if (!sweet_spi_net || !gicd_base) {
+		return 0;
+	}
+	r = sweet_spi_dispatch(&sweet_spi_tab, intid);
+	if (r == SSPI_NOT_SPI) {
+		return 0;
+	}
+	if (r == SSPI_MASK && sweet_spi_mask_reg(intid, &off, &bit) == 0) {
+		gicd_write32(off, bit);
+	}
+	return 1;
+}
+
+void sweet_spi_counts(uint32_t *unhandled, uint32_t *last);
+void
+sweet_spi_counts(uint32_t *unhandled, uint32_t *last)
+{
+	*unhandled = sweet_spi_tab.unhandled;
+	*last = sweet_spi_tab.last_unhandled;
+}
+
+void sweet_spi_detach(uint32_t intid);
+void
+sweet_spi_detach(uint32_t intid)
+{
+	struct sweet_spi_regs r;
+
+	if (!gicd_base || sweet_spi_regs(intid, &r)) {
+		return;
+	}
+	gicd_write32(SSPI_ICENABLER + r.word_off, r.bit);
+	(void)sweet_spi_rwp_wait();
+	sweet_spi_clear(&sweet_spi_tab, intid);
+}
+
+/* 0 = attached and enabled (ISENABLER read back set). Writes, in order: ICENABLER, ICPENDR, ICACTIVER, IGROUPR |= bit, (RWP), ISENABLER, (RWP).
+ * ICFGR, IGRPMODR and IROUTER are only READ: they must already say level / group-modifier 0 / this CPU (the 0109 probe read 0, 0, 0 on oriole),
+ * else nothing is written (EPERM). *isen, *igroupr, *irouter: read back for the caller's log line. */
+int sweet_spi_attach(uint32_t intid, void (*fn)(void *), void *arg, uint32_t *isen, uint32_t *igroupr, uint64_t *irouter);
+int
+sweet_spi_attach(uint32_t intid, void (*fn)(void *), void *arg, uint32_t *isen, uint32_t *igroupr, uint64_t *irouter)
+{
+	struct sweet_spi_regs r;
+	struct sweet_spi_state s;
+
+	if (!gicd_base) {
+		return 6;               /* ENXIO */
+	}
+	if (sweet_spi_regs(intid, &r) || fn == NULL) {
+		return 22;              /* EINVAL */
+	}
+	s.icfgr = gicd_read32(r.icfgr_off);
+	s.igrpmodr = gicd_read32(SSPI_IGRPMODR + r.word_off);
+	s.irouter = (uint64_t)gicd_read32(r.irouter_off) | ((uint64_t)gicd_read32(r.irouter_off + 4) << 32);
+	s.mpidr_aff = sweet_spi_mpidr_aff(__builtin_arm_rsr64("MPIDR_EL1"));
+	*irouter = s.irouter;
+	*igroupr = gicd_read32(SSPI_IGROUPR + r.word_off);
+	*isen = gicd_read32(SSPI_ISENABLER + r.word_off);
+	if (sweet_spi_precheck(intid, &s)) {
+		return 1;               /* EPERM: zero writes */
+	}
+	if (sweet_spi_set(&sweet_spi_tab, intid, fn, arg)) {
+		return 16;              /* EBUSY: already attached */
+	}
+	sweet_spi_net = 1;              /* the net is live before the first enable */
+	gicd_write32(SSPI_ICENABLER + r.word_off, r.bit);
+	gicd_write32(SSPI_ICPENDR + r.word_off, r.bit);
+	gicd_write32(SSPI_ICACTIVER + r.word_off, r.bit);
+	gicd_write32(SSPI_IGROUPR + r.word_off, gicd_read32(SSPI_IGROUPR + r.word_off) | r.bit);

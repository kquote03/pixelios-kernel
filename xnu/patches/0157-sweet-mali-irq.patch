index 0000000..2e614c2
--- /dev/null
+++ b/pexpert/arm/sweet_spi.h
@@ -0,0 +1,168 @@
+/*
+ * GIC SPI table for the sweet port (patch 0157, docs/research/35 s.6/s.8): which SPIs a driver may attach (allowlist: INTID 452 = Mali JOB,
+ * 453 = Mali MMU; never 451 = Mali GPU, doc 35 s.8 item 6), where their GICD bits live, the attach preconditions on the read-back state, and
+ * the decision sleh_irq makes for an SPI: run the attached handler, or mask the SPI (GICD_ICENABLER) and count it so a stuck level line
+ * cannot re-enter forever (review M2, doc 35 s.4). Pure code: shim/sweet_spi_host_test.c builds it with plain cc (pexpert/arm/sweet_spi.h, included by pe_fiq.c only). No register access here.
+ * GICD layout [src: doc 35 s.6, offsets cross-checked with the sibling port's macros; the read-only probe of patch 0109 used the same offsets
+ * on oriole and read TYPER 0x79041e, CTLR 0x12, row 14 all 0, ICFGR 0, IROUTER 0 (PORT.md 2026-11-14, run gpu-oriole-g4b)].
+ * INTIDs: stock oriole DT mali@1C500000 interrupts SPI 420 JOB / 421 MMU / 419 GPU, level-high (PORT.md G4b, oriole-ref1 capture), INTID = SPI + 32.
+ */
+#ifndef SWEET_SPI_H
+#define SWEET_SPI_H
+#include <stdint.h>
+#include <stddef.h>
+
+#define SSPI_IGROUPR    0x080u
+#define SSPI_ISENABLER  0x100u
+#define SSPI_ICENABLER  0x180u
+#define SSPI_ICPENDR    0x280u
+#define SSPI_ICACTIVER  0x380u
+#define SSPI_ICFGR      0xC00u
+#define SSPI_IGRPMODR   0xD00u
+#define SSPI_IROUTER    0x6000u
+#define SSPI_CTLR       0x000u
+#define SSPI_CTLR_RWP   (1u << 31)
+#define SSPI_IROUTER_IRM (1ull << 31)
+#define SSPI_SLOTS      2u
+
+enum { SSPI_HANDLED = 0, SSPI_MASK = 1, SSPI_NOT_SPI = 2 };
+
+struct sweet_spi_regs {
+	uint32_t word_off;      /* 4 * (intid / 32): add to IGROUPR/ISENABLER/ICENABLER/ICPENDR/ICACTIVER/IGRPMODR */
+	uint32_t bit;           /* 1 << (intid % 32) */
+	uint32_t icfgr_off;     /* ICFGR word holding the 2-bit field */
+	uint32_t icfgr_shift;   /* field position; bit (shift + 1) = 1 means edge */
+	uint32_t irouter_off;   /* 64-bit IROUTER */
+};
+
+/* the read-back state an attach requires (nothing of it is written): level, group modifier 0 (with IGROUPR = 1: Group 1 Non-secure),
+ * routed (IRM = 0) to exactly the attaching CPU's affinity */
+struct sweet_spi_state {
+	uint32_t icfgr, igrpmodr;
+	uint64_t irouter, mpidr_aff;
+};
+
+struct sweet_spi_table {
+	struct {
+		uint32_t intid;
+		void (*fn)(void *);
+		void *arg;
+	} slot[SSPI_SLOTS];
+	uint32_t unhandled, last_unhandled;
+};
+
+static int
+sweet_spi_allowed(uint32_t intid)
+{
+	return intid == 452u || intid == 453u;
+}
+
+/* 0 and *r for an allowlisted INTID, -1 otherwise */
+static int
+sweet_spi_regs(uint32_t intid, struct sweet_spi_regs *r)
+{
+	if (!sweet_spi_allowed(intid)) {
+		return -1;
+	}
+	r->word_off = 4u * (intid / 32u);
+	r->bit = 1u << (intid % 32u);
+	r->icfgr_off = SSPI_ICFGR + 4u * (intid / 16u);
+	r->icfgr_shift = 2u * (intid % 16u);
+	r->irouter_off = SSPI_IROUTER + 8u * intid;
+	return 0;
+}
+
+/* IROUTER affinity of a CPU: MPIDR Aff3 [39:32] and Aff2.Aff1.Aff0 [23:0]; bits 24 (MT), 30 (U), 31 (RES1) dropped */
+static uint64_t
+sweet_spi_mpidr_aff(uint64_t mpidr)
+{
+	return mpidr & 0xFF00FFFFFFull;
+}
+
+/* 0 = the SPI may be attached as it is (no ICFGR / IGRPMODR / IROUTER write needed), else -1 */
+static int
+sweet_spi_precheck(uint32_t intid, const struct sweet_spi_state *s)
+{
+	struct sweet_spi_regs r;
+
+	if (sweet_spi_regs(intid, &r)) {
+		return -1;
+	}
+	if ((s->icfgr >> r.icfgr_shift) & 2u) {
+		return -1;                      /* edge-triggered: not the Mali line */
+	}
+	if (s->igrpmodr & r.bit) {
+		return -1;                      /* group modifier set: Secure group, not ours */
+	}
+	if ((s->irouter & SSPI_IROUTER_IRM) || (s->irouter & 0xFF00FFFFFFull) != s->mpidr_aff) {
+		return -1;                      /* routed elsewhere: would not reach this CPU's handler */
+	}
+	return 0;
+}
+
+/* GICD_ICENABLER word offset and bit of any SPI (the safety net masks unattached SPIs, not only allowlisted ones) */
+static int
+sweet_spi_mask_reg(uint32_t intid, uint32_t *off, uint32_t *bit)
+{
+	if (intid < 32u || intid >= 1020u) {
+		return -1;
+	}
+	*off = SSPI_ICENABLER + 4u * (intid / 32u);
+	*bit = 1u << (intid % 32u);
+	return 0;
+}
+
+static int
+sweet_spi_set(struct sweet_spi_table *t, uint32_t intid, void (*fn)(void *), void *arg)
+{
+	unsigned i, free_i = SSPI_SLOTS;
+
+	if (!sweet_spi_allowed(intid) || fn == NULL) {
+		return -1;
+	}
+	for (i = 0; i < SSPI_SLOTS; i++) {
+		if (t->slot[i].fn != NULL && t->slot[i].intid == intid) {
+			return -1;
+		}
+		if (t->slot[i].fn == NULL && free_i == SSPI_SLOTS) {
+			free_i = i;
+		}
+	}
+	if (free_i == SSPI_SLOTS) {
+		return -1;
+	}
+	t->slot[free_i].intid = intid;
+	t->slot[free_i].arg = arg;
+	t->slot[free_i].fn = fn;                /* last: the IRQ path keys on fn */
+	return 0;
+}
+
+static void
+sweet_spi_clear(struct sweet_spi_table *t, uint32_t intid)
+{
+	for (unsigned i = 0; i < SSPI_SLOTS; i++) {
+		if (t->slot[i].fn != NULL && t->slot[i].intid == intid) {
+			t->slot[i].fn = NULL;
+		}
+	}
+}
+
+/* IRQ context: SSPI_HANDLED (the handler ran), SSPI_MASK (no handler: the caller masks the SPI; counted here), SSPI_NOT_SPI */
+static int
+sweet_spi_dispatch(struct sweet_spi_table *t, uint32_t intid)
+{
+	if (intid < 32u || intid >= 1020u) {
+		return SSPI_NOT_SPI;
+	}
+	for (unsigned i = 0; i < SSPI_SLOTS; i++) {
+		void (*fn)(void *) = t->slot[i].fn;
+		if (fn != NULL && t->slot[i].intid == intid) {
+			fn(t->slot[i].arg);
+			return SSPI_HANDLED;
+		}
+	}
+	t->unhandled++;
+	t->last_unhandled = intid;
+	return SSPI_MASK;
+}
+#endif

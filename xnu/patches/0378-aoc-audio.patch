+#define AMP_A9_N 23u
+#define AMP_REG_PLL_CTRL	0x2C04u
+#define AMP_PLL_LOCK		0x2u
+#define AMP_PLL_UNLOCK		0x10u
+#define AMP_GLOBAL_EN		0x1u
+#define AMP_A9_PLL_POLLS	100u
+#define AMP_A9_X_ASSERT(r, m, f) _Static_assert((r) != AMP_REG_PWR_CTRL1 && ((f) & ~(m)) == 0u, "A9 row: never PWR_CTRL1, field inside its mask");
+AMP_A9_TAB(AMP_A9_X_ASSERT)
+#undef AMP_A9_X_ASSERT
+struct amp_a9_row { uint32_t reg, mask, field; };
+static const struct amp_a9_row amp_a9_tab[AMP_A9_N] = {
+#define AMP_A9_X_ROW(r, m, f) { (r), (m), (f) },

+	X(0x4808u, 0x00000700u, 0u) X(0x4808u, 0x00000010u, 0u) X(0x4808u, 0x00000001u, 0u) X(0x4808u, 0x00000004u, 0u) X(0x4808u, 0x00000040u, 0u) \

new file mode 100644
index 0000000..3659292
--- /dev/null
+++ b/bsd/dev/sweet_audio.h
@@ -0,0 +1,381 @@
+/*
+ * AOC audio control (patch 0378, plan 2026-11-14 oneshot-2 step A9a), boot-arg sweetaoc=4 (= the A8 start of patch 0377, then this).
+ * Pure logic, no kernel headers: the host test shim/aoc_audio_host_test.c drives it with a fake AOC queue peer.
+ * Sources (docs/research/50 s.6.6 / s.7; aoc = google-modules/aoc ac69293, ipc = aoc-ipc 1fe9b9c, alsa = aoc/alsa):
+ *   service header (ipc aoc_ipc_core_internal.h:76-98): name[32], u32 flags @32, regions[2] @36, each 28 bytes
+ *     {offset, size, slots, tx, rx, wp, rp}; region 0 = AOC_UP (FW -> AP), 1 = AOC_DOWN (AP -> FW) (aoc_ipc_core.h:36-44);
+ *     type = (flags >> 16) & 7 (0 queue), irq index = (flags >> 19) & 0x1F (aoc_ipc_core.c:221-246). A8 measured
+ *     audio_output_control = service 6, flags 0 (queue, irq 0).
+ *   queue write (aoc_service_write_message aoc_ipc_core.c:654-690, _aoc_queue_write_buffer :102-113): slot = offset +
+ *     size * (tx % slots), {u16 length, u16 0, u16 0, u16 0} then the payload; barrier; tx += 1, wp = (wp + 1) % size
+ *     (_region_advance_tx :53-65); room = slots - (tx - rx) (:400-422); payload <= size - 8 (aoc_service_message_size :287-306).
+ *     Then the doorbell: AOC mailbox INTGR0 = 1 << irq (signal_aoc aoc_service_core.c:192-195, 560-563; wc_mbox_int_generate
+ *     mailbox-wc.c:91-98).
+ *   queue read (aoc_service_read_message :613-652): slot at offset + size * (rx % slots), length from its header, then
+ *     rx += 1, rp = (rp + 1) % size; if the queue was full before the read, ring the doorbell (aoc_service_read aoc_service_core.c:495-511).
+ *   one command (aoc_audio_control alsa:aoc_alsa_hw.c:196-311): drain stale replies, write, poll the reply <= 500 ms
+ *     (WAITING_TIME_MS); a 4-byte reply is an error code (:277-282). Stock then only logs; here every exchange stops on: timeout,
+ *     a 4-byte error, a reply shorter than the 8-byte header, a reply whose type / id differ from the command (unknown), reply != 0
+ *     (rejected). Stock would trigger the AOC watchdog on a timeout (:268-276): not done.
+ *   header (aoc-interface-gs101.h:330-334, 419-423, AocCmdHdrSet :2499-2511): {u8 type = DATA_TYPE_CMD 0, u8 cntr (running,
+ *     first 0), u16 len = total size, u16 id, i16 reply}, packed little endian.
+ * Commands (exactly docs/research/50 s.7.3 rows 0 and 1, the path open of aoc_audio_path_open alsa:aoc_alsa_hw.c:1322-1343,
+ * 1635-1660; and its undo, row 5):
+ *   CMD_AUDIO_OUTPUT_GET_DSP_STATE 233 (:154, struct :1199-1202): + u8 mode = 0, 9 bytes (read only);
+ *   CMD_AUDIO_OUTPUT_BIND2 271 (:225, struct CMD_AUDIO_OUTPUT_BIND :894-899): + u8 src = 0 (ep_id_to_source(0)), u8 dst =
+ *     SINK_SPEAKER 0 (:2083, PORT_TDM_0_RX -> SINK_SPEAKER alsa:aoc_alsa_hw.c:33-48), u8 bind = 1; 11 bytes;
+ *   the same with bind = 0 on every path after a BIND2 bind = 1 was written (restore).
+ * No EP_SETUP, no SOURCE, no PCM data, no gain, no SET_PARAMETER. Every wait bounded.
+ */
+#ifndef SWEET_AUDIO_H
+#define SWEET_AUDIO_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#define SWAU_IPC_LEN        0x00400000u     /* = SWAS_IPC_LEN of sweet_aoc_start.h (patch 0377) */
+#define SWAU_HDR            8u              /* struct aoc_ipc_message_header */
+#define SWAU_MAX_SLOT       4096u           /* our bound on one slot (the stock reader allocates 1024 bytes, aoc_alsa_hw.c:203) */
+#define SWAU_MAX_MSG        64u             /* our reply buffer: the replies here are 9 / 11 bytes */
+#define SWAU_REPLY_MS       500u            /* WAITING_TIME_MS */
+#define SWAU_POLL_MS        1u
+#define SWAU_UP             0u
+#define SWAU_DOWN           1u
+
+#define SWAU_CMD_GET_DSP_STATE 233u
+#define SWAU_CMD_BIND2         271u
+#define SWAU_SINK_SPEAKER      0u
+#define SWAU_SRC_EP0           0u
+
+enum {
+	SWAU_OK = 0, SWAU_E_ARGS, SWAU_E_READ, SWAU_E_SVC, SWAU_E_FULL, SWAU_E_WRITE, SWAU_E_RING, SWAU_E_TIMEOUT, SWAU_E_AOCERR,
+	SWAU_E_SHORT, SWAU_E_UNKNOWN, SWAU_E_REJECTED, SWAU_E_CORRUPT, SWAU_NSTOP
+};
+static const char *const swau_stop_name[SWAU_NSTOP] = { "ok", "bad-args", "read-failed", "bad-service-header", "queue-full",
+	"write-failed", "doorbell-failed", "reply-timeout", "aoc-error-code", "short-reply", "unknown-reply", "rejected",
+	"queue-counters-corrupt" };
+
+struct swau_bus {
+	int (*ir32)(void *ctx, uint32_t off, uint32_t *v);      /* IPC window word (offset from ipc_base); 1 ok */
+	int (*iw32)(void *ctx, uint32_t off, uint32_t v);
+	void (*isync)(void *ctx);                               /* write barrier */
+	int (*doorbell)(void *ctx, uint32_t irq);               /* AOC mailbox INTGR0 := 1 << irq; 1 ok */
+	void (*sleep_ms)(void *ctx, uint32_t ms);
+	void (*say)(void *ctx, const char *what);
+	void *ctx;
+};
+
+struct swau_region { uint32_t base, offset, size, slots, tx, rx, wp, rp; };
+
+struct swau_svc {
+	uint32_t hdr;                   /* ipc offset of the service header */
+	uint32_t flags, irq;
+	struct swau_region r[2];
+};
+
+/* one exchange, for the log line of the glue */
+struct swau_x {
+	uint16_t id;
+	uint8_t cntr, sent_len;
+	uint32_t drained, waited_ms, reply_len, aoc_err;
+	int16_t reply;
+	uint8_t reply_type;
+	uint16_t reply_id;
+	uint8_t payload0;               /* first payload byte of the reply (GET_DSP_STATE: mode) */
+	uint8_t written;                /* the message may have reached the AOC (write started) */
+	int rc;
+};
+
+#define SWAU_NX 3
+struct swau_res {
+	struct swau_svc s;
+	struct swau_x x[SWAU_NX];
+	uint32_t nx, bound, unbound, dsp_mode;
+	uint8_t cntr;
+	int rc;
+};
+
+static int
+swau_region_read(const struct swau_bus *b, struct swau_region *g)
+{
+	return b->ir32(b->ctx, g->base + 0u, &g->offset) && b->ir32(b->ctx, g->base + 4u, &g->size) &&
+	       b->ir32(b->ctx, g->base + 8u, &g->slots) && b->ir32(b->ctx, g->base + 12u, &g->tx) &&
+	       b->ir32(b->ctx, g->base + 16u, &g->rx) && b->ir32(b->ctx, g->base + 20u, &g->wp) && b->ir32(b->ctx, g->base + 24u, &g->rp);
+}
+
+/* the counters only (tx, rx, wp, rp) */
+static int
+swau_counters(const struct swau_bus *b, struct swau_region *g)
+{
+	return b->ir32(b->ctx, g->base + 12u, &g->tx) && b->ir32(b->ctx, g->base + 16u, &g->rx) &&
+	       b->ir32(b->ctx, g->base + 20u, &g->wp) && b->ir32(b->ctx, g->base + 24u, &g->rp);
+}
+
+/* the service header of service `idx` (A8 table): a queue, both regions inside the window, word aligned, sane sizes */
+static int
+swau_svc_open(const struct swau_bus *b, struct swau_svc *s, uint32_t services_offset, uint32_t service_size, uint32_t idx)
+{
+	uint32_t i, end;
+
+	*s = (struct swau_svc){ 0 };
+	if (service_size < 32u + 4u + 56u || services_offset >= SWAU_IPC_LEN || idx >= 200u) {
+		return SWAU_E_ARGS;
+	}
+	s->hdr = services_offset + idx * service_size;
+	if (s->hdr > SWAU_IPC_LEN - (32u + 4u + 56u) || (s->hdr & 3u)) {
+		return SWAU_E_SVC;
+	}
+	if (!b->ir32(b->ctx, s->hdr + 32u, &s->flags)) {
+		return SWAU_E_READ;
+	}
+	if (((s->flags >> 16) & 7u) != 0u) {
+		return SWAU_E_SVC;      /* not a queue */
+	}
+	s->irq = (s->flags >> 19) & 0x1Fu;
+	if (s->irq > 15u) {
+		return SWAU_E_SVC;      /* 16 AOC mailbox channels (gs101-aoc.dtsi:9-19) */
+	}
+	for (i = 0; i < 2u; i++) {
+		s->r[i].base = s->hdr + 36u + 28u * i;
+		if (!swau_region_read(b, &s->r[i])) {
+			return SWAU_E_READ;
+		}
+		if (s->r[i].slots == 0u || s->r[i].slots > 256u || s->r[i].size <= SWAU_HDR || s->r[i].size > SWAU_MAX_SLOT ||
+		    (s->r[i].size & 3u) || (s->r[i].offset & 3u) || s->r[i].offset >= SWAU_IPC_LEN) {
+			return SWAU_E_SVC;
+		}
+		end = s->r[i].offset + s->r[i].size * s->r[i].slots;
+		if (end > SWAU_IPC_LEN || end < s->r[i].offset) {
+			return SWAU_E_SVC;
+		}
+	}
+	return SWAU_OK;
+}
+
+/* messages waiting in region g (tx - rx as aoc_ipc_core.c _read_write_delta for the non-wrapped case); > slots = corrupt */
+static int
+swau_pending(const struct swau_region *g, uint32_t *n)
+{
+	*n = g->tx - g->rx;
+	return *n <= g->slots ? SWAU_OK : SWAU_E_CORRUPT;
+}
+
+static int
+swau_write(const struct swau_bus *b, struct swau_svc *s, const uint8_t *msg, uint32_t len)
+{
+	struct swau_region *g = &s->r[SWAU_DOWN];
+	uint32_t n, slot, i, w;
+
+	if (len == 0u || len > g->size - SWAU_HDR || len > SWAU_MAX_MSG) {
+		return SWAU_E_ARGS;
+	}
+	if (!swau_counters(b, g)) {
+		return SWAU_E_READ;
+	}
+	if (swau_pending(g, &n) != SWAU_OK) {
+		return SWAU_E_CORRUPT;
+	}
+	if (n >= g->slots) {
+		return SWAU_E_FULL;
+	}
+	slot = g->offset + g->size * (g->tx % g->slots);
+	if (!b->iw32(b->ctx, slot + 0u, len & 0xFFFFu) || !b->iw32(b->ctx, slot + 4u, 0u)) {
+		return SWAU_E_WRITE;
+	}
+	for (i = 0; i < len; i += 4u) {
+		w = 0;
+		for (n = 0; n < 4u && i + n < len; n++) {
+			w |= (uint32_t)msg[i + n] << (8u * n);
+		}
+		if (!b->iw32(b->ctx, slot + SWAU_HDR + i, w)) {
+			return SWAU_E_WRITE;
+		}
+	}
+	b->isync(b->ctx);
+	if (!b->iw32(b->ctx, g->base + 12u, g->tx + 1u) || !b->iw32(b->ctx, g->base + 20u, (g->wp + 1u) % g->size)) {
+		return SWAU_E_WRITE;
+	}
+	b->isync(b->ctx);
+	return b->doorbell(b->ctx, s->irq) ? SWAU_OK : SWAU_E_RING;
+}
+
+/* one message from AOC_UP: 1 = got one (len set), 0 = none, < 0 = -error */
+static int
+swau_read(const struct swau_bus *b, struct swau_svc *s, uint8_t *buf, uint32_t cap, uint32_t *len)
+{
+	struct swau_region *g = &s->r[SWAU_UP];
+	uint32_t n, slot, i, k, w = 0, h0 = 0;
+
+	if (!swau_counters(b, g)) {
+		return -SWAU_E_READ;
+	}
+	if (swau_pending(g, &n) != SWAU_OK) {
+		return -SWAU_E_CORRUPT;
+	}
+	if (n == 0u) {
+		return 0;
+	}
+	slot = g->offset + g->size * (g->rx % g->slots);
+	if (!b->ir32(b->ctx, slot, &h0)) {
+		return -SWAU_E_READ;
+	}
+	*len = h0 & 0xFFFFu;
+	if (*len > g->size - SWAU_HDR) {
+		return -SWAU_E_CORRUPT;
+	}
+	for (i = 0; i < *len && i < cap; i += 4u) {
+		if (!b->ir32(b->ctx, slot + SWAU_HDR + i, &w)) {
+			return -SWAU_E_READ;
+		}
+		for (k = 0; k < 4u && i + k < *len && i + k < cap; k++) {
+			buf[i + k] = (uint8_t)(w >> (8u * k));
+		}
+	}
+	if (!b->iw32(b->ctx, g->base + 16u, g->rx + 1u) || !b->iw32(b->ctx, g->base + 24u, (g->rp + 1u) % g->size)) {
+		return -SWAU_E_WRITE;
+	}
+	b->isync(b->ctx);
+	if (n == g->slots && !b->doorbell(b->ctx, s->irq)) {
+		return -SWAU_E_RING;            /* it was full: tell the AOC there is room (aoc_service_core.c:504-511) */
+	}
+	return 1;
+}
+
+static void
+swau_hdr(uint8_t *m, uint8_t cntr, uint16_t len, uint16_t id)
+{
+	m[0] = 0u;              /* DATA_TYPE_CMD */
+	m[1] = cntr;
+	m[2] = (uint8_t)len;
+	m[3] = (uint8_t)(len >> 8);
+	m[4] = (uint8_t)id;
+	m[5] = (uint8_t)(id >> 8);
+	m[6] = 0u;
+	m[7] = 0u;
+}
+
+/* one command, the stock exchange; x records it */
+static int
+swau_cmd(const struct swau_bus *b, struct swau_res *r, const uint8_t *m, uint32_t len)
+{
+	struct swau_x *x = &r->x[r->nx < SWAU_NX ? r->nx : SWAU_NX - 1u];
+	uint8_t rb[SWAU_MAX_MSG];
+	uint32_t ms, rl = 0, i;
+	int g;
+
+	if (r->nx < SWAU_NX) {
+		r->nx++;
+	}
+	*x = (struct swau_x){ 0 };
+	x->id = (uint16_t)(m[4] | m[5] << 8);
+	x->cntr = m[1];
+	x->sent_len = (uint8_t)len;
+	for (i = 0; i <= r->s.r[SWAU_UP].slots; i++) {          /* drain stale replies (aoc_alsa_hw.c:236-245), bounded by the slots */
+		g = swau_read(b, &r->s, rb, sizeof(rb), &rl);
+		if (g < 0) {
+			return x->rc = -g;
+		}
+		if (g == 0) {
+			break;
+		}
+		x->drained++;
+	}
+	x->rc = swau_write(b, &r->s, m, len);
+	x->written = x->rc == SWAU_OK || x->rc == SWAU_E_WRITE || x->rc == SWAU_E_RING;
+	if (x->rc != SWAU_OK) {
+		return x->rc;
+	}
+	for (ms = 0;; ms += SWAU_POLL_MS) {
+		g = swau_read(b, &r->s, rb, sizeof(rb), &rl);
+		if (g < 0) {
+			return x->rc = -g;
+		}
+		if (g == 1 || ms >= SWAU_REPLY_MS) {
+			break;
+		}
+		b->sleep_ms(b->ctx, SWAU_POLL_MS);
+	}
+	x->waited_ms = ms;
+	if (g != 1) {
+		return x->rc = SWAU_E_TIMEOUT;
+	}
+	x->reply_len = rl;
+	if (rl == 4u) {
+		x->aoc_err = (uint32_t)rb[0] | (uint32_t)rb[1] << 8 | (uint32_t)rb[2] << 16 | (uint32_t)rb[3] << 24;
+		return x->rc = SWAU_E_AOCERR;
+	}
+	if (rl < 8u || rl > sizeof(rb)) {
+		return x->rc = SWAU_E_SHORT;
+	}
+	x->reply_type = rb[0];
+	x->reply_id = (uint16_t)(rb[4] | rb[5] << 8);
+	x->reply = (int16_t)(uint16_t)(rb[6] | rb[7] << 8);
+	x->payload0 = rl > 8u ? rb[8] : 0u;
+	if (x->reply_type != 0u || x->reply_id != x->id || rl != len) {
+		return x->rc = SWAU_E_UNKNOWN;
+	}
+	if (x->reply != 0) {
+		return x->rc = SWAU_E_REJECTED;
+	}
+	return x->rc = SWAU_OK;
+}
+
+static int
+swau_get_dsp_state(const struct swau_bus *b, struct swau_res *r)
+{
+	uint8_t m[9];
+
+	swau_hdr(m, r->cntr++, sizeof(m), SWAU_CMD_GET_DSP_STATE);
+	m[8] = 0u;
+	return swau_cmd(b, r, m, sizeof(m));
+}
+
+static int
+swau_bind2(const struct swau_bus *b, struct swau_res *r, uint8_t bind)
+{
+	uint8_t m[11];
+
+	swau_hdr(m, r->cntr++, sizeof(m), SWAU_CMD_BIND2);
+	m[8] = SWAU_SRC_EP0;
+	m[9] = SWAU_SINK_SPEAKER;
+	m[10] = bind;
+	return swau_cmd(b, r, m, sizeof(m));
+}
+
+/* open: service header, GET_DSP_STATE, BIND2 bind = 1. After a BIND2 bind = 1 was WRITTEN (whatever the reply), r->bound = 1 and
+ * the caller must call swau_close on every path. */
+static int
+swau_open(const struct swau_bus *b, struct swau_res *r, uint32_t services_offset, uint32_t service_size, uint32_t ctl_index)
+{
+	*r = (struct swau_res){ 0 };
+	b->say(b->ctx, "audio_output_control: service header (queue, regions inside the window)");
+	r->rc = swau_svc_open(b, &r->s, services_offset, service_size, ctl_index);
+	if (r->rc != SWAU_OK) {
+		return r->rc;
+	}
+	b->say(b->ctx, "cmd 233 GET_DSP_STATE (read only)");
+	r->rc = swau_get_dsp_state(b, r);
+	if (r->rc != SWAU_OK) {
+		return r->rc;
+	}
+	r->dsp_mode = r->x[0].payload0;
+	b->say(b->ctx, "cmd 271 BIND2 src 0 dst 0 (SINK_SPEAKER = TDM_0_RX) bind 1");
+	r->rc = swau_bind2(b, r, 1u);
+	r->bound = r->x[1].written;     /* the message may have reached the AOC: undo it */
+
+	return r->rc;
+}
+
+/* undo: BIND2 bind = 0 once, if a bind = 1 may have reached the AOC */
+static int
+swau_close(const struct swau_bus *b, struct swau_res *r)
+{
+	if (!r->bound || r->unbound) {
+		return SWAU_OK;
+	}
+	b->say(b->ctx, "cmd 271 BIND2 src 0 dst 0 bind 0 (undo)");
+	r->unbound = 1;
+	return swau_bind2(b, r, 0u);
+}
+
+#endif /* SWEET_AUDIO_H */
diff --git a/bsd/dev/sweet_cs_dsp.h b/bsd/dev/sweet_cs_dsp.h
new file mode 100644
index 0000000..f073861
--- /dev/null
+++ b/bsd/dev/sweet_cs_dsp.h
@@ -0,0 +1,194 @@
+/*
+ * CS35L41 HALO firmware file parser (patch 0378, plan A9c, PARSER ONLY: nothing in the kernel includes it yet; host test
+ * shim/aoc_audio_host_test.c runs it on the stock files when present). It walks a .wmfw and a .bin exactly as Linux v6.18 does and lists
+ * what the loader would write; it writes nothing.
+ * Sources (linux-v6.18 7d0a66e4bb90, $A/research-src/linux-v6.18): drivers/firmware/cirrus/cs_dsp.c cs_dsp_load :1477-1648 (wmfw, regions unpadded :1629),
+ * cs_dsp_load_coeff :2163-2356 (bin, blocks 4-byte aligned :2337), cs_dsp_halo_validate_version :1467-1475 (ver 3), cs_dsp_adsp2_parse_sizes :1433-1451 (16 bytes of sizes),
+ * cs_dsp_halo_region_to_reg :595-612 (XM/YM unpacked: base + 4 * off; XM/YM packed: (base + 3 * off) & ~3; PM packed: base + 5 * off);
+ * include/linux/firmware/cirrus/wmfw.h (wmfw_header 12 bytes {magic, le32 len, le16 rev, u8 core, u8 ver}, wmfw_adsp2_sizes 16, wmfw_footer 12,
+ * wmfw_region {u32 type/offset, le32 len, data}: offset = le32 & 0xFFFFFF, type = be32 & 0xFF i.e. the top byte; wmfw_coeff_hdr {magic, le32 len,
+ * be32 rev, le32 core_ver}, wmfw_coeff_item 20 bytes {le16 offset, le16 type, le32 id, ver, sr, len}; WMFW_HALO 4, region types);
+ * sound/soc/codecs/cs35l41-lib.c:1409-1415 the CS35L41 regions (include/sound/cs35l41.h: PM 0x3800000, XM packed 0x2000000, YM packed 0x2C00000,
+ * XM unpacked24 0x2800000, YM unpacked24 0x3400000).
+ * A bin block of an XM/YM/PM type is relative to an algorithm's base, which Linux reads back from the running core (cs_dsp_halo_setup_algs);
+ * the parser reports those as "alg-relative" (reg 0), absolute blocks with their register.
+ */
+#ifndef SWEET_CS_DSP_H
+#define SWEET_CS_DSP_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#define SWCD_HALO           4u
+#define SWCD_ABSOLUTE       0xF0u
+#define SWCD_ALGORITHM_DATA 0xF2u
+#define SWCD_METADATA       0xFCu
+#define SWCD_NAME_TEXT      0xFEu
+#define SWCD_INFO_TEXT      0xFFu
+#define SWCD_ADSP2_XM       5u
+#define SWCD_ADSP2_YM       6u
+#define SWCD_PM_PACKED      0x10u
+#define SWCD_XM_PACKED      0x11u
+#define SWCD_YM_PACKED      0x12u
+#define SWCD_PM_BASE        0x03800000u
+#define SWCD_XM_PACK_BASE   0x02000000u
+#define SWCD_YM_PACK_BASE   0x02C00000u
+#define SWCD_XM_UNP_BASE    0x02800000u
+#define SWCD_YM_UNP_BASE    0x03400000u
+#define SWCD_MAX_REGIONS    256u
+
+enum { SWCD_OK = 0, SWCD_E_SHORT, SWCD_E_MAGIC, SWCD_E_VERSION, SWCD_E_CORE, SWCD_E_LEN, SWCD_E_OVERFLOW, SWCD_E_TYPE, SWCD_E_MANY };
+
+struct swcd_item { uint32_t type, offset, len, pos, reg, id; };
+struct swcd_file {
+	uint32_t ver, core, rev, hdr_len, nitems, write_bytes, alg_relative, text_items, odd_len;
+	uint32_t sizes[4];                      /* wmfw: xm, ym, pm, zm */
+	uint64_t timestamp;
+	struct swcd_item it[SWCD_MAX_REGIONS];
+};
+
+static uint32_t swcd_le32(const uint8_t *p) { return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24; }
+static uint32_t swcd_le16(const uint8_t *p) { return (uint32_t)p[0] | (uint32_t)p[1] << 8; }
+
+/* cs_dsp_halo_region_to_reg + cs35l41_dsp1_regions; 0 = not a memory region */
+static uint32_t
+swcd_region_to_reg(uint32_t type, uint32_t off)
+{
+	switch (type) {
+	case SWCD_ADSP2_XM: return SWCD_XM_UNP_BASE + off * 4u;
+	case SWCD_ADSP2_YM: return SWCD_YM_UNP_BASE + off * 4u;
+	case SWCD_XM_PACKED: return (SWCD_XM_PACK_BASE + off * 3u) & ~3u;
+	case SWCD_YM_PACKED: return (SWCD_YM_PACK_BASE + off * 3u) & ~3u;
+	case SWCD_PM_PACKED: return SWCD_PM_BASE + off * 5u;
+	default: return 0u;
+	}
+}
+
+static int
+swcd_wmfw(const uint8_t *d, size_t n, struct swcd_file *f)
+{
+	size_t pos;
+	uint32_t len, type, off;
+
+	*f = (struct swcd_file){ 0 };
+	if (n <= 12u) {
+		return SWCD_E_SHORT;
+	}
+	if (d[0] != 'W' || d[1] != 'M' || d[2] != 'F' || d[3] != 'W') {
+		return SWCD_E_MAGIC;
+	}
+	f->hdr_len = swcd_le32(d + 4);
+	f->rev = swcd_le16(d + 8);
+	f->core = d[10];
+	f->ver = d[11];
+	if (f->ver != 3u) {
+		return SWCD_E_VERSION;
+	}
+	if (f->core != SWCD_HALO) {
+		return SWCD_E_CORE;
+	}
+	if (n < 12u + 16u + 12u) {
+		return SWCD_E_OVERFLOW;
+	}
+	for (pos = 0; pos < 4u; pos++) {
+		f->sizes[pos] = swcd_le32(d + 12u + 4u * pos);
+	}
+	f->timestamp = (uint64_t)swcd_le32(d + 28) | (uint64_t)swcd_le32(d + 32) << 32;
+	pos = 12u + 16u + 12u;
+	if (f->hdr_len != pos) {
+		return SWCD_E_LEN;
+	}
+	while (pos < n) {
+		if (n - pos < 8u) {
+			return SWCD_E_OVERFLOW;
+		}
+		len = swcd_le32(d + pos + 4u);
+		if (len > n - pos - 8u) {
+			return SWCD_E_OVERFLOW;
+		}
+		off = swcd_le32(d + pos) & 0xFFFFFFu;
+		type = d[pos + 3u];             /* be32 type & 0xff = the 4th byte */
+		if (f->nitems >= SWCD_MAX_REGIONS) {
+			return SWCD_E_MANY;
+		}
+		f->it[f->nitems] = (struct swcd_item){ type, off, len, (uint32_t)pos, 0u, 0u };
+		switch (type) {
+		case SWCD_INFO_TEXT: case SWCD_NAME_TEXT: case SWCD_ALGORITHM_DATA: case SWCD_METADATA:
+			f->text_items++;
+			break;
+		case SWCD_ABSOLUTE:
+			f->it[f->nitems].reg = off;
+			break;
+		case SWCD_ADSP2_XM: case SWCD_ADSP2_YM: case SWCD_PM_PACKED: case SWCD_XM_PACKED: case SWCD_YM_PACKED:
+			f->it[f->nitems].reg = swcd_region_to_reg(type, off);
+			break;
+		default:
+			return SWCD_E_TYPE;     /* Linux warns and skips; a stock file has none, so unknown = stop here */
+		}
+		if (f->it[f->nitems].reg) {
+			f->write_bytes += len;
+			f->odd_len += (len & 3u) != 0u;
+		}
+		f->nitems++;
+		pos += 8u + len;
+	}
+	return SWCD_OK;
+}
+
+static int
+swcd_bin(const uint8_t *d, size_t n, struct swcd_file *f)
+{
+	size_t pos;
+	uint32_t len, type, off;
+
+	*f = (struct swcd_file){ 0 };
+	if (n <= 16u) {
+		return SWCD_E_SHORT;
+	}
+	if (d[0] != 'W' || d[1] != 'M' || d[2] != 'D' || d[3] != 'R') {
+		return SWCD_E_MAGIC;
+	}
+	f->hdr_len = swcd_le32(d + 4);
+	f->rev = (uint32_t)d[8] << 24 | (uint32_t)d[9] << 16 | (uint32_t)d[10] << 8 | d[11];        /* be32 */
+	f->ver = swcd_le32(d + 12);
+	if ((f->rev & 0xFFu) != 1u && (f->rev & 0xFFu) != 2u) {
+		return SWCD_E_VERSION;
+	}
+	if (f->hdr_len < 16u || f->hdr_len > n) {
+		return SWCD_E_LEN;
+	}
+	pos = f->hdr_len;
+	while (pos < n) {
+		if (n - pos < 20u) {
+			return SWCD_E_OVERFLOW;
+		}
+		len = swcd_le32(d + pos + 16u);
+		if (len > n - pos - 20u) {
+			return SWCD_E_OVERFLOW;
+		}
+		off = swcd_le16(d + pos);
+		type = swcd_le16(d + pos + 2u);
+		if (f->nitems >= SWCD_MAX_REGIONS) {
+			return SWCD_E_MANY;
+		}
+		f->it[f->nitems] = (struct swcd_item){ type, off, len, (uint32_t)pos, 0u, swcd_le32(d + pos + 4u) };
+		if (type == SWCD_NAME_TEXT << 8 || type == SWCD_INFO_TEXT << 8 || type == SWCD_METADATA << 8) {
+			f->text_items++;
+		} else if (type == SWCD_ABSOLUTE << 8) {
+			f->it[f->nitems].reg = off;     /* "register" (the fw_id / offset 0 global-coefficient case aside) */
+			f->write_bytes += len;
+		} else if (type == SWCD_ADSP2_XM || type == SWCD_ADSP2_YM || type == SWCD_XM_PACKED || type == SWCD_YM_PACKED ||
+		    type == SWCD_PM_PACKED) {
+			f->alg_relative++;              /* reg = alg base (from the running core) + offset */
+			f->write_bytes += len;
+		} else {
+			return SWCD_E_TYPE;
+		}
+		f->odd_len += (len & 3u) != 0u && type != SWCD_NAME_TEXT << 8 && type != SWCD_INFO_TEXT << 8 && type != SWCD_METADATA << 8;
+		f->nitems++;
+		pos += (20u + len + 3u) & ~3u;     /* blocks are 4-byte aligned (cs_dsp.c:2337) */
+	}
+	return SWCD_OK;
+}
+
+#endif /* SWEET_CS_DSP_H */

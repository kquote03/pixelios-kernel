+/* ---- A9b run (patch 0378): called by amp_init_run between the init of both amps and the restore, only when the AOC glue armed amp_a9_cb ---- */
+struct amp_a9_cb { int on; int (*open)(void *ctx); void (*close)(void *ctx); void *ctx; };
+static struct amp_a9_cb amp_a9_cb;
+struct amp_a9_side { int cfg, locked, unlock, gen, err; unsigned writes, skipped, polls; uint32_t st1, st3, pwr1; };
+static struct amp_a9_res { int ran, opened; struct amp_a9_side a[2]; } amp_a9_res;
+
+/* one row: read, merge, write only if it changes (regmap_update_bits; a plain write row always writes), read back the field.
+ * IRQ1_STATUS3 (write-1-to-clear) is not compared after its write. */
+static int amp_a9_write(const struct amp_snap *s, int cs, uint32_t idx, struct amp_a9_side *d)
+{
+	const struct amp_a9_row *t = &amp_a9_tab[idx];
+	uint32_t old = 0, v, rb = 0;
+	int e = amp_read(s, cs, t->reg, &old);
+
+	if (e != AMP_OK)
+		return e;
+	v = (old & ~t->mask) | t->field;
+	if (t->mask != 0xFFFFFFFFu && v == old) {
+		d->skipped++;
+		return AMP_OK;
+	}
+	amp_a9.on = 1;
+	amp_a9.idx = idx;
+	amp_a9.old = old;
+	e = amp_write(s, cs, t->reg, v);
+	amp_a9.on = 0;
+	amp_a9.idx = 0;
+	amp_a9.old = 0;
+	d->writes++;
+	if (e == AMP_OK && t->reg != AMP_REG_IRQ1_STATUS3) {
+		e = amp_read(s, cs, t->reg, &rb);
+		if (e == AMP_OK && (rb & t->mask) != t->field)
+			e = AMP_ERROR;
+	}
+	return e;
+}
+
+static void amp_a9_line(const char *name, const char *what, const struct amp_a9_side *d)
+{
+	char line[RAMLOG_LINE_MAX];
+	unsigned p = put_txt(line, sizeof(line), 0, name);
+
+	p = put_txt(line, sizeof(line), p, what);
+	p = put_txt(line, sizeof(line), p, " w=");
+	p = put_dec(line, sizeof(line), p, d->writes);
+	p = put_txt(line, sizeof(line), p, " skip=");
+	p = put_dec(line, sizeof(line), p, d->skipped);
+	p = put_txt(line, sizeof(line), p, " pwr1=");
+	p = put_hex(line, sizeof(line), p, d->pwr1, 8);
+	p = put_txt(line, sizeof(line), p, " st1=");
+	p = put_hex(line, sizeof(line), p, d->st1, 8);
+	p = put_txt(line, sizeof(line), p, " st3=");
+	p = put_hex(line, sizeof(line), p, d->st3, 8);
+	p = put_txt(line, sizeof(line), p, " polls=");
+	p = put_dec(line, sizeof(line), p, d->polls);
+	emit("AMP", line, p);
+}
+
+/* the rows in order; before: IRQ1_STATUS1 error bits 0 and GLOBAL_EN 0; after: GLOBAL_EN still 0 */
+static int amp_a9_cfg(const struct amp_snap *s, int cs, const char *name, struct amp_a9_side *d)
+{
+	int e = amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1);
+
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_REG_PWR_CTRL1, &d->pwr1);
+	if (e == AMP_OK && ((d->st1 & AMP_ERR_BITS) || (d->pwr1 & AMP_GLOBAL_EN))) {
+		say(name, " a9: error bit or GLOBAL_EN set before the TDM config: no write (H8)");
+		e = AMP_ERROR;
+	}
+	for (uint32_t i = 0; e == AMP_OK && i < AMP_A9_N; i++)
+		e = amp_a9_write(s, cs, i, d);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_REG_PWR_CTRL1, &d->pwr1);
+	if (e == AMP_OK && (d->pwr1 & AMP_GLOBAL_EN))
+		e = AMP_ERROR;
+	d->cfg = e == AMP_OK;
+	amp_a9_line(name, d->cfg ? " a9 cfg ok" : " a9 cfg FAILED", d);
+	return e;
+}
+
+/* after the AOC open: PLL_LOCK in IRQ1_STATUS3, <= AMP_A9_PLL_POLLS x 1 ms; then IRQ1_STATUS1 and PWR_CTRL1 (reads only) */
+static void amp_a9_pll(const struct amp_snap *s, int cs, const char *name, struct amp_a9_side *d)
+{
+	int e = AMP_OK;
+
+	for (d->polls = 0; e == AMP_OK && d->polls < AMP_A9_PLL_POLLS && !d->locked; d->polls++) {
+		if (wait_ms(1u))
+			e = AMP_TIMEOUT;
+		if (e == AMP_OK)
+			e = amp_read(s, cs, AMP_REG_IRQ1_STATUS3, &d->st3);
+		d->locked = e == AMP_OK && (d->st3 & AMP_PLL_LOCK);
+	}
+	d->unlock = (d->st3 & AMP_PLL_UNLOCK) != 0u;
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_REG_PWR_CTRL1, &d->pwr1);
+	d->err = e != AMP_OK || (d->st1 & AMP_ERR_BITS);
+	d->gen = e != AMP_OK || (d->pwr1 & AMP_GLOBAL_EN);
+	amp_a9_line(name, d->locked ? " a9 pll locked" : " a9 pll NOT locked", d);
+	if (d->err)
+		say(name, " !!! a9: amp error bit or read failure after the TDM open (H8)");
+}
+
+static void amp_a9_part(const struct amp_snap *s, int il, int ir)
+{
+	amp_a9_res = (struct amp_a9_res){ 0 };
+	amp_a9_res.ran = 1;
+	if (il != AMP_OK || ir != AMP_OK) {
+		say("a9: ", "init not ok on both amps: no TDM config, no AOC open");
+		return;
+	}
+	if (amp_a9_cfg(s, 0, "L", &amp_a9_res.a[0]) != AMP_OK || amp_a9_cfg(s, 1, "R", &amp_a9_res.a[1]) != AMP_OK)
+		return;
+	amp_a9_res.opened = amp_a9_cb.open(amp_a9_cb.ctx);
+	if (amp_a9_res.opened) {
+		amp_a9_pll(s, 0, "L", &amp_a9_res.a[0]);
+		amp_a9_pll(s, 1, "R", &amp_a9_res.a[1]);
+	}
+	amp_a9_cb.close(amp_a9_cb.ctx);		/* undo the AOC bind on every path after an open attempt (the glue knows if it was sent) */
+}
+
 static int amp_init_run(void)
 {
 	struct amp_snap s = { 0 };
@@ -1106,6 +1293,8 @@ static int amp_init_run(void)
 		if (il == AMP_OK && AMP_ID_OK(er, r))	/* review F4: no R write after a failed L init */
 			ir = amp_init(&s, 1, "R");
 	}
+	if (amp_a9_cb.on && e == AMP_OK)
+		amp_a9_part(&s, il, ir);	/* patch 0378 (sweetaoc=4): TDM config, AOC open, PLL lock, AOC close; then the same restore */
 
 	/* ALWAYS put everything back (a write was attempted on every path that reaches here) */
 	restored = restore(&s, stage);

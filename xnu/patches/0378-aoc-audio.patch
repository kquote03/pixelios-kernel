 }
+/* patch 0378 (plan A9b, sweetaoc=4): the same identify + init + restore run, late, from the AOC audio step, with the A9 TDM config, the AOC open /
+ * close callbacks and the PLL lock read between the init and the restore (sweet_amp.h amp_a9_part). Needs the windows of the sweetamp=1 run above.
+ * Runs while the touch thread is up: gpp23 DAT is shared with the touch chip select (a GPIO, toggled by tg_pin_put of patch 0088 with a
+ * read-modify-write). A lost update either leaves the R reset low (the R identify then fails: no write) or re-drives the touch CS for one transfer
+ * (the next transfer drives it again); the restore compares only the amp bits. out[]: 0 run rc (0 = pass), 1 a9 ran, 2 AOC opened, 3/4 cfg L/R,
+ * 5/6 PLL locked L/R, 7 bits: 1 L error, 2 R error, 4 L GLOBAL_EN, 8 R GLOBAL_EN, 16 L PLL_UNLOCK, 32 R PLL_UNLOCK. */
+int sweet_amp_audio_run(int (*open)(void *), void (*close)(void *), void *ctx, uint32_t out[8]);
+int
+sweet_amp_audio_run(int (*open)(void *), void (*close)(void *), void *ctx, uint32_t out[8])
+{
+	unsigned i;
+	int rc;
+
+	for (i = 0; i < 8u; i++) {
+		out[i] = 0;
+	}
+	for (i = 0; i < SA_NWIN; i++) {
+		if (sa_win[i].va == NULL) {
+			printf("SWEET AMP: a9 refused: the sweetamp=1 windows are not mapped (boot-arg sweetamp=1 needed), not touched\n");
+			return -1;
+		}
+	}
+	printf("SWEET AMP: a9 run (sweetaoc=4): identify, init, TDM config, AOC open, PLL lock, AOC close, restore\n");
+	amp_a9_cb = (struct amp_a9_cb){ 1, open, close, ctx };
+	rc = amp_init_run();
+	amp_a9_cb = (struct amp_a9_cb){ 0 };
+	out[0] = (uint32_t)rc;
+	out[1] = (uint32_t)amp_a9_res.ran;
+	out[2] = (uint32_t)amp_a9_res.opened;
+	for (i = 0; i < 2u; i++) {
+		out[3 + i] = (uint32_t)amp_a9_res.a[i].cfg;
+		out[5 + i] = (uint32_t)amp_a9_res.a[i].locked;
+		out[7] |= (amp_a9_res.a[i].err ? 1u : 0u) << i | (amp_a9_res.a[i].gen ? 4u : 0u) << i | (amp_a9_res.a[i].unlock ? 16u : 0u) << i;
+	}
+	printf("SWEET AMP: a9 verdict run %s\n", rc == 0 ? "PASS" : "FAIL (see the AMP lines)");
+	return rc;
+}

+
+/* an A9 write is allowed only while its row is armed: same register, the mask's bits = the field, every other bit = the word read before */
+static inline __attribute__((always_inline)) int amp_a9_ok(uint32_t reg, uint32_t val)
+{
+	const struct amp_a9_row *t;
+
+	if (!amp_a9.on || amp_a9.idx >= AMP_A9_N || reg == AMP_REG_PWR_CTRL1)
+		return 0;
+	t = &amp_a9_tab[amp_a9.idx];
+	return reg == t->reg && (val & t->mask) == t->field && (val & ~t->mask) == (amp_a9.old & ~t->mask);
+}
+
+/* registers the A9 part reads: the rows' registers (read before each write and read back), PWR_CTRL1 (read only) */
+static inline __attribute__((always_inline)) int amp_a9_read_ok(uint32_t reg)
+{
+	return reg == 0x3810u || reg == 0x3814u || reg == 0x3808u || reg == 0x480Cu || reg == 0x6808u || reg == 0x4808u || reg == 0x2D10u ||
+	       reg == 0x2C04u || reg == 0x2C0Cu || reg == 0x4840u || reg == AMP_REG_PWR_CTRL1;
+}
+

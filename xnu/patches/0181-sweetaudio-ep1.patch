+		now = mach_absolute_time();
+		if (swau_dev_opens != seen) {             /* a new open: its detector window starts */
+			seen = swau_dev_opens;
+			up_at = now;
+		}
+		if (!st_det && swau_dev_opens == 0u && swau_ff.played >= 23000u && swau_amp_state == 1) {  /* end of self-test beep 1 */
+			st_det = 1;
+			(void)sweet_amp_srv(1, t);
+			swau_det_line("self-test beep 1", t);
+		}
+		if (swau_dev_writer == 1 && !swau_ses_det_ok && swau_amp_state == 1 && swau_ses_nz >= 14000u && now - up_at < SWAU_DET_WIN_MS * ms_per) {
+			swau_ses_det_ok = 1;
+			(void)sweet_amp_srv(1, swau_ses_det);
+			swau_det_line("user PCM", swau_ses_det);
+		}
+		if (!st_done && st >= SWAU_ST15_FRAMES && swau_dev_opens == 0u && swau_ff.played >= SWAU_ST15_FRAMES) {
+			st_done = 1;
+			(void)swau_counters(&ab, &swau_r.pb.g);
+			printf("SWEET AUDIO: a12: self-test played %llu frames through the FIFO (pcm bytes into the ring %u, AOC consumed %u bytes since up, "
+			    "underruns %u, resync %u)\n", swau_ff.played, swau_r.pb.pulled, swau_r.pb.g.rx - rx0, swau_ff.underruns, swau_r.pb.resync);
+		}
+		if (swau_r.pb.feed_err != errs0) {
+			errs0 = swau_r.pb.feed_err;
+			if (++bad >= 100u) {
+				printf("SWEET AUDIO: a12: AOC ring feed failing (%u errors), path down\n", swau_r.pb.feed_err);
+				break;
+			}
+		} else {
+			bad = 0;
+		}
+	}
+	lck_mtx_lock(&swau_dev_mtx);
+	swau_dev_down = 1;
+	lck_mtx_unlock(&swau_dev_mtx);
+	swau_r.pb.pull = NULL;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	(void)swau_counters(&ab, &swau_r.pb.g);
+	printf("SWEET AUDIO: a12: serve end (%s) after %llu ms: pcm bytes %u, AOC consumed %u bytes, opens %u, amp power-ups %u downs %u, resync %u; "
+	    "power-down follows\n", swau_stop_req ? "stop request" : "ring failure", ns / NSEC_PER_MSEC, swau_r.pb.pulled, swau_r.pb.g.rx - rx0,
+	    swau_dev_opens, ups, downs, swau_r.pb.resync);
+	return (unsigned)(ns / NSEC_PER_MSEC);
+}

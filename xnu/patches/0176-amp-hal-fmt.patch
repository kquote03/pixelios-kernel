diff --git a/bsd/dev/sweet_amp_pwr.h b/bsd/dev/sweet_amp_pwr.h
--- a/bsd/dev/sweet_amp_pwr.h
+++ b/bsd/dev/sweet_amp_pwr.h
@@ -315,6 +315,33 @@ static void amp_pwr_line(const char *name, const struct amp_pwr_side *d)
  * In the middle of the first beep of each phase and at the end: IRQ1_STATUS1..4 (0x10010..0x1001C) and IRQ1_RAW_STATUS1..4 (0x10090..0x1009C,
  * v6.18 cs35l41.h:118-131), DSP MBOX_2, DAC_PCM1_SRC of both amps. Ticks each ms; no other amp access. ---- */
 static int amp_pwr_diag;
+
+/* ---- patch 0176 (sweetaoc=10, amp_pwr_diag 2): what the stock HAL sets that the 0166 rows did not. Source: stock oriole vendor.img mixer
+ * paths (factory CP1A.260405.005, <mixer> defaults: "TDM_0_RX Chan" Four, "TDM_0_RX Format" S32_LE, "ASPRX1 Slot Position" 0, "ASPRX2 Slot
+ * Position" 1, "R ASPRX1 Slot Position" 1, "R ASPRX2 Slot Position" 0, "DSP RX2 Source" ASPRX1 (both), "AMP PCM Gain" 17 (both); path "speaker":
+ * "Boost Peak Current Limit" 1.70A, "R ..." 1.90A). S32_LE goes through the card fixup (aoc_alsa_card.c:344-380) into the codec
+ * pcm_hw_params: ASP_WIDTH_RX := physical width 32, ASP_RX_WL := min(32, 24) = 24 (AMP cs35l41.c:2725-2750); the 0166 rows had the S16_LE card
+ * default (16 / 16). Controls: slot positions SP_FRAME_RX_SLOT 0x4820 RX1 [0x3F], RX2 [0x3F00] (AMP cs35l41.c:1772-1775, v6.18 cs35l41.h:84,
+ * :635-638); DSP RX2 Source DSP1_RX2_SRC 0x4C44 [0x7F] := ASPRX1 0x08 (cs35l41.h:94, :645); AMP PCM Gain AMP_GAIN_CTRL 0x6C04 [0x3E0] := 17 << 5
+ * (AMP cs35l41.c:1762); boost peak BSTCVRT_PEAK_CUR 0x3808 [0x7F] := (mA - 1600) / 50 + 0x10 (the 0166 formula): 1700 -> 0x12, 1900 -> 0x16 (lower
+ * than the 0166 3500 mA). Written before GLOBAL_EN with SP_ENABLES off (from amp_a9_cfg); restore() resets both amps afterwards. ---- */
+static int amp_hal_rows(const struct amp_snap *s, int cs)
+{
+	int e = amp_pwr_rmw(s, cs, 0x4808u, 0xFF000000u, 0x20000000u, NULL);
+
+	if (e == AMP_OK)
+		e = amp_pwr_rmw(s, cs, 0x4840u, 0x3Fu, 24u, NULL);
+	if (e == AMP_OK)
+		e = amp_pwr_rmw(s, cs, 0x4820u, 0x3F3Fu, cs ? 0x0001u : 0x0100u, NULL);
+	if (e == AMP_OK)
+		e = amp_pwr_rmw(s, cs, 0x4C44u, 0x7Fu, 0x08u, NULL);
+	if (e == AMP_OK)
+		e = amp_pwr_rmw(s, cs, AMP_PWR_GAIN, 0x3E0u, 17u << 5, NULL);
+	if (e == AMP_OK)
+		e = amp_pwr_rmw(s, cs, 0x3808u, 0x7Fu, cs ? 0x16u : 0x12u, NULL);
+	say(cs ? "R" : "L", e == AMP_OK ? " a10d: HAL words ok (ASP 32/24, slots, DSP RX2 ASPRX1, gain 17, ipk)" : " a10d: HAL words FAILED");
+	return e;
+}

+/* patch 0176 (amp_pwr_diag 2): 1 s silence (snapshot S), pattern 4 on the DSP path (snapshot A in the first beep), 2 s gap (snapshot G),
+ * pattern 5 with the DSP bypassed (DAC_PCM1_SRC 0x08, snapshot B), back to 0x32, snapshot end. ~18.4 s, ticks each ms. */
+static unsigned amp_pwr_diag2_run(const struct amp_snap *s)
+{
+	unsigned ms = 0;
+	int cs;
+
+	ms += amp_pwr_diag_wait(1000u, s, "S", 900u);
+	con_str("SWEET", "AUDIO: pattern 4 starts now (3 x 2 s beeps, DSP path)");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 4);
+	ms += amp_pwr_diag_wait(9200u, s, "A", 1000u);
+	amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	ms += amp_pwr_diag_wait(AMP_DIAG_GAP_MS, s, "G", 1500u);
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, 0x08u, NULL);
+	con_str("SWEET", "AUDIO: pattern 5 starts now (2 x 2 s beeps, DSP bypassed)");
+	amp_a9_cb.tone(amp_a9_cb.ctx, 5);
+	ms += amp_pwr_diag_wait(6200u, s, "B", 1000u);
+	amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	for (cs = 0; cs < 2; cs++)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, AMP_PCMSRC_DSP, NULL);
+	amp_pwr_diag_snap(s, "end");
+	return ms;
+}

diff --git a/bsd/dev/sweet_aoc_load.c b/bsd/dev/sweet_aoc_load.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_aoc_load.c
@@ -0,0 +1,349 @@
+/*
+ * AOC firmware load (patch 0164, plan 2026-11-14 oneshot-2 step A6), boot-arg sweetaoc=2; without it nothing runs.
+ * Glue for the pure sequence in sweet_aoc_load.h (all cites there; host test shim/aoc_load_host_test.c):
+ *   - the image: /chosen/memory-map AOCFW <pa, size> (tools/mkpayload.py --aocfw, container tools/pack_aocfw.py), read through
+ *     ml_static_ptovirt like WLANFW (patch 0128); container magic/entry/CRC32 checked and the stated length + sha256 compared
+ *     with the pinned identity before inflating; the kernel zlib (libkern/zlib.h) inflates it in 64 KiB pieces with the
+ *     allocator of patch 0163 (the kernel zlib has no default one); swal_run inflates twice (identity, then copy).
+ *   - the wired header buffer: one kmem_alloc_contig page, KMA_PERMANENT (never freed: the GSA may read it late; pattern of
+ *     patches 0159/0162), cleaned to memory with flush_dcache64 before the doorbell (stock uses coherent DMA memory, aoc.c:441-470).
+ *   - windows: ml_io_map (device) for PMU / aoc_req / GSA mailbox (3 x 16 KiB of the io submap). The carveout: write-combined
+ *     (stock: devm_ioremap_wc, aoc.c:2614) through ml_io_map_unmappable = io_map(.., unmappable) from kernel_map, ONLY the
+ *     body extent, unmapped before the GSA call. Round 1 used ml_io_map_wcomb for all 48 MiB: that allocates from io_submap,
+ *     which is 8 MiB (IO_MAP_SIZE, osfmk/arm/io_map.c:65) with KMA_NOFAIL (:120-130), i.e. a panic in kmem_alloc that the
+ *     thread-based USB log cannot show (run o6-a6-aocload: silent stop right after the "pass 2" line); a dsb sy after every register write and after the carveout copy.
+ * Waits: the USB log (300 s, as patch 0161), 300 ms after each progress line, the GSA reply (10 s, 1 ms polls). No retry.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <vm/vm_kern.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <libkern/zlib.h>
+#include <vm/memory_types.h>             /* VM_MEM_* */
+#include <arm/memory_types.h>            /* VM_WIMG_WCOMB = VM_MEM_NOT_CACHEABLE | VM_MEM_COHERENT (0x6), :46 */
+#include <stdint.h>
+
+#include "sweet_aoc_load.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);           /* osfmk/arm/machine_routines.h, XNU-private */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);   /* osfmk/arm64/machine_routines.c:1574 */
+extern void ml_io_unmap(vm_offset_t, vm_size_t);
+extern vm_offset_t kvtophys(vm_offset_t);
+extern void flush_dcache64(addr64_t, unsigned, int);            /* osfmk/arm/caches_internal.h:43 */
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern volatile uint32_t sweet_usblog_sent;                     /* sweet_usb.c (patch 0161) */
+void sweet_aoc_load_start(void);
+
+#define SWAL_WAIT_USB_MS  300000u
+#define SWAL_SETTLE_MS    300u
+#define SWAL_CHUNK        (64u * 1024u)
+
+static const uint64_t swal_win_pa[SWAL_NWIN] = { SWAL_PMU_PA, SWAL_REQ_PA, SWAL_GSA_PA };
+static vm_offset_t swal_va[SWAL_NWIN], swal_carve_va;
+static vm_size_t swal_carve_maplen;
+static int swal_chan;
+
+static struct {
+	z_stream z;
+	int live, ended;
+	const uint8_t *in;
+	uint32_t inlen;
+} swal_zs;
+
+/* zlib allocator, as patch 0163 (sd_zalloc/sd_zfree) */
+static voidpf
+swal_zalloc(voidpf op __unused, uInt items, uInt size)
+{
+	uint64_t t = (uint64_t)items * size + 16;
+	uint64_t *p;
+
+	if (t > (1u << 20)) {
+		return Z_NULL;
+	}
+	p = kalloc_data((vm_size_t)t, Z_WAITOK | Z_ZERO);
+	if (!p) {
+		return Z_NULL;
+	}
+	p[0] = t;
+	return p + 2;
+}
+
+static void
+swal_zfree(voidpf op __unused, voidpf ptr)
+{
+	uint64_t *p = (uint64_t *)ptr - 2;
+	kfree_data(p, (vm_size_t)p[0]);
+}
+
+static int
+swal_src_open(__unused void *ctx)
+{
+	if (swal_zs.live) {
+		inflateEnd(&swal_zs.z);
+		swal_zs.live = 0;
+	}
+	memset(&swal_zs.z, 0, sizeof(swal_zs.z));
+	swal_zs.z.zalloc = swal_zalloc;
+	swal_zs.z.zfree = swal_zfree;
+	swal_zs.z.next_in = (Bytef *)(uintptr_t)swal_zs.in;
+	swal_zs.z.avail_in = swal_zs.inlen;
+	swal_zs.ended = 0;
+	if (inflateInit(&swal_zs.z) != Z_OK) {
+		return -1;
+	}
+	swal_zs.live = 1;
+	return 0;
+}
+
+/* Bounded: inflate returns Z_OK only after consuming input or producing output; no progress = error. Data after the
+ * end of the zlib stream is an error. */
+static int
+swal_src_next(__unused void *ctx, uint8_t *buf, uint32_t cap, uint32_t *n)
+{
+	uint32_t guard;
+	int zr;
+
+	*n = 0;
+	if (!swal_zs.live) {
+		return -1;
+	}
+	if (swal_zs.ended) {
+		return 0;
+	}
+	swal_zs.z.next_out = buf;
+	swal_zs.z.avail_out = cap;
+	for (guard = 0; swal_zs.z.avail_out != 0; guard++) {
+		uInt ai = swal_zs.z.avail_in, ao = swal_zs.z.avail_out;
+		if (guard >= (1u << 20)) {
+			return -1;
+		}
+		zr = inflate(&swal_zs.z, Z_NO_FLUSH);
+		if (zr == Z_STREAM_END) {
+			if (swal_zs.z.avail_in != 0) {
+				return -1;
+			}
+			swal_zs.ended = 1;
+			break;
+		}
+		if (zr != Z_OK || (ai == swal_zs.z.avail_in && ao == swal_zs.z.avail_out)) {
+			return -1;
+		}
+	}
+	*n = cap - swal_zs.z.avail_out;
+	return 0;
+}
+
+static int
+swal_map(int w)
+{
+	if (w < 0 || w >= SWAL_NWIN) {
+		return 0;
+	}
+	if (swal_va[w] == 0) {
+		swal_va[w] = ml_io_map((vm_offset_t)swal_win_pa[w], (vm_size_t)SWAL_WIN_LEN);
+	}
+	return swal_va[w] != 0;
+}
+
+static int
+swal_r32(__unused void *ctx, int w, uint32_t off, uint32_t *v)
+{
+	if ((off & 3u) || off > SWAL_WIN_LEN - 4u || !swal_map(w)) {
+		return 0;
+	}
+	*v = *(volatile uint32_t *)(swal_va[w] + off);
+	return 1;
+}
+
+static int
+swal_w32(__unused void *ctx, int w, uint32_t off, uint32_t v)
+{
+	if ((off & 3u) || off > SWAL_WIN_LEN - 4u || !swal_map(w)) {
+		return 0;
+	}
+	*(volatile uint32_t *)(swal_va[w] + off) = v;
+	__builtin_arm_dsb(0xF);
+	return 1;
+}
+
+static int
+swal_cmap(__unused void *ctx, uint64_t len)
+{
+	if (swal_carve_va != 0 || len == 0 || len > SWAL_CARVE_LEN) {
+		return 0;
+	}
+	swal_carve_maplen = round_page((vm_size_t)len);
+	swal_carve_va = ml_io_map_unmappable((vm_offset_t)SWAL_CARVE_PA, swal_carve_maplen, VM_WIMG_WCOMB);
+	return swal_carve_va != 0;
+}
+
+static void
+swal_cunmap(__unused void *ctx)
+{
+	if (swal_carve_va != 0) {
+		__builtin_arm_dsb(0xF);
+		ml_io_unmap(swal_carve_va, swal_carve_maplen);
+		swal_carve_va = 0;
+	}
+}
+
+static void
+swal_progress(void *ctx, const char *what, uint64_t a, uint64_t b);
+
+static int
+swal_cwrite(__unused void *ctx, uint64_t off, const uint8_t *p, uint32_t n)
+{
+	if (swal_carve_va == 0 || off > swal_carve_maplen || n > swal_carve_maplen - off) {
+		return 0;
+	}
+	memcpy((void *)(swal_carve_va + (vm_offset_t)off), p, n);
+	return 1;
+}
+
+static int
+swal_cread(__unused void *ctx, uint64_t off, uint8_t *p, uint32_t n)
+{
+	if (swal_carve_va == 0 || off > swal_carve_maplen || n > swal_carve_maplen - off) {
+		return 0;
+	}
+	memcpy(p, (const void *)(swal_carve_va + (vm_offset_t)off), n);
+	return 1;
+}
+
+static uint64_t swal_hdr_pa;
+
+static void
+swal_csync(__unused void *ctx)
+{
+	__builtin_arm_dsb(0xF);
+}
+
+static void
+swal_hflush(__unused void *ctx)
+{
+	flush_dcache64((addr64_t)swal_hdr_pa, SWAL_HDR_LEN, TRUE);
+	__builtin_arm_dsb(0xF);
+}
+
+static void
+swal_sleep_ms(__unused void *ctx, uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&swal_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+swal_progress(void *ctx, const char *what, uint64_t a, uint64_t b)
+{
+	printf("SWEET AOC: %s %#llx %#llx\n", what, a, b);
+	swal_sleep_ms(ctx, 100u);
+}
+
+static void
+swal_say(void *ctx, const char *what)
+{
+	printf("SWEET AOC: %s\n", what);
+	swal_sleep_ms(ctx, SWAL_SETTLE_MS);
+}
+
+static void
+swal_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static struct swal_res r;
+	static struct swal_bus b;
+	DTEntry mm;
+	void const *p = NULL;
+	unsigned int psize = 0;
+	uint64_t pa, len;
+	const uint8_t *z, *sha;
+	uint32_t zlen, usize, ms;
+	vm_offset_t hva = 0;
+	uint8_t *chunk;
+	const char *en;
+	int rc;
+
+	for (ms = 0; sweet_usblog_sent == 0 && ms < SWAL_WAIT_USB_MS; ms += 100u) {
+		swal_sleep_ms(NULL, 100);
+	}
+	printf("SWEET AOC: load start after %u ms (usb log %s); GSA command 90 only, no AOC start\n", ms, sweet_usblog_sent ? "up" : "NOT up");
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &mm) != kSuccess ||
+	    SecureDTGetProperty(mm, "AOCFW", &p, &psize) != kSuccess || psize != 2 * sizeof(uint64_t)) {
+		printf("SWEET AOC: load stop no-AOCFW (xrun --aocfw), nothing touched\n");
+		return;
+	}
+	memcpy(&pa, p, sizeof(pa));
+	memcpy(&len, (uint8_t const *)p + sizeof(pa), sizeof(len));
+	if (len < SWAL_C_HDR + SWAL_C_ENTRY || len > SWAL_C_MAX || pa + len < pa) {
+		printf("SWEET AOC: load stop AOCFW <%#llx, %#llx> out of bounds, nothing touched\n", pa, len);
+		return;
+	}
+	rc = swal_container((const uint8_t *)ml_static_ptovirt((vm_offset_t)pa), (size_t)len, &z, &zlen, &usize, &sha);
+	if (rc != 0 || usize != SWAL_FW_LEN || !swal_eq(sha, swal_fw_sha, 32)) {
+		printf("SWEET AOC: load stop container code %d usize %u (pinned %u), nothing touched\n", rc, usize, SWAL_FW_LEN);
+		return;
+	}
+	printf("SWEET AOC: AOCFW at %#llx, %llu bytes, zlib %u -> %u bytes, sha256 pinned\n", pa, len, zlen, usize);
+	if (kmem_alloc_contig(kernel_map, &hva, PAGE_SIZE, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS || hva == 0) {
+		printf("SWEET AOC: load stop no-memory, nothing touched\n");
+		return;
+	}
+	swal_hdr_pa = (uint64_t)kvtophys(hva);
+	printf("SWEET AOC: wired header page va %#lx pa %#llx\n", (unsigned long)hva, swal_hdr_pa);
+	chunk = kalloc_data(SWAL_CHUNK, Z_WAITOK);
+	if (chunk == NULL) {
+		printf("SWEET AOC: load stop no-memory, nothing touched\n");
+		return;
+	}
+	swal_zs.in = z;
+	swal_zs.inlen = zlen;
+	b = (struct swal_bus){ swal_src_open, swal_src_next, swal_r32, swal_w32, swal_cwrite, swal_cread, swal_cmap, swal_cunmap,
+		               swal_progress, swal_csync, swal_hflush, swal_sleep_ms, swal_say, (uint8_t *)hva, swal_hdr_pa, chunk, SWAL_CHUNK, SWAL_CARVE_LEN, SWAL_FW_LEN,
+		               swal_fw_sha, NULL };
+	rc = swal_run(&b, &r);
+	if (swal_zs.live) {
+		inflateEnd(&swal_zs.z);
+		swal_zs.live = 0;
+	}
+	kfree_data(chunk, SWAL_CHUNK);
+	printf("SWEET AOC: len %u/%u body %llu auth gen %u len %#x image_size %#x pmu %08x req found %u status %08x hdr pa %#llx\n",
+	    r.len1, r.len2, r.body_len, r.auth_gen, r.auth_len, r.sb_image_size, r.pmu_stat, r.req_found, r.req_st, swal_hdr_pa);
+	if (rc >= SWAL_E_GSA_TIMEOUT) {
+		printf("SWEET AOC: gsa intmr0 found %08x rsp sr0 %08x err %u argc %u waited %u ms\n", r.intmr0_found, r.rsp_cmd,
+		    r.rsp_err, r.rsp_argc, r.waited_ms);
+	}
+	if (rc == SWAL_OK) {
+		printf("SWEET AOC: gsa load ok (err 0, rsp_argc %u, %u ms)\n", r.rsp_argc, r.waited_ms);
+		return;
+	}
+	en = swal_gsa_err_name(r.rsp_err);
+	if (rc == SWAL_E_GSA_ERR) {
+		printf("SWEET AOC: gsa load error code=%u (%s), stopped, no retry\n", r.rsp_err, en ? en : "?");
+		return;
+	}
+	printf("SWEET AOC: load stop %s (code %d), no retry\n", rc > 0 && rc < SWAL_NSTOP ? swal_stop_name[rc] : "?", rc);
+}
+
+void
+sweet_aoc_load_start(void)
+{
+	thread_t th;
+
+	if (kernel_thread_start(swal_thread, NULL, &th) != KERN_SUCCESS) {
+		printf("SWEET AOC: kernel_thread_start failed, not touched\n");
+		return;
+	}
+	thread_deallocate(th);
+	printf("SWEET AOC: load armed (sweetaoc=2), starts once the USB log is up\n");
+}
diff --git a/bsd/dev/sweet_aoc_load.h b/bsd/dev/sweet_aoc_load.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_aoc_load.h
@@ -0,0 +1,536 @@
+/*
+ * AOC firmware load (patch 0164, plan 2026-11-14 oneshot-2 step A6), boot-arg sweetaoc=2. Pure logic, no kernel headers: the
+ * host test shim/aoc_load_host_test.c drives it with a fake SoC (PMU, aoc_req, GSA mailbox, carveout). Sources pinned in
+ * docs/research/50 (gsa = soc/gs 2040787 drivers/soc/google/gsa, aoc = google-modules/aoc ac69293, fw = stock aoc.bin).
+ *
+ * Image: the unmodified stock /vendor/firmware/aoc.bin, 15,158,976 B, sha256 9be56622...5743 (docs/research/50 table, `fw`),
+ * delivered zlib-compressed in the AOCFW container (tools/pack_aocfw.py). The glue inflates it; this file sees a byte source
+ * that can be restarted (src_open/src_next).
+ *
+ * Order (row A6, which follows aoc_fw_callback, aoc.c:472-674 / docs/research/50 s.6.3):
+ *   0. pass 1, no hardware access: inflate everything, length + sha256 == pinned identity; keep the first 8 KiB.
+ *   1. PMU AOC_STATUS 0x17461884 bit 0 must read 1 (the A4 gate, flexpmu_cal_local_gs101.h:3-20); read only.
+ *   2. aoc_req 0x175D0000 := 1 (request_aoc_on(1), aoc_v1.c:87-91, aoc.c:557); the value found is read first and written back
+ *      on every stop before the GSA call if it was not 1 (A4 found req=1 status=1, then this write changes nothing).
+ *   3. header checks of _aoc_fw_is_valid (aoc_firmware.c:116-154, region_is_in_firmware :106-110) and _aoc_fw_is_signed
+ *      (:163-182, auth header v1/v2, magic 0x00434F41 at 0x400, struct aoc_auth_header :24-51).
+ *   4. (round 2, after run o6-a6-aocload stalled right after the "pass 2" line) map only the body extent of the carveout
+ *      (cmap), write + read back ONE word at +0 (the image's own first body word), then pass 2 with a progress line per
+ *      MiB; the CPU mapping is dropped (cunmap) after the read-back, before the GSA call, and on every stop after cmap.
+ *      pass 2: header (first 4096 B, AOC_AUTH_HEADER_SIZE aoc_firmware.h:16) into the wired buffer, body (file offset 4096 to
+ *      the end) to carveout + 0 (_aoc_fw_commit aoc_firmware.c:286-294, aoc.c:612-614); every write is bounds-checked against
+ *      the carveout 0x94000000 + 0x03000000 (tools/test_aoc_carveout.py; ref dmesg:21, iomem.txt:186-187). Then the header
+ *      buffer is cleaned to memory, the carveout written back (barrier) and READ BACK: sha256(header buffer || carveout body)
+ *      must equal the pinned sha256 again.
+ *   5. GSA mailbox 0x17C90000 (gs101-gsa.dtsi:3-12), the one command GSA_MB_CMD_LOAD_AOC_FW_IMG = 90 (gsa_mbox.h:50),
+ *      argc 4 (gsa_mbox.h:90-96, gsa_core.c:82-95): SR2/SR3 = header PA lo/hi, SR4/SR5 = body PA lo/hi (0x94000000, 0;
+ *      aoc.c:459-460, 624-625). Sequence exec_mbox_cmd_sync_locked (gsa_mbox.c:255-335): SR0 = cmd, SR1 = argc, SR2.. = args;
+ *      INTCR0 = 1 (clr, :132-135); INTMR0 &= ~1 (unmask, :107-117); INTGR1 = 1 (:301); wait (stock: no bound, :304; here
+ *      polled INTSR0|INTMSR0 bit 0 every 1 ms, at most SWAL_GSA_WAIT_MS); read SR0 (= cmd | 1<<31, GSA_MB_CMD_RSP :342),
+ *      SR1 = err, SR2 = rsp_argc (rsp_argc + 3 <= 16, :311-316); INTCR0 = 1; INTMR0 |= 1 (:331-332).
+ *      Timeout: INTMR0 is written back to the value found (the only write after the doorbell), stop. No retry of anything.
+ *      err: the documented codes (gsa_mbox.c:345-360) are named, any other value (or a bad SR0/argc) is "undocumented" (H9).
+ * Register offsets (gsa_mbox.c:22-57): INTCR0 0x24, INTMR0 0x28, INTSR0 0x2C, INTMSR0 0x30, INTGR1 0x40, SR(n) 0x80 + 4n.
+ * Nothing else is ever written: no other GSA command, no AOC start (that is A8), no SysMMU/S2MPU, no Trusty.
+ */
+#ifndef SWEET_AOC_LOAD_H
+#define SWEET_AOC_LOAD_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+/* ---- pinned identity (docs/research/50, table row `fw`) ---- */
+#define SWAL_FW_LEN       15158976u
+static const uint8_t swal_fw_sha[32] = {
+	0x9b, 0xe5, 0x66, 0x22, 0x90, 0x14, 0x9c, 0xb0, 0x14, 0xd8, 0x9b, 0x63, 0x0d, 0x2a, 0x19, 0xb3,
+	0x6e, 0x98, 0xa6, 0x58, 0x0c, 0x78, 0x98, 0xeb, 0x9b, 0x58, 0x74, 0xcc, 0x28, 0x98, 0x57, 0x43,
+};
+
+/* ---- container (tools/pack_aocfw.py = tools/pack_wlanfw.py layout, magic AOCFWZB1, one entry AOCF) ---- */
+#define SWAL_C_HDR        16u
+#define SWAL_C_ENTRY      16u
+#define SWAL_C_SUB        40u             /* u32 usize, u32 flags (1 = zlib), u8 sha256[32] */
+#define SWAL_C_MAX        (8u << 20)      /* the container is ~3.3 MB; brief limit for the zlib stream 7.5 MB */
+
+/* ---- hardware (cites above) ---- */
+#define SWAL_PMU_PA       0x17461000ull
+#define SWAL_PMU_STAT     0x884u
+#define SWAL_REQ_PA       0x175D0000ull
+#define SWAL_REQ_REQ      0x00u
+#define SWAL_REQ_STATUS   0x40u
+#define SWAL_GSA_PA       0x17C90000ull
+#define SWAL_WIN_LEN      0x1000u
+#define SWAL_INTCR0       0x24u
+#define SWAL_INTMR0       0x28u
+#define SWAL_INTSR0       0x2Cu
+#define SWAL_INTMSR0      0x30u
+#define SWAL_INTGR1       0x40u
+#define SWAL_SR(n)        (0x80u + 4u * (n))
+#define SWAL_SR_NUM       16u
+#define SWAL_CMD_LOAD_AOC 90u             /* GSA_MB_CMD_LOAD_AOC_FW_IMG, gsa_mbox.h:50 */
+#define SWAL_CMD_RSP      0x80000000u     /* GSA_MB_CMD_RSP, gsa_mbox.c:342 */
+#define SWAL_LOAD_ARGC    4u
+#define SWAL_CARVE_PA     0x94000000ull
+#define SWAL_CARVE_LEN    0x03000000u
+#define SWAL_HDR_LEN      4096u           /* AOC_AUTH_HEADER_SIZE, aoc_firmware.h:16 */
+#define SWAL_HEAD_KEEP    8192u           /* auth header + superbin header for the checks */
+#define SWAL_AUTH_MAGIC   0x00434F41u     /* AOC_AUTH_HEADER_MAGIC_VALUE, aoc_firmware.c:13 */
+#define SWAL_SB_MAGIC     0xaabbccddu     /* aoc_firmware.c:129 */
+#define SWAL_SB_SIZE      168u            /* sizeof(struct aoc_superbin_header), aoc_firmware.c:53-78, packed */
+#define SWAL_DMA_LIMIT    (1ull << 36)    /* GSA DMA mask 36 bit, gsa_core.c:826 */
+#define SWAL_GSA_WAIT_MS  10000u
+
+enum { SWAL_W_PMU = 0, SWAL_W_REQ, SWAL_W_GSA, SWAL_NWIN };
+
+enum swal_stop {
+	SWAL_OK = 0, SWAL_E_ARGS, SWAL_E_SRC, SWAL_E_IDENTITY, SWAL_E_PD_OFF, SWAL_E_READ, SWAL_E_HEADER, SWAL_E_TOO_BIG,
+	SWAL_E_COPY, SWAL_E_READBACK, SWAL_E_HDR_PA, SWAL_E_MAP, SWAL_E_PROBE, SWAL_E_GSA_TIMEOUT, SWAL_E_GSA_UNDOC, SWAL_E_GSA_ERR, SWAL_NSTOP
+};
+static const char *const swal_stop_name[SWAL_NSTOP] = {
+	"ok", "bad-args", "source-error", "identity-mismatch", "aoc-pd-off", "read-failed", "bad-header", "body-larger-than-carveout",
+	"copy-refused", "readback-mismatch", "header-pa-above-36bit", "carveout-map-failed", "carveout-probe-word-mismatch", "gsa-timeout", "gsa-undocumented-reply", "gsa-error",
+};
+
+/* gsa_mbox.c:345-360 */
+static inline const char *
+swal_gsa_err_name(uint32_t e)
+{
+	switch (e) {
+	case 0: return "OK";
+	case 1: return "INVALID_ARGS";
+	case 2: return "AUTH_FAILED";
+	case 3: return "BUSY";
+	case 4: return "ALREADY_RUNNING";
+	case 5: return "OUT_OF_RESOURCES";
+	case 6: return "BAD_HANDLE";
+	case 128: return "GENERIC";
+	case 129: return "INTERNAL";
+	case 130: return "TIMED_OUT";
+	case 131: return "BAD_STATE";
+	default: return 0;
+	}
+}
+
+/* ---- SHA-256 (FIPS 180-4) ---- */
+struct swal_sha { uint32_t h[8]; uint64_t n; uint8_t b[64]; };
+static const uint32_t swal_k[64] = {
+	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01,
+	0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+	0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
+	0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08,
+	0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+	0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+};
+#define SWAL_ROR(x, n) (((x) >> (n)) | ((x) << (32 - (n))))
+
+static inline void
+swal_sha_block(struct swal_sha *s, const uint8_t *p)
+{
+	uint32_t w[64], a, b, c, d, e, f, g, h, t1, t2;
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 | (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];
+	}
+	for (i = 16; i < 64; i++) {
+		w[i] = w[i - 16] + (SWAL_ROR(w[i - 15], 7) ^ SWAL_ROR(w[i - 15], 18) ^ (w[i - 15] >> 3)) + w[i - 7] +
+		    (SWAL_ROR(w[i - 2], 17) ^ SWAL_ROR(w[i - 2], 19) ^ (w[i - 2] >> 10));
+	}
+	a = s->h[0]; b = s->h[1]; c = s->h[2]; d = s->h[3]; e = s->h[4]; f = s->h[5]; g = s->h[6]; h = s->h[7];
+	for (i = 0; i < 64; i++) {
+		t1 = h + (SWAL_ROR(e, 6) ^ SWAL_ROR(e, 11) ^ SWAL_ROR(e, 25)) + ((e & f) ^ (~e & g)) + swal_k[i] + w[i];
+		t2 = (SWAL_ROR(a, 2) ^ SWAL_ROR(a, 13) ^ SWAL_ROR(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+		h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+	}
+	s->h[0] += a; s->h[1] += b; s->h[2] += c; s->h[3] += d; s->h[4] += e; s->h[5] += f; s->h[6] += g; s->h[7] += h;
+}
+
+static inline void
+swal_sha_init(struct swal_sha *s)
+{
+	static const uint32_t iv[8] = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 };
+	int i;
+
+	for (i = 0; i < 8; i++) {
+		s->h[i] = iv[i];
+	}
+	s->n = 0;
+}
+
+static inline void
+swal_sha_update(struct swal_sha *s, const uint8_t *p, size_t len)
+{
+	while (len) {
+		uint32_t o = (uint32_t)(s->n & 63u);
+		if (o == 0 && len >= 64) {
+			swal_sha_block(s, p);
+			p += 64; len -= 64; s->n += 64;
+			continue;
+		}
+		s->b[o] = *p++;
+		len--;
+		s->n++;
+		if (o == 63u) {
+			swal_sha_block(s, s->b);
+		}
+	}
+}
+
+static inline void
+swal_sha_final(struct swal_sha *s, uint8_t out[32])
+{
+	uint64_t bits = s->n * 8u;
+	uint8_t pad = 0x80, z = 0, l[8];
+	int i;
+
+	swal_sha_update(s, &pad, 1);
+	while ((s->n & 63u) != 56u) {
+		swal_sha_update(s, &z, 1);
+	}
+	for (i = 0; i < 8; i++) {
+		l[i] = (uint8_t)(bits >> (56 - 8 * i));
+	}
+	swal_sha_update(s, l, 8);
+	for (i = 0; i < 32; i++) {
+		out[i] = (uint8_t)(s->h[i / 4] >> (24 - 8 * (i % 4)));
+	}
+}
+
+static inline int
+swal_eq(const uint8_t *a, const uint8_t *b, size_t n)
+{
+	uint8_t d = 0;
+	while (n--) {
+		d |= (uint8_t)(*a++ ^ *b++);
+	}
+	return d == 0;
+}
+
+static inline uint32_t
+swal_rd32le(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline uint32_t
+swal_crc32(const uint8_t *p, size_t n)       /* zlib crc32, as tools/pack_wlanfw.py writes it */
+{
+	uint32_t c = 0xFFFFFFFFu;
+	int k;
+
+	while (n--) {
+		c ^= *p++;
+		for (k = 0; k < 8; k++) {
+			c = (c >> 1) ^ (0xEDB88320u & (0u - (c & 1u)));
+		}
+	}
+	return ~c;
+}
+
+/* AOCFW container -> the zlib stream (*z, *zlen) and its sub-header. 0 ok, else a negative code. */
+static inline int
+swal_container(const uint8_t *buf, size_t len, const uint8_t **z, uint32_t *zlen, uint32_t *usize, const uint8_t **sha)
+{
+	uint32_t elen, eoff;
+
+	*z = 0;
+	*sha = 0;
+	*zlen = 0;
+	*usize = 0;
+	if (buf == 0 || len < SWAL_C_HDR + SWAL_C_ENTRY || len > SWAL_C_MAX) {
+		return -1;
+	}
+	if (!swal_eq(buf, (const uint8_t *)"AOCFWZB1", 8) || swal_rd32le(buf + 8) != 1u || swal_rd32le(buf + 12) != 1u) {
+		return -2;
+	}
+	if (!swal_eq(buf + 16, (const uint8_t *)"AOCF", 4)) {
+		return -3;
+	}
+	elen = swal_rd32le(buf + 20);
+	eoff = swal_rd32le(buf + 24);
+	if ((eoff & 7u) || eoff < SWAL_C_HDR + SWAL_C_ENTRY || elen <= SWAL_C_SUB || eoff > len || elen > len - eoff) {
+		return -4;
+	}
+	if (swal_crc32(buf + eoff, elen) != swal_rd32le(buf + 28)) {
+		return -5;
+	}
+	if (swal_rd32le(buf + eoff + 4) != 1u) {
+		return -6;
+	}
+	*usize = swal_rd32le(buf + eoff);
+	*sha = buf + eoff + 8;
+	*z = buf + eoff + SWAL_C_SUB;
+	*zlen = elen - SWAL_C_SUB;
+	return 0;
+}
+
+/* region_is_in_firmware(start, len) of aoc_firmware.c:106-110 with the signed header size 4096 */
+static inline int
+swal_in_fw(uint64_t start, uint64_t len, uint64_t fwsize)
+{
+	return fwsize > SWAL_HDR_LEN && start + len < fwsize - SWAL_HDR_LEN;
+}
+
+/* _aoc_fw_is_signed (aoc_firmware.c:163-182) and _aoc_fw_is_valid (:116-154) on the first 8 KiB of an image of fwsize bytes */
+static inline int
+swal_header_ok(const uint8_t *head, uint64_t fwsize)
+{
+	const uint8_t *sb = head + SWAL_HDR_LEN;        /* superbin_header() = data + aoc_img_header_size() = data + 4096 */
+	uint32_t gen = swal_rd32le(head + 0x404), magic = swal_rd32le(head + 0x400);
+
+	if (!(magic == SWAL_AUTH_MAGIC && (gen == 1u || gen == 2u))) {
+		return 0;
+	}
+	if (!swal_in_fw(0, SWAL_SB_SIZE, fwsize) || swal_rd32le(sb) != SWAL_SB_MAGIC) {
+		return 0;
+	}
+	if (!swal_in_fw(swal_rd32le(sb + 32), swal_rd32le(sb + 36), fwsize)) {     /* uuid_table_offset, uuid_table_size */
+		return 0;
+	}
+	return swal_in_fw(swal_rd32le(sb + 24), swal_rd32le(sb + 28), fwsize);      /* bootloader_offset, bootloader_size */
+}
+
+struct swal_bus {
+	int (*src_open)(void *ctx);                                     /* (re)start the inflated image; 0 ok */
+	int (*src_next)(void *ctx, uint8_t *buf, uint32_t cap, uint32_t *n);   /* next bytes (n = 0 at the end); 0 ok */
+	int (*r32)(void *ctx, int w, uint32_t off, uint32_t *v);       /* 1 ok */
+	int (*w32)(void *ctx, int w, uint32_t off, uint32_t v);        /* 1 ok */
+	int (*cwrite)(void *ctx, uint64_t off, const uint8_t *p, uint32_t n);  /* carveout + off; 1 ok */
+	int (*cread)(void *ctx, uint64_t off, uint8_t *p, uint32_t n);
+	int (*cmap)(void *ctx, uint64_t len);                            /* map carveout [0, len) for the CPU; 1 ok */
+	void (*cunmap)(void *ctx);                                      /* drop that mapping (before the GSA locks the body) */
+	void (*progress)(void *ctx, const char *what, uint64_t a, uint64_t b);   /* live line, the glue waits for the log */
+	void (*csync)(void *ctx);                                       /* barrier after the carveout writes */
+	void (*hflush)(void *ctx);                                      /* clean the header buffer to memory */
+	void (*sleep_ms)(void *ctx, uint32_t ms);
+	void (*say)(void *ctx, const char *what);                       /* progress line before each hardware step */
+	uint8_t *hdr;                                                   /* wired 4096-byte header buffer (GSA reads it) */
+	uint64_t hdr_pa;
+	uint8_t *chunk;                                                 /* scratch, chunk_len bytes */
+	uint32_t chunk_len;
+	uint64_t carve_len;                                             /* SWAL_CARVE_LEN on hardware */
+	uint32_t fw_len;                                                /* SWAL_FW_LEN on hardware */
+	const uint8_t *fw_sha;                                          /* swal_fw_sha on hardware */
+	void *ctx;
+};
+
+struct swal_res {
+	uint32_t len1, len2, pmu_stat, req_found, req_st, req_wrote, intmr0_found;
+	uint32_t rsp_cmd, rsp_err, rsp_argc, waited_ms;
+	uint32_t auth_gen, auth_len, sb_image_size, writes_after_doorbell;
+	uint32_t mapped, probe_rd;
+	uint64_t body_len;
+	uint8_t head[SWAL_HEAD_KEEP];
+	int stage;      /* the step that stopped */
+};
+
+/* pass over the whole source; hash it; head != 0: keep the first SWAL_HEAD_KEEP bytes; copy != 0: header to b->hdr, body to carveout */
+static inline int
+swal_pass(const struct swal_bus *b, uint8_t *head, int copy, uint32_t *len, uint8_t sha[32])
+{
+	struct swal_sha s;
+	uint64_t pos = 0;
+	uint32_t n, i, guard;
+
+	if (b->src_open(b->ctx) != 0) {
+		return SWAL_E_SRC;
+	}
+	swal_sha_init(&s);
+	for (guard = 0; guard < 0x100000u; guard++) {
+		if (b->src_next(b->ctx, b->chunk, b->chunk_len, &n) != 0 || n > b->chunk_len) {
+			return SWAL_E_SRC;
+		}
+		if (n == 0) {
+			break;
+		}
+		if (pos + n > (uint64_t)b->fw_len) {
+			return SWAL_E_IDENTITY;         /* longer than the pinned image: stop before anything else */
+		}
+		swal_sha_update(&s, b->chunk, n);
+		for (i = 0; head && i < n && pos + i < SWAL_HEAD_KEEP; i++) {
+			head[pos + i] = b->chunk[i];
+		}
+		if (copy) {
+			uint32_t h = 0;
+			for (; h < n && pos + h < SWAL_HDR_LEN; h++) {
+				b->hdr[pos + h] = b->chunk[h];
+			}
+			if (pos < SWAL_HDR_LEN && pos + h >= SWAL_HDR_LEN) {
+				b->progress(b->ctx, "header buffer written (bytes, pa)", SWAL_HDR_LEN, b->hdr_pa);
+			}
+			if (h < n) {
+				uint64_t off = pos + h - SWAL_HDR_LEN;
+				if (off + (n - h) > b->carve_len || !b->cwrite(b->ctx, off, b->chunk + h, n - h)) {
+					return SWAL_E_COPY;
+				}
+			}
+		}
+		pos += n;
+		if (copy && pos > SWAL_HDR_LEN && ((pos - SWAL_HDR_LEN) >> 20) != ((pos - n > SWAL_HDR_LEN ? pos - n - SWAL_HDR_LEN : 0) >> 20)) {
+			b->progress(b->ctx, "carveout body copied (bytes, of)", pos - SWAL_HDR_LEN, (uint64_t)b->fw_len - SWAL_HDR_LEN);
+		}
+	}
+	*len = (uint32_t)pos;
+	swal_sha_final(&s, sha);
+	return pos == b->fw_len ? SWAL_OK : SWAL_E_IDENTITY;
+}
+
+static inline int
+swal_stop_req(const struct swal_bus *b, struct swal_res *r, int code)
+{
+	if (r->mapped) {
+		b->cunmap(b->ctx);
+		r->mapped = 0;
+	}
+	if (r->req_wrote && r->req_found != 1u) {
+		(void)b->w32(b->ctx, SWAL_W_REQ, SWAL_REQ_REQ, r->req_found);  /* restore aoc_req as found */
+	}
+	return code;
+}
+
+/* The whole A6 sequence. Returns SWAL_OK only after GSA answered LOAD_AOC_FW_IMG with err 0. r->stage = the stop code. */
+static inline int
+swal_run(const struct swal_bus *b, struct swal_res *r)
+{
+	uint8_t sha[32];
+	uint32_t i, v, ms, len;
+	uint64_t off;
+	struct swal_sha s;
+	int rc;
+
+	if (b == 0 || r == 0 || !b->src_open || !b->src_next || !b->r32 || !b->w32 || !b->cwrite || !b->cread || !b->csync ||
+	    !b->hflush || !b->sleep_ms || !b->say || !b->cmap || !b->cunmap || !b->progress || !b->hdr || !b->chunk || b->chunk_len < 64u || !b->fw_sha ||
+	    b->fw_len <= SWAL_HEAD_KEEP) {
+		return SWAL_E_ARGS;
+	}
+	*r = (struct swal_res){ 0 };
+	/* 0. identity, no hardware access */
+	b->say(b->ctx, "pass 1: inflate + sha256 (no hardware access)");
+	rc = swal_pass(b, r->head, 0, &r->len1, sha);
+	if (rc != SWAL_OK || !swal_eq(sha, b->fw_sha, 32)) {
+		return r->stage = rc == SWAL_E_SRC ? SWAL_E_SRC : SWAL_E_IDENTITY;
+	}
+	r->body_len = (uint64_t)r->len1 - SWAL_HDR_LEN;
+	r->auth_gen = swal_rd32le(r->head + 0x404);
+	r->auth_len = swal_rd32le(r->head + 0x40C);
+	r->sb_image_size = swal_rd32le(r->head + SWAL_HDR_LEN + 12);
+	if (r->body_len > b->carve_len) {
+		return r->stage = SWAL_E_TOO_BIG;
+	}
+	/* 1. AOC power domain on (read only) */
+	b->say(b->ctx, "reading pmu AOC_STATUS");
+	if (!b->r32(b->ctx, SWAL_W_PMU, SWAL_PMU_STAT, &r->pmu_stat)) {
+		return r->stage = SWAL_E_READ;
+	}
+	if (!(r->pmu_stat & 1u)) {
+		return r->stage = SWAL_E_PD_OFF;
+	}
+	/* 2. aoc_req on, as stock */
+	b->say(b->ctx, "aoc_req := 1");
+	if (!b->r32(b->ctx, SWAL_W_REQ, SWAL_REQ_REQ, &r->req_found)) {
+		return r->stage = SWAL_E_READ;
+	}
+	if (!b->w32(b->ctx, SWAL_W_REQ, SWAL_REQ_REQ, 1u)) {
+		return r->stage = SWAL_E_READ;
+	}
+	r->req_wrote = 1;
+	(void)b->r32(b->ctx, SWAL_W_REQ, SWAL_REQ_STATUS, &r->req_st);
+	/* 3. header checks */
+	if (!swal_header_ok(r->head, r->len1)) {
+		return r->stage = swal_stop_req(b, r, SWAL_E_HEADER);
+	}
+	/* 4. map the body extent of the carveout, write + read back ONE word (the image's own first body word) at its start,
+	 *    then copy with a progress line per MiB, then read back */
+	b->say(b->ctx, "carveout: map body extent");
+	if (!b->cmap(b->ctx, r->body_len)) {
+		return r->stage = swal_stop_req(b, r, SWAL_E_MAP);
+	}
+	r->mapped = 1;
+	b->say(b->ctx, "carveout: mapped; writing one word at +0");
+	if (!b->cwrite(b->ctx, 0, r->head + SWAL_HDR_LEN, 4u) || (b->csync(b->ctx), !b->cread(b->ctx, 0, (uint8_t *)&r->probe_rd, 4u)) ||
+	    !swal_eq((const uint8_t *)&r->probe_rd, r->head + SWAL_HDR_LEN, 4u)) {
+		b->progress(b->ctx, "carveout word +0 read back (got, want)", r->probe_rd, swal_rd32le(r->head + SWAL_HDR_LEN));
+		return r->stage = swal_stop_req(b, r, SWAL_E_PROBE);
+	}
+	b->progress(b->ctx, "carveout word +0 read back ok (value, pa)", r->probe_rd, SWAL_CARVE_PA);
+	b->say(b->ctx, "pass 2: header -> wired buffer, body -> carveout 0x94000000");
+	rc = swal_pass(b, 0, 1, &r->len2, sha);
+	if (rc != SWAL_OK) {
+		return r->stage = swal_stop_req(b, r, rc == SWAL_E_COPY ? SWAL_E_COPY : SWAL_E_READBACK);
+	}
+	if (!swal_eq(sha, b->fw_sha, 32)) {
+		return r->stage = swal_stop_req(b, r, SWAL_E_READBACK);
+	}
+	b->hflush(b->ctx);
+	b->csync(b->ctx);
+	b->say(b->ctx, "read back: sha256(header buffer || carveout body)");
+	swal_sha_init(&s);
+	swal_sha_update(&s, b->hdr, SWAL_HDR_LEN);
+	for (off = 0; off < r->body_len; off += len) {
+		len = r->body_len - off > b->chunk_len ? b->chunk_len : (uint32_t)(r->body_len - off);
+		if (!b->cread(b->ctx, off, b->chunk, len)) {
+			return r->stage = swal_stop_req(b, r, SWAL_E_READBACK);
+		}
+		swal_sha_update(&s, b->chunk, len);
+	}
+	swal_sha_final(&s, sha);
+	if (!swal_eq(sha, b->fw_sha, 32)) {
+		return r->stage = swal_stop_req(b, r, SWAL_E_READBACK);
+	}
+	/* the CPU mapping goes before the GSA locks the body (gsa_aoc.h:17-35): no speculative access to a locked range */
+	b->cunmap(b->ctx);
+	r->mapped = 0;
+	b->progress(b->ctx, "read back ok, carveout unmapped (body bytes, pa)", r->body_len, SWAL_CARVE_PA);
+	if (b->hdr_pa == 0 || (b->hdr_pa & 0xFFFu) || b->hdr_pa + SWAL_HDR_LEN > SWAL_DMA_LIMIT) {
+		return r->stage = swal_stop_req(b, r, SWAL_E_HDR_PA);
+	}
+	/* 5. LOAD_AOC_FW_IMG, the only GSA command */
+	b->say(b->ctx, "gsa: LOAD_AOC_FW_IMG (90)");
+	if (!b->r32(b->ctx, SWAL_W_GSA, SWAL_INTMR0, &r->intmr0_found)) {
+		return r->stage = swal_stop_req(b, r, SWAL_E_READ);
+	}
+	{
+		const uint32_t sr[2 + SWAL_LOAD_ARGC] = { SWAL_CMD_LOAD_AOC, SWAL_LOAD_ARGC, (uint32_t)b->hdr_pa,
+			                                  (uint32_t)(b->hdr_pa >> 32), (uint32_t)SWAL_CARVE_PA, (uint32_t)(SWAL_CARVE_PA >> 32) };
+		for (i = 0; i < 2u + SWAL_LOAD_ARGC; i++) {
+			(void)b->w32(b->ctx, SWAL_W_GSA, SWAL_SR(i), sr[i]);
+		}
+	}
+	(void)b->w32(b->ctx, SWAL_W_GSA, SWAL_INTCR0, 1u);
+	(void)b->w32(b->ctx, SWAL_W_GSA, SWAL_INTMR0, r->intmr0_found & ~1u);
+	(void)b->w32(b->ctx, SWAL_W_GSA, SWAL_INTGR1, 1u);
+	for (ms = 0;; ms++) {
+		uint32_t raw = 0, msk = 0;
+		(void)b->r32(b->ctx, SWAL_W_GSA, SWAL_INTSR0, &raw);
+		(void)b->r32(b->ctx, SWAL_W_GSA, SWAL_INTMSR0, &msk);
+		if ((raw | msk) & 1u) {
+			break;
+		}
+		if (ms >= SWAL_GSA_WAIT_MS) {
+			r->waited_ms = ms;
+			(void)b->w32(b->ctx, SWAL_W_GSA, SWAL_INTMR0, r->intmr0_found);   /* restore the mask as found; nothing else */
+			r->writes_after_doorbell = 1;
+			return r->stage = SWAL_E_GSA_TIMEOUT;
+		}
+		b->sleep_ms(b->ctx, 1);
+	}
+	r->waited_ms = ms;
+	(void)b->r32(b->ctx, SWAL_W_GSA, SWAL_SR(0), &r->rsp_cmd);
+	(void)b->r32(b->ctx, SWAL_W_GSA, SWAL_SR(1), &r->rsp_err);
+	(void)b->r32(b->ctx, SWAL_W_GSA, SWAL_SR(2), &r->rsp_argc);
+	(void)b->w32(b->ctx, SWAL_W_GSA, SWAL_INTCR0, 1u);                           /* gsa_mbox.c:331 */
+	v = 0;
+	(void)b->r32(b->ctx, SWAL_W_GSA, SWAL_INTMR0, &v);
+	(void)b->w32(b->ctx, SWAL_W_GSA, SWAL_INTMR0, v | 1u);                       /* gsa_mbox.c:332 */
+	r->writes_after_doorbell = 2;
+	if (r->rsp_cmd != (SWAL_CMD_LOAD_AOC | SWAL_CMD_RSP) || r->rsp_argc + 3u > SWAL_SR_NUM || !swal_gsa_err_name(r->rsp_err)) {
+		return r->stage = SWAL_E_GSA_UNDOC;
+	}
+	if (r->rsp_err != 0u) {
+		return r->stage = SWAL_E_GSA_ERR;
+	}
+	return r->stage = SWAL_OK;
+}
+
+#endif /* SWEET_AOC_LOAD_H */

diff --git a/bsd/dev/sweet_amp_pwr.h b/bsd/dev/sweet_amp_pwr.h
new file mode 100644
index 0000000..8c5a877
--- /dev/null
+++ b/bsd/dev/sweet_amp_pwr.h
@@ -0,0 +1,371 @@
+/*
+ * CS35L41 power-up, tone window, power-down (patch 0172, plan A10, boot-arg sweetaoc=7 with sweetamp=1). Included by sweet_amp.h; run by
+ * amp_a9_part between the A9 PLL poll (the AOC stream of zeros runs) and the DSP window 2 / stop, only when the glue armed the tone
+ * (sweet_amp_tone_arm) and both HALO cores run (heartbeat moved). USER DECISION 2026-11-18: the old rule "PLL locked + reviewed calibration
+ * before GLOBAL_EN" is lifted for this level; the stock order is kept. AMP = google-modules amplifiers cs35l41 (cs35l41.c, cs35l41.h,
+ * cs35l41-tables.c); v6.18 = Linux v6.18 sound/soc/codecs/cs35l41-lib.c + include/sound/cs35l41.h; DAPM = soc-dapm.c dapm_up_seq /
+ * dapm_down_seq / dapm_seq_compare (read from the Linux 7.3.4 source tree, :76-156, :1787-1817: sorted by type seq, then reg, then component).
+ * Power-up, the DAPM order of SPK <- Main AMP <- CLASS H <- PCM Source "DSP" <- DSP1 <- VMON / IMON / VPMON / VBSTMON / TEMPMON ADC <- ASPRX1
+ * (AMP cs35l41.c:2560-2582); each step on L, then R (same seq and reg: sorted by component):
+ *   mixer words: DAC_PCM1_SRC 0x4C00 [0x7F] := 0x32 "DSP" (AMP cs35l41.c:1132-1138, cs35l41.h:94, :633); Boost Converter Enable PWR_CTRL2
+ *     0x2018 BST_EN [0x30] := 2 << 4 (v6.18 cs35l41-lib.c:1164, cs35l41.h:680-682; AMP control cs35l41.c:1799)
+ *   seq 5 aif_in: SP_ENABLES 0x4800 ASPRX1 bit 16 + ASPRX2 bit 17 (AMP cs35l41.c:2451-2456; DSP RX2 Source default ASPRX2, tables.c:80);
+ *     POST_PMU AMP_OUT_MUTE 0x2024 [0x10] := 0 (cs35l41_mute_amp, cs35l41.c:2378-2387, cs35l41.h:46, :672)
+ *   seq 11 adc: PWR_CTRL2 VPMON 8, VBSTMON 9, TEMPMON 10, VMON 12, IMON 13 (cs35l41.c:2462-2466)
+ *   seq 12 out_drv DSP1 (NOPM sorts first) POST_PMU: MBOX_2 0x13004 RUNNING 0 / PAUSED 1 -> VIRT1_MBOX_1 0x13020 := RESUME 2, MBOX_2 polled
+ *     <= 5 x 1 ms for RUNNING (cs35l41.c:283-306, :1023-1055; cs35l41.h:179, :186, :810-820)
+ *   seq 12 out_drv Main AMP: PWR_CTRL2 AMP_EN bit 0 (cs35l41.c:2469); POST_PMU: pup patch TEST_KEY 0x40 := 0x55, 0xAA, 0x2084 := 0x002F1AA0,
+ *     0x40 := 0xCC, 0x33 (:2168-2174, :2280-2282); VIRT1_MBOX_8 0x1303C := gpi_global_en 0 (:2286-2290, :4167); PWR_CTRL1 GLOBAL_EN := 1
+ *     (:2292-2294); 1 ms (:2296); then IRQ1_STATUS1 PUP_DONE 0x01000000 polled <= 100 x 1 ms and cleared W1C (v6.18 cs35l41-lib.c:1286-1293,
+ *     cs35l41.h:676); IRQ1_STATUS3 PLL_LOCK <= 100 x 1 ms (ours: logged, not a stop); IRQ1_STATUS1 & AMP_ERR_BITS must be 0.
+ * Tone window: <= AMP_TONE_MS x 1 ms, the AOC tick each ms, IRQ1_STATUS1 of both amps every AMP_TONE_CHECK_MS; an error bit ends it.
+ * Power-down (every amp that was written, every path): mute first (AMP_OUT_MUTE := 0x10, the ASPRX PRE_PMD mute :2378-2383, here first);
+ *   then the DAPM down order: seq 3 adc bits := 0; seq 5 Main AMP AMP_EN := 0, POST_PMD (:2300-2351): VIRT1_MBOX_1 := PAUSE 1 (MBOX_2 <= 5 x 1 ms
+ *   for PAUSED) if RESUME was sent, VIRT1_MBOX_8 := 0, if GLOBAL_EN: := 0, PDN_DONE 0x00800000 polled <= 100 x 1 ms, cleared; pdn patch (0x2084
+ *   := 0x002F1AA3, :2176-2182); seq 12 aif_in SP_ENABLES bits := 0; then the mixer words back to the values read before; PWR_CTRL1/2 and
+ *   SP_ENABLES read back. restore() puts both amps back in reset after this anyway.
+ * Not written: hibernate (never entered), the volume ramp (manual_ramp 0), AMP_DIG_VOL_CTRL / AMP_GAIN_CTRL (reset defaults 0x8000 = 0 dB,
+ *   0x273, tables.c:89, :100; read and logged). The level is the PCM level (the glue's sine at about -30 dBFS).
+ */
+#ifndef SWEET_AMP_PWR_H
+#define SWEET_AMP_PWR_H
+
+#define AMP_PCMSRC_DSP		0x32u
+#define AMP_BST_EN_FIELD	0x20u		/* CS35L41_BST_EN_DEFAULT 2 << CS35L41_BST_EN_SHIFT 4 */
+#define AMP_BST_EN_MASK		0x30u
+#define AMP_ASPRX_EN		0x00030000u	/* ASP_RX1_EN bit 16, ASP_RX2_EN bit 17 */
+#define AMP_MUTE_BIT		0x10u
+#define AMP_AMP_EN		0x1u
+#define AMP_MBOX_RESUME		2u
+#define AMP_MBOX_PAUSE		1u
+#define AMP_MBOX_STS_RUNNING	0u
+#define AMP_MBOX_STS_PAUSED	1u
+#define AMP_MBOX_POLLS		5u
+#define AMP_PUP_POLLS		100u
+#define AMP_TONE_MS		5400u		/* the glue's pattern is 5 s; + the AOC ring (80 ms) and margin */
+#define AMP_TONE_CHECK_MS	50u
+
+struct amp_pwr_side {
+	int touched, resumed, gen, pup, locked, err, paused, pdn, off;
+	const char *fail;			/* the first step that stopped the power-up (NULL = none) */
+	uint32_t pcm0, pwr2_0, st1_pre, sts0, sts, st1_up, st3, st1_tone, st1_end, pwr1_end, pwr2_end, spe_end, vol, gain;
+	unsigned pup_polls, pll_polls;
+};
+static struct amp_pwr_res { int ran, up, errstop; unsigned tone_ms; struct amp_pwr_side a[2]; } amp_pwr_res;
+
+/* one armed write (the only way PWR_CTRL1 and the other power words pass amp_write_ok) */
+static int amp_pwr_w(const struct amp_snap *s, int cs, uint32_t reg, uint32_t val)
+{
+	int e;
+
+	amp_pwr_row.on = 1;
+	amp_pwr_row.reg = reg;
+	amp_pwr_row.val = val;
+	e = amp_write(s, cs, reg, val);
+	amp_pwr_row.on = 0;
+	amp_pwr_row.reg = amp_pwr_row.val = 0;
+	return e;
+}
+
+/* regmap_update_bits: read, write only if it changes, read the field back */
+static int amp_pwr_rmw(const struct amp_snap *s, int cs, uint32_t reg, uint32_t mask, uint32_t field, uint32_t *old)
+{
+	uint32_t o = 0, rb = 0;
+	int e = amp_read(s, cs, reg, &o);
+
+	if (old)
+		*old = o;
+	if (e != AMP_OK || ((o & ~mask) | field) == o)
+		return e;
+	e = amp_pwr_w(s, cs, reg, (o & ~mask) | field);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, reg, &rb);
+	if (e == AMP_OK && (rb & mask) != field)
+		e = AMP_ERROR;
+	return e;
+}
+
+/* cs35l41_set_cspl_mbox_cmd: VIRT1_MBOX_1 := cmd, MBOX_2 <= 5 x 1 ms for the expected status (the last one read in *sts) */
+static int amp_pwr_mbox(const struct amp_snap *s, int cs, uint32_t cmd, uint32_t want, uint32_t *sts)
+{
+	int e = amp_pwr_w(s, cs, AMP_PWR_MBOX_CMD, cmd);
+
+	for (unsigned i = 0; e == AMP_OK && i < AMP_MBOX_POLLS; i++) {
+		if (wait_ms(1u))
+			return AMP_TIMEOUT;
+		e = amp_read(s, cs, AMP_DSP_MBOX2, sts);
+		if (e == AMP_OK && *sts == want)
+			return AMP_OK;
+	}
+	return e == AMP_OK ? AMP_ERROR : e;
+}
+
+static int amp_pwr_fail(struct amp_pwr_side *d, const char *step, int e)
+{
+	if (!d->fail)
+		d->fail = step;
+	return e == AMP_OK ? AMP_ERROR : e;
+}
+
+/* power-up step st of one amp (stock order above); d->touched is set before its first write */
+static int amp_pwr_step(const struct amp_snap *s, int cs, unsigned st, struct amp_pwr_side *d)
+{
+	uint32_t v = 0;
+	int e = AMP_OK;
+	unsigned i;
+
+	switch (st) {
+	case 0:		/* pre: no error bit, GLOBAL_EN 0, the DSP mailbox status, the volume words (logged) */
+		e = amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1_pre);
+		if (e == AMP_OK)
+			e = amp_read(s, cs, AMP_REG_PWR_CTRL1, &v);
+		if (e == AMP_OK)
+			e = amp_read(s, cs, AMP_DSP_MBOX2, &d->sts0);
+		if (e == AMP_OK)
+			e = amp_read(s, cs, AMP_PWR_DIGVOL, &d->vol);
+		if (e == AMP_OK)
+			e = amp_read(s, cs, AMP_PWR_GAIN, &d->gain);
+		if (e != AMP_OK || (d->st1_pre & AMP_ERR_BITS) || (v & AMP_GLOBAL_EN))
+			return amp_pwr_fail(d, "pre", e);
+		return AMP_OK;
+	case 1:		/* mixer: PCM Source DSP, boost enable */
+		d->touched = 1;
+		e = amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, AMP_PCMSRC_DSP, &d->pcm0);
+		if (e == AMP_OK)
+			e = amp_pwr_rmw(s, cs, AMP_PWR_CTRL2, AMP_BST_EN_MASK, AMP_BST_EN_FIELD, &d->pwr2_0);
+		return e == AMP_OK ? AMP_OK : amp_pwr_fail(d, "mixer", e);
+	case 2:		/* aif_in ASPRX1 / ASPRX2, POST_PMU unmute */
+		e = amp_pwr_rmw(s, cs, AMP_PWR_SPE, AMP_ASPRX_EN, AMP_ASPRX_EN, NULL);
+		if (e == AMP_OK)
+			e = amp_pwr_rmw(s, cs, AMP_PWR_MUTE, AMP_MUTE_BIT, 0u, NULL);
+		return e == AMP_OK ? AMP_OK : amp_pwr_fail(d, "asprx", e);
+	case 3:		/* adc */
+		e = amp_pwr_rmw(s, cs, AMP_PWR_CTRL2, AMP_ADC_BITS, AMP_ADC_BITS, NULL);
+		return e == AMP_OK ? AMP_OK : amp_pwr_fail(d, "adc", e);
+	case 4:		/* DSP1 POST_PMU: RESUME */
+		e = amp_read(s, cs, AMP_DSP_MBOX2, &d->sts0);
+		if (e != AMP_OK || (d->sts0 != AMP_MBOX_STS_RUNNING && d->sts0 != AMP_MBOX_STS_PAUSED))
+			return amp_pwr_fail(d, "mbox-sts", e);
+		d->resumed = 1;
+		e = amp_pwr_mbox(s, cs, AMP_MBOX_RESUME, AMP_MBOX_STS_RUNNING, &d->sts);
+		return e == AMP_OK ? AMP_OK : amp_pwr_fail(d, "resume", e);
+	case 5:		/* Main AMP: AMP_EN, POST_PMU pup patch, MBOX_8 := 0, GLOBAL_EN, 1 ms */
+		e = amp_pwr_rmw(s, cs, AMP_PWR_CTRL2, AMP_AMP_EN, AMP_AMP_EN, NULL);
+		if (e == AMP_OK)
+			e = amp_pwr_w(s, cs, AMP_REG_TEST_KEY, 0x55u);
+		if (e == AMP_OK)
+			e = amp_pwr_w(s, cs, AMP_REG_TEST_KEY, 0xAAu);
+		if (e == AMP_OK)
+			e = amp_pwr_w(s, cs, AMP_PWR_PATCH, 0x002F1AA0u);
+		if (e == AMP_OK)
+			e = amp_pwr_w(s, cs, AMP_REG_TEST_KEY, 0xCCu);
+		if (e == AMP_OK)
+			e = amp_pwr_w(s, cs, AMP_REG_TEST_KEY, 0x33u);
+		if (e == AMP_OK)
+			e = amp_pwr_w(s, cs, AMP_PWR_MBOX_8, 0u);
+		if (e == AMP_OK) {
+			d->gen = 1;	/* from here the power-down clears GLOBAL_EN if it reads set */
+			e = amp_pwr_rmw(s, cs, AMP_REG_PWR_CTRL1, AMP_GLOBAL_EN, AMP_GLOBAL_EN, NULL);
+		}
+		if (e == AMP_OK && wait_ms(1u))
+			e = AMP_TIMEOUT;
+		return e == AMP_OK ? AMP_OK : amp_pwr_fail(d, "global-en", e);
+	case 6:		/* PUP_DONE, clear it; PLL lock; error bits */
+		for (i = 0; e == AMP_OK && i < AMP_PUP_POLLS && !d->pup; i++) {
+			e = amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1_up);
+			d->pup_polls = i + 1u;
+			d->pup = e == AMP_OK && (d->st1_up & AMP_PUP_DONE);
+			if (e == AMP_OK && !d->pup && wait_ms(1u))
+				e = AMP_TIMEOUT;
+		}
+		if (e == AMP_OK && d->pup)
+			e = amp_pwr_w(s, cs, AMP_REG_IRQ1_STATUS1, AMP_PUP_DONE);
+		for (i = 0; e == AMP_OK && i < AMP_PUP_POLLS && !d->locked; i++) {
+			e = amp_read(s, cs, AMP_REG_IRQ1_STATUS3, &d->st3);
+			d->pll_polls = i + 1u;
+			d->locked = e == AMP_OK && (d->st3 & AMP_PLL_LOCK);
+			if (e == AMP_OK && !d->locked && wait_ms(1u))
+				e = AMP_TIMEOUT;
+		}
+		if (e == AMP_OK)
+			e = amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1_up);
+		if (e != AMP_OK || (d->st1_up & AMP_ERR_BITS)) {
+			d->err = 1;
+			return amp_pwr_fail(d, "post-st1", e);
+		}
+		return AMP_OK;
+	}
+	return AMP_ERROR;
+}
+#define AMP_PWR_NSTEP	7u
+
+/* the stock power-down of one amp that was written (each write best effort: the next one still runs) */
+static void amp_pwr_down_mute(const struct amp_snap *s, int cs, struct amp_pwr_side *d)
+{
+	if (d->touched)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_MUTE, AMP_MUTE_BIT, AMP_MUTE_BIT, NULL);
+}
+static void amp_pwr_down_adc(const struct amp_snap *s, int cs, struct amp_pwr_side *d)
+{
+	if (d->touched)
+		(void)amp_pwr_rmw(s, cs, AMP_PWR_CTRL2, AMP_ADC_BITS, 0u, NULL);
+}
+static void amp_pwr_down_amp(const struct amp_snap *s, int cs, struct amp_pwr_side *d)
+{
+	uint32_t v = 0, sts = 0;
+	unsigned i;
+
+	if (!d->touched)
+		return;
+	(void)amp_pwr_rmw(s, cs, AMP_PWR_CTRL2, AMP_AMP_EN, 0u, NULL);
+	if (d->resumed)
+		d->paused = amp_pwr_mbox(s, cs, AMP_MBOX_PAUSE, AMP_MBOX_STS_PAUSED, &sts) == AMP_OK;
+	(void)amp_pwr_w(s, cs, AMP_PWR_MBOX_8, 0u);
+	if (amp_read(s, cs, AMP_REG_PWR_CTRL1, &v) == AMP_OK && (v & AMP_GLOBAL_EN)) {
+		(void)amp_pwr_rmw(s, cs, AMP_REG_PWR_CTRL1, AMP_GLOBAL_EN, 0u, NULL);
+		for (i = 0; i < AMP_PUP_POLLS && !d->pdn; i++) {
+			if (amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &v) != AMP_OK)
+				break;
+			d->pdn = (v & AMP_PDN_DONE) != 0u;
+			if (!d->pdn && wait_ms(1u))
+				break;
+		}
+		(void)amp_pwr_w(s, cs, AMP_REG_IRQ1_STATUS1, AMP_PDN_DONE);
+	}
+	(void)amp_pwr_w(s, cs, AMP_REG_TEST_KEY, 0x55u);
+	(void)amp_pwr_w(s, cs, AMP_REG_TEST_KEY, 0xAAu);
+	(void)amp_pwr_w(s, cs, AMP_PWR_PATCH, 0x002F1AA3u);
+	(void)amp_pwr_w(s, cs, AMP_REG_TEST_KEY, 0xCCu);
+	(void)amp_pwr_w(s, cs, AMP_REG_TEST_KEY, 0x33u);
+}
+static void amp_pwr_down_aif(const struct amp_snap *s, int cs, struct amp_pwr_side *d)
+{
+	int e;
+
+	if (!d->touched)
+		return;
+	(void)amp_pwr_rmw(s, cs, AMP_PWR_SPE, AMP_ASPRX_EN, 0u, NULL);
+	(void)amp_pwr_rmw(s, cs, AMP_PWR_CTRL2, AMP_BST_EN_MASK, d->pwr2_0 & AMP_BST_EN_MASK, NULL);
+	(void)amp_pwr_rmw(s, cs, AMP_PWR_PCMSRC, 0x7Fu, d->pcm0 & 0x7Fu, NULL);
+	e = amp_read(s, cs, AMP_REG_PWR_CTRL1, &d->pwr1_end);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_PWR_CTRL2, &d->pwr2_end);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_PWR_SPE, &d->spe_end);
+	if (e == AMP_OK)
+		e = amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1_end);
+	d->off = e == AMP_OK && !(d->pwr1_end & AMP_GLOBAL_EN) && !(d->pwr2_end & (AMP_AMP_EN | AMP_ADC_BITS)) && !(d->spe_end & AMP_ASPRX_EN);
+}
+
+static void amp_pwr_line(const char *name, const struct amp_pwr_side *d)
+{
+	char line[RAMLOG_LINE_MAX];
+	unsigned p = put_txt(line, sizeof(line), 0, name);
+
+	p = put_txt(line, sizeof(line), p, " pwr up=");
+	p = put_txt(line, sizeof(line), p, d->fail ? d->fail : "ok");
+	p = put_txt(line, sizeof(line), p, " st1 ");
+	p = put_hexmin(line, sizeof(line), p, d->st1_pre);
+	p = put_txt(line, sizeof(line), p, "/");
+	p = put_hexmin(line, sizeof(line), p, d->st1_up);
+	p = put_txt(line, sizeof(line), p, "/");
+	p = put_hexmin(line, sizeof(line), p, d->st1_tone);
+	p = put_txt(line, sizeof(line), p, "/");
+	p = put_hexmin(line, sizeof(line), p, d->st1_end);
+	p = put_txt(line, sizeof(line), p, " st3=");
+	p = put_hexmin(line, sizeof(line), p, d->st3);
+	p = put_txt(line, sizeof(line), p, " mbox ");
+	p = put_hexmin(line, sizeof(line), p, d->sts0);
+	p = put_txt(line, sizeof(line), p, "->");
+	p = put_hexmin(line, sizeof(line), p, d->sts);
+	emit("AMP", line, p);
+	p = put_txt(line, sizeof(line), 0, name);
+	p = put_txt(line, sizeof(line), p, " pwr pup=");
+	p = put_dec(line, sizeof(line), p, (uint32_t)d->pup);
+	p = put_txt(line, sizeof(line), p, "/");
+	p = put_dec(line, sizeof(line), p, d->pup_polls);
+	p = put_txt(line, sizeof(line), p, " pll=");
+	p = put_dec(line, sizeof(line), p, (uint32_t)d->locked);
+	p = put_txt(line, sizeof(line), p, "/");
+	p = put_dec(line, sizeof(line), p, d->pll_polls);
+	p = put_txt(line, sizeof(line), p, " pdn=");
+	p = put_dec(line, sizeof(line), p, (uint32_t)d->pdn);
+	p = put_txt(line, sizeof(line), p, " paused=");
+	p = put_dec(line, sizeof(line), p, (uint32_t)d->paused);
+	p = put_txt(line, sizeof(line), p, " end pwr1=");
+	p = put_hexmin(line, sizeof(line), p, d->pwr1_end);
+	p = put_txt(line, sizeof(line), p, " pwr2=");
+	p = put_hexmin(line, sizeof(line), p, d->pwr2_end);
+	p = put_txt(line, sizeof(line), p, " spe=");
+	p = put_hexmin(line, sizeof(line), p, d->spe_end);
+	p = put_txt(line, sizeof(line), p, " vol=");
+	p = put_hexmin(line, sizeof(line), p, d->vol);
+	p = put_txt(line, sizeof(line), p, " g=");
+	p = put_hexmin(line, sizeof(line), p, d->gain);
+	emit("AMP", line, p);
+}
+
+/* power-up both (step by step, L then R), the tone window, power-down both; the power-down runs on every path after the first step */
+static void amp_pwr_run(const struct amp_snap *s)
+{
+	struct amp_pwr_side *l = &amp_pwr_res.a[0], *r = &amp_pwr_res.a[1];
+	char line[RAMLOG_LINE_MAX];
+	unsigned st, p, ms;
+	int cs, e = AMP_OK;
+
+	amp_pwr_res = (struct amp_pwr_res){ 0 };
+	amp_pwr_res.ran = 1;
+	for (st = 0; e == AMP_OK && st < AMP_PWR_NSTEP; st++)
+		for (cs = 0; e == AMP_OK && cs < 2; cs++)
+			e = amp_pwr_step(s, cs, st, &amp_pwr_res.a[cs]);
+	amp_pwr_res.up = e == AMP_OK;
+	p = put_txt(line, sizeof(line), 0, amp_pwr_res.up ? "AUDIO: amp on l,r pll " : "AUDIO: amp power-up STOPPED at ");
+	if (amp_pwr_res.up) {
+		p = put_txt(line, sizeof(line), p, l->locked && r->locked ? "locked l,r" : l->locked ? "locked l only" : r->locked ? "locked r only" :
+		    "NOT locked l,r");
+	} else {
+		p = put_txt(line, sizeof(line), p, l->fail ? "L " : "R ");
+		p = put_txt(line, sizeof(line), p, l->fail ? l->fail : r->fail ? r->fail : "?");
+		p = put_txt(line, sizeof(line), p, ", powering down");
+	}
+	emit("SWEET", line, p);
+	if (amp_pwr_res.up) {
+		if (amp_a9_cb.tone)
+			amp_a9_cb.tone(amp_a9_cb.ctx, 1);
+		for (ms = 0; ms < AMP_TONE_MS; ms++) {
+			if (wait_ms(1u))
+				break;
+			if (amp_a9_cb.tick)
+				amp_a9_cb.tick(amp_a9_cb.ctx);
+			if ((ms + 1u) % AMP_TONE_CHECK_MS)
+				continue;
+			for (cs = 0; cs < 2; cs++) {
+				struct amp_pwr_side *d = &amp_pwr_res.a[cs];
+
+				if (amp_read(s, cs, AMP_REG_IRQ1_STATUS1, &d->st1_tone) != AMP_OK || (d->st1_tone & AMP_ERR_BITS))
+					d->err = 1;
+			}
+			if (l->err || r->err) {
+				amp_pwr_res.errstop = 1;
+				ms++;
+				break;
+			}
+		}
+		amp_pwr_res.tone_ms = ms;
+		if (amp_a9_cb.tone)
+			amp_a9_cb.tone(amp_a9_cb.ctx, 0);
+	}
+	/* the stock power-down, each stage on L then R */
+	amp_pwr_down_mute(s, 0, l);
+	amp_pwr_down_mute(s, 1, r);
+	amp_pwr_down_adc(s, 0, l);
+	amp_pwr_down_adc(s, 1, r);
+	amp_pwr_down_amp(s, 0, l);
+	amp_pwr_down_amp(s, 1, r);
+	amp_pwr_down_aif(s, 0, l);
+	amp_pwr_down_aif(s, 1, r);
+	amp_pwr_line("L", l);
+	amp_pwr_line("R", r);
+}

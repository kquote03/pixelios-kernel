#!/usr/bin/env python3
"""phone-battery: read the battery voltage the bootloader reports (TP-031).

  tools/phone-battery [--record RUN_DIR] [--min MV]

Only `fastboot getvar product|battery-voltage|battery-soc-ok`, each bounded (PB_TIMEOUT, default 8 s), and only when
`product` equals $BOARD (tools/boards.py target_board, default bluejay; AGENTS.md rule 2). Never `fastboot oem`, flash or reboot.
Last line: RESULT: PASS battery-voltage=NNNN mV soc-ok=yes|no|? (exit 0) | FAIL ... (exit 1: variable missing, or below --min)
| ERROR ... (exit 2: no fastboot device, wrong product, timeout). --record merges battery_mv / battery_soc_ok into RUN_DIR/run.json.
Env (tests): PB_FASTBOOT fastboot binary, PB_TIMEOUT seconds.
"""
import json, os, re, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)


def getvar(name):
    exe = os.environ.get("PB_FASTBOOT", "fastboot")
    try:
        p = subprocess.run([exe, "getvar", name], capture_output=True, text=True, timeout=float(os.environ.get("PB_TIMEOUT", "8")))
    except subprocess.TimeoutExpired:
        return None
    m = re.search(r"^%s:\s*(.*?)\s*$" % re.escape(name), p.stderr + p.stdout, re.M)
    return m.group(1) if m else ""


def main(argv):
    rec, mn = None, None
    i = 0
    while i < len(argv):
        if argv[i] == "--record" and i + 1 < len(argv):
            rec = argv[i + 1]; i += 2
        elif argv[i] == "--min" and i + 1 < len(argv):
            mn = int(argv[i + 1]); i += 2
        else:
            print("RESULT: ERROR unknown argument %r" % argv[i]); return 2
    import boards
    try:
        board = boards.target_board()
    except SystemExit as e:
        print("RESULT: ERROR %s" % e); return 2
    prod = getvar("product")
    if prod is None:
        print("RESULT: ERROR fastboot getvar product timed out"); return 2
    if prod != board:
        print("RESULT: ERROR product=%r is not BOARD=%s; not touched" % (prod, board)); return 2
    mv = getvar("battery-voltage")
    if mv is None:
        print("RESULT: ERROR getvar battery-voltage timed out"); return 2
    ok = getvar("battery-soc-ok")
    print("battery-voltage: %s" % mv)
    print("battery-soc-ok: %s" % ok)
    m = re.match(r"(\d+)", mv or "")
    if not m:
        print("RESULT: FAIL battery-voltage missing (%r)" % mv); return 1
    v = int(m.group(1))
    if rec:
        p = os.path.join(rec, "run.json")
        j = {}
        if os.path.exists(p):
            with open(p) as f:
                j = json.load(f)
        j["battery_mv"] = v
        j["battery_soc_ok"] = ok or "?"
        with open(p, "w") as f:
            json.dump(j, f, indent=1)
    if mn is not None and v < mn:
        print("RESULT: FAIL battery-voltage=%d mV below %d" % (v, mn)); return 1
    print("RESULT: PASS battery-voltage=%d mV soc-ok=%s" % (v, ok or "?"))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

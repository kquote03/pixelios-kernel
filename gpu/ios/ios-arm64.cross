# PixOS G3: Mesa for iOS 16 arm64 (iPhoneOS16.5.sdk from theos), clang 21 from nix as the Mach-O cross compiler, theos ld64 (wrapped)
[constants]
sdk = '/home/kenan1099/pixelios-artifacts/localbuild/theos/sdks/iPhoneOS16.5.sdk'
common = ['--target=arm64-apple-ios16.0', '-isysroot', sdk]


[binaries]
c = ['/nix/store/jskv39ga5njhv0hwv5yxjq56dmc5jjm8-clang-21.1.8/bin/clang'] + common
cpp = ['/nix/store/jskv39ga5njhv0hwv5yxjq56dmc5jjm8-clang-21.1.8/bin/clang++'] + common
objc = ['/nix/store/jskv39ga5njhv0hwv5yxjq56dmc5jjm8-clang-21.1.8/bin/clang'] + common
objcpp = ['/nix/store/jskv39ga5njhv0hwv5yxjq56dmc5jjm8-clang-21.1.8/bin/clang++'] + common
ar = '/nix/store/vravw6d9gh8vmbmmfs5qbgq4nqrmi2y5-llvm-21.1.8/bin/llvm-ar'
strip = '/nix/store/vravw6d9gh8vmbmmfs5qbgq4nqrmi2y5-llvm-21.1.8/bin/llvm-strip'
ranlib = '/nix/store/vravw6d9gh8vmbmmfs5qbgq4nqrmi2y5-llvm-21.1.8/bin/llvm-ranlib'
pkg-config = 'false'

[built-in options]
c_args = ['-miphoneos-version-min=16.0']
cpp_args = ['-miphoneos-version-min=16.0']
c_link_args = ['-miphoneos-version-min=16.0']
cpp_link_args = ['-miphoneos-version-min=16.0']

[properties]
needs_exe_wrapper = true

[host_machine]
system = 'darwin'
subsystem = 'ios'
kernel = 'xnu'
cpu_family = 'aarch64'
cpu = 'arm64'
endian = 'little'

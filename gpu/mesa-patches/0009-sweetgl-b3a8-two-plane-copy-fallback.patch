From: PixOS-Project contributors
Subject: [PATCH 0009] sweetgl: b3a8 two-plane copy fallback (assumed w30r plane 0 + A8 plane 1)

PixOS G6 (run g6-c, docs/research/52 s.14). On top of 0001-0008.
- b3a8 (CA scanout, undocumented): GPU RGBA8 buffer; on flush plane 0 <- XR10 (w30r encoding, ASSUMED), plane 1 <- alpha.
  Plane bpr from IOSurfaceGetBytesPerRowOfPlane, else surface bpr (plane 0) / (alloc - offset) / h & ~63 (plane 1);
  refused unless both planes fit in the alloc size and do not overlap. Layout and assumption logged once.
- host test: the g6-c shape, guard bytes past alloc, exact fit, overlap and out-of-range refusals.

diff --git a/src/gallium/targets/sweetgl/sweetgl_convert.h b/src/gallium/targets/sweetgl/sweetgl_convert.h
index 33dab0b..04f7f99 100644
--- a/src/gallium/targets/sweetgl/sweetgl_convert.h
+++ b/src/gallium/targets/sweetgl/sweetgl_convert.h
@@ -39,6 +39,7 @@ enum sgl_conv {
    SGL_CONV_RGBA8_TO_RGBA8,  /* 'RGBA' */
    SGL_CONV_RGBA8_TO_BGRA8,  /* 'BGRA' */
    SGL_CONV_RGB10A2_TO_W30R, /* 'w30r' */
+   SGL_CONV_RGBA8_TO_B3A8,   /* 'b3a8', two planes: sgl_convert_b3a8 (assumed layout, see below) */
 };
 
 struct sgl_rt_format {
@@ -59,6 +60,9 @@ sgl_rt_format_for(uint32_t fourcc)
    case SGL_FOURCC_BGRA:
       f = (struct sgl_rt_format){SGL_CONV_RGBA8_TO_BGRA8, SGL_GL_RGBA8, SGL_GL_RGBA, SGL_GL_UNSIGNED_BYTE};
       break;
+   case 0x62336138u: /* 'b3a8' */
+      f = (struct sgl_rt_format){SGL_CONV_RGBA8_TO_B3A8, SGL_GL_RGBA8, SGL_GL_RGBA, SGL_GL_UNSIGNED_BYTE};
+      break;
    case SGL_FOURCC_W30R:
       /* ES 3.0 glReadPixels accepts RGBA/UNSIGNED_INT_2_10_10_10_REV for an RGB10_A2 buffer (Mesa readpix.c) */
       f = (struct sgl_rt_format){SGL_CONV_RGB10A2_TO_W30R, SGL_GL_RGB10_A2, SGL_GL_RGBA, SGL_GL_UNSIGNED_INT_2_10_10_10_REV};
@@ -159,6 +163,78 @@ sgl_w30r_rows_to_rgb10a2(uint32_t *dst, const void *src, size_t src_bpr, uint32_
    return 0;
 }
 
+/* 'b3a8' (CA scanout buffers, runs g6-a..c): NOT defined in the iOS 16.5 SDK headers. Layout observed (g6-c): 2 planes,
+ * plane 0 bpe 4 at offset 0, plane 1 bpe 1 at offset 0xa8f000 = 4544 * 2436 rounded up to 4 KiB; per-plane bytes per row read 0.
+ * ASSUMPTION (FourCC 'b3' + 4 bytes/element): plane 0 holds w30r-encoded pixels (XR 10:10:10, B low), plane 1 8-bit alpha.
+ * The GPU renders RGBA8 (8-bit alpha needed; RGB10_A2 has 2); colour widens to 10 bits by bit replication, then XR. */
+#define SGL_FOURCC_B3A8 0x62336138u
+
+struct sgl_b3a8_layout {
+   size_t alloc, off0, bpr0, off1, bpr1; /* bytes from IOSurfaceGetBaseAddress */
+   unsigned bpr1_derived; /* 1: plane-1 bpr derived from (alloc - off1) / h, 64-byte aligned */
+};
+
+/* plane bytes per row: the API value if it covers the row, else (alloc - off) / h rounded down to 64; 0 = refuse */
+static inline size_t
+sgl_plane_bpr(size_t api_bpr, size_t fallback_bpr, size_t alloc, size_t off, uint32_t w, uint32_t h, size_t bpe, unsigned *derived)
+{
+   *derived = 0;
+   if (api_bpr >= (size_t)w * bpe)
+      return api_bpr;
+   if (fallback_bpr >= (size_t)w * bpe)
+      return fallback_bpr;
+   if (h == 0 || off >= alloc)
+      return 0;
+   size_t d = ((alloc - off) / h) & ~(size_t)63;
+   *derived = 1;
+   return d >= (size_t)w * bpe ? d : 0;
+}
+
+/* true when both planes, w x h, fit inside alloc */
+static inline int
+sgl_b3a8_check(const struct sgl_b3a8_layout *l, uint32_t w, uint32_t h)
+{
+   if (w == 0 || h == 0 || l->bpr0 < (size_t)w * 4 || l->bpr1 < (size_t)w)
+      return 0;
+   if (l->off0 > l->alloc || l->off1 > l->alloc)
+      return 0;
+   if ((l->alloc - l->off0 - (size_t)w * 4) / l->bpr0 < (size_t)h - 1 || l->alloc - l->off0 < (size_t)w * 4)
+      return 0;
+   if (l->alloc - l->off1 < (size_t)w || (l->alloc - l->off1 - (size_t)w) / l->bpr1 < (size_t)h - 1)
+      return 0;
+   /* planes must not overlap: plane 0 ends before plane 1 starts or vice versa */
+   size_t end0 = l->off0 + l->bpr0 * ((size_t)h - 1) + (size_t)w * 4, end1 = l->off1 + l->bpr1 * ((size_t)h - 1) + (size_t)w;
+   return end0 <= l->off1 || end1 <= l->off0;
+}
+
+static inline uint32_t
+sgl_unorm10_from_unorm8(uint32_t c)
+{
+   c &= 0xff;
+   return c << 2 | c >> 6;
+}
+
+/* RGBA8 rows (tight, GL readback order) -> b3a8 planes at base; -1 (nothing written) if the layout does not fit */
+static inline int
+sgl_convert_b3a8(void *base, const struct sgl_b3a8_layout *l, const void *src, uint32_t w, uint32_t h)
+{
+   if (!base || !src || !sgl_b3a8_check(l, w, h))
+      return -1;
+   for (uint32_t y = 0; y < h; y++) {
+      const uint8_t *s = (const uint8_t *)src + (size_t)y * w * 4;
+      uint8_t *p0 = (uint8_t *)base + l->off0 + (size_t)y * l->bpr0;
+      uint8_t *p1 = (uint8_t *)base + l->off1 + (size_t)y * l->bpr1;
+      for (uint32_t x = 0; x < w; x++) {
+         uint32_t v = sgl_xr10_from_unorm10(sgl_unorm10_from_unorm8(s[4 * x + 2])) |
+                      sgl_xr10_from_unorm10(sgl_unorm10_from_unorm8(s[4 * x + 1])) << 10 |
+                      sgl_xr10_from_unorm10(sgl_unorm10_from_unorm8(s[4 * x + 0])) << 20;
+         memcpy(p0 + 4 * x, &v, 4);
+         p1[x] = s[4 * x + 3];
+      }
+   }
+   return 0;
+}
+
 /* Sampling fallback for surfaces without a known pixel format (fmt 0x0, 'LA08', run g6-b): upload with the
  * (internalFormat, format, type) CA passed to texImageIOSurface (doc 33 s.2.1: attach_surface_texture maps the surface to
  * them), checked against the surface's bytes per element. ES rules: with UNSIGNED_BYTE / packed 16-bit types the unsized
diff --git a/src/gallium/targets/sweetgl/sweetgl_convert_host_test.c b/src/gallium/targets/sweetgl/sweetgl_convert_host_test.c
index 719237c..dd98f9d 100644
--- a/src/gallium/targets/sweetgl/sweetgl_convert_host_test.c
+++ b/src/gallium/targets/sweetgl/sweetgl_convert_host_test.c
@@ -56,7 +56,7 @@ main(void)
    CHECK(sgl_rt_format_for(0x42475241u).conv == SGL_CONV_RGBA8_TO_BGRA8);
    CHECK(sgl_rt_format_for(0x52474241u).conv == SGL_CONV_RGBA8_TO_RGBA8);
    CHECK(sgl_rt_format_for(0).conv == SGL_CONV_NONE);
-   CHECK(sgl_rt_format_for(0x62336138u).conv == SGL_CONV_NONE); /* 'b3a8' */
+   CHECK(sgl_rt_format_for(0x62336138u).conv == SGL_CONV_RGBA8_TO_B3A8 && sgl_rt_format_for(0x62336138u).internalformat == 0x8058);
    CHECK(sgl_rt_format_for(0x4c413038u).conv == SGL_CONV_NONE); /* 'LA08' */
 
    /* XR range end points and monotonicity; round trip within 1 code */
@@ -168,6 +168,57 @@ main(void)
    sgl_fence_gen(&ft, SGL_FENCE_MAX, many); /* table full: the last names are 0, no overrun */
    CHECK(many[SGL_FENCE_MAX - 1] == 0 && many[0] != 0);
 
+   /* 'b3a8', the g6-c shape: 1125x2436, alloc 13893632, plane 0 bpr 4544 at 0, plane 1 at 0xa8f000, per-plane bpr 0 */
+   {
+      const uint32_t bw = 1125, bh = 2436;
+      const size_t alloc = 13893632, off1 = 0xa8f000;
+      unsigned der = 9;
+      CHECK(off1 == ((4544u * 2436u + 4095u) & ~4095u)); /* plane-1 offset = plane 0 rounded up to 4 KiB */
+      size_t bpr0 = sgl_plane_bpr(0, 4544, alloc, 0, bw, bh, 4, &der);
+      CHECK(bpr0 == 4544 && der == 0);
+      size_t bpr1 = sgl_plane_bpr(0, 0, alloc, off1, bw, bh, 1, &der);
+      CHECK(bpr1 == 1152 && der == 1); /* (13893632 - 0xa8f000) / 2436 = 1158 -> 1152 */
+      CHECK(sgl_plane_bpr(0, 0, alloc, off1, 2400, bh, 1, &der) == 0); /* does not cover the width: refuse */
+      CHECK(sgl_plane_bpr(1200, 0, alloc, off1, bw, bh, 1, &der) == 1200 && der == 0); /* API value wins */
+      struct sgl_b3a8_layout l = {alloc, 0, bpr0, off1, bpr1, 1};
+      CHECK(sgl_b3a8_check(&l, bw, bh));
+      uint8_t *surf = malloc(alloc + 64), *rgba = malloc((size_t)bw * bh * 4);
+      if (!surf || !rgba)
+         return 2;
+      memset(surf, 0x5a, alloc + 64); /* 64 guard bytes past alloc */
+      for (size_t i = 0; i < (size_t)bw * bh; i++) {
+         rgba[4 * i + 0] = 255; /* red */
+         rgba[4 * i + 1] = 0;
+         rgba[4 * i + 2] = (uint8_t)i;
+         rgba[4 * i + 3] = (uint8_t)(i * 7);
+      }
+      CHECK(sgl_convert_b3a8(surf, &l, rgba, bw, bh) == 0);
+      int guard = 1;
+      for (size_t i = alloc; i < alloc + 64; i++)
+         guard &= surf[i] == 0x5a;
+      CHECK(guard); /* nothing written past alloc */
+      size_t li = (size_t)bw * bh - 1;
+      uint32_t p;
+      memcpy(&p, surf + (size_t)(bh - 1) * 4544 + (size_t)(bw - 1) * 4, 4);
+      CHECK(p == (sgl_xr10_from_unorm10(sgl_unorm10_from_unorm8((uint8_t)li)) | 384u << 10 | 895u << 20));
+      CHECK(surf[off1 + (size_t)(bh - 1) * 1152 + bw - 1] == (uint8_t)(li * 7)); /* last alpha byte */
+      CHECK(surf[off1 + 1152 - 1] == 0x5a && surf[4544 - 1] == 0x5a);   /* row padding untouched */
+      CHECK(sgl_unorm10_from_unorm8(255) == 1023 && sgl_unorm10_from_unorm8(0) == 0 && sgl_unorm10_from_unorm8(128) == 514);
+      struct sgl_b3a8_layout bad = l;
+      bad.alloc = off1 + 1152u * (bh - 1) + bw - 1; /* last alpha byte one past alloc */
+      { struct sgl_b3a8_layout ok = l; ok.alloc = bad.alloc + 1; CHECK(sgl_b3a8_check(&ok, bw, bh)); } /* exact fit passes */
+      memset(surf, 0x5a, alloc + 64);
+      CHECK(sgl_convert_b3a8(surf, &bad, rgba, bw, bh) == -1 && surf[0] == 0x5a);
+      bad = l;
+      bad.off1 = 0x1000; /* overlapping planes */
+      CHECK(!sgl_b3a8_check(&bad, bw, bh));
+      bad = l;
+      bad.off1 = alloc + 1;
+      CHECK(!sgl_b3a8_check(&bad, bw, bh));
+      free(surf);
+      free(rgba);
+   }
+
    free(src);
    free(dst);
    printf("sweetgl_convert host test: %d/%d %s\n", pass, total, pass == total ? "PASS" : "FAIL");
diff --git a/src/gallium/targets/sweetgl/sweetgl_eagl.c b/src/gallium/targets/sweetgl/sweetgl_eagl.c
index c759c77..ede2437 100644
--- a/src/gallium/targets/sweetgl/sweetgl_eagl.c
+++ b/src/gallium/targets/sweetgl/sweetgl_eagl.c
@@ -77,6 +77,7 @@ static struct sgl_shadow {
    uint32_t id, w, h;
    struct sgl_rt_format rt;
    void *stage; /* w*h*4 readback buffer */
+   struct sgl_b3a8_layout b3; /* b3a8 only */
    bool dirty;
 } sgl_shadow[SGL_MAX_SHADOW];
 static unsigned sgl_shadow_count;
@@ -357,6 +358,37 @@ shadow_forget(struct sweetgl_context *ctx, GLuint tex)
    pthread_mutex_unlock(&sgl_lock);
 }
 
+/* 'b3a8' plane layout (sweetgl_convert.h: plane 0 = w30r encoding is an ASSUMPTION from the FourCC and 4 bytes/element).
+ * Plane bpr: IOSurfaceGetBytesPerRowOfPlane (reads 0 on this kernel, run g6-c) -> plane 0 the surface bpr, plane 1
+ * (alloc - offset) / height rounded down to 64. Refused (false, logged once) unless 2 planes of bpe 4 / 1 fit inside alloc. */
+static bool
+b3a8_layout(IOSurfaceRef s, uint32_t w, uint32_t h, struct sgl_b3a8_layout *l)
+{
+   uintptr_t base = (uintptr_t)IOSurfaceGetBaseAddress(s);
+   uintptr_t p0 = (uintptr_t)IOSurfaceGetBaseAddressOfPlane(s, 0), p1 = (uintptr_t)IOSurfaceGetBaseAddressOfPlane(s, 1);
+   unsigned d0 = 0, d1 = 0;
+   bool ok = IOSurfaceGetPlaneCount(s) == 2 && IOSurfaceGetBytesPerElementOfPlane(s, 0) == 4 &&
+             IOSurfaceGetBytesPerElementOfPlane(s, 1) == 1 && IOSurfaceGetWidthOfPlane(s, 1) == w &&
+             IOSurfaceGetHeightOfPlane(s, 1) == h && base && p0 >= base && p1 >= base;
+
+   l->alloc = IOSurfaceGetAllocSize(s);
+   if (ok) {
+      l->off0 = p0 - base;
+      l->off1 = p1 - base;
+      l->bpr0 = sgl_plane_bpr(IOSurfaceGetBytesPerRowOfPlane(s, 0), IOSurfaceGetBytesPerRow(s), l->alloc, l->off0, w, h, 4, &d0);
+      l->bpr1 = sgl_plane_bpr(IOSurfaceGetBytesPerRowOfPlane(s, 1), 0, l->alloc, l->off1, w, h, 1, &d1);
+      l->bpr1_derived = d1;
+      ok = l->bpr0 && l->bpr1 && sgl_b3a8_check(l, w, h);
+   }
+   if (first_of_shape(SGL_FOURCC_B3A8, w, h, (uint32_t)l->bpr1, 8))
+      sweetgl_log("sweetgl: 'b3a8' surface %u %ux%u: plane0 off 0x%zx bpr %zu (API %zu), plane1 off 0x%zx bpr %zu (%s), alloc %zu -> %s; "
+                  "plane 0 written as w30r-encoded XR10 and plane 1 as 8-bit alpha: ASSUMED from FourCC + 4 bytes/element, "
+                  "not documented",
+                  IOSurfaceGetID(s), w, h, l->off0, l->bpr0, IOSurfaceGetBytesPerRowOfPlane(s, 0), l->off1, l->bpr1,
+                  d1 ? "derived (alloc-off)/h & ~63" : "API", l->alloc, ok ? "copy fallback" : "refused");
+   return ok;
+}
+
 /* give tex GPU storage of a renderable format and remember to copy it into s on flush; context current */
 static bool
 shadow_attach(struct sgl_eagl *e, GLuint tex, IOSurfaceRef s)
@@ -373,7 +405,11 @@ shadow_attach(struct sgl_eagl *e, GLuint tex, IOSurfaceRef s)
    uint32_t w = (uint32_t)IOSurfaceGetWidth(s), h = (uint32_t)IOSurfaceGetHeight(s);
    size_t bpr = IOSurfaceGetBytesPerRow(s);
 
-   if (rt.conv == SGL_CONV_NONE || w == 0 || h == 0 || bpr < (size_t)w * 4 || IOSurfaceGetPlaneCount(s) > 1)
+   if (rt.conv == SGL_CONV_NONE || w == 0 || h == 0 || bpr < (size_t)w * 4 || (IOSurfaceGetPlaneCount(s) > 1 && rt.conv != SGL_CONV_RGBA8_TO_B3A8))
+      return false;
+   struct sgl_b3a8_layout b3;
+   memset(&b3, 0, sizeof(b3));
+   if (rt.conv == SGL_CONV_RGBA8_TO_B3A8 && !b3a8_layout(s, w, h, &b3))
       return false;
 
    for (unsigned i = 0; i < 8 && glGetError() != GL_NO_ERROR; i++) /* drop errors CA left pending */
@@ -412,6 +448,7 @@ shadow_attach(struct sgl_eagl *e, GLuint tex, IOSurfaceRef s)
       sh->w = w;
       sh->h = h;
       sh->rt = rt;
+      sh->b3 = b3;
       sh->dirty = false;
       __atomic_add_fetch(&sgl_shadow_count, 1, __ATOMIC_RELAXED);
    }
@@ -497,7 +534,9 @@ shadow_copy_locked(struct sgl_shadow *sh)
    size_t bpr = IOSurfaceGetBytesPerRow(sh->surf);
    int r = -1;
    if (base && IOSurfaceGetWidth(sh->surf) == sh->w && IOSurfaceGetHeight(sh->surf) == sh->h)
-      r = sgl_convert_rows(sh->rt.conv, base, bpr, sh->stage, (size_t)sh->w * 4, sh->w, sh->h);
+      r = sh->rt.conv == SGL_CONV_RGBA8_TO_B3A8
+             ? (IOSurfaceGetAllocSize(sh->surf) == sh->b3.alloc ? sgl_convert_b3a8(base, &sh->b3, sh->stage, sh->w, sh->h) : -1)
+             : sgl_convert_rows(sh->rt.conv, base, bpr, sh->stage, (size_t)sh->w * 4, sh->w, sh->h);
    IOSurfaceUnlock(sh->surf, 0, NULL);
    if (r && first_of_shape(sh->rt.conv, sh->w, sh->h, (uint32_t)bpr, 5))
       sweetgl_log("sweetgl: copy fallback: surface %u not written (base %p bpr %zu)", sh->id, base, bpr);

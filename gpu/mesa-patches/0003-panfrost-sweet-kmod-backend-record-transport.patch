diff --git a/src/panfrost/lib/kmod/sweet_kmod.c b/src/panfrost/lib/kmod/sweet_kmod.c
new file mode 100644
index 0000000..c392a45
--- /dev/null
+++ b/src/panfrost/lib/kmod/sweet_kmod.c
@@ -0,0 +1,359 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * Copyright © 2023 Collabora, Ltd. (structure follows panfrost_kmod.c)
+ * SPDX-License-Identifier: MIT
+ *
+ * pan_kmod backend "sweet" (see sweet_kmod.h). One VM, kernel-chosen VAs (AUTO_VA, whole-BO maps, like panfrost),
+ * CPU mappings handed out by the transport (no mmap() of a DRM node), one in-order queue: a BO wait is a wait on the
+ * last submitted seqno.
+ */
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/macros.h"
+#include "util/os_time.h"
+
+#include "pan_kmod_backend.h"
+#include "sweet_kmod.h"
+
+const struct pan_kmod_ops sweet_kmod_ops;
+
+static const struct sweet_transport *sweet_transport;
+
+void
+sweet_kmod_set_transport(const struct sweet_transport *t)
+{
+   sweet_transport = t;
+}
+
+const struct sweet_transport *
+sweet_kmod_get_transport(void)
+{
+#ifdef PAN_SWEET_HAVE_RECORD
+   if (!sweet_transport) {
+      const char *dir = getenv("PAN_SWEET_RECORD");
+      if (dir && *dir)
+         sweet_transport = sweet_record_transport_create(dir);
+   }
+#endif
+   return sweet_transport;
+}
+
+struct sweet_kmod_vm {
+   struct pan_kmod_vm base;
+};
+
+struct sweet_kmod_dev {
+   struct pan_kmod_dev base;
+   const struct sweet_transport *t;
+   struct sweet_kmod_vm *vm;
+   uint64_t va_start, va_end;
+   simple_mtx_t seq_lock;
+   uint64_t last_seq;
+};
+
+struct sweet_kmod_bo {
+   struct pan_kmod_bo base;
+   uint64_t va;
+   void *cpu;
+};
+
+static struct sweet_kmod_dev *
+to_sdev(const struct pan_kmod_dev *dev)
+{
+   return container_of(dev, struct sweet_kmod_dev, base);
+}
+
+bool
+pan_kmod_dev_is_sweet(const struct pan_kmod_dev *dev)
+{
+   return dev && dev->ops == &sweet_kmod_ops;
+}
+
+static struct pan_kmod_dev *
+sweet_kmod_dev_create(int fd, uint32_t flags,
+                      const struct pan_kmod_driver *drv_info,
+                      const struct pan_kmod_allocator *allocator)
+{
+   const struct sweet_transport *t = sweet_kmod_get_transport();
+   struct sweet_transport_info info = {0};
+
+   if (!t || t->query(t->priv, &info)) {
+      mesa_loge("sweet: no transport or query failed");
+      return NULL;
+   }
+   if (info.va_start >= info.va_end || info.va_end > (1ull << 32)) {
+      mesa_loge("sweet: bad GPU VA window %#" PRIx64 "-%#" PRIx64,
+                info.va_start, info.va_end);
+      return NULL;
+   }
+
+   struct sweet_kmod_dev *sdev = pan_kmod_alloc(allocator, sizeof(*sdev));
+   if (!sdev)
+      return NULL;
+
+   pan_kmod_dev_init(&sdev->base, fd, flags, drv_info, &sweet_kmod_ops,
+                     allocator);
+   sdev->t = t;
+   sdev->va_start = info.va_start;
+   sdev->va_end = info.va_end;
+   simple_mtx_init(&sdev->seq_lock, mtx_plain);
+
+   struct pan_kmod_dev_props *props = &sdev->base.props;
+   memset(props, 0, sizeof(*props));
+   props->gpu_id = info.gpu_id;
+   props->shader_present = info.shader_present;
+   props->tiler_features = info.tiler_features;
+   props->mem_features = info.mem_features;
+   props->mmu_features = info.mmu_features;
+   props->l2_features = info.l2_features;
+   for (unsigned i = 0; i < 4; i++)
+      props->texture_features[i] = info.texture_features[i];
+   props->afbc_features = info.afbc_features;
+
+   /* Thread properties: same fallbacks as panfrost_dev_query_thread_props() for arch 9 when a register reads 0. */
+   props->max_threads_per_core = info.thread_max_threads ?: 512;
+   props->max_threads_per_wg =
+      info.thread_max_workgroup ?: props->max_threads_per_core;
+   props->max_tasks_per_core = MAX2(info.thread_features >> 24, 1);
+   props->num_registers_per_core = info.thread_features & 0xffff;
+   if (!props->num_registers_per_core)
+      props->num_registers_per_core = props->max_threads_per_core * 32;
+   props->max_tls_instance_per_core = props->max_threads_per_core;
+
+   props->gpu_can_query_timestamp = false;
+   props->timestamp_device_coherent = true;
+   props->allowed_group_priorities_mask = PAN_KMOD_GROUP_ALLOW_PRIORITY_MEDIUM;
+   /* No alloc-on-fault (no fault-driven heap growth in SweetMali), no WB mmap, not IO coherent (COHERENCY_ENABLE = 31). */
+   props->supported_bo_flags =
+      PAN_KMOD_BO_FLAG_EXECUTABLE | PAN_KMOD_BO_FLAG_NO_MMAP;
+   props->is_io_coherent = false;
+   props->pgsize_bitmap = PAN_PGSIZE_4K;
+
+   return &sdev->base;
+}
+
+static void
+sweet_kmod_dev_destroy(struct pan_kmod_dev *dev)
+{
+   struct sweet_kmod_dev *sdev = to_sdev(dev);
+
+   simple_mtx_destroy(&sdev->seq_lock);
+   pan_kmod_dev_cleanup(dev);
+   pan_kmod_free(dev->allocator, sdev);
+}
+
+static struct pan_kmod_va_range
+sweet_kmod_dev_query_user_va_range(const struct pan_kmod_dev *dev)
+{
+   const struct sweet_kmod_dev *sdev = to_sdev(dev);
+
+   return (struct pan_kmod_va_range){
+      .start = sdev->va_start,
+      .size = sdev->va_end - sdev->va_start,
+   };
+}
+
+static struct pan_kmod_bo *
+sweet_kmod_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
+                    uint64_t size, uint32_t flags)
+{
+   struct sweet_kmod_dev *sdev = to_sdev(dev);
+   uint32_t tflags = 0, handle = 0;
+   uint64_t va = 0, allocated = 0;
+   void *cpu = NULL;
+
+   if (flags & (PAN_KMOD_BO_FLAG_GPU_UNCACHED | PAN_KMOD_BO_FLAG_WB_MMAP))
+      return NULL;
+   if (flags & PAN_KMOD_BO_FLAG_EXECUTABLE)
+      tflags |= SWEET_BO_EXEC;
+   if (flags & PAN_KMOD_BO_FLAG_NO_MMAP)
+      tflags |= SWEET_BO_NO_MMAP;
+   if (flags & PAN_KMOD_BO_FLAG_ALLOC_ON_FAULT)
+      tflags |= SWEET_BO_HEAP | SWEET_BO_NO_MMAP; /* backed eagerly */
+
+   struct sweet_kmod_bo *bo = pan_kmod_dev_alloc(dev, sizeof(*bo));
+   if (!bo)
+      return NULL;
+
+   int e = sdev->t->bo_new(sdev->t->priv, size, tflags, &handle, &va,
+                           &allocated, &cpu);
+   if (e || handle == 0 || va < sdev->va_start || allocated < size ||
+       va + allocated > sdev->va_end) {
+      mesa_loge("sweet: bo_new(size=%" PRIu64 ") failed (%d)", size, e);
+      if (!e && handle)
+         sdev->t->bo_close(sdev->t->priv, handle);
+      pan_kmod_dev_free(dev, bo);
+      return NULL;
+   }
+
+   pan_kmod_bo_init(&bo->base, dev, exclusive_vm, allocated, flags, handle);
+   bo->va = va;
+   bo->cpu = cpu;
+   return &bo->base;
+}
+
+static void
+sweet_kmod_bo_free(struct pan_kmod_bo *bo)
+{
+   struct sweet_kmod_dev *sdev = to_sdev(bo->dev);
+
+   pan_kmod_bo_cleanup(bo);
+   sdev->t->bo_close(sdev->t->priv, bo->handle);
+   pan_kmod_dev_free(bo->dev, bo);
+}
+
+static struct pan_kmod_bo *
+sweet_kmod_bo_import(struct pan_kmod_dev *dev, uint32_t handle, uint64_t size)
+{
+   mesa_loge("sweet: dma-buf import is not supported (IOSurface import: G6)");
+   return NULL;
+}
+
+static off_t
+sweet_kmod_bo_get_mmap_offset(struct pan_kmod_bo *bo)
+{
+   return -1; /* mapping goes through bo_mmap below */
+}
+
+void *sweet_kmod_bo_mmap(struct pan_kmod_bo *bo);
+
+void *
+sweet_kmod_bo_mmap(struct pan_kmod_bo *bo)
+{
+   struct sweet_kmod_bo *sbo = container_of(bo, struct sweet_kmod_bo, base);
+
+   return sbo->cpu ? sbo->cpu : MAP_FAILED;
+}
+
+static bool
+sweet_kmod_bo_wait(struct pan_kmod_bo *bo, int64_t timeout_ns,
+                   bool for_read_only_access)
+{
+   struct sweet_kmod_dev *sdev = to_sdev(bo->dev);
+   uint64_t seq;
+
+   simple_mtx_lock(&sdev->seq_lock);
+   seq = sdev->last_seq;
+   simple_mtx_unlock(&sdev->seq_lock);
+   if (!seq)
+      return true;
+
+   /* timeout_ns is absolute on os_time_get_nano() (docs/research/32 s.2.2 row 10); the transport takes a relative bound */
+   int64_t now = os_time_get_nano();
+   uint64_t rel_us = timeout_ns <= now ? 0 : (uint64_t)(timeout_ns - now) / 1000;
+   if (rel_us > 60000000ull)
+      rel_us = 60000000ull;
+
+   int e = sdev->t->wait(sdev->t->priv, seq, rel_us);
+   return e != ETIMEDOUT;
+}
+
+static struct pan_kmod_vm *
+sweet_kmod_vm_create(struct pan_kmod_dev *dev, uint32_t flags,
+                     uint64_t va_start, uint64_t va_range)
+{
+   struct sweet_kmod_dev *sdev = to_sdev(dev);
+
+   if (sdev->vm || !(flags & PAN_KMOD_VM_FLAG_AUTO_VA)) {
+      mesa_loge("sweet: one AUTO_VA VM per device only");
+      return NULL;
+   }
+
+   struct sweet_kmod_vm *vm = pan_kmod_dev_alloc(dev, sizeof(*vm));
+   if (!vm)
+      return NULL;
+
+   pan_kmod_vm_init(&vm->base, dev, 0, flags);
+   sdev->vm = vm;
+   return &vm->base;
+}
+
+static void
+sweet_kmod_vm_destroy(struct pan_kmod_vm *vm)
+{
+   struct sweet_kmod_dev *sdev = to_sdev(vm->dev);
+
+   sdev->vm = NULL;
+   pan_kmod_vm_cleanup(vm);
+   pan_kmod_dev_free(vm->dev, vm);
+}
+
+static int
+sweet_kmod_vm_bind(struct pan_kmod_vm *vm, enum pan_kmod_vm_op_mode mode,
+                   struct pan_kmod_vm_op *ops, uint32_t op_count)
+{
+   if (mode != PAN_KMOD_VM_OP_MODE_IMMEDIATE &&
+       mode != PAN_KMOD_VM_OP_MODE_DEFER_TO_NEXT_IDLE_POINT)
+      return -1;
+
+   for (uint32_t i = 0; i < op_count; i++) {
+      if (ops[i].type == PAN_KMOD_VM_OP_TYPE_MAP) {
+         struct sweet_kmod_bo *sbo =
+            container_of(ops[i].map.bo, struct sweet_kmod_bo, base);
+
+         if (ops[i].va.start != PAN_KMOD_VM_MAP_AUTO_VA ||
+             ops[i].map.bo_offset != 0 ||
+             ops[i].va.size != ops[i].map.bo->size ||
+             (ops[i].flags & PAN_KMOD_VM_OP_OP_MAP_SPARSE)) {
+            mesa_loge("sweet: only whole-BO AUTO_VA maps");
+            return -1;
+         }
+         ops[i].va.start = sbo->va;
+      } else if (ops[i].type != PAN_KMOD_VM_OP_TYPE_UNMAP) {
+         return -1;
+      }
+   }
+   return 0;
+}
+
+static uint64_t
+sweet_kmod_query_timestamp(const struct pan_kmod_dev *dev)
+{
+   return 0;
+}
+
+static void
+sweet_kmod_bo_set_label(struct pan_kmod_dev *dev, struct pan_kmod_bo *bo,
+                        const char *label)
+{
+   struct sweet_kmod_dev *sdev = to_sdev(dev);
+
+   if (sdev->t->bo_label)
+      sdev->t->bo_label(sdev->t->priv, bo->handle, label);
+}
+
+int
+sweet_kmod_submit(struct pan_kmod_dev *dev, uint64_t jc, uint32_t reqs)
+{
+   struct sweet_kmod_dev *sdev = to_sdev(dev);
+   uint64_t seq = 0;
+
+   int e = sdev->t->submit(sdev->t->priv, jc, reqs, &seq);
+   if (e)
+      return e;
+
+   simple_mtx_lock(&sdev->seq_lock);
+   if (seq > sdev->last_seq)
+      sdev->last_seq = seq;
+   simple_mtx_unlock(&sdev->seq_lock);
+   return 0;
+}
+
+const struct pan_kmod_ops sweet_kmod_ops = {
+   .dev_create = sweet_kmod_dev_create,
+   .dev_destroy = sweet_kmod_dev_destroy,
+   .dev_query_user_va_range = sweet_kmod_dev_query_user_va_range,
+   .bo_alloc = sweet_kmod_bo_alloc,
+   .bo_free = sweet_kmod_bo_free,
+   .bo_import = sweet_kmod_bo_import,
+   .bo_get_mmap_offset = sweet_kmod_bo_get_mmap_offset,
+   .bo_wait = sweet_kmod_bo_wait,
+   .vm_create = sweet_kmod_vm_create,
+   .vm_destroy = sweet_kmod_vm_destroy,
+   .vm_bind = sweet_kmod_vm_bind,
+   .query_timestamp = sweet_kmod_query_timestamp,
+   .bo_set_label = sweet_kmod_bo_set_label,
+};
diff --git a/src/panfrost/lib/kmod/sweet_kmod.h b/src/panfrost/lib/kmod/sweet_kmod.h
new file mode 100644
index 0000000..4fee93b
--- /dev/null
+++ b/src/panfrost/lib/kmod/sweet_kmod.h
@@ -0,0 +1,65 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * pan_kmod backend "sweet": Panfrost on the PixOS SweetMali driver (XNU, Mali-G78 on gs101, one GPU address space,
+ * kernel-chosen GPU VAs in 16 KiB pages, one in-order job queue). The backend talks to a small transport; two
+ * implementations exist:
+ *   - record (sweet_record.c, host): BOs are host memory at VAs handed out with the SweetMali rule; every submit is
+ *     appended to a capture file instead of reaching a GPU (format: PixOS docs/research/52).
+ *   - iokit  (sweet_iokit.c, iOS): the SweetMali user-client selectors of PixOS xnu patch 0105.
+ * Selected before drmGetVersion() in pan_kmod_dev_create(): a transport registered with sweet_kmod_set_transport(),
+ * or the record transport when PAN_SWEET_RECORD=<dir> is set.
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#if defined(__cplusplus)
+extern "C" {
+#endif
+
+/* Same field order as struct sweet_mali_info (PixOS bsd/dev/sweet_mali.h, query selector 0). */
+struct sweet_transport_info {
+   uint32_t gpu_id, l2_features, tiler_features, mem_features, mmu_features,
+      as_present, js_present;
+   uint32_t thread_max_threads, thread_max_workgroup, thread_max_barrier,
+      thread_features, texture_features[4], afbc_features, shader_present;
+   uint64_t va_start, va_end;
+};
+
+#define SWEET_BO_EXEC    (1u << 0) /* GPU may execute (shader code); the only flag the kernel takes */
+#define SWEET_BO_NO_MMAP (1u << 1) /* never CPU-mapped (tiler heap, invisible pools) */
+#define SWEET_BO_HEAP    (1u << 2) /* the tiler heap */
+
+#define SWEET_REQ_FS (1u << 0) /* fragment chain (JS0); otherwise vertex/tiler/compute (JS1) */
+
+struct sweet_transport {
+   void *priv;
+   int (*query)(void *priv, struct sweet_transport_info *out);
+   /* *cpu = CPU mapping (write-combined/uncached on iOS) or NULL with SWEET_BO_NO_MMAP. 0 or an errno. */
+   int (*bo_new)(void *priv, uint64_t size, uint32_t flags, uint32_t *handle,
+                 uint64_t *va, uint64_t *allocated, void **cpu);
+   int (*bo_close)(void *priv, uint32_t handle);
+   void (*bo_label)(void *priv, uint32_t handle, const char *label);
+   int (*submit)(void *priv, uint64_t jc, uint32_t req, uint64_t *seq);
+   /* relative timeout; 0 done, ETIMEDOUT, EIO (job failed), ENXIO */
+   int (*wait)(void *priv, uint64_t seq, uint64_t timeout_us);
+   void (*destroy)(void *priv);
+};
+
+struct pan_kmod_dev;
+
+void sweet_kmod_set_transport(const struct sweet_transport *t);
+const struct sweet_transport *sweet_kmod_get_transport(void);
+const struct sweet_transport *sweet_record_transport_create(const char *dir);
+
+bool pan_kmod_dev_is_sweet(const struct pan_kmod_dev *dev);
+
+/* The DRM_IOCTL_PANFROST_SUBMIT replacement used by gallium's pan_jm.c. Returns 0 or an errno. */
+int sweet_kmod_submit(struct pan_kmod_dev *dev, uint64_t jc, uint32_t reqs);
+
+#if defined(__cplusplus)
+}
+#endif
diff --git a/src/panfrost/lib/kmod/sweet_malijob.h b/src/panfrost/lib/kmod/sweet_malijob.h
new file mode 100644
index 0000000..e741ca3
--- /dev/null
+++ b/src/panfrost/lib/kmod/sweet_malijob.h
@@ -0,0 +1,72 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * .malijob capture file, version 1 (PixOS docs/research/52). All fields little-endian, every offset is from the start
+ * of the file. The PixOS kernel replay (sweetmali=0x100) parses the same layout; keep the two in sync.
+ *
+ *   header   64 B  at 0
+ *   chains   16 B  x n_chains at chain_off (submit order; the kernel submits them one by one, in order)
+ *   rt       64 B  at rt_off when flags & MJ_F_RT (added by the finalize tool, never by the recorder)
+ *   bos      64 B  x n_bos at bo_off
+ *   data     BO contents; BO i has data_len bytes at data_off (16-byte aligned), the rest of its size is zero
+ */
+#pragma once
+
+#include <stdint.h>
+
+#define MJ_MAGIC        "PIXMJOB1"
+#define MJ_VERSION      1u
+#define MJ_HDR_SIZE     64u
+#define MJ_CHAIN_SIZE   16u
+#define MJ_RT_SIZE      64u
+#define MJ_BO_SIZE      64u
+#define MJ_MAX_CHAINS   8u
+#define MJ_MAX_BOS      4096u
+
+#define MJ_F_RT         (1u << 0)
+
+#define MJ_BO_EXEC      (1u << 0)
+#define MJ_BO_NO_MMAP   (1u << 1)
+#define MJ_BO_HEAP      (1u << 2)
+
+#define MJ_REQ_FS       (1u << 0)
+
+#define MJ_FMT_RGBA8    1u /* R8G8B8A8_UNORM, byte order R,G,B,A; a pixel read as LE u32 is R | G<<8 | B<<16 | A<<24 */
+
+struct mj_header {
+   char magic[8];
+   uint32_t version, header_size, gpu_id, n_chains, n_bos, flags;
+   uint64_t file_size;
+   uint32_t chain_off, rt_off, bo_off, data_off;
+   uint32_t reserved[2];
+};
+
+struct mj_chain {
+   uint64_t jc;
+   uint32_t req, reserved;
+};
+
+struct mj_pixel {
+   uint16_t x, y;
+   uint32_t rgba;
+};
+
+struct mj_rt {
+   uint64_t va;
+   uint32_t width, height, stride, format;
+   uint32_t expect_crc, crc_valid; /* crc32 (IEEE/zlib) of height rows of width*4 bytes */
+   struct mj_pixel px[3];
+   uint32_t reserved[2];
+};
+
+struct mj_bo {
+   uint64_t va, size, data_off, data_len;
+   uint32_t flags, reserved;
+   char label[24];
+};
+
+_Static_assert(sizeof(struct mj_header) == MJ_HDR_SIZE, "header");
+_Static_assert(sizeof(struct mj_chain) == MJ_CHAIN_SIZE, "chain");
+_Static_assert(sizeof(struct mj_rt) == MJ_RT_SIZE, "rt");
+_Static_assert(sizeof(struct mj_bo) == MJ_BO_SIZE, "bo");
diff --git a/src/panfrost/lib/kmod/sweet_record.c b/src/panfrost/lib/kmod/sweet_record.c
new file mode 100644
index 0000000..1cdd091
--- /dev/null
+++ b/src/panfrost/lib/kmod/sweet_record.c
@@ -0,0 +1,324 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Record transport for the "sweet" pan_kmod backend (host only). Nothing runs on a GPU: BOs are anonymous host memory
+ * placed at GPU VAs chosen with the SweetMali rule (16 KiB pages, first fit with a rolling hint inside
+ * 0x02000000..0x100000000: PixOS bsd/dev/sweet_mali_pt.h mali_va_alloc, as called by sweet_mali_map with n*4 pages,
+ * align 4). Each submit is queued; a fragment (FS) submit writes one capture file <dir>/capNNN.malijob holding every
+ * live BO and the queued chains (format: sweet_malijob.h). Waits complete at once.
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+
+#include "util/simple_mtx.h"
+#include "sweet_kmod.h"
+#include "sweet_malijob.h"
+
+#define REC_VA_START 0x02000000ull
+#define REC_VA_END   0x100000000ull
+#define REC_PG       0x1000ull
+#define REC_BO_PG    0x4000ull /* XNU page */
+#define REC_PAGES    ((REC_VA_END - REC_VA_START) / REC_PG)
+
+struct rec_bo {
+   uint64_t va, size;
+   uint32_t flags;
+   void *cpu;
+   char label[24];
+};
+
+struct rec {
+   simple_mtx_t lock;
+   char dir[512];
+   uint32_t bits[(REC_PAGES + 31) / 32];
+   uint32_t hint;
+   struct rec_bo bo[MJ_MAX_BOS];
+   struct mj_chain chain[MJ_MAX_CHAINS];
+   unsigned n_chain, n_files;
+   uint64_t seq;
+};
+
+static int
+va_test(const struct rec *r, uint32_t i)
+{
+   return (r->bits[i >> 5] >> (i & 31)) & 1u;
+}
+
+static uint64_t
+va_alloc(struct rec *r, uint32_t npages, uint32_t align)
+{
+   uint32_t total = (uint32_t)REC_PAGES;
+
+   for (int pass = 0; pass < 2; pass++) {
+      uint32_t i = pass ? 0 : r->hint, end = pass ? r->hint + npages : total;
+      i = (i + align - 1) & ~(align - 1);
+      while (i + npages <= total && i < end) {
+         uint32_t k = 0;
+         while (k < npages && !va_test(r, i + k))
+            k++;
+         if (k == npages) {
+            for (uint32_t j = 0; j < npages; j++)
+               r->bits[(i + j) >> 5] |= 1u << ((i + j) & 31);
+            r->hint = i + npages;
+            return REC_VA_START + (uint64_t)i * REC_PG;
+         }
+         i = (i + k + 1 + align - 1) & ~(align - 1);
+      }
+   }
+   return 0;
+}
+
+static void
+va_free(struct rec *r, uint64_t va, uint32_t npages)
+{
+   uint32_t i = (uint32_t)((va - REC_VA_START) / REC_PG);
+
+   for (uint32_t j = 0; j < npages; j++)
+      r->bits[(i + j) >> 5] &= ~(1u << ((i + j) & 31));
+   if (i < r->hint)
+      r->hint = i;
+}
+
+static int
+rec_query(void *priv, struct sweet_transport_info *o)
+{
+   memset(o, 0, sizeof(*o));
+   /* observed on oriole (SWEET GPU probe, patch 0102, PORT.md 2026-11-14) */
+   o->gpu_id = 0x92020010;
+   o->shader_present = 0x779fff;
+   o->l2_features = 0x8130206;
+   o->mem_features = 0x301;
+   o->mmu_features = 0x2830;
+   o->as_present = 0xff;
+   o->js_present = 0x7;
+   /* not yet read on hardware: kbase software model row "tBEx" (google gpu 696fc02,
+    * mali_kbase/backend/gpu/mali_kbase_model_dummy.c:308-322; its mmu_features 0x2830 matches the observed value).
+    * THREAD_FEATURES_PARTIAL(0x6000, 4, 0) = 0x6000 registers | 4 << 16 tasks. texture/afbc 0: no compressed
+    * formats claimed, AFBC "present" (pan_query_afbc treats 0 as supported); the capture forces linear anyway. */
+   o->tiler_features = 0x809;
+   o->thread_max_threads = 0x180;
+   o->thread_max_workgroup = 0x180;
+   o->thread_max_barrier = 0x180;
+   o->thread_features = 0x6000 | (4u << 16);
+   o->va_start = REC_VA_START;
+   o->va_end = REC_VA_END;
+   return 0;
+}
+
+static int
+rec_bo_new(void *priv, uint64_t size, uint32_t flags, uint32_t *handle,
+           uint64_t *va, uint64_t *allocated, void **cpu)
+{
+   struct rec *r = priv;
+   uint64_t len = (size + REC_BO_PG - 1) & ~(REC_BO_PG - 1);
+
+   if (size == 0 || len > (256ull << 20)) /* SWEET_MALI_MAX_BO_BYTES, patch 0105 */
+      return EINVAL;
+
+   simple_mtx_lock(&r->lock);
+   unsigned slot = MJ_MAX_BOS;
+   for (unsigned i = 0; i < MJ_MAX_BOS; i++) {
+      if (!r->bo[i].size) {
+         slot = i;
+         break;
+      }
+   }
+   uint64_t v = slot < MJ_MAX_BOS ? va_alloc(r, (uint32_t)(len / REC_PG), 4) : 0;
+   if (!v) {
+      simple_mtx_unlock(&r->lock);
+      return ENOMEM;
+   }
+   void *p = NULL;
+   if (!(flags & SWEET_BO_NO_MMAP)) {
+      p = mmap(NULL, len, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+      if (p == MAP_FAILED) {
+         va_free(r, v, (uint32_t)(len / REC_PG));
+         simple_mtx_unlock(&r->lock);
+         return ENOMEM;
+      }
+   }
+   r->bo[slot] = (struct rec_bo){.va = v, .size = len, .flags = flags, .cpu = p};
+   simple_mtx_unlock(&r->lock);
+
+   *handle = slot + 1;
+   *va = v;
+   *allocated = len;
+   *cpu = p;
+   return 0;
+}
+
+static int
+rec_bo_close(void *priv, uint32_t handle)
+{
+   struct rec *r = priv;
+
+   if (handle == 0 || handle > MJ_MAX_BOS)
+      return EINVAL;
+   simple_mtx_lock(&r->lock);
+   struct rec_bo *b = &r->bo[handle - 1];
+   if (b->size) {
+      if (b->cpu)
+         munmap(b->cpu, b->size);
+      va_free(r, b->va, (uint32_t)(b->size / REC_PG));
+      memset(b, 0, sizeof(*b));
+   }
+   simple_mtx_unlock(&r->lock);
+   return 0;
+}
+
+static void
+rec_bo_label(void *priv, uint32_t handle, const char *label)
+{
+   struct rec *r = priv;
+
+   if (handle == 0 || handle > MJ_MAX_BOS || !label)
+      return;
+   simple_mtx_lock(&r->lock);
+   snprintf(r->bo[handle - 1].label, sizeof(r->bo[handle - 1].label), "%s", label);
+   simple_mtx_unlock(&r->lock);
+}
+
+static uint64_t
+trimmed_len(const struct rec_bo *b)
+{
+   if (!b->cpu)
+      return 0;
+   const uint8_t *p = b->cpu;
+   uint64_t n = b->size;
+   while (n && !p[n - 1])
+      n--;
+   return (n + 15) & ~15ull;
+}
+
+/* lock held */
+static int
+rec_write(struct rec *r)
+{
+   char path[600];
+   unsigned n_bos = 0;
+
+   for (unsigned i = 0; i < MJ_MAX_BOS; i++)
+      n_bos += r->bo[i].size != 0;
+
+   struct mj_header h = {
+      .version = MJ_VERSION,
+      .header_size = MJ_HDR_SIZE,
+      .gpu_id = 0x92020010,
+      .n_chains = r->n_chain,
+      .n_bos = n_bos,
+      .chain_off = MJ_HDR_SIZE,
+      .rt_off = 0,
+   };
+   memcpy(h.magic, MJ_MAGIC, 8);
+   /* room for the RT block is reserved so the finalize tool can fill it in place */
+   h.bo_off = MJ_HDR_SIZE + MJ_MAX_CHAINS * MJ_CHAIN_SIZE + MJ_RT_SIZE;
+   h.data_off = h.bo_off + n_bos * MJ_BO_SIZE;
+
+   snprintf(path, sizeof(path), "%s/cap%03u.malijob", r->dir, r->n_files++);
+   FILE *f = fopen(path, "wb");
+   if (!f) {
+      fprintf(stderr, "sweet-record: cannot write %s\n", path);
+      return EIO;
+   }
+
+   struct mj_bo *tab = calloc(n_bos ? n_bos : 1, sizeof(*tab));
+   uint64_t off = h.data_off;
+   unsigned k = 0;
+   for (unsigned i = 0; i < MJ_MAX_BOS; i++) {
+      const struct rec_bo *b = &r->bo[i];
+      if (!b->size)
+         continue;
+      tab[k] = (struct mj_bo){.va = b->va, .size = b->size, .data_off = off,
+                              .data_len = trimmed_len(b), .flags = 0};
+      if (b->flags & SWEET_BO_EXEC)
+         tab[k].flags |= MJ_BO_EXEC;
+      if (b->flags & SWEET_BO_NO_MMAP)
+         tab[k].flags |= MJ_BO_NO_MMAP;
+      if (b->flags & SWEET_BO_HEAP)
+         tab[k].flags |= MJ_BO_HEAP;
+      memcpy(tab[k].label, b->label, sizeof(tab[k].label));
+      tab[k].label[sizeof(tab[k].label) - 1] = 0;
+      off += tab[k].data_len;
+      k++;
+   }
+   h.file_size = off;
+
+   struct mj_chain chains[MJ_MAX_CHAINS] = {0};
+   memcpy(chains, r->chain, r->n_chain * sizeof(chains[0]));
+   uint8_t rt_pad[MJ_RT_SIZE] = {0};
+
+   fwrite(&h, sizeof(h), 1, f);
+   fwrite(chains, sizeof(chains), 1, f);
+   fwrite(rt_pad, sizeof(rt_pad), 1, f);
+   fwrite(tab, sizeof(*tab), n_bos, f);
+   k = 0;
+   for (unsigned i = 0; i < MJ_MAX_BOS; i++) {
+      if (!r->bo[i].size)
+         continue;
+      if (tab[k].data_len)
+         fwrite(r->bo[i].cpu, 1, tab[k].data_len, f);
+      k++;
+   }
+   int bad = ferror(f);
+   fclose(f);
+   free(tab);
+   fprintf(stderr, "sweet-record: wrote %s (%u chains, %u BOs, %llu bytes)\n",
+           path, h.n_chains, n_bos, (unsigned long long)h.file_size);
+   return bad ? EIO : 0;
+}
+
+static int
+rec_submit(void *priv, uint64_t jc, uint32_t req, uint64_t *seq)
+{
+   struct rec *r = priv;
+   int e = 0;
+
+   simple_mtx_lock(&r->lock);
+   if (r->n_chain == MJ_MAX_CHAINS) {
+      simple_mtx_unlock(&r->lock);
+      return ENOSPC;
+   }
+   r->chain[r->n_chain++] = (struct mj_chain){.jc = jc, .req = req & MJ_REQ_FS};
+   fprintf(stderr, "sweet-record: submit jc=%#llx req=%#x\n", (unsigned long long)jc, req);
+   if (req & SWEET_REQ_FS) {
+      e = rec_write(r);
+      r->n_chain = 0;
+   }
+   *seq = ++r->seq;
+   simple_mtx_unlock(&r->lock);
+   return e;
+}
+
+static int
+rec_wait(void *priv, uint64_t seq, uint64_t timeout_us)
+{
+   return 0;
+}
+
+const struct sweet_transport *
+sweet_record_transport_create(const char *dir)
+{
+   static struct sweet_transport t;
+   struct rec *r = calloc(1, sizeof(*r));
+
+   if (!r)
+      return NULL;
+   simple_mtx_init(&r->lock, mtx_plain);
+   snprintf(r->dir, sizeof(r->dir), "%s", dir);
+   t = (struct sweet_transport){
+      .priv = r,
+      .query = rec_query,
+      .bo_new = rec_bo_new,
+      .bo_close = rec_bo_close,
+      .bo_label = rec_bo_label,
+      .submit = rec_submit,
+      .wait = rec_wait,
+   };
+   fprintf(stderr, "sweet-record: recording to %s\n", dir);
+   return &t;
+}

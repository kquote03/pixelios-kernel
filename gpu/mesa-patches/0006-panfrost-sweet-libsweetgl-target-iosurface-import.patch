+# Copyright © 2026 PixOS-Project contributors
+# SPDX-License-Identifier: MIT
+#
+# PixOS libsweetgl (iOS): Panfrost gallium + st/mesa GLES + the sweet pan_kmod backend in one dylib, with the libdrm stand-in,
+# the EAGL shim and the GLI wrappers; and sweetgl_selftest, which dlopen()s it.
+
+sweetgl_gli_wrappers_c = custom_target(
+  'sweetgl_gli_wrappers.c',
+  input : ['gen_gli_wrappers.py', main_dispatch_h],
+  output : 'sweetgl_gli_wrappers.c',
+  command : [prog_python, '@INPUT0@', '@INPUT1@', '@OUTPUT@'],
+)
+
+sweetgl_inc = [
+  inc_include, inc_src, inc_mesa, inc_gallium, inc_gallium_aux, inc_util, inc_gallium_drivers, inc_gallium_winsys,
+  inc_panfrost, include_directories('.', '../../../mesa/glapi/glapi/gen', '../../../mesa/glapi', '../../../panfrost/lib'),
+]
+
+sweetgl_exports = files('sweetgl.exports')
+
+libsweetgl = shared_library(
+  'sweetgl',
+  files('sweetgl_frontend.c', 'sweet_drm.c', 'sweetgl_gli.c', 'sweetgl_eagl.c') + [sweetgl_gli_wrappers_c, main_dispatch_h],
+  include_directories : sweetgl_inc,
+  c_args : ['-DGL_SILENCE_DEPRECATION'],
+  gnu_symbol_visibility : 'hidden',
+  link_args : [
+    '-Wl,-exported_symbols_list,' + join_paths(meson.current_source_dir(), 'sweetgl.exports'),
+    '-Wl,-dead_strip', '-Wl,-install_name,/usr/lib/libsweetgl.dylib',
+    '-framework', 'IOKit', '-framework', 'IOSurface', '-framework', 'CoreFoundation', '-lobjc',
+  ],
+  link_depends : sweetgl_exports,
+  link_with : [libmesa, libgallium, libglapi],
+  link_whole : [libglapi_bridge],
+  dependencies : [driver_panfrost, dep_libdrm, dep_thread, idep_mesautil, idep_nir, idep_xmlconfig],
+  name_prefix : 'lib',
+  install : true,
+)
+
+sweetgl_selftest = executable(
+  'sweetgl_selftest',
+  files('sweetgl_selftest.c'),
+  include_directories : [inc_include],
+  link_args : ['-framework', 'IOSurface', '-framework', 'CoreFoundation'],
+  install : true,
+)
diff --git a/src/gallium/targets/sweetgl/sweet_drm.c b/src/gallium/targets/sweetgl/sweet_drm.c
new file mode 100644
index 0000000..9c10ac7
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweet_drm.c
@@ -0,0 +1,360 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * libdrm stand-in for libsweetgl (declarations: include/darwin-sweet/xf86drm.h). iOS has no DRM node: BOs, the VM and job
+ * submission go through the "sweet" pan_kmod backend (SweetMali IOKit user client), so what is left of libdrm is:
+ *
+ *  - syncobjs (docs/research/32 s.2.5). gallium panfrost needs working ones (pan_context.c creates ctx->syncobj and fails
+ *    without it; fences export/import sync files and wait on them). SweetMali has ONE in-order job queue and the sweet
+ *    submit path does not pass out_sync, so a syncobj carries no seqno: waiting on any unsignalled syncobj means "every
+ *    chain submitted so far has completed" (sweet_kmod_wait_idle). That over-waits (it also waits for later work), never
+ *    under-waits. Signalled/unsignalled state is tracked per handle so that Query/Wait on a never-submitted syncobj return
+ *    the same answers DRM would for the patterns Mesa uses (create SIGNALED, reset, signal).
+ *  - sync-file fds: real fds (dup of /dev/null) so Mesa's close() is valid; fd -> nothing (the state is global).
+ *  - prime fds for IOSurface import: sweetgl_frontend.c registers a placeholder fd -> parked SweetMali handle before it calls
+ *    resource_from_handle; drmPrimeFDToHandle resolves it here.
+ *  - everything else (drmIoctl, prime export, caps) fails with ENOSYS/EINVAL like a kernel without the feature.
+ *
+ * Return convention follows libdrm: 0 on success, -1 with errno or a negative errno where libdrm returns the ioctl result.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "xf86drm.h"
+#include "util/os_time.h"
+#include "kmod/sweet_kmod.h"
+
+#include "sweetgl_priv.h"
+
+#define SWEET_SYNCOBJ_MAX 1024
+#define SWEET_PRIME_MAX   64
+
+static pthread_mutex_t drm_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct {
+   bool used;
+   bool signalled;
+} syncobjs[SWEET_SYNCOBJ_MAX + 1]; /* handle 0 is invalid */
+static struct {
+   int fd;
+   uint32_t handle;
+} primes[SWEET_PRIME_MAX];
+
+static int
+fail(int e)
+{
+   errno = e;
+   return -e;
+}
+
+static bool
+valid_locked(uint32_t h)
+{
+   return h != 0 && h <= SWEET_SYNCOBJ_MAX && syncobjs[h].used;
+}
+
+int
+drmIoctl(int fd, unsigned long request, void *arg)
+{
+   errno = ENOSYS;
+   return -1;
+}
+
+int
+drmCommandWrite(int fd, unsigned long drmCommandIndex, void *data, unsigned long size)
+{
+   return fail(ENOSYS);
+}
+
+drmVersionPtr
+drmGetVersion(int fd)
+{
+   /* never reached for the sweet backend (pan_kmod_dev_create selects it before drmGetVersion); a name no backend matches */
+   drmVersionPtr v = calloc(1, sizeof(*v));
+   if (!v)
+      return NULL;
+   v->version_major = 1;
+   v->name = strdup("sweet");
+   v->name_len = v->name ? (int)strlen(v->name) : 0;
+   v->date = strdup("");
+   v->desc = strdup("PixOS SweetMali");
+   v->desc_len = v->desc ? (int)strlen(v->desc) : 0;
+   return v;
+}
+
+void
+drmFreeVersion(drmVersionPtr v)
+{
+   if (!v)
+      return;
+   free(v->name);
+   free(v->date);
+   free(v->desc);
+   free(v);
+}
+
+int
+drmGetCap(int fd, uint64_t capability, uint64_t *value)
+{
+   /* no DRM_CAP_SYNCOBJ_TIMELINE etc.: u_sync_provider then treats timelines as absent */
+   return fail(EINVAL);
+}
+
+void
+sweet_drm_prime_register(int fd, uint32_t handle)
+{
+   pthread_mutex_lock(&drm_lock);
+   for (unsigned i = 0; i < SWEET_PRIME_MAX; i++) {
+      if (primes[i].handle == 0) {
+         primes[i].fd = fd;
+         primes[i].handle = handle;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&drm_lock);
+}
+
+void
+sweet_drm_prime_unregister(int fd)
+{
+   pthread_mutex_lock(&drm_lock);
+   for (unsigned i = 0; i < SWEET_PRIME_MAX; i++) {
+      if (primes[i].handle && primes[i].fd == fd)
+         primes[i].handle = 0;
+   }
+   pthread_mutex_unlock(&drm_lock);
+}
+
+int
+drmPrimeFDToHandle(int fd, int prime_fd, uint32_t *handle)
+{
+   int ret = fail(EBADF);
+
+   pthread_mutex_lock(&drm_lock);
+   for (unsigned i = 0; i < SWEET_PRIME_MAX; i++) {
+      if (primes[i].handle && primes[i].fd == prime_fd) {
+         *handle = primes[i].handle;
+         ret = 0;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&drm_lock);
+   return ret;
+}
+
+int
+drmPrimeHandleToFD(int fd, uint32_t handle, uint32_t flags, int *prime_fd)
+{
+   return fail(ENOSYS); /* no export: CA never asks for one (docs/research/32 s.2.2 row 18) */
+}
+
+int
+drmCloseBufferHandle(int fd, uint32_t handle)
+{
+   /* only pan_kmod_bo_import's error path reaches this on the sweet backend: drop a parked IOSurface import */
+   sweet_kmod_import_drop(handle);
+   return 0;
+}
+
+int
+drmSyncobjCreate(int fd, uint32_t flags, uint32_t *handle)
+{
+   int ret = fail(ENOMEM);
+
+   pthread_mutex_lock(&drm_lock);
+   for (uint32_t h = 1; h <= SWEET_SYNCOBJ_MAX; h++) {
+      if (!syncobjs[h].used) {
+         syncobjs[h].used = true;
+         syncobjs[h].signalled = (flags & DRM_SYNCOBJ_CREATE_SIGNALED) != 0;
+         *handle = h;
+         ret = 0;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&drm_lock);
+   return ret;
+}
+
+int
+drmSyncobjDestroy(int fd, uint32_t handle)
+{
+   int ret = fail(EINVAL);
+
+   pthread_mutex_lock(&drm_lock);
+   if (valid_locked(handle)) {
+      syncobjs[handle].used = false;
+      ret = 0;
+   }
+   pthread_mutex_unlock(&drm_lock);
+   return ret;
+}
+
+/* a fresh real fd standing for "the queue as of now" */
+static int
+new_sync_fd(void)
+{
+   return open("/dev/null", O_RDONLY | O_CLOEXEC);
+}
+
+int
+drmSyncobjHandleToFD(int fd, uint32_t handle, int *obj_fd)
+{
+   return drmSyncobjExportSyncFile(fd, handle, obj_fd);
+}
+
+int
+drmSyncobjFDToHandle(int fd, int obj_fd, uint32_t *handle)
+{
+   int ret = drmSyncobjCreate(fd, 0, handle);
+   return ret;
+}
+
+int
+drmSyncobjImportSyncFile(int fd, uint32_t handle, int sync_file_fd)
+{
+   int ret = fail(EINVAL);
+
+   pthread_mutex_lock(&drm_lock);
+   if (valid_locked(handle)) {
+      syncobjs[handle].signalled = false; /* resolves on the next wait (queue idle) */
+      ret = 0;
+   }
+   pthread_mutex_unlock(&drm_lock);
+   return ret;
+}
+
+int
+drmSyncobjExportSyncFile(int fd, uint32_t handle, int *sync_file_fd)
+{
+   pthread_mutex_lock(&drm_lock);
+   bool ok = valid_locked(handle);
+   pthread_mutex_unlock(&drm_lock);
+   if (!ok) {
+      *sync_file_fd = -1;
+      return fail(EINVAL);
+   }
+   *sync_file_fd = new_sync_fd();
+   return *sync_file_fd < 0 ? fail(errno) : 0;
+}
+
+static int
+wait_handles(uint32_t *handles, unsigned num_handles, int64_t timeout_nsec, uint32_t *first_signaled)
+{
+   bool need_wait = false;
+
+   pthread_mutex_lock(&drm_lock);
+   for (unsigned i = 0; i < num_handles; i++) {
+      if (!valid_locked(handles[i])) {
+         pthread_mutex_unlock(&drm_lock);
+         return fail(EINVAL);
+      }
+      /* no per-syncobj seqno (no out_sync on the sweet submit path), so even a "signalled" one may stand for work
+       * submitted after it was signalled (ctx->syncobj is created signalled and reused for every batch): always wait for
+       * the queue; on an idle queue that is one bounded selector-4 call or nothing (sweet_kmod_wait_idle with no submit) */
+      need_wait = true;
+   }
+   pthread_mutex_unlock(&drm_lock);
+
+   if (need_wait) {
+      /* timeout_nsec is absolute on os_time_get_nano(), like DRM's (docs/research/32 s.5 J); wait_idle bounds it */
+      int e = sweet_kmod_wait_idle(timeout_nsec);
+      if (e == ETIMEDOUT)
+         return fail(ETIME);
+      if (e)
+         return fail(e);
+      pthread_mutex_lock(&drm_lock);
+      for (unsigned i = 0; i < num_handles; i++) {
+         if (valid_locked(handles[i]))
+            syncobjs[handles[i]].signalled = true;
+      }
+      pthread_mutex_unlock(&drm_lock);
+   }
+   if (first_signaled)
+      *first_signaled = 0;
+   return 0;
+}
+
+int
+drmSyncobjWait(int fd, uint32_t *handles, unsigned num_handles, int64_t timeout_nsec, unsigned flags,
+               uint32_t *first_signaled)
+{
+   return wait_handles(handles, num_handles, timeout_nsec, first_signaled);
+}
+
+int
+drmSyncobjTimelineWait(int fd, uint32_t *handles, uint64_t *points, unsigned num_handles, int64_t timeout_nsec,
+                       unsigned flags, uint32_t *first_signaled)
+{
+   return wait_handles(handles, num_handles, timeout_nsec, first_signaled);
+}
+
+static int
+set_state(const uint32_t *handles, uint32_t count, bool signalled)
+{
+   int ret = 0;
+
+   pthread_mutex_lock(&drm_lock);
+   for (uint32_t i = 0; i < count; i++) {
+      if (!valid_locked(handles[i])) {
+         ret = fail(EINVAL);
+         break;
+      }
+      syncobjs[handles[i]].signalled = signalled;
+   }
+   pthread_mutex_unlock(&drm_lock);
+   return ret;
+}
+
+int
+drmSyncobjReset(int fd, const uint32_t *handles, uint32_t handle_count)
+{
+   return set_state(handles, handle_count, false);
+}
+
+int
+drmSyncobjSignal(int fd, const uint32_t *handles, uint32_t handle_count)
+{
+   return set_state(handles, handle_count, true);
+}
+
+int
+drmSyncobjTimelineSignal(int fd, const uint32_t *handles, uint64_t *points, uint32_t handle_count)
+{
+   return set_state(handles, handle_count, true);
+}
+
+int
+drmSyncobjQuery2(int fd, uint32_t *handles, uint64_t *points, uint32_t handle_count, uint32_t flags)
+{
+   int ret = 0;
+
+   pthread_mutex_lock(&drm_lock);
+   for (uint32_t i = 0; i < handle_count; i++) {
+      if (!valid_locked(handles[i])) {
+         ret = fail(EINVAL);
+         break;
+      }
+      points[i] = syncobjs[handles[i]].signalled ? 1 : 0;
+   }
+   pthread_mutex_unlock(&drm_lock);
+   return ret;
+}
+
+int
+drmSyncobjTransfer(int fd, uint32_t dst_handle, uint64_t dst_point, uint32_t src_handle, uint64_t src_point,
+                   uint32_t flags)
+{
+   int ret = fail(EINVAL);
+
+   pthread_mutex_lock(&drm_lock);
+   if (valid_locked(dst_handle) && valid_locked(src_handle)) {
+      syncobjs[dst_handle].signalled = syncobjs[src_handle].signalled;
+      ret = 0;
+   }
+   pthread_mutex_unlock(&drm_lock);
+   return ret;
+}

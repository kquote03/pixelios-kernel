diff --git a/src/gallium/targets/sweetgl/gen_gli_wrappers.py b/src/gallium/targets/sweetgl/gen_gli_wrappers.py
new file mode 100644
index 0000000..8f172d2
--- /dev/null
+++ b/src/gallium/targets/sweetgl/gen_gli_wrappers.py
@@ -0,0 +1,69 @@
+# Copyright © 2026 PixOS-Project contributors
+# SPDX-License-Identifier: MIT
+#
+# libsweetgl: generate the GLI wrappers of the EAGL shim from Mesa's own generated dispatch.h.
+# Apple's GLI calling convention (docs/research/33 s.2.2): every slot is called as fn(rctx, gl-args...). Each wrapper makes rctx
+# current (sweetgl_gli_ensure), refuses to run on a NULL Mesa context (docs/research/36 crash 1: return a zero value instead of
+# dereferencing NULL), and calls the current dispatch table entry. The wrappers are typed C (one per dispatch typedef), so the
+# arm64 argument shift (x1.. -> x0.., stack arguments) is the compiler's business, not a trampoline's.
+# Output: wrappers, a name-sorted table {"glName", fn} and 1036 per-slot trap stubs (slot number known for the log).
+import re
+import sys
+
+GLI_SLOTS = 1036  # Apple GLEngine GLI table size (docs/research/18 s.1.2)
+
+TYPEDEF = re.compile(r'^typedef (.+?) \(GLAPIENTRYP _glptr_(\w+)\)\((.*)\);$')
+
+
+def main():
+    src, out = sys.argv[1], sys.argv[2]
+    funcs = []
+    with open(src) as f:
+        for line in f:
+            m = TYPEDEF.match(line.strip())
+            if m:
+                ret, name, params = m.group(1).strip(), m.group(2), m.group(3).strip()
+                ptypes = [] if params in ('', 'void') else [p.strip() for p in params.split(',')]
+                funcs.append((name, ret, ptypes))
+    seen = set()
+    o = []
+    o.append('/* generated by gen_gli_wrappers.py from dispatch.h: do not edit */')
+    o.append('#include "util/glheader.h"')
+    o.append('#include "glapi/glapi.h"')
+    o.append('#include "dispatch.h"')
+    o.append('#include "sweetgl_gli.h"')
+    o.append('')
+    names = []
+    for name, ret, ptypes in funcs:
+        if name in seen:
+            continue
+        seen.add(name)
+        args = ', '.join('%s a%d' % (t, i) for i, t in enumerate(ptypes))
+        call = ', '.join('a%d' % i for i in range(len(ptypes)))
+        sig = 'void *rctx' + (', ' + args if args else '')
+        o.append('static %s GLAPIENTRY\ngli_%s(%s)\n{' % (ret, name, sig))
+        if ret == 'void':
+            o.append('   if (!sweetgl_gli_ensure(rctx, "gl%s"))\n      return;' % name)
+            o.append('   CALL_%s(GET_DISPATCH(), (%s));\n}\n' % (name, call))
+        else:
+            o.append('   if (!sweetgl_gli_ensure(rctx, "gl%s"))\n      return (%s)0;' % (name, ret))
+            o.append('   return CALL_%s(GET_DISPATCH(), (%s));\n}\n' % (name, call))
+        names.append(name)
+    names.sort(key=lambda n: 'gl' + n)
+    o.append('const struct sweetgl_gli_entry sweetgl_gli_entries[] = {')
+    for n in names:
+        o.append('   { "gl%s", (void *)gli_%s },' % (n, n))
+    o.append('};')
+    o.append('const unsigned sweetgl_gli_entry_count = %d;\n' % len(names))
+    for s in range(GLI_SLOTS):
+        o.append('static uint64_t gli_trap_%d(void) { sweetgl_gli_trap(%d); return 0; }' % (s, s))
+    o.append('void *const sweetgl_gli_traps[%d] = {' % GLI_SLOTS)
+    for s in range(GLI_SLOTS):
+        o.append('   (void *)gli_trap_%d,' % s)
+    o.append('};')
+    with open(out, 'w') as f:
+        f.write('\n'.join(o) + '\n')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/src/gallium/targets/sweetgl/meson.build b/src/gallium/targets/sweetgl/meson.build

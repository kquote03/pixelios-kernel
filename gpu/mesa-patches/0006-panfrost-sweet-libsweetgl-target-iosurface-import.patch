diff --git a/src/gallium/targets/sweetgl/sweetgl.h b/src/gallium/targets/sweetgl/sweetgl.h
new file mode 100644
index 0000000..3789f1c
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweetgl.h
@@ -0,0 +1,67 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * libsweetgl: OpenGL ES 3.x on the PixOS SweetMali kernel driver (Mali-G78, Panfrost gallium, "sweet" pan_kmod backend).
+ * Exported C interface (sweetgl.exports). The GL entry points (gl*) are exported too and dispatch to the calling thread's
+ * current context, so a client either links them or looks them up with sweetgl_get_proc_address().
+ *
+ * Contexts are surfaceless: the client renders into framebuffer objects. IOSurfaces become textures through
+ * sweetgl_image_from_iosurface() (SweetMali selector 5 maps the surface's memory into the GPU address space).
+ * Threading: a context is current on at most one thread; sweetgl_make_current() on another thread fails with -EBUSY
+ * until the owner releases it (sweetgl_make_current(NULL)). Every call returns 0 or a negative errno unless noted.
+ */
+#ifndef SWEETGL_H
+#define SWEETGL_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Mesa builds with -fvisibility=hidden; the exported interface is default visibility (and listed in sweetgl.exports) */
+#define SWEETGL_EXPORT __attribute__((visibility("default")))
+
+struct sweetgl_context;
+struct sweetgl_image;
+
+/* Opens the SweetMali service and creates the pipe_screen (once per process). */
+SWEETGL_EXPORT int sweetgl_init(void);
+/* "Mali-G78 (Panfrost)" style string of the screen, or NULL before init */
+SWEETGL_EXPORT const char *sweetgl_renderer(void);
+
+/* OpenGL ES context, version major.minor (2.0 .. 3.1); share = NULL or a context whose objects are shared. */
+SWEETGL_EXPORT struct sweetgl_context *sweetgl_context_create(int major, int minor, struct sweetgl_context *share, int *err);
+SWEETGL_EXPORT void sweetgl_context_destroy(struct sweetgl_context *ctx);
+/* ctx = NULL releases the calling thread's context */
+SWEETGL_EXPORT int sweetgl_make_current(struct sweetgl_context *ctx);
+SWEETGL_EXPORT struct sweetgl_context *sweetgl_get_current(void);
+/* glFlush / glFinish of the current context; finish waits for the GPU (bounded by the kernel's 60 s wait limit) */
+SWEETGL_EXPORT int sweetgl_flush(int finish);
+
+/* GL entry point by name (NULL if unknown) */
+SWEETGL_EXPORT void *sweetgl_get_proc_address(const char *name);
+
+/*
+ * IOSurface -> GL image. surface_id: IOSurfaceGetID(); cpu: IOSurfaceGetBaseAddress() or NULL; pipe_format: 0 = from the
+ * surface's pixel format ('BGRA' and 'RGBA' 8888 are known). The surface's length must be a whole number of 16 KiB pages
+ * (kernel rule). The image holds the GPU mapping until sweetgl_image_release().
+ */
+SWEETGL_EXPORT struct sweetgl_image *sweetgl_image_from_iosurface(uint32_t surface_id, void *cpu, int *err);
+SWEETGL_EXPORT void sweetgl_image_release(struct sweetgl_image *img);
+SWEETGL_EXPORT void sweetgl_image_size(const struct sweetgl_image *img, uint32_t *width, uint32_t *height, uint32_t *bytes_per_row);
+/* glEGLImageTargetTexture2DOES on the currently bound texture of target (GL_TEXTURE_2D) of the current context */
+SWEETGL_EXPORT int sweetgl_image_bind_texture(struct sweetgl_image *img, unsigned target);
+/* finish GPU work and clean+invalidate the CPU caches of the surface (SweetMali selector 6) before the CPU reads it */
+SWEETGL_EXPORT int sweetgl_image_sync_for_cpu(struct sweetgl_image *img);
+
+/* EAGL shim (sweetgl_eagl.m): swizzles EAGLContext. Returns 0, or -ENOENT if the class is absent, -ENOTSUP if the GLI slot
+ * map is not compiled in (then Apple's EAGLContext is left untouched and CoreAnimation keeps its CPU renderer). */
+SWEETGL_EXPORT int sweetgl_eagl_install(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/gallium/targets/sweetgl/sweetgl_eagl.c b/src/gallium/targets/sweetgl/sweetgl_eagl.c
new file mode 100644
index 0000000..dc74557
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweetgl_eagl.c
@@ -0,0 +1,449 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * libsweetgl EAGL shim: makes -[EAGLContext initWithAPI:properties:] succeed in backboardd with a Mesa/Panfrost context, so
+ * CoreAnimation's EAGLServer picks its GLES renderer (docs/research/33 s.1.1: API must be 3). Written in C against the
+ * Objective-C runtime (no Foundation). Replaced methods (docs/research/18 s.1.2, 33 s.2.1 / s.4 P0):
+ *   -initWithAPI:properties:   API >= 2 -> our context (ES 3.1 for API 3, ES 2.0 for API 2); API 1 -> Apple's
+ *   -dealloc  -API  -setParameter:to:  -getMacroContextPrivate  (GLI table {rctx, disp[1036]}, sweetgl_gli.h)
+ *   -texImageIOSurface:target:internalFormat:width:height:format:type:plane:invert:  (and the public 8-argument form)
+ *   -attachImage:toCoreSurface:invertedRender:
+ *   +setCurrentContext:  +currentContext
+ * Contexts the shim did not create go to Apple's implementations unchanged.
+ * IOSurfaces become textures through SweetMali selector 5 (sweetgl_image_from_iosurface); a 32-entry cache keyed by (surface
+ * id, base address, width, height, bytes per row) shares one Mesa resource between the writer and the readers of a surface
+ * (docs/research/18 s.1.3 item 3). Sampled surfaces the kernel cannot map (length not 16 KiB-paged, unknown format) fall back
+ * to a CPU copy (glTexImage2D); render targets have no fallback (the call returns NO and logs).
+ *
+ * Crash causes of the earlier sweetgl designed around (docs/research/36): (1) a GL call on a thread whose Mesa context is NULL
+ * -> every GLI wrapper checks the context after making rctx current (sweetgl_gli_ensure) and skips the call otherwise; the
+ * context is never left bound on the creating thread and the render thread takes it over. (2) an IOSurface client built from
+ * an all-zero lock result -> a surface whose geometry reads as zero is refused here before anything uses it.
+ */
+#include <errno.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <objc/message.h>
+#include <objc/runtime.h>
+#include <IOSurface/IOSurfaceRef.h>
+
+#include <GLES3/gl3.h>
+#include <GLES2/gl2ext.h>
+
+#include "sweetgl.h"
+#include "sweetgl_gli.h"
+#include "sweetgl_priv.h"
+
+#define SGL_MAX_CTX   64
+#define SGL_IMG_CACHE 32
+#define kEAGLRenderingAPIOpenGLES2 2
+#define kEAGLRenderingAPIOpenGLES3 3
+
+struct sgl_eagl {
+   id obj;
+   unsigned api;
+   struct sweetgl_context *ctx;
+   struct sweetgl_gli_table *gli;
+};
+
+static pthread_mutex_t sgl_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct sgl_eagl sgl_ctx[SGL_MAX_CTX];
+static __thread id tl_current; /* our EAGLContext current on this thread, or nil */
+
+static struct {
+   uint32_t id, w, h, bpr;
+   void *base;
+   uint64_t stamp;
+   struct sweetgl_image *img;
+} sgl_cache[SGL_IMG_CACHE];
+static uint64_t sgl_stamp;
+
+static IMP orig_init, orig_dealloc, orig_api, orig_set_param, orig_macro, orig_teximg9, orig_teximg8, orig_attach,
+   orig_set_current, orig_current;
+
+static struct sgl_eagl *
+find_locked(id obj)
+{
+   if (!obj)
+      return NULL;
+   for (unsigned i = 0; i < SGL_MAX_CTX; i++) {
+      if (sgl_ctx[i].obj == obj)
+         return &sgl_ctx[i];
+   }
+   return NULL;
+}
+
+static struct sgl_eagl *
+find(id obj)
+{
+   pthread_mutex_lock(&sgl_lock);
+   struct sgl_eagl *e = find_locked(obj);
+   pthread_mutex_unlock(&sgl_lock);
+   return e;
+}
+
+/* ---- IOSurface -> image (cache) ---- */
+
+static struct sweetgl_image *
+surface_image(IOSurfaceRef s, bool *fallback_ok)
+{
+   uint32_t sid = IOSurfaceGetID(s);
+   uint32_t w = (uint32_t)IOSurfaceGetWidth(s), h = (uint32_t)IOSurfaceGetHeight(s);
+   uint32_t bpr = (uint32_t)IOSurfaceGetBytesPerRow(s);
+   void *base = IOSurfaceGetBaseAddress(s);
+   struct sweetgl_image *img = NULL;
+
+   *fallback_ok = false;
+   if (w == 0 || h == 0 || bpr == 0 || base == NULL) {
+      /* doc 36 crash 2: a client built from a zero lock result */
+      sweetgl_log("sweetgl: IOSurface %u with empty geometry (%ux%u bpr %u base %p) refused", sid, w, h, bpr, base);
+      return NULL;
+   }
+
+   pthread_mutex_lock(&sgl_lock);
+   unsigned victim = 0;
+   for (unsigned i = 0; i < SGL_IMG_CACHE; i++) {
+      if (sgl_cache[i].img && sgl_cache[i].id == sid && sgl_cache[i].base == base && sgl_cache[i].w == w &&
+          sgl_cache[i].h == h && sgl_cache[i].bpr == bpr) {
+         sgl_cache[i].stamp = ++sgl_stamp;
+         img = sgl_cache[i].img;
+         pthread_mutex_unlock(&sgl_lock);
+         return img;
+      }
+      /* victim: an empty slot, else the least recently used */
+      if (sgl_cache[victim].img && (!sgl_cache[i].img || sgl_cache[i].stamp < sgl_cache[victim].stamp))
+         victim = i;
+   }
+   pthread_mutex_unlock(&sgl_lock);
+
+   int err = 0;
+   img = sweetgl_image_from_iosurface(sid, base, &err);
+   if (!img) {
+      sweetgl_log("sweetgl: IOSurface %u (%ux%u bpr %u fmt 0x%x) not importable (%d)", sid, w, h, bpr,
+                  (unsigned)IOSurfaceGetPixelFormat(s), err);
+      *fallback_ok = true;
+      return NULL;
+   }
+
+   pthread_mutex_lock(&sgl_lock);
+   struct sweetgl_image *old = sgl_cache[victim].img;
+   sgl_cache[victim].id = sid;
+   sgl_cache[victim].base = base;
+   sgl_cache[victim].w = w;
+   sgl_cache[victim].h = h;
+   sgl_cache[victim].bpr = bpr;
+   sgl_cache[victim].stamp = ++sgl_stamp;
+   sgl_cache[victim].img = img;
+   pthread_mutex_unlock(&sgl_lock);
+   /* textures that still use the evicted image keep its pipe_resource alive (reference counted) */
+   sweetgl_image_release(old);
+   return img;
+}
+
+/* sampled-surface fallback: copy the pixels (BGRA/RGBA 8888 only) into the bound texture */
+static bool
+copy_surface(IOSurfaceRef s, GLenum target)
+{
+   uint32_t fmt = (uint32_t)IOSurfaceGetPixelFormat(s);
+   GLenum glfmt;
+
+   if (fmt == 0x42475241)
+      glfmt = GL_BGRA_EXT;
+   else if (fmt == 0x52474241)
+      glfmt = GL_RGBA;
+   else
+      return false;
+   size_t bpr = IOSurfaceGetBytesPerRow(s);
+   if (bpr % 4)
+      return false;
+   IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL);
+   glPixelStorei(GL_UNPACK_ROW_LENGTH, (GLint)(bpr / 4));
+   glTexImage2D(target, 0, (GLint)glfmt, (GLsizei)IOSurfaceGetWidth(s), (GLsizei)IOSurfaceGetHeight(s), 0, glfmt,
+                GL_UNSIGNED_BYTE, IOSurfaceGetBaseAddress(s));
+   glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+   IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+   return true;
+}
+
+static bool
+make_ours_current(struct sgl_eagl *e)
+{
+   return e && sweetgl_gli_ensure(e->ctx, "EAGL");
+}
+
+/* ---- replaced methods ---- */
+
+static id
+m_init(id self, SEL cmd, unsigned long api, id props)
+{
+   if (api < kEAGLRenderingAPIOpenGLES2 || api > kEAGLRenderingAPIOpenGLES3)
+      return ((id(*)(id, SEL, unsigned long, id))orig_init)(self, cmd, api, props);
+
+   int err = 0;
+   struct sweetgl_context *ctx =
+      sweetgl_context_create(api == kEAGLRenderingAPIOpenGLES3 ? 3 : 2, api == kEAGLRenderingAPIOpenGLES3 ? 1 : 0, NULL,
+                             &err);
+   struct sweetgl_gli_table *gli = ctx ? calloc(1, sizeof(*gli)) : NULL;
+   int mapped = gli ? sweetgl_gli_fill(gli, ctx) : -ENOMEM;
+   if (!ctx || mapped <= 0) {
+      sweetgl_log("sweetgl: initWithAPI:%lu refused (context %d, GLI map %d)", api, err, mapped);
+      free(gli);
+      sweetgl_context_destroy(ctx);
+      /* Apple's init then fails as it did before the shim (CA falls back to its CPU renderer) or succeeds */
+      return ((id(*)(id, SEL, unsigned long, id))orig_init)(self, cmd, api, props);
+   }
+
+   pthread_mutex_lock(&sgl_lock);
+   struct sgl_eagl *slot = find_locked(nil);
+   for (unsigned i = 0; !slot && i < SGL_MAX_CTX; i++) {
+      if (!sgl_ctx[i].obj)
+         slot = &sgl_ctx[i];
+   }
+   if (slot) {
+      slot->obj = self;
+      slot->api = (unsigned)api;
+      slot->ctx = ctx;
+      slot->gli = gli;
+   }
+   pthread_mutex_unlock(&sgl_lock);
+   if (!slot) {
+      free(gli);
+      sweetgl_context_destroy(ctx);
+      return ((id(*)(id, SEL, unsigned long, id))orig_init)(self, cmd, api, props);
+   }
+   sweetgl_log("sweetgl: EAGLContext %p API %lu -> %s, %d GLI slots", (void *)self, api, sweetgl_renderer(), mapped);
+   return self;
+}
+
+static void
+m_dealloc(id self, SEL cmd)
+{
+   pthread_mutex_lock(&sgl_lock);
+   struct sgl_eagl *e = find_locked(self);
+   struct sgl_eagl copy = e ? *e : (struct sgl_eagl){0};
+   if (e)
+      memset(e, 0, sizeof(*e));
+   pthread_mutex_unlock(&sgl_lock);
+   if (!copy.obj) {
+      ((void (*)(id, SEL))orig_dealloc)(self, cmd);
+      return;
+   }
+   if (tl_current == self)
+      tl_current = nil;
+   sweetgl_context_destroy(copy.ctx);
+   free(copy.gli);
+   /* our instances never ran Apple's init: skip EAGLContext's dealloc, run NSObject's */
+   struct objc_super sup = {self, class_getSuperclass(objc_getClass("EAGLContext"))};
+   ((void (*)(struct objc_super *, SEL))objc_msgSendSuper)(&sup, cmd);
+}
+
+static unsigned long
+m_api(id self, SEL cmd)
+{
+   struct sgl_eagl *e = find(self);
+   return e ? e->api : ((unsigned long (*)(id, SEL))orig_api)(self, cmd);
+}
+
+static bool
+m_set_param(id self, SEL cmd, int pname, const int *value)
+{
+   if (find(self))
+      return true; /* CA: setParameter:0x260 to:&0 (docs/research/33 s.1.1); ignored */
+   return ((bool (*)(id, SEL, int, const int *))orig_set_param)(self, cmd, pname, value);
+}
+
+static void *
+m_macro(id self, SEL cmd)
+{
+   struct sgl_eagl *e = find(self);
+   return e ? (void *)e->gli : ((void *(*)(id, SEL))orig_macro)(self, cmd);
+}
+
+static bool
+tex_iosurface(struct sgl_eagl *e, IOSurfaceRef s, unsigned long target)
+{
+   if (!s || target != GL_TEXTURE_2D || !make_ours_current(e))
+      return false;
+   bool fallback_ok;
+   struct sweetgl_image *img = surface_image(s, &fallback_ok);
+   if (img)
+      return sweetgl_image_bind_texture(img, (unsigned)target) == 0;
+   return fallback_ok && copy_surface(s, (GLenum)target);
+}
+
+static bool
+m_teximg9(id self, SEL cmd, IOSurfaceRef s, unsigned long target, unsigned long ifmt, uint32_t w, uint32_t h,
+          unsigned long fmt, unsigned long type, uint32_t plane, bool invert)
+{
+   struct sgl_eagl *e = find(self);
+   if (!e)
+      return ((bool (*)(id, SEL, IOSurfaceRef, unsigned long, unsigned long, uint32_t, uint32_t, unsigned long,
+                        unsigned long, uint32_t, bool))orig_teximg9)(self, cmd, s, target, ifmt, w, h, fmt, type, plane,
+                                                                    invert);
+   if (plane != 0)
+      return false;
+   return tex_iosurface(e, s, target);
+}
+
+static bool
+m_teximg8(id self, SEL cmd, IOSurfaceRef s, unsigned long target, unsigned long ifmt, uint32_t w, uint32_t h,
+          unsigned long fmt, unsigned long type, uint32_t plane)
+{
+   struct sgl_eagl *e = find(self);
+   if (!e)
+      return ((bool (*)(id, SEL, IOSurfaceRef, unsigned long, unsigned long, uint32_t, uint32_t, unsigned long,
+                        unsigned long, uint32_t))orig_teximg8)(self, cmd, s, target, ifmt, w, h, fmt, type, plane);
+   if (plane != 0)
+      return false;
+   return tex_iosurface(e, s, target);
+}
+
+static bool
+m_attach(id self, SEL cmd, uint32_t tex, IOSurfaceRef s, bool inverted)
+{
+   struct sgl_eagl *e = find(self);
+   if (!e)
+      return ((bool (*)(id, SEL, uint32_t, IOSurfaceRef, bool))orig_attach)(self, cmd, tex, s, inverted);
+   if (!s || !make_ours_current(e))
+      return false;
+   bool fallback_ok;
+   struct sweetgl_image *img = surface_image(s, &fallback_ok);
+   if (!img) {
+      sweetgl_log("sweetgl: attachImage: surface %u cannot be a render target (no copy fallback)", IOSurfaceGetID(s));
+      return false;
+   }
+   GLint prev = 0;
+   glGetIntegerv(GL_TEXTURE_BINDING_2D, &prev);
+   glBindTexture(GL_TEXTURE_2D, tex);
+   int r = sweetgl_image_bind_texture(img, GL_TEXTURE_2D);
+   glBindTexture(GL_TEXTURE_2D, (GLuint)prev);
+   return r == 0;
+}
+
+static bool
+m_set_current(id cls, SEL cmd, id ctx)
+{
+   struct sgl_eagl *e = find(ctx);
+   if (e) {
+      int r = sweetgl_make_current(e->ctx);
+      if (r == -EBUSY)
+         r = sweetgl_make_current_steal(e->ctx);
+      if (r) {
+         sweetgl_log("sweetgl: setCurrentContext:%p failed (%d)", (void *)ctx, r);
+         return false;
+      }
+      tl_current = ctx;
+      return true;
+   }
+   if (tl_current) {
+      sweetgl_make_current(NULL);
+      tl_current = nil;
+   }
+   return ((bool (*)(id, SEL, id))orig_set_current)(cls, cmd, ctx);
+}
+
+static id
+m_current(id cls, SEL cmd)
+{
+   if (tl_current)
+      return tl_current;
+   return ((id(*)(id, SEL))orig_current)(cls, cmd);
+}
+
+/* replace a method DEFINED by c itself (class_getInstanceMethod would also return an inherited NSObject method, and
+ * method_setImplementation on that would change every class); NULL if c does not define it (then nothing is replaced) */
+static IMP
+swap(Class c, const char *sel, IMP imp)
+{
+   SEL s = sel_registerName(sel);
+   unsigned n = 0;
+   Method *list = class_copyMethodList(c, &n);
+   IMP old = NULL;
+
+   for (unsigned i = 0; list && i < n; i++) {
+      if (method_getName(list[i]) == s) {
+         old = method_setImplementation(list[i], imp);
+         break;
+      }
+   }
+   free(list);
+   return old;
+}
+
+int
+sweetgl_eagl_install(void)
+{
+   static int done = 1;
+   static pthread_mutex_t once = PTHREAD_MUTEX_INITIALIZER;
+
+   pthread_mutex_lock(&once);
+   if (done != 1) {
+      pthread_mutex_unlock(&once);
+      return done;
+   }
+   Class c = objc_getClass("EAGLContext");
+   if (!c) {
+      pthread_mutex_unlock(&once);
+      return -ENOENT; /* OpenGLES not loaded in this process: try again later */
+   }
+   /* without the slot map CA would call traps only: leave Apple's EAGLContext alone (CA keeps its CPU renderer) */
+   struct sweetgl_gli_table probe;
+   int mapped = sweetgl_gli_fill(&probe, NULL);
+   if (mapped <= 0) {
+      sweetgl_log("sweetgl: EAGL shim not installed: no GLI slot map (%d)", mapped);
+      done = -ENOTSUP;
+      pthread_mutex_unlock(&once);
+      return done;
+   }
+   Class meta = object_getClass((id)c);
+   orig_init = swap(c, "initWithAPI:properties:", (IMP)m_init);
+   orig_dealloc = swap(c, "dealloc", (IMP)m_dealloc);
+   orig_api = swap(c, "API", (IMP)m_api);
+   orig_set_param = swap(c, "setParameter:to:", (IMP)m_set_param);
+   orig_macro = swap(c, "getMacroContextPrivate", (IMP)m_macro);
+   orig_teximg9 = swap(c, "texImageIOSurface:target:internalFormat:width:height:format:type:plane:invert:", (IMP)m_teximg9);
+   orig_teximg8 = swap(c, "texImageIOSurface:target:internalFormat:width:height:format:type:plane:", (IMP)m_teximg8);
+   orig_attach = swap(c, "attachImage:toCoreSurface:invertedRender:", (IMP)m_attach);
+   orig_set_current = swap(meta, "setCurrentContext:", (IMP)m_set_current);
+   orig_current = swap(meta, "currentContext", (IMP)m_current);
+   sweetgl_log("sweetgl: EAGL shim installed (%d GLI slots mapped; init %p macro %p attach %p teximg %p/%p setcur %p)", mapped,
+               (void *)orig_init, (void *)orig_macro, (void *)orig_attach, (void *)orig_teximg9, (void *)orig_teximg8,
+               (void *)orig_set_current);
+   done = 0;
+   pthread_mutex_unlock(&once);
+   return 0;
+}
+
+/* ---- injection (DYLD_INSERT_LIBRARIES into backboardd, docs/research/18 s.1.5) ---- */
+
+#include <mach-o/dyld.h>
+
+static void
+sgl_image_added(const struct mach_header *mh, intptr_t slide)
+{
+   static bool settled;
+
+   if (settled)
+      return;
+   int r = sweetgl_eagl_install();
+   if (r != -ENOENT)
+      settled = true; /* installed, or refused for good (no slot map) */
+}
+
+__attribute__((constructor)) static void
+sgl_ctor(void)
+{
+   const char *force = getenv("SWEETGL_EAGL");
+   const char *prog = getprogname();
+
+   /* only the render server, unless forced; SWEETGL_EAGL=0 disables it everywhere */
+   if (force ? strcmp(force, "1") != 0 : (prog == NULL || strcmp(prog, "backboardd") != 0))
+      return;
+   /* runs once for every image already loaded, then for each new one: installs as soon as OpenGLES has registered EAGLContext */
+   _dyld_register_func_for_add_image(sgl_image_added);
+}
diff --git a/src/gallium/targets/sweetgl/sweetgl_frontend.c b/src/gallium/targets/sweetgl/sweetgl_frontend.c
new file mode 100644
index 0000000..147baa4
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweetgl_frontend.c
@@ -0,0 +1,478 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * libsweetgl GL frontend: a pipe_frontend_screen + st_context wrapper over the Panfrost gallium screen, modelled on Mesa's
+ * Haiku frontend (src/gallium/frontends/hgl/hgl.c: st_api_create_context with a frontend screen, st_context_flush,
+ * st_destroy_context). Differences: no drawables at all (surfaceless, st_api_make_current(st, NULL, NULL)), GLES profile,
+ * a hand-built driOptionCache because xmlconfig is disabled on iOS (docs/research/32 s.7 item 8), and EGLImage-style
+ * IOSurface textures through get_egl_image (docs/research/18 s.1.3, 32 s.2.4).
+ *
+ * Design points from PixOS docs/research/36 (the two backboardd crashes of the earlier sweetgl):
+ *   1. make_current reports every failure, a context never stays bound on the thread that created it, and the per-thread
+ *      binding is checked against Mesa's own TLS (sweetgl_get_current() returns NULL if Mesa has no context).
+ *   2. IOSurfaces with zero geometry or an unmappable length are refused before anything reaches gallium.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "frontend/api.h"
+#include "frontend/winsys_handle.h"
+#include "util/driconf.h"
+#include "util/format/u_format.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+#include "util/xmlconfig.h"
+#include "util/u_driconf.h"
+#include "main/glthread.h"
+#include "main/mtypes.h"
+#include "state_tracker/st_context.h"
+#include "drm-uapi/drm_fourcc.h"
+
+#include "panfrost/drm/panfrost_drm_public.h"
+#include "kmod/sweet_kmod.h"
+
+#include "sweetgl.h"
+#include "sweetgl_priv.h"
+
+/* driconf: gallium common options (st/mesa reads them through u_driconf_fill_st_options) + panfrost's own
+ * (panfrost_create_screen queries them; an option missing from the cache is a lookup of an absent key) */
+static const driOptionDescription sweetgl_driconf[] = {
+#include "pipe-loader/driinfo_gallium.h"
+#include "panfrost/driinfo_panfrost.h"
+};
+
+struct sweetgl_screen {
+   struct pipe_frontend_screen base;
+   driOptionCache info, options;
+   int fd;
+   char renderer[128];
+};
+
+struct sweetgl_context {
+   struct st_context *st;
+   pthread_t owner;
+   bool bound;
+};
+
+struct sweetgl_image {
+   struct pipe_resource *tex;
+   enum pipe_format format;
+   uint32_t surface_id, width, height, bytes_per_row, handle;
+};
+
+static struct sweetgl_screen g_screen;
+static pthread_mutex_t g_lock = PTHREAD_MUTEX_INITIALIZER;
+static int g_init_err = 1; /* 1 = not tried */
+static __thread struct sweetgl_context *tl_cur;
+
+static bool
+sweetgl_get_egl_image(struct pipe_frontend_screen *fscreen, void *egl_image, struct st_egl_image *out)
+{
+   struct sweetgl_image *img = egl_image;
+
+   if (!img || !img->tex)
+      return false;
+   memset(out, 0, sizeof(*out));
+   pipe_resource_reference(&out->texture, img->tex); /* "owned by the caller" (api.h): st unreferences it */
+   out->format = img->format;
+   out->level = 0;
+   out->layer = 0;
+   out->internalformat = 0; /* derived from the format */
+   out->imported_dmabuf = false;
+   return true;
+}
+
+static bool
+sweetgl_validate_egl_image(struct pipe_frontend_screen *fscreen, void *egl_image)
+{
+   struct sweetgl_image *img = egl_image;
+
+   return img && img->tex;
+}
+
+static int
+sweetgl_get_param(struct pipe_frontend_screen *fscreen, enum st_manager_param param)
+{
+   return 0;
+}
+
+int
+sweetgl_init(void)
+{
+   pthread_mutex_lock(&g_lock);
+   if (g_init_err != 1) {
+      int e = g_init_err;
+      pthread_mutex_unlock(&g_lock);
+      return e;
+   }
+
+   /* The pan_kmod sweet backend selects the iokit transport by itself on __APPLE__ (sweet_kmod_get_transport); the screen
+    * still wants a dup-able fd (panfrost_drm_screen_create dups it, u_pipe_screen_lookup_or_create keys on it). */
+   int fd = open("/dev/null", O_RDWR | O_CLOEXEC);
+   if (fd < 0) {
+      g_init_err = -errno;
+      pthread_mutex_unlock(&g_lock);
+      return g_init_err;
+   }
+   if (!sweet_kmod_get_transport()) {
+      sweetgl_log("sweetgl: no SweetMali service (IOServiceOpen failed)");
+      close(fd);
+      g_init_err = -ENODEV;
+      pthread_mutex_unlock(&g_lock);
+      return g_init_err;
+   }
+
+   driParseOptionInfo(&g_screen.info, sweetgl_driconf, ARRAY_SIZE(sweetgl_driconf));
+   driParseConfigFiles(&g_screen.options, &g_screen.info,
+                       &(driConfigFileParseParams){.driverName = "panfrost"});
+   struct pipe_screen_config config = {
+      .options = &g_screen.options,
+      .options_info = &g_screen.info,
+   };
+   struct pipe_screen *screen = panfrost_drm_screen_create(fd, &config);
+   if (!screen) {
+      sweetgl_log("sweetgl: panfrost_drm_screen_create failed");
+      close(fd);
+      driDestroyOptionCache(&g_screen.options);
+      driDestroyOptionInfo(&g_screen.info);
+      g_init_err = -EIO;
+      pthread_mutex_unlock(&g_lock);
+      return g_init_err;
+   }
+   g_screen.fd = fd;
+   g_screen.base.screen = screen;
+   g_screen.base.get_egl_image = sweetgl_get_egl_image;
+   g_screen.base.validate_egl_image = sweetgl_validate_egl_image;
+   g_screen.base.get_param = sweetgl_get_param;
+   snprintf(g_screen.renderer, sizeof(g_screen.renderer), "%s", screen->get_name(screen));
+   sweetgl_log("sweetgl: screen %s", g_screen.renderer);
+   g_init_err = 0;
+   pthread_mutex_unlock(&g_lock);
+   return 0;
+}
+
+const char *
+sweetgl_renderer(void)
+{
+   return g_init_err == 0 ? g_screen.renderer : NULL;
+}
+
+/* bind ctx on this thread (NULL = release); g_lock held. steal: take ctx over from another thread (that thread's Mesa TLS
+ * still names it, so the caller must know the other thread no longer issues GL calls: CA creates/binds on one thread and renders
+ * on its render thread, docs/research/36 s.2) */
+static int
+bind_locked(struct sweetgl_context *ctx, bool steal)
+{
+   pthread_t self = pthread_self();
+   struct sweetgl_context *old = tl_cur;
+
+   if (ctx && ctx->bound && !pthread_equal(ctx->owner, self)) {
+      if (!steal)
+         return -EBUSY;
+      sweetgl_log("sweetgl: context %p taken over from another thread", (void *)ctx);
+      ctx->bound = false;
+   }
+   if (old == ctx && (!ctx || st_api_get_current() == ctx->st))
+      return 0;
+
+   if (old && old != ctx) {
+      st_context_flush(old->st, ST_FLUSH_FRONT, NULL, NULL, NULL);
+      old->bound = false;
+   }
+   if (!st_api_make_current(ctx ? ctx->st : NULL, NULL, NULL)) {
+      /* Mesa unbound whatever was current; keep our view identical to Mesa's */
+      tl_cur = NULL;
+      return -EIO;
+   }
+   tl_cur = ctx;
+   if (ctx) {
+      ctx->owner = self;
+      ctx->bound = true;
+   }
+   return 0;
+}
+
+int
+sweetgl_make_current(struct sweetgl_context *ctx)
+{
+   pthread_mutex_lock(&g_lock);
+   int e = bind_locked(ctx, false);
+   pthread_mutex_unlock(&g_lock);
+   return e;
+}
+
+int
+sweetgl_make_current_steal(struct sweetgl_context *ctx)
+{
+   pthread_mutex_lock(&g_lock);
+   int e = bind_locked(ctx, true);
+   pthread_mutex_unlock(&g_lock);
+   return e;
+}
+
+struct sweetgl_context *
+sweetgl_get_current(void)
+{
+   if (tl_cur && (st_api_get_current() != tl_cur->st || !pthread_equal(tl_cur->owner, pthread_self())))
+      return NULL; /* Mesa lost it (doc 36 crash 1): say so instead of letting GL calls run on a NULL context */
+   return tl_cur;
+}
+
+struct sweetgl_context *
+sweetgl_context_create(int major, int minor, struct sweetgl_context *share, int *err)
+{
+   int e = sweetgl_init();
+   struct sweetgl_context *ctx = NULL;
+
+   if (e)
+      goto out;
+   if (major < 2 || major > 3 || minor < 0 || (major == 3 && minor > 2)) {
+      e = -EINVAL;
+      goto out;
+   }
+   ctx = CALLOC_STRUCT(sweetgl_context);
+   if (!ctx) {
+      e = -ENOMEM;
+      goto out;
+   }
+
+   struct st_context_attribs attribs;
+   memset(&attribs, 0, sizeof(attribs));
+   attribs.profile = API_OPENGLES2;
+   attribs.major = major;
+   attribs.minor = minor;
+   /* no window-system buffers: the visual stays empty (buffer_mask 0), CA and the selftest render into FBOs */
+   attribs.visual.color_format = PIPE_FORMAT_NONE;
+   attribs.visual.depth_stencil_format = PIPE_FORMAT_NONE;
+   u_driconf_fill_st_options(&attribs.options, &g_screen.options);
+
+   enum st_context_error st_err = ST_CONTEXT_SUCCESS;
+   pthread_mutex_lock(&g_lock);
+   ctx->st = st_api_create_context(&g_screen.base, &attribs, &st_err, share ? share->st : NULL);
+   if (ctx->st) {
+      ctx->st->frontend_context = ctx;
+      /* st_api_create_context leaves the new context unbound; make sure the calling thread's binding is unchanged */
+   }
+   pthread_mutex_unlock(&g_lock);
+   if (!ctx->st) {
+      sweetgl_log("sweetgl: st_api_create_context(ES %d.%d) failed: %d", major, minor, (int)st_err);
+      FREE(ctx);
+      ctx = NULL;
+      e = st_err == ST_CONTEXT_ERROR_NO_MEMORY ? -ENOMEM : -EINVAL;
+   }
+out:
+   if (err)
+      *err = e;
+   return ctx;
+}
+
+void
+sweetgl_context_destroy(struct sweetgl_context *ctx)
+{
+   if (!ctx)
+      return;
+   pthread_mutex_lock(&g_lock);
+   if (ctx->bound && !pthread_equal(ctx->owner, pthread_self())) {
+      /* still current on another thread: destroying it under that thread is a use-after-free; leak instead */
+      sweetgl_log("sweetgl: destroy of a context bound on another thread refused (leaked)");
+      pthread_mutex_unlock(&g_lock);
+      return;
+   }
+   if (tl_cur == ctx)
+      bind_locked(NULL, false);
+   st_context_flush(ctx->st, 0, NULL, NULL, NULL);
+   st_destroy_context(ctx->st);
+   pthread_mutex_unlock(&g_lock);
+   FREE(ctx);
+}
+
+int
+sweetgl_flush(int finish)
+{
+   struct sweetgl_context *ctx = sweetgl_get_current();
+   struct pipe_fence_handle *fence = NULL;
+
+   if (!ctx)
+      return -EINVAL;
+   st_context_flush(ctx->st, ST_FLUSH_FRONT, finish ? &fence : NULL, NULL, NULL);
+   if (fence) {
+      struct pipe_screen *screen = g_screen.base.screen;
+      bool ok = screen->fence_finish(screen, NULL, fence, OS_TIMEOUT_INFINITE);
+      screen->fence_reference(screen, &fence, NULL);
+      if (!ok)
+         return -ETIMEDOUT;
+   }
+   return 0;
+}
+
+static enum pipe_format
+format_from_iosurface(uint32_t fourcc)
+{
+   switch (fourcc) {
+   case 0x42475241: /* 'BGRA': bytes B,G,R,A in memory */
+      return PIPE_FORMAT_B8G8R8A8_UNORM;
+   case 0x52474241: /* 'RGBA' */
+      return PIPE_FORMAT_R8G8B8A8_UNORM;
+   default:
+      return PIPE_FORMAT_NONE;
+   }
+}
+
+struct sweetgl_image *
+sweetgl_image_from_iosurface(uint32_t surface_id, void *cpu, int *err)
+{
+   struct sweet_kmod_import imp;
+   struct sweetgl_image *img = NULL;
+   int e = sweetgl_init();
+
+   if (e)
+      goto out;
+   e = -sweet_kmod_import_surface(surface_id, cpu, &imp);
+   if (e)
+      goto out;
+
+   enum pipe_format fmt = format_from_iosurface(imp.pixel_format);
+   uint32_t bpp = fmt == PIPE_FORMAT_NONE ? 0 : util_format_get_blocksize(fmt);
+   if (fmt == PIPE_FORMAT_NONE || imp.width == 0 || imp.height == 0 || imp.bytes_per_row < imp.width * bpp ||
+       (uint64_t)imp.bytes_per_row * imp.height > imp.size) {
+      sweetgl_log("sweetgl: surface %u refused: fmt 0x%x %ux%u bpr %u len %llu", surface_id, imp.pixel_format, imp.width,
+                  imp.height, imp.bytes_per_row, (unsigned long long)imp.size);
+      sweet_kmod_import_drop(imp.handle);
+      e = -EINVAL;
+      goto out;
+   }
+
+   /* the "prime fd" Mesa's import path carries: any open fd works, sweet_drm.c maps it to the parked handle */
+   int pfd = open("/dev/null", O_RDONLY | O_CLOEXEC);
+   if (pfd < 0) {
+      e = -errno;
+      sweet_kmod_import_drop(imp.handle);
+      goto out;
+   }
+   sweet_drm_prime_register(pfd, imp.handle);
+
+   struct pipe_resource templ;
+   memset(&templ, 0, sizeof(templ));
+   templ.target = PIPE_TEXTURE_2D;
+   templ.format = fmt;
+   templ.width0 = imp.width;
+   templ.height0 = imp.height;
+   templ.depth0 = 1;
+   templ.array_size = 1;
+   templ.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+
+   struct winsys_handle wh;
+   memset(&wh, 0, sizeof(wh));
+   wh.type = WINSYS_HANDLE_TYPE_FD;
+   wh.handle = (unsigned)pfd;
+   wh.stride = imp.bytes_per_row;
+   wh.offset = 0;
+   wh.modifier = DRM_FORMAT_MOD_LINEAR;
+   wh.format = fmt;
+
+   struct pipe_screen *screen = g_screen.base.screen;
+   struct pipe_resource *tex =
+      screen->resource_from_handle(screen, &templ, &wh, PIPE_HANDLE_USAGE_FRAMEBUFFER_WRITE);
+   sweet_drm_prime_unregister(pfd);
+   close(pfd);
+   if (!tex) {
+      /* the parked import may still be there if gallium failed before bo_import */
+      sweet_kmod_import_drop(imp.handle);
+      sweetgl_log("sweetgl: resource_from_handle failed for surface %u (%ux%u bpr %u)", surface_id, imp.width,
+                  imp.height, imp.bytes_per_row);
+      e = -EINVAL;
+      goto out;
+   }
+
+   img = CALLOC_STRUCT(sweetgl_image);
+   if (!img) {
+      pipe_resource_reference(&tex, NULL);
+      e = -ENOMEM;
+      goto out;
+   }
+   img->tex = tex;
+   img->format = fmt;
+   img->surface_id = surface_id;
+   img->width = imp.width;
+   img->height = imp.height;
+   img->bytes_per_row = imp.bytes_per_row;
+   img->handle = imp.handle;
+out:
+   if (err)
+      *err = e;
+   return img;
+}
+
+void
+sweetgl_image_release(struct sweetgl_image *img)
+{
+   if (!img)
+      return;
+   pipe_resource_reference(&img->tex, NULL); /* last reference closes the BO (selector 2) */
+   FREE(img);
+}
+
+void
+sweetgl_image_size(const struct sweetgl_image *img, uint32_t *width, uint32_t *height, uint32_t *bytes_per_row)
+{
+   if (width)
+      *width = img ? img->width : 0;
+   if (height)
+      *height = img ? img->height : 0;
+   if (bytes_per_row)
+      *bytes_per_row = img ? img->bytes_per_row : 0;
+}
+
+void GLAPIENTRY _mesa_EGLImageTargetTexture2DOES(GLenum target, GLeglImageOES image);
+
+int
+sweetgl_image_bind_texture(struct sweetgl_image *img, unsigned target)
+{
+   if (!img || !sweetgl_get_current())
+      return -EINVAL;
+   _mesa_EGLImageTargetTexture2DOES(target, (GLeglImageOES)img);
+   return 0;
+}
+
+int
+sweetgl_image_sync_for_cpu(struct sweetgl_image *img)
+{
+   if (!img)
+      return -EINVAL;
+   int e = sweetgl_flush(1);
+   if (e)
+      return e;
+   return -sweet_kmod_bo_cache_sync(img->handle);
+}
+
+void
+sweetgl_log(const char *fmt, ...)
+{
+   char buf[512];
+   va_list ap;
+
+   va_start(ap, fmt);
+   int n = vsnprintf(buf, sizeof(buf) - 1, fmt, ap);
+   va_end(ap);
+   if (n < 0)
+      return;
+   if (n > (int)sizeof(buf) - 2)
+      n = sizeof(buf) - 2;
+   buf[n++] = '\n';
+   fputs(buf, stderr);
+   int fd = open("/dev/null", O_WRONLY | O_CLOEXEC);
+   if (fd >= 0) {
+      ssize_t w = write(fd, buf, (size_t)n);
+      (void)w;
+      close(fd);
+   }
+}
diff --git a/src/gallium/targets/sweetgl/sweetgl_gli.c b/src/gallium/targets/sweetgl/sweetgl_gli.c
new file mode 100644
index 0000000..bd2ad99
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweetgl_gli.c
@@ -0,0 +1,309 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * libsweetgl: GLI table support (sweetgl_gli.h). The hand-written slots are the ones docs/research/33 s.2.2 lists as used by
+ * CoreAnimation's GLES renderer whose desktop/Apple form has no ES equivalent under the same name in Mesa's ES dispatch:
+ * ARB shader-object calls -> ES 2 program/shader calls (GLhandleARB is the object name), glFlush = glFinish (CA hands
+ * surfaces to the display without a fence: docs/research/18 s.1.2, 33 s.3), Apple fence/object calls, the Apple-only
+ * framebuffer parameter and the private glGetString(0x8a1e) list (no GL error: NULL, as CA's search is NULL-safe).
+ * Not done here (docs/research/33 s.4 P1): GL_TEXTURE_RECTANGLE / sampler2DRect emulation and GLSL source rewriting.
+ */
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/glheader.h"
+#include "glapi/glapi.h"
+#include "dispatch.h"
+
+#include "sweetgl.h"
+#include "sweetgl_gli.h"
+#include "sweetgl_priv.h"
+
+#define GL_PROGRAM_OBJECT_ARB_ 0x8B40
+#define APPLE_PRIVATE_EXTENSIONS_2 0x8a1e /* docs/research/33 s.2.3: second extension list query, not a standard enum */
+
+bool
+sweetgl_gli_ensure(void *rctx, const char *name)
+{
+   struct sweetgl_context *ctx = rctx;
+   static __thread const char *last_fail;
+
+   if (ctx && sweetgl_get_current() == ctx && _mesa_glapi_get_context())
+      return true;
+   int e = ctx ? sweetgl_make_current_steal(ctx) : -EINVAL;
+   if (e == 0 && sweetgl_get_current() == ctx && _mesa_glapi_get_context())
+      return true;
+   if (last_fail != name) {
+      last_fail = name;
+      sweetgl_log("sweetgl: %s on rctx %p without a usable context (make_current %d); call skipped", name, rctx, e);
+   }
+   return false;
+}
+
+void
+sweetgl_gli_trap(unsigned slot)
+{
+   static unsigned char seen[SWEETGL_GLI_SLOTS];
+
+   if (slot < SWEETGL_GLI_SLOTS && !seen[slot]) {
+      seen[slot] = 1;
+      sweetgl_log("sweetgl: GLI slot %u has no mapping (returned 0)", slot);
+   }
+}
+
+#define ENSURE(ret)                                  \
+   do {                                              \
+      if (!sweetgl_gli_ensure(rctx, __func__))       \
+         return ret;                                 \
+   } while (0)
+
+static void GLAPIENTRY
+s_Flush(void *rctx)
+{
+   ENSURE();
+   CALL_Finish(GET_DISPATCH(), ());
+}
+
+static void GLAPIENTRY
+s_FinishObjectAPPLE(void *rctx, GLenum object, GLint name)
+{
+   ENSURE();
+   CALL_Finish(GET_DISPATCH(), ());
+}
+
+static GLboolean GLAPIENTRY
+s_TestObjectAPPLE(void *rctx, GLenum object, GLuint name)
+{
+   return GL_TRUE; /* every object is finished after s_Flush/s_FinishObjectAPPLE */
+}
+
+static void GLAPIENTRY
+s_FramebufferParameterivAPPLE(void *rctx, GLenum target, GLenum pname, const GLint *params)
+{
+   /* docs/research/33 s.2.1: (GL_FRAMEBUFFER, 0x8a79, {0x8a7a|0x8a7d}), meaning unknown [guess: colour-space mode]: ignored */
+}
+
+static const GLubyte *GLAPIENTRY
+s_GetString(void *rctx, GLenum name)
+{
+   if (name == APPLE_PRIVATE_EXTENSIONS_2)
+      return NULL;
+   ENSURE(NULL);
+   return CALL_GetString(GET_DISPATCH(), (name));
+}
+
+static void GLAPIENTRY
+s_EnableClientState(void *rctx, GLenum cap)
+{
+   /* fixed-function client state does not exist in ES 2/3; CA's GLES renderer uses vertex attributes */
+}
+
+static GLhandleARB GLAPIENTRY
+s_CreateShaderObjectARB(void *rctx, GLenum type)
+{
+   ENSURE(0);
+   return CALL_CreateShader(GET_DISPATCH(), (type));
+}
+
+static GLhandleARB GLAPIENTRY
+s_CreateProgramObjectARB(void *rctx)
+{
+   ENSURE(0);
+   return CALL_CreateProgram(GET_DISPATCH(), ());
+}
+
+static void GLAPIENTRY
+s_AttachObjectARB(void *rctx, GLhandleARB program, GLhandleARB shader)
+{
+   ENSURE();
+   CALL_AttachShader(GET_DISPATCH(), ((GLuint)program, (GLuint)shader));
+}
+
+static void GLAPIENTRY
+s_UseProgramObjectARB(void *rctx, GLhandleARB program)
+{
+   ENSURE();
+   CALL_UseProgram(GET_DISPATCH(), ((GLuint)program));
+}
+
+static void GLAPIENTRY
+s_DeleteObjectARB(void *rctx, GLhandleARB obj)
+{
+   ENSURE();
+   if (CALL_IsProgram(GET_DISPATCH(), ((GLuint)obj)))
+      CALL_DeleteProgram(GET_DISPATCH(), ((GLuint)obj));
+   else
+      CALL_DeleteShader(GET_DISPATCH(), ((GLuint)obj));
+}
+
+static void GLAPIENTRY
+s_GetObjectParameterivARB(void *rctx, GLhandleARB obj, GLenum pname, GLint *params)
+{
+   ENSURE();
+   /* the ARB enums used (COMPILE/LINK/VALIDATE/DELETE status, INFO_LOG_LENGTH, ...) have the ES 2 values */
+   if (CALL_IsProgram(GET_DISPATCH(), ((GLuint)obj)))
+      CALL_GetProgramiv(GET_DISPATCH(), ((GLuint)obj, pname, params));
+   else
+      CALL_GetShaderiv(GET_DISPATCH(), ((GLuint)obj, pname, params));
+}
+
+static void GLAPIENTRY
+s_GetInfoLogARB(void *rctx, GLhandleARB obj, GLsizei max, GLsizei *len, GLcharARB *log)
+{
+   ENSURE();
+   if (CALL_IsProgram(GET_DISPATCH(), ((GLuint)obj)))
+      CALL_GetProgramInfoLog(GET_DISPATCH(), ((GLuint)obj, max, len, log));
+   else
+      CALL_GetShaderInfoLog(GET_DISPATCH(), ((GLuint)obj, max, len, log));
+}
+
+static void GLAPIENTRY
+s_GetAttachedObjectsARB(void *rctx, GLhandleARB program, GLsizei max, GLsizei *count, GLhandleARB *objs)
+{
+   ENSURE();
+   GLuint tmp[64];
+   GLsizei n = 0;
+   if (max > 64)
+      max = 64;
+   CALL_GetAttachedShaders(GET_DISPATCH(), ((GLuint)program, max, &n, tmp));
+   for (GLsizei i = 0; i < n; i++)
+      objs[i] = tmp[i];
+   if (count)
+      *count = n;
+}
+
+static GLhandleARB GLAPIENTRY
+s_GetHandleARB(void *rctx, GLenum pname)
+{
+   GLint prog = 0;
+   ENSURE(0);
+   if (pname != GL_PROGRAM_OBJECT_ARB_)
+      return 0;
+   CALL_GetIntegerv(GET_DISPATCH(), (GL_CURRENT_PROGRAM, &prog));
+   return (GLhandleARB)prog;
+}
+
+static void GLAPIENTRY
+s_BindFramebufferEXT(void *rctx, GLenum target, GLuint fb)
+{
+   ENSURE();
+   CALL_BindFramebuffer(GET_DISPATCH(), (target, fb));
+}
+
+static void GLAPIENTRY
+s_GetIntegerIndexedv(void *rctx, GLenum target, GLuint index, GLint *data)
+{
+   ENSURE();
+   CALL_GetIntegeri_v(GET_DISPATCH(), (target, index, data));
+}
+
+static const struct sweetgl_gli_entry specials[] = {
+   {"glAttachObjectARB", (void *)s_AttachObjectARB},
+   {"glBindFramebufferEXT", (void *)s_BindFramebufferEXT},
+   {"glCreateProgramObjectARB", (void *)s_CreateProgramObjectARB},
+   {"glCreateShaderObjectARB", (void *)s_CreateShaderObjectARB},
+   {"glDeleteObjectARB", (void *)s_DeleteObjectARB},
+   {"glDisableClientState", (void *)s_EnableClientState},
+   {"glEnableClientState", (void *)s_EnableClientState},
+   {"glFinishObjectAPPLE", (void *)s_FinishObjectAPPLE},
+   {"glFlush", (void *)s_Flush},
+   {"glFramebufferParameterivAPPLE", (void *)s_FramebufferParameterivAPPLE},
+   {"glGetAttachedObjectsARB", (void *)s_GetAttachedObjectsARB},
+   {"glGetHandleARB", (void *)s_GetHandleARB},
+   {"glGetInfoLogARB", (void *)s_GetInfoLogARB},
+   {"glGetIntegerIndexedv", (void *)s_GetIntegerIndexedv},
+   {"glGetIntegerIndexedvEXT", (void *)s_GetIntegerIndexedv},
+   {"glGetObjectParameterivARB", (void *)s_GetObjectParameterivARB},
+   {"glGetString", (void *)s_GetString},
+   {"glTestObjectAPPLE", (void *)s_TestObjectAPPLE},
+   {"glUseProgramObjectARB", (void *)s_UseProgramObjectARB},
+};
+
+static void *
+find_generated(const char *name)
+{
+   unsigned lo = 0, hi = sweetgl_gli_entry_count;
+
+   while (lo < hi) {
+      unsigned mid = (lo + hi) / 2;
+      int c = strcmp(name, sweetgl_gli_entries[mid].name);
+      if (c == 0)
+         return sweetgl_gli_entries[mid].fn;
+      if (c < 0)
+         hi = mid;
+      else
+         lo = mid + 1;
+   }
+   return NULL;
+}
+
+void *
+sweetgl_gli_lookup(const char *name)
+{
+   static const char *const suffixes[] = {"ARB", "EXT", "OES", "APPLE", "KHR"};
+
+   for (unsigned i = 0; i < sizeof(specials) / sizeof(specials[0]); i++) {
+      if (!strcmp(name, specials[i].name))
+         return specials[i].fn;
+   }
+   void *fn = find_generated(name);
+   if (fn)
+      return fn;
+   size_t n = strlen(name);
+   for (unsigned i = 0; i < sizeof(suffixes) / sizeof(suffixes[0]); i++) {
+      size_t sl = strlen(suffixes[i]);
+      if (n > sl + 2 && n < 128 && !strcmp(name + n - sl, suffixes[i])) {
+         char base[128];
+         memcpy(base, name, n - sl);
+         base[n - sl] = 0;
+         if ((fn = find_generated(base)))
+            return fn;
+      }
+   }
+   return NULL;
+}
+
+int
+sweetgl_gli_fill(struct sweetgl_gli_table *t, void *rctx)
+{
+   const char *path = getenv("SWEETGL_GLI_MAP");
+   if (!path || !*path)
+      path = "/usr/share/sweetgl/gli-slots.txt";
+
+   t->rctx = rctx;
+   for (unsigned s = 0; s < SWEETGL_GLI_SLOTS; s++)
+      t->disp[s] = sweetgl_gli_traps[s];
+
+   FILE *f = fopen(path, "r");
+   if (!f)
+      return -ENOENT;
+   char line[256];
+   int mapped = 0, unknown = 0;
+   while (fgets(line, sizeof(line), f)) {
+      unsigned slot;
+      char name[128];
+      if (line[0] == '#' || sscanf(line, "%u %127s", &slot, name) != 2)
+         continue;
+      if (slot >= SWEETGL_GLI_SLOTS)
+         continue;
+      void *fn = sweetgl_gli_lookup(name);
+      if (fn) {
+         t->disp[slot] = fn;
+         mapped++;
+      } else if (unknown++ < 16) {
+         sweetgl_log("sweetgl: GLI map %s: slot %u %s has no Mesa entry point (trap)", path, slot, name);
+      }
+   }
+   fclose(f);
+   return mapped;
+}
+
+void *
+sweetgl_get_proc_address(const char *name)
+{
+   /* the exported gl* entry points of libglapi_bridge dispatch through the calling thread's table */
+   return (void *)_mesa_glapi_get_proc_address(name);
+}
diff --git a/src/gallium/targets/sweetgl/sweetgl_gli.h b/src/gallium/targets/sweetgl/sweetgl_gli.h
new file mode 100644
index 0000000..f5f62b9
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweetgl_gli.h
@@ -0,0 +1,41 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * libsweetgl: Apple GLI dispatch table emulation for the EAGL shim (docs/research/18 s.1.2, 33 s.2.2).
+ * Layout returned by -[EAGLContext getMacroContextPrivate]: { rctx, disp[SWEETGL_GLI_SLOTS] }; CA calls disp[slot](rctx, ...).
+ * The slot -> GL name map is Apple's (GLEngine _gliInitDispatchTable) and is NOT compiled in: it is loaded at run time from a
+ * text file ("<slot> <glName>" per line, '#' comments; SWEETGL_GLI_MAP or /usr/share/sweetgl/gli-slots.txt). Slots without a
+ * name call a per-slot trap that logs once and returns 0.
+ */
+#ifndef SWEETGL_GLI_H
+#define SWEETGL_GLI_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define SWEETGL_GLI_SLOTS 1036
+
+struct sweetgl_gli_entry {
+   const char *name;
+   void *fn;
+};
+
+struct sweetgl_gli_table {
+   void *rctx;
+   void *disp[SWEETGL_GLI_SLOTS];
+};
+
+extern const struct sweetgl_gli_entry sweetgl_gli_entries[];
+extern const unsigned sweetgl_gli_entry_count;
+extern void *const sweetgl_gli_traps[SWEETGL_GLI_SLOTS];
+
+/* make rctx (a struct sweetgl_eagl *) current on this thread; false = no usable Mesa context (logged once per name) */
+bool sweetgl_gli_ensure(void *rctx, const char *name);
+void sweetgl_gli_trap(unsigned slot);
+/* wrapper for a GL name: hand-written specials, then the generated table, then the name with ARB/EXT/OES/APPLE/KHR removed */
+void *sweetgl_gli_lookup(const char *name);
+/* fill disp[] from the slot map; returns the number of mapped slots or a negative errno (-ENOENT: no map file) */
+int sweetgl_gli_fill(struct sweetgl_gli_table *t, void *rctx);
+
+#endif

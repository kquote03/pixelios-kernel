+/* PixOS G3: surfaces mapped by sweet_kmod_import_surface() and not yet taken by bo_import (see sweet_kmod.h) */
+#define SWEET_PARKED_MAX 64
+static struct {
+   bool used;
+   struct sweet_kmod_import imp;
+   void *cpu;
+} sweet_parked[SWEET_PARKED_MAX];
+static simple_mtx_t sweet_parked_lock = SIMPLE_MTX_INITIALIZER;
+
+int
+sweet_kmod_import_surface(uint32_t surface_id, void *cpu, struct sweet_kmod_import *out)
+{
+   struct sweet_kmod_dev *sdev = sweet_last_dev;
+   struct sweet_kmod_import imp = {0};
+
+   if (!sdev || !sdev->t->import_surface)
+      return ENOSYS;
+   int e = sdev->t->import_surface(sdev->t->priv, surface_id, &imp.handle, &imp.va, &imp.size, &imp.bytes_per_row,
+                                   &imp.width, &imp.height, &imp.pixel_format);
+   if (e)
+      return e;
+   if (imp.handle == 0 || imp.size == 0 || imp.va < sdev->va_start || imp.va + imp.size > sdev->va_end) {
+      if (imp.handle)
+         sdev->t->bo_close(sdev->t->priv, imp.handle);
+      return EINVAL;
+   }
+
+   simple_mtx_lock(&sweet_parked_lock);
+   unsigned i;
+   for (i = 0; i < SWEET_PARKED_MAX && sweet_parked[i].used; i++)
+      ;
+   if (i == SWEET_PARKED_MAX) {
+      simple_mtx_unlock(&sweet_parked_lock);
+      sdev->t->bo_close(sdev->t->priv, imp.handle);
+      return ENOSPC;
+   }
+   sweet_parked[i].used = true;
+   sweet_parked[i].imp = imp;
+   sweet_parked[i].cpu = cpu;
+   simple_mtx_unlock(&sweet_parked_lock);
+   *out = imp;
+   return 0;
+}
+
+/* takes the entry out when take is set; returns its index or -1 */
+static int
+sweet_parked_find(uint32_t handle, bool take, struct sweet_kmod_import *imp, void **cpu)
+{
+   int found = -1;
+
+   simple_mtx_lock(&sweet_parked_lock);
+   for (unsigned i = 0; i < SWEET_PARKED_MAX; i++) {
+      if (sweet_parked[i].used && sweet_parked[i].imp.handle == handle) {
+         if (imp)
+            *imp = sweet_parked[i].imp;
+         if (cpu)
+            *cpu = sweet_parked[i].cpu;
+         if (take)
+            sweet_parked[i].used = false;
+         found = (int)i;
+         break;
+      }
+   }
+   simple_mtx_unlock(&sweet_parked_lock);
+   return found;
+}
+
+uint64_t
+sweet_kmod_import_size(uint32_t handle)
+{
+   struct sweet_kmod_import imp;
+
+   return sweet_parked_find(handle, false, &imp, NULL) >= 0 ? imp.size : 0;
+}
+
+void
+sweet_kmod_import_drop(uint32_t handle)
+{
+   struct sweet_kmod_dev *sdev = sweet_last_dev;
+
+   if (sweet_parked_find(handle, true, NULL, NULL) >= 0 && sdev)
+      sdev->t->bo_close(sdev->t->priv, handle);
+}
+
+int
+sweet_kmod_bo_cache_sync(uint32_t handle)
+{
+   struct sweet_kmod_dev *sdev = sweet_last_dev;
+
+   if (!sdev || !sdev->t->bo_cache_sync)
+      return ENOSYS;
+   return sdev->t->bo_cache_sync(sdev->t->priv, handle);
+}

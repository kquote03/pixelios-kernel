diff --git a/src/gallium/targets/sweetgl/sweetgl_selftest.c b/src/gallium/targets/sweetgl/sweetgl_selftest.c
new file mode 100644
index 0000000..2f1d2ec
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweetgl_selftest.c
@@ -0,0 +1,378 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * sweetgl_selftest: loads libsweetgl.dylib with dlopen (so the executable itself links only SDK libraries), creates an
+ * OpenGL ES context on the SweetMali GPU, renders into an offscreen 256x256 RGBA8 renderbuffer and reads it back:
+ *   clear: glClearColor(0.2, 0.4, 0.6, 1.0) -> every pixel must read (0x33, 0x66, 0x99, 0xff) (the G1 capture's colour)
+ *   tri:   same clear + one triangle (-0.5,-0.5) (0.5,-0.5) (0,0.5) in constant (0,1,0,1): pixel (128,128) green,
+ *          (2,2) and (253,253) the clear colour
+ * With --iosurface it repeats both into an IOSurface-backed 256x256 BGRA texture (SweetMali selector 5) and reads the
+ * surface memory after sweetgl_image_sync_for_cpu (selector 6).
+ * Last line: "sweetgl selftest: clear=PASS tri=PASS" (exit 0) or with FAIL/SKIP (exit 1).
+ * Usage: sweetgl_selftest [--iosurface] [path/to/libsweetgl.dylib]   (default: SWEETGL_DYLIB, next to the executable,
+ * /usr/lib/libsweetgl.dylib)
+ */
+#include <dlfcn.h>
+#include <limits.h>
+#include <mach-o/dyld.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOSurface/IOSurfaceRef.h>
+
+#define GL_GLEXT_PROTOTYPES 0
+#include <GLES3/gl3.h>
+
+#define W 256
+#define H 256
+
+struct sweetgl_context;
+struct sweetgl_image;
+
+static int (*p_init)(void);
+static const char *(*p_renderer)(void);
+static struct sweetgl_context *(*p_create)(int, int, struct sweetgl_context *, int *);
+static int (*p_make_current)(struct sweetgl_context *);
+static void (*p_destroy)(struct sweetgl_context *);
+static void *(*p_proc)(const char *);
+static struct sweetgl_image *(*p_img_from)(uint32_t, void *, int *);
+static int (*p_img_bind)(struct sweetgl_image *, unsigned);
+static int (*p_img_sync)(struct sweetgl_image *);
+static void (*p_img_release)(struct sweetgl_image *);
+
+#define GLFN(ret, name, args) static ret(*p_##name) args
+GLFN(const GLubyte *, glGetString, (GLenum));
+GLFN(GLenum, glGetError, (void));
+GLFN(void, glGenFramebuffers, (GLsizei, GLuint *));
+GLFN(void, glBindFramebuffer, (GLenum, GLuint));
+GLFN(void, glGenRenderbuffers, (GLsizei, GLuint *));
+GLFN(void, glBindRenderbuffer, (GLenum, GLuint));
+GLFN(void, glRenderbufferStorage, (GLenum, GLenum, GLsizei, GLsizei));
+GLFN(void, glFramebufferRenderbuffer, (GLenum, GLenum, GLenum, GLuint));
+GLFN(void, glFramebufferTexture2D, (GLenum, GLenum, GLenum, GLuint, GLint));
+GLFN(GLenum, glCheckFramebufferStatus, (GLenum));
+GLFN(void, glGenTextures, (GLsizei, GLuint *));
+GLFN(void, glBindTexture, (GLenum, GLuint));
+GLFN(void, glViewport, (GLint, GLint, GLsizei, GLsizei));
+GLFN(void, glClearColor, (GLfloat, GLfloat, GLfloat, GLfloat));
+GLFN(void, glClear, (GLbitfield));
+GLFN(void, glFinish, (void));
+GLFN(void, glReadPixels, (GLint, GLint, GLsizei, GLsizei, GLenum, GLenum, void *));
+GLFN(GLuint, glCreateShader, (GLenum));
+GLFN(void, glShaderSource, (GLuint, GLsizei, const GLchar *const *, const GLint *));
+GLFN(void, glCompileShader, (GLuint));
+GLFN(void, glGetShaderiv, (GLuint, GLenum, GLint *));
+GLFN(void, glGetShaderInfoLog, (GLuint, GLsizei, GLsizei *, GLchar *));
+GLFN(GLuint, glCreateProgram, (void));
+GLFN(void, glAttachShader, (GLuint, GLuint));
+GLFN(void, glBindAttribLocation, (GLuint, GLuint, const GLchar *));
+GLFN(void, glLinkProgram, (GLuint));
+GLFN(void, glGetProgramiv, (GLuint, GLenum, GLint *));
+GLFN(void, glUseProgram, (GLuint));
+GLFN(void, glGenBuffers, (GLsizei, GLuint *));
+GLFN(void, glBindBuffer, (GLenum, GLuint));
+GLFN(void, glBufferData, (GLenum, GLsizeiptr, const void *, GLenum));
+GLFN(void, glVertexAttribPointer, (GLuint, GLint, GLenum, GLboolean, GLsizei, const void *));
+GLFN(void, glEnableVertexAttribArray, (GLuint));
+GLFN(void, glDrawArrays, (GLenum, GLint, GLsizei));
+
+static void *lib;
+
+static bool
+load(const char *path)
+{
+   char buf[PATH_MAX];
+   const char *cands[4];
+   unsigned n = 0;
+
+   if (path)
+      cands[n++] = path;
+   if (getenv("SWEETGL_DYLIB"))
+      cands[n++] = getenv("SWEETGL_DYLIB");
+   uint32_t sz = sizeof(buf);
+   if (_NSGetExecutablePath(buf, &sz) == 0) {
+      char *slash = strrchr(buf, '/');
+      if (slash && (size_t)(slash - buf) + sizeof("/libsweetgl.dylib") < sizeof(buf)) {
+         strcpy(slash, "/libsweetgl.dylib");
+         cands[n++] = buf;
+      }
+   }
+   cands[n++] = "/usr/lib/libsweetgl.dylib";
+   for (unsigned i = 0; i < n && !lib; i++) {
+      lib = dlopen(cands[i], RTLD_NOW | RTLD_LOCAL);
+      if (!lib)
+         fprintf(stderr, "sweetgl_selftest: dlopen %s: %s\n", cands[i], dlerror());
+      else
+         printf("sweetgl_selftest: loaded %s\n", cands[i]);
+   }
+   return lib != NULL;
+}
+
+#define SYM(var, name)                                               \
+   do {                                                              \
+      *(void **)&var = dlsym(lib, name);                             \
+      if (!var) {                                                    \
+         fprintf(stderr, "sweetgl_selftest: missing %s\n", name);    \
+         return false;                                               \
+      }                                                              \
+   } while (0)
+#define GLSYM(name) SYM(p_##name, #name)
+
+static bool
+resolve(void)
+{
+   SYM(p_init, "sweetgl_init");
+   SYM(p_renderer, "sweetgl_renderer");
+   SYM(p_create, "sweetgl_context_create");
+   SYM(p_make_current, "sweetgl_make_current");
+   SYM(p_destroy, "sweetgl_context_destroy");
+   SYM(p_proc, "sweetgl_get_proc_address");
+   SYM(p_img_from, "sweetgl_image_from_iosurface");
+   SYM(p_img_bind, "sweetgl_image_bind_texture");
+   SYM(p_img_sync, "sweetgl_image_sync_for_cpu");
+   SYM(p_img_release, "sweetgl_image_release");
+   GLSYM(glGetString); GLSYM(glGetError); GLSYM(glGenFramebuffers); GLSYM(glBindFramebuffer); GLSYM(glGenRenderbuffers);
+   GLSYM(glBindRenderbuffer); GLSYM(glRenderbufferStorage); GLSYM(glFramebufferRenderbuffer); GLSYM(glFramebufferTexture2D);
+   GLSYM(glCheckFramebufferStatus); GLSYM(glGenTextures); GLSYM(glBindTexture); GLSYM(glViewport); GLSYM(glClearColor);
+   GLSYM(glClear); GLSYM(glFinish); GLSYM(glReadPixels); GLSYM(glCreateShader); GLSYM(glShaderSource); GLSYM(glCompileShader);
+   GLSYM(glGetShaderiv); GLSYM(glGetShaderInfoLog); GLSYM(glCreateProgram); GLSYM(glAttachShader); GLSYM(glBindAttribLocation);
+   GLSYM(glLinkProgram); GLSYM(glGetProgramiv); GLSYM(glUseProgram); GLSYM(glGenBuffers); GLSYM(glBindBuffer);
+   GLSYM(glBufferData); GLSYM(glVertexAttribPointer); GLSYM(glEnableVertexAttribArray); GLSYM(glDrawArrays);
+   return true;
+}
+
+static GLuint
+shader(GLenum type, const char *src)
+{
+   GLuint s = p_glCreateShader(type);
+   GLint ok = 0;
+   p_glShaderSource(s, 1, &src, NULL);
+   p_glCompileShader(s);
+   p_glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+   if (!ok) {
+      char log[512] = "";
+      p_glGetShaderInfoLog(s, sizeof(log), NULL, log);
+      fprintf(stderr, "sweetgl_selftest: shader: %s\n", log);
+      return 0;
+   }
+   return s;
+}
+
+static GLuint
+program(void)
+{
+   GLuint vs = shader(GL_VERTEX_SHADER, "attribute vec2 pos;\nvoid main() { gl_Position = vec4(pos, 0.0, 1.0); }\n");
+   GLuint fs = shader(GL_FRAGMENT_SHADER,
+                      "precision mediump float;\nvoid main() { gl_FragColor = vec4(0.0, 1.0, 0.0, 1.0); }\n");
+   if (!vs || !fs)
+      return 0;
+   GLuint p = p_glCreateProgram();
+   GLint ok = 0;
+   p_glAttachShader(p, vs);
+   p_glAttachShader(p, fs);
+   p_glBindAttribLocation(p, 0, "pos");
+   p_glLinkProgram(p);
+   p_glGetProgramiv(p, GL_LINK_STATUS, &ok);
+   return ok ? p : 0;
+}
+
+/* pixel as R,G,B,A bytes; x,y in GL window coordinates (origin bottom-left) for readback, rows top-down for surfaces */
+static bool
+px_is(const uint8_t *p, uint8_t r, uint8_t g, uint8_t b, uint8_t a)
+{
+   return p[0] == r && p[1] == g && p[2] == b && p[3] == a;
+}
+
+static void
+draw(GLuint prog, bool tri)
+{
+   static const float v[] = {-0.5f, -0.5f, 0.5f, -0.5f, 0.0f, 0.5f};
+   static GLuint vbo;
+
+   p_glViewport(0, 0, W, H);
+   p_glClearColor(0.2f, 0.4f, 0.6f, 1.0f);
+   p_glClear(GL_COLOR_BUFFER_BIT);
+   if (tri) {
+      if (!vbo) {
+         p_glGenBuffers(1, &vbo);
+         p_glBindBuffer(GL_ARRAY_BUFFER, vbo);
+         p_glBufferData(GL_ARRAY_BUFFER, sizeof(v), v, GL_STATIC_DRAW);
+      }
+      p_glBindBuffer(GL_ARRAY_BUFFER, vbo);
+      p_glUseProgram(prog);
+      p_glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, 0);
+      p_glEnableVertexAttribArray(0);
+      p_glDrawArrays(GL_TRIANGLES, 0, 3);
+   }
+}
+
+static uint8_t pix[W * H * 4];
+
+static bool
+check_readback(bool tri)
+{
+   memset(pix, 0, sizeof(pix));
+   p_glReadPixels(0, 0, W, H, GL_RGBA, GL_UNSIGNED_BYTE, pix);
+   if (p_glGetError() != GL_NO_ERROR)
+      return false;
+   if (!tri) {
+      for (unsigned i = 0; i < W * H; i++) {
+         if (!px_is(&pix[i * 4], 0x33, 0x66, 0x99, 0xff)) {
+            fprintf(stderr, "sweetgl_selftest: clear pixel %u = %02x%02x%02x%02x\n", i, pix[i * 4], pix[i * 4 + 1],
+                    pix[i * 4 + 2], pix[i * 4 + 3]);
+            return false;
+         }
+      }
+      return true;
+   }
+   const uint8_t *c = &pix[(128 * W + 128) * 4], *a = &pix[(2 * W + 2) * 4], *b = &pix[(253 * W + 253) * 4];
+   bool ok = px_is(c, 0, 0xff, 0, 0xff) && px_is(a, 0x33, 0x66, 0x99, 0xff) && px_is(b, 0x33, 0x66, 0x99, 0xff);
+   if (!ok)
+      fprintf(stderr, "sweetgl_selftest: tri (128,128)=%02x%02x%02x%02x (2,2)=%02x%02x%02x%02x (253,253)=%02x%02x%02x%02x\n",
+              c[0], c[1], c[2], c[3], a[0], a[1], a[2], a[3], b[0], b[1], b[2], b[3]);
+   return ok;
+}
+
+static IOSurfaceRef
+make_surface(void)
+{
+   int w = W, h = H, bpe = 4, bpr = W * 4;
+   uint32_t fmt = 0x42475241; /* 'BGRA' */
+   /* 256 KiB: a whole number of 16 KiB pages (selector 5 rule) */
+   CFNumberRef nw = CFNumberCreate(NULL, kCFNumberIntType, &w), nh = CFNumberCreate(NULL, kCFNumberIntType, &h);
+   CFNumberRef ne = CFNumberCreate(NULL, kCFNumberIntType, &bpe), nr = CFNumberCreate(NULL, kCFNumberIntType, &bpr);
+   CFNumberRef nf = CFNumberCreate(NULL, kCFNumberSInt32Type, &fmt);
+   const void *k[] = {kIOSurfaceWidth, kIOSurfaceHeight, kIOSurfaceBytesPerElement, kIOSurfaceBytesPerRow,
+                      kIOSurfacePixelFormat};
+   const void *v[] = {nw, nh, ne, nr, nf};
+   CFDictionaryRef d = CFDictionaryCreate(NULL, k, v, 5, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+   IOSurfaceRef s = IOSurfaceCreate(d);
+   CFRelease(d);
+   CFRelease(nw);
+   CFRelease(nh);
+   CFRelease(ne);
+   CFRelease(nr);
+   CFRelease(nf);
+   return s;
+}
+
+/* surface rows are top-down in memory as the GPU wrote them (GL row 0 = first row of the resource) */
+static bool
+check_surface(IOSurfaceRef s, bool tri)
+{
+   const uint8_t *base = IOSurfaceGetBaseAddress(s);
+   size_t bpr = IOSurfaceGetBytesPerRow(s);
+#define SPX(x, y) (base + (size_t)(y) * bpr + (size_t)(x) * 4) /* B,G,R,A */
+   if (!tri) {
+      for (unsigned y = 0; y < H; y++)
+         for (unsigned x = 0; x < W; x++)
+            if (!px_is(SPX(x, y), 0x99, 0x66, 0x33, 0xff))
+               return false;
+      return true;
+   }
+   return px_is(SPX(128, 128), 0, 0xff, 0, 0xff) && px_is(SPX(2, 2), 0x99, 0x66, 0x33, 0xff) &&
+          px_is(SPX(253, 253), 0x99, 0x66, 0x33, 0xff);
+#undef SPX
+}
+
+static const char *
+iosurface_test(GLuint prog)
+{
+   IOSurfaceRef s = make_surface();
+   if (!s)
+      return "SKIP(IOSurfaceCreate)";
+   int err = 0;
+   struct sweetgl_image *img = p_img_from(IOSurfaceGetID(s), IOSurfaceGetBaseAddress(s), &err);
+   if (!img) {
+      fprintf(stderr, "sweetgl_selftest: IOSurface import failed (%d)\n", err);
+      CFRelease(s);
+      return "FAIL(import)";
+   }
+   GLuint tex = 0, fb = 0;
+   p_glGenTextures(1, &tex);
+   p_glBindTexture(GL_TEXTURE_2D, tex);
+   p_img_bind(img, GL_TEXTURE_2D);
+   p_glGenFramebuffers(1, &fb);
+   p_glBindFramebuffer(GL_FRAMEBUFFER, fb);
+   p_glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+   const char *r = "FAIL(fbo)";
+   if (p_glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+      draw(prog, false);
+      bool c = p_img_sync(img) == 0 && check_surface(s, false);
+      draw(prog, true);
+      bool t = p_img_sync(img) == 0 && check_surface(s, true);
+      r = c && t ? "PASS" : (c ? "FAIL(tri)" : "FAIL(clear)");
+   }
+   p_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+   p_img_release(img);
+   CFRelease(s);
+   return r;
+}
+
+int
+main(int argc, char **argv)
+{
+   bool with_surface = false;
+   const char *path = NULL;
+   const char *clear = "SKIP", *tri = "SKIP";
+
+   for (int i = 1; i < argc; i++) {
+      if (!strcmp(argv[i], "--iosurface"))
+         with_surface = true;
+      else
+         path = argv[i];
+   }
+   if (!load(path) || !resolve())
+      goto out;
+   int e = p_init();
+   if (e) {
+      fprintf(stderr, "sweetgl_selftest: sweetgl_init failed (%d)\n", e);
+      goto out;
+   }
+   struct sweetgl_context *ctx = NULL;
+   static const int ver[][2] = {{3, 1}, {3, 0}, {2, 0}};
+   for (unsigned i = 0; i < 3 && !ctx; i++)
+      ctx = p_create(ver[i][0], ver[i][1], NULL, &e);
+   if (!ctx || p_make_current(ctx)) {
+      fprintf(stderr, "sweetgl_selftest: no context (%d)\n", e);
+      goto out;
+   }
+   printf("sweetgl_selftest: GL_RENDERER=%s GL_VERSION=%s\n", (const char *)p_glGetString(GL_RENDERER),
+          (const char *)p_glGetString(GL_VERSION));
+
+   GLuint fb = 0, rb = 0;
+   p_glGenFramebuffers(1, &fb);
+   p_glBindFramebuffer(GL_FRAMEBUFFER, fb);
+   p_glGenRenderbuffers(1, &rb);
+   p_glBindRenderbuffer(GL_RENDERBUFFER, rb);
+   p_glRenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, W, H);
+   p_glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, rb);
+   if (p_glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+      fprintf(stderr, "sweetgl_selftest: framebuffer incomplete\n");
+      clear = tri = "FAIL";
+      goto out;
+   }
+   draw(0, false);
+   p_glFinish();
+   clear = check_readback(false) ? "PASS" : "FAIL";
+   GLuint prog = program();
+   if (!prog) {
+      tri = "FAIL";
+   } else {
+      draw(prog, true);
+      p_glFinish();
+      tri = check_readback(true) ? "PASS" : "FAIL";
+   }
+   if (with_surface)
+      printf("sweetgl_selftest: iosurface=%s\n", prog ? iosurface_test(prog) : "SKIP(no program)");
+   p_make_current(NULL);
+   p_destroy(ctx);
+out:
+   printf("sweetgl selftest: clear=%s tri=%s\n", clear, tri);
+   return strcmp(clear, "PASS") || strcmp(tri, "PASS");
+}

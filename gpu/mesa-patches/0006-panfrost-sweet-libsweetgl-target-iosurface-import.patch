 sweet_kmod_bo_import(struct pan_kmod_dev *dev, uint32_t handle, uint64_t size)
 {
-   mesa_loge("sweet: dma-buf import is not supported (IOSurface import: G6)");
-   return NULL;
+   struct sweet_kmod_import imp;
+   void *cpu = NULL;
+
+   if (sweet_parked_find(handle, true, &imp, &cpu) < 0 || imp.size != size) {
+      mesa_loge("sweet: import of handle %u that sweet_kmod_import_surface() did not map", handle);
+      return NULL;
+   }
+
+   struct sweet_kmod_bo *bo = pan_kmod_dev_alloc(dev, sizeof(*bo));
+   if (!bo) {
+      to_sdev(dev)->t->bo_close(to_sdev(dev)->t->priv, handle);
+      return NULL;
+   }
+   /* not executable, CPU access through the surface's own mapping (if the caller gave one) */
+   pan_kmod_bo_init(&bo->base, dev, NULL, size, cpu ? 0 : PAN_KMOD_BO_FLAG_NO_MMAP, handle);
+   bo->base.flags |= PAN_KMOD_BO_FLAG_IMPORTED;
+   bo->va = imp.va;
+   bo->cpu = cpu;
+   return &bo->base;
 }
 

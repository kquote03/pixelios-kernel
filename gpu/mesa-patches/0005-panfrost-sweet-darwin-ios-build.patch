+   if (sweet_last_dev == sdev)
+      sweet_last_dev = NULL;
    simple_mtx_destroy(&sdev->seq_lock);
    pan_kmod_dev_cleanup(dev);
    pan_kmod_free(dev->allocator, sdev);
@@ -325,6 +334,27 @@ sweet_kmod_bo_set_label(struct pan_kmod_dev *dev, struct pan_kmod_bo *bo,
       sdev->t->bo_label(sdev->t->priv, bo->handle, label);
 }
 
+/* wait (bounded by timeout_ns, absolute on os_time_get_nano) until every chain submitted so far has completed: 0, ETIMEDOUT, EIO, ENXIO */
+int
+sweet_kmod_wait_idle(int64_t timeout_ns)
+{
+   struct sweet_kmod_dev *sdev = sweet_last_dev;
+   uint64_t seq;
+
+   if (!sdev)
+      return 0;
+   simple_mtx_lock(&sdev->seq_lock);
+   seq = sdev->last_seq;
+   simple_mtx_unlock(&sdev->seq_lock);
+   if (!seq)
+      return 0;
+   int64_t now = os_time_get_nano();
+   uint64_t rel_us = timeout_ns <= now ? 0 : (uint64_t)(timeout_ns - now) / 1000;
+   if (rel_us > 60000000ull)
+      rel_us = 60000000ull;
+   return sdev->t->wait(sdev->t->priv, seq, rel_us);
+}
+
 int
 sweet_kmod_submit(struct pan_kmod_dev *dev, uint64_t jc, uint32_t reqs)
 {

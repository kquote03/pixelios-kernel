diff --git a/src/panfrost/lib/kmod/sweet_iokit.c b/src/panfrost/lib/kmod/sweet_iokit.c
new file mode 100644
index 0000000..d030793
--- /dev/null
+++ b/src/panfrost/lib/kmod/sweet_iokit.c
@@ -0,0 +1,180 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * iokit transport of the "sweet" pan_kmod backend (iOS): the SweetMali user client of PixOS xnu patch 0105
+ * (iokit/Kernel/arm/SweetMali.cpp). Selectors: 0 query (struct out = struct sweet_mali_info), 1 boNew (in size, flags; out handle, GPU VA,
+ * allocated), 2 boClose (in handle), 3 submit (in jc, req; out seqno), 4 wait (in seqno, relative timeout in us), 5 importSurface, 6 boCacheSync.
+ * The CPU mapping of a BO is IOConnectMapMemory64(type = handle) with kIOMapWriteCombineCache (no cache maintenance needed, 0105 header).
+ * One client per system (0105: a second open gets kIOReturnBusy).
+ */
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <IOKit/IOKitLib.h>
+#include <mach/mach.h>
+
+#include "util/simple_mtx.h"
+#include "sweet_kmod.h"
+
+#define SWEET_IOKIT_MAX_BOS 4096 /* SWEET_MALI_MAX_BOS, patch 0105 */
+
+struct sweet_iokit {
+   io_connect_t conn;
+   simple_mtx_t lock;
+   struct {
+      mach_vm_address_t cpu;
+      mach_vm_size_t size;
+   } map[SWEET_IOKIT_MAX_BOS + 1];
+};
+
+static int
+kr_to_errno(kern_return_t kr)
+{
+   switch (kr) {
+   case kIOReturnSuccess: return 0;
+   case kIOReturnTimeout: return ETIMEDOUT;
+   case kIOReturnIOError: return EIO;
+   case kIOReturnNotReady: return ENXIO;
+   case kIOReturnNoMemory:
+   case kIOReturnNoResources: return ENOMEM;
+   case kIOReturnBusy: return EBUSY;
+   case kIOReturnNotPermitted: return EPERM;
+   default: return EINVAL;
+   }
+}
+
+static int
+io_query(void *priv, struct sweet_transport_info *o)
+{
+   struct sweet_iokit *s = priv;
+   size_t n = sizeof(*o);
+
+   memset(o, 0, sizeof(*o));
+   return kr_to_errno(IOConnectCallStructMethod(s->conn, 0, NULL, 0, o, &n));
+}
+
+static int
+io_bo_new(void *priv, uint64_t size, uint32_t flags, uint32_t *handle, uint64_t *va, uint64_t *allocated, void **cpu)
+{
+   struct sweet_iokit *s = priv;
+   uint64_t in[2] = { size, flags & SWEET_BO_EXEC }, out[3] = { 0 };
+   uint32_t nout = 3;
+
+   kern_return_t kr = IOConnectCallScalarMethod(s->conn, 1, in, 2, out, &nout);
+   if (kr != kIOReturnSuccess)
+      return kr_to_errno(kr);
+   if (out[0] == 0 || out[0] > SWEET_IOKIT_MAX_BOS) {
+      uint64_t h = out[0];
+      IOConnectCallScalarMethod(s->conn, 2, &h, 1, NULL, NULL);
+      return EINVAL;
+   }
+   *handle = (uint32_t)out[0];
+   *va = out[1];
+   *allocated = out[2];
+   *cpu = NULL;
+   if (!(flags & SWEET_BO_NO_MMAP)) {
+      mach_vm_address_t addr = 0;
+      mach_vm_size_t len = 0;
+      kr = IOConnectMapMemory64(s->conn, *handle, mach_task_self(), &addr, &len,
+                                kIOMapAnywhere | kIOMapWriteCombineCache);
+      if (kr != kIOReturnSuccess || len < *allocated) {
+         uint64_t h = *handle;
+         if (kr == kIOReturnSuccess)
+            IOConnectUnmapMemory64(s->conn, *handle, mach_task_self(), addr);
+         IOConnectCallScalarMethod(s->conn, 2, &h, 1, NULL, NULL);
+         return kr == kIOReturnSuccess ? ENOMEM : kr_to_errno(kr);
+      }
+      simple_mtx_lock(&s->lock);
+      s->map[*handle].cpu = addr;
+      s->map[*handle].size = len;
+      simple_mtx_unlock(&s->lock);
+      *cpu = (void *)(uintptr_t)addr;
+   }
+   return 0;
+}
+
+static int
+io_bo_close(void *priv, uint32_t handle)
+{
+   struct sweet_iokit *s = priv;
+   uint64_t h = handle;
+
+   if (handle == 0 || handle > SWEET_IOKIT_MAX_BOS)
+      return EINVAL;
+   simple_mtx_lock(&s->lock);
+   if (s->map[handle].cpu) {
+      IOConnectUnmapMemory64(s->conn, handle, mach_task_self(), s->map[handle].cpu);
+      s->map[handle].cpu = 0;
+      s->map[handle].size = 0;
+   }
+   simple_mtx_unlock(&s->lock);
+   return kr_to_errno(IOConnectCallScalarMethod(s->conn, 2, &h, 1, NULL, NULL));
+}
+
+static int
+io_submit(void *priv, uint64_t jc, uint32_t req, uint64_t *seq)
+{
+   struct sweet_iokit *s = priv;
+   uint64_t in[2] = { jc, req & SWEET_REQ_FS }, out[1] = { 0 };
+   uint32_t nout = 1;
+
+   kern_return_t kr = IOConnectCallScalarMethod(s->conn, 3, in, 2, out, &nout);
+   *seq = out[0];
+   return kr_to_errno(kr);
+}
+
+static int
+io_wait(void *priv, uint64_t seq, uint64_t timeout_us)
+{
+   struct sweet_iokit *s = priv;
+   uint64_t in[2] = { seq, timeout_us };
+
+   return kr_to_errno(IOConnectCallScalarMethod(s->conn, 4, in, 2, NULL, NULL));
+}
+
+static void
+io_destroy(void *priv)
+{
+   struct sweet_iokit *s = priv;
+
+   IOServiceClose(s->conn);
+   simple_mtx_destroy(&s->lock);
+   free(s);
+}
+
+const struct sweet_transport *sweet_iokit_transport_create(void);
+
+const struct sweet_transport *
+sweet_iokit_transport_create(void)
+{
+   static struct sweet_transport t;
+   io_service_t svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("SweetMali"));
+   struct sweet_iokit *s;
+
+   if (!svc)
+      return NULL;
+   s = calloc(1, sizeof(*s));
+   if (!s) {
+      IOObjectRelease(svc);
+      return NULL;
+   }
+   kern_return_t kr = IOServiceOpen(svc, mach_task_self(), 0, &s->conn);
+   IOObjectRelease(svc);
+   if (kr != kIOReturnSuccess) {
+      free(s);
+      return NULL;
+   }
+   simple_mtx_init(&s->lock, mtx_plain);
+   t = (struct sweet_transport){
+      .priv = s,
+      .query = io_query,
+      .bo_new = io_bo_new,
+      .bo_close = io_bo_close,
+      .submit = io_submit,
+      .wait = io_wait,
+      .destroy = io_destroy,
+   };
+   return &t;
+}

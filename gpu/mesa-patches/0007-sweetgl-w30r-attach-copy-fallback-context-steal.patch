From: PixOS-Project contributors
Subject: [PATCH 0007] sweetgl: w30r attachImage copy fallback, context take-back fix, refusals logged once per shape

PixOS G6 (run g6-a, docs/research/52 s.12). On top of 0001-0006.
- frontend bind_locked: taking a context back on a thread whose Mesa TLS still names it now re-marks owner/bound
  (was: make_current 0 but sweetgl_get_current() NULL -> every GL call skipped).
- eagl attachImage: w30r/BGRA/RGBA surfaces that cannot be imported get GPU storage (RGB10_A2 / RGBA8), read back and
  converted into the locked IOSurface on glFlush/glFinishObjectAPPLE/glFenceSync (sweetgl_convert.h); other formats
  refused with the context left current; refusals logged once per shape with plane/element properties.
- gli: specials glBindFramebuffer (dirty tracking), glDeleteTextures (drop shadow), glFenceSync.
- sweetgl_convert_host_test.c: host test of the w30r mapping and row conversion.

diff --git a/src/gallium/targets/sweetgl/sweetgl_convert.h b/src/gallium/targets/sweetgl/sweetgl_convert.h
new file mode 100644
index 0000000..fcb5f03
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweetgl_convert.h
@@ -0,0 +1,162 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * libsweetgl: IOSurface pixel formats the shim cannot render to zero-copy, and the row conversions of the copy fallback
+ * (attachImage: render into a GPU colour buffer, read it back on flush, convert into the locked IOSurface). No Mesa or
+ * Apple dependency, so the host test (sweetgl_convert_host_test.c) compiles it on Linux.
+ *
+ * 'w30r' = kCVPixelFormatType_30RGBLEPackedWideGamut, "little-endian RGB101010, 2 MSB are zero, wide-gamut (384-895)"
+ * [src iPhoneOS16.5.sdk CoreVideo.framework/Headers/CVPixelBuffer.h:87]. Bit layout read as for the neighbouring 'l10r'
+ * ARGB2101010LEPacked (:88, A in the 2 MSB): R 29:20, G 19:10, B 9:0, bits 31:30 zero; Metal's twin is
+ * MTLPixelFormatBGR10_XR (Metal.framework/Headers/MTLPixelFormat.h:78). That memory layout is Mesa's
+ * PIPE_FORMAT_B10G10R10X2_UNORM (u_format.yaml: channels UN10,UN10,UN10,X2 from the LSB, swizzle Z,Y,X,1), which Panfrost
+ * renders on every arch incl. v9 (pan_format.c: FMT(B10G10R10X2_UNORM, RGB10_A2_UNORM, BGR1, L, VTR_IB), _R = render target;
+ * blend BFMT(B10G10R10X2_UNORM, R10G10B10A2)). It is NOT imported zero-copy all the same: the values are extended range,
+ * code 384 = 0.0 and 895 = 1.0, while a UNORM render target writes 0 and 1023. So the GPU renders [0,1] into an RGB10_A2
+ * buffer and the copy maps c (0..1023) to 384 + round(c * 511 / 1023).
+ */
+#ifndef SWEETGL_CONVERT_H
+#define SWEETGL_CONVERT_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define SGL_FOURCC_BGRA 0x42475241u /* kCVPixelFormatType_32BGRA */
+#define SGL_FOURCC_RGBA 0x52474241u /* kCVPixelFormatType_32RGBA */
+#define SGL_FOURCC_W30R 0x77333072u /* kCVPixelFormatType_30RGBLEPackedWideGamut */
+
+/* GL enums (ES 3.0), repeated so the host test needs no GL headers */
+#define SGL_GL_RGBA                        0x1908
+#define SGL_GL_RGBA8                       0x8058
+#define SGL_GL_RGB10_A2                    0x8059
+#define SGL_GL_UNSIGNED_BYTE               0x1401
+#define SGL_GL_UNSIGNED_INT_2_10_10_10_REV 0x8368
+
+enum sgl_conv {
+   SGL_CONV_NONE = 0,
+   SGL_CONV_RGBA8_TO_RGBA8,  /* 'RGBA' */
+   SGL_CONV_RGBA8_TO_BGRA8,  /* 'BGRA' */
+   SGL_CONV_RGB10A2_TO_W30R, /* 'w30r' */
+};
+
+struct sgl_rt_format {
+   enum sgl_conv conv;
+   unsigned internalformat, format, type; /* GPU colour buffer and the glReadPixels format/type for it */
+};
+
+/* copy-fallback render target for an IOSurface pixel format; conv NONE = no fallback */
+static inline struct sgl_rt_format
+sgl_rt_format_for(uint32_t fourcc)
+{
+   struct sgl_rt_format f = {SGL_CONV_NONE, 0, 0, 0};
+
+   switch (fourcc) {
+   case SGL_FOURCC_RGBA:
+      f = (struct sgl_rt_format){SGL_CONV_RGBA8_TO_RGBA8, SGL_GL_RGBA8, SGL_GL_RGBA, SGL_GL_UNSIGNED_BYTE};
+      break;
+   case SGL_FOURCC_BGRA:
+      f = (struct sgl_rt_format){SGL_CONV_RGBA8_TO_BGRA8, SGL_GL_RGBA8, SGL_GL_RGBA, SGL_GL_UNSIGNED_BYTE};
+      break;
+   case SGL_FOURCC_W30R:
+      /* ES 3.0 glReadPixels accepts RGBA/UNSIGNED_INT_2_10_10_10_REV for an RGB10_A2 buffer (Mesa readpix.c) */
+      f = (struct sgl_rt_format){SGL_CONV_RGB10A2_TO_W30R, SGL_GL_RGB10_A2, SGL_GL_RGBA, SGL_GL_UNSIGNED_INT_2_10_10_10_REV};
+      break;
+   default:
+      break;
+   }
+   return f;
+}
+
+/* UNORM10 code -> extended-range code (0 -> 384, 1023 -> 895), rounded to nearest */
+static inline uint32_t
+sgl_xr10_from_unorm10(uint32_t c)
+{
+   c &= 0x3ff;
+   return 384u + (c * 511u * 2u + 1023u) / 2046u;
+}
+
+/* extended-range code -> UNORM10 code, values outside 384..895 clamped (sampling fallback) */
+static inline uint32_t
+sgl_unorm10_from_xr10(uint32_t x)
+{
+   x &= 0x3ff;
+   if (x <= 384u)
+      return 0;
+   if (x >= 895u)
+      return 1023u;
+   return ((x - 384u) * 1023u * 2u + 511u) / 1022u;
+}
+
+/* GL RGB10_A2 read as UNSIGNED_INT_2_10_10_10_REV: R 9:0, G 19:10, B 29:20, A 31:30 -> w30r: B 9:0, G 19:10, R 29:20, 0 */
+static inline uint32_t
+sgl_w30r_from_rgb10a2(uint32_t p)
+{
+   return sgl_xr10_from_unorm10(p >> 20) | sgl_xr10_from_unorm10(p >> 10) << 10 | sgl_xr10_from_unorm10(p) << 20;
+}
+
+/* w30r -> RGB10_A2 (UNSIGNED_INT_2_10_10_10_REV), alpha 3 */
+static inline uint32_t
+sgl_rgb10a2_from_w30r(uint32_t p)
+{
+   return sgl_unorm10_from_xr10(p >> 20) | sgl_unorm10_from_xr10(p >> 10) << 10 | sgl_unorm10_from_xr10(p) << 20 |
+          3u << 30;
+}
+
+/* convert h rows of w pixels (4 bytes each) from src (stride src_stride, GL readback order = IOSurface row order) into dst
+ * (stride dst_bpr, the IOSurface's bytes per row). Returns 0, or -1 if a stride is too short or conv is unknown. */
+static inline int
+sgl_convert_rows(enum sgl_conv conv, void *dst, size_t dst_bpr, const void *src, size_t src_stride, uint32_t w,
+                 uint32_t h)
+{
+   if (!dst || !src || dst_bpr < (size_t)w * 4 || src_stride < (size_t)w * 4)
+      return -1;
+   for (uint32_t y = 0; y < h; y++) {
+      uint8_t *d = (uint8_t *)dst + (size_t)y * dst_bpr;
+      const uint8_t *s = (const uint8_t *)src + (size_t)y * src_stride;
+      switch (conv) {
+      case SGL_CONV_RGBA8_TO_RGBA8:
+         memcpy(d, s, (size_t)w * 4);
+         break;
+      case SGL_CONV_RGBA8_TO_BGRA8:
+         for (uint32_t x = 0; x < w; x++) {
+            d[4 * x + 0] = s[4 * x + 2];
+            d[4 * x + 1] = s[4 * x + 1];
+            d[4 * x + 2] = s[4 * x + 0];
+            d[4 * x + 3] = s[4 * x + 3];
+         }
+         break;
+      case SGL_CONV_RGB10A2_TO_W30R:
+         for (uint32_t x = 0; x < w; x++) {
+            uint32_t p;
+            memcpy(&p, s + 4 * x, 4); /* both sides little-endian (arm64) */
+            p = sgl_w30r_from_rgb10a2(p);
+            memcpy(d + 4 * x, &p, 4);
+         }
+         break;
+      default:
+         return -1;
+      }
+   }
+   return 0;
+}
+
+/* sampling fallback: w30r surface rows -> tightly packed RGB10_A2 (UNSIGNED_INT_2_10_10_10_REV) rows */
+static inline int
+sgl_w30r_rows_to_rgb10a2(uint32_t *dst, const void *src, size_t src_bpr, uint32_t w, uint32_t h)
+{
+   if (!dst || !src || src_bpr < (size_t)w * 4)
+      return -1;
+   for (uint32_t y = 0; y < h; y++) {
+      const uint8_t *s = (const uint8_t *)src + (size_t)y * src_bpr;
+      for (uint32_t x = 0; x < w; x++) {
+         uint32_t p;
+         memcpy(&p, s + 4 * x, 4);
+         dst[(size_t)y * w + x] = sgl_rgb10a2_from_w30r(p);
+      }
+   }
+   return 0;
+}
+
+#endif
diff --git a/src/gallium/targets/sweetgl/sweetgl_convert_host_test.c b/src/gallium/targets/sweetgl/sweetgl_convert_host_test.c
new file mode 100644
index 0000000..f0ae573
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweetgl_convert_host_test.c
@@ -0,0 +1,107 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Host test of sweetgl_convert.h (Linux, no Mesa): cc -std=c11 -Wall -Werror -fsanitize=address,undefined
+ *   sweetgl_convert_host_test.c -o /tmp/t && /tmp/t     -> last line "sweetgl_convert host test: N/N PASS"
+ */
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "sweetgl_convert.h"
+
+static int pass, total;
+
+#define CHECK(c)                                                                                                       \
+   do {                                                                                                                \
+      total++;                                                                                                         \
+      if (c)                                                                                                           \
+         pass++;                                                                                                       \
+      else                                                                                                             \
+         printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c);                                                            \
+   } while (0)
+
+int
+main(void)
+{
+   /* mapping: only the three convertible formats have a fallback; the refused ones of run g6-a stay refused */
+   struct sgl_rt_format f = sgl_rt_format_for(0x77333072u); /* 'w30r' */
+   CHECK(f.conv == SGL_CONV_RGB10A2_TO_W30R && f.internalformat == 0x8059 && f.format == 0x1908 && f.type == 0x8368);
+   CHECK(sgl_rt_format_for(0x42475241u).conv == SGL_CONV_RGBA8_TO_BGRA8);
+   CHECK(sgl_rt_format_for(0x52474241u).conv == SGL_CONV_RGBA8_TO_RGBA8);
+   CHECK(sgl_rt_format_for(0).conv == SGL_CONV_NONE);
+   CHECK(sgl_rt_format_for(0x62336138u).conv == SGL_CONV_NONE); /* 'b3a8' */
+   CHECK(sgl_rt_format_for(0x4c413038u).conv == SGL_CONV_NONE); /* 'LA08' */
+
+   /* XR range end points and monotonicity; round trip within 1 code */
+   CHECK(sgl_xr10_from_unorm10(0) == 384 && sgl_xr10_from_unorm10(1023) == 895 && sgl_xr10_from_unorm10(512) == 640);
+   CHECK(sgl_unorm10_from_xr10(384) == 0 && sgl_unorm10_from_xr10(895) == 1023 && sgl_unorm10_from_xr10(0) == 0 &&
+         sgl_unorm10_from_xr10(1023) == 1023);
+   int mono = 1, rt = 1;
+   for (uint32_t c = 1; c < 1024; c++) {
+      if (sgl_xr10_from_unorm10(c) < sgl_xr10_from_unorm10(c - 1))
+         mono = 0;
+      int back = (int)sgl_unorm10_from_xr10(sgl_xr10_from_unorm10(c));
+      if (back - (int)c > 1 || (int)c - back > 1)
+         rt = 0;
+   }
+   CHECK(mono);
+   CHECK(rt);
+
+   /* channel placement: GL RGB10_A2 (R low) -> w30r (B low, R 29:20, top 2 bits zero) */
+   uint32_t red = 1023u | 3u << 30, green = 1023u << 10, blue = 1023u << 20;
+   CHECK(sgl_w30r_from_rgb10a2(red) == (895u << 20 | 384u << 10 | 384u));
+   CHECK(sgl_w30r_from_rgb10a2(green) == (384u << 20 | 895u << 10 | 384u));
+   CHECK(sgl_w30r_from_rgb10a2(blue) == (384u << 20 | 384u << 10 | 895u));
+   CHECK((sgl_w30r_from_rgb10a2(0xffffffffu) >> 30) == 0);
+   CHECK(sgl_rgb10a2_from_w30r(895u << 20 | 384u << 10 | 384u) == (1023u | 3u << 30));
+
+   /* rows: the g6-a display surface shape, 1125x2436 with bytes per row 4608 (log) -- padding untouched */
+   const uint32_t w = 1125, h = 2436, bpr = 4608;
+   uint32_t *src = malloc((size_t)w * h * 4);
+   uint8_t *dst = malloc((size_t)bpr * h);
+   if (!src || !dst)
+      return 2;
+   for (uint32_t i = 0; i < w * h; i++)
+      src[i] = (i % 1024) | ((i / 7) % 1024) << 10 | ((i / 13) % 1024) << 20 | 3u << 30;
+   memset(dst, 0xa5, (size_t)bpr * h);
+   CHECK(sgl_convert_rows(SGL_CONV_RGB10A2_TO_W30R, dst, bpr, src, (size_t)w * 4, w, h) == 0);
+   int rows_ok = 1, pad_ok = 1;
+   for (uint32_t y = 0; y < h && rows_ok; y += 97) {
+      for (uint32_t x = 0; x < w; x += 31) {
+         uint32_t p;
+         memcpy(&p, dst + (size_t)y * bpr + 4 * x, 4);
+         if (p != sgl_w30r_from_rgb10a2(src[(size_t)y * w + x]))
+            rows_ok = 0;
+      }
+      for (uint32_t b = w * 4; b < bpr; b++)
+         if (dst[(size_t)y * bpr + b] != 0xa5)
+            pad_ok = 0;
+   }
+   CHECK(rows_ok);
+   CHECK(pad_ok);
+   /* last pixel of the last row lands at (h-1)*bpr + (w-1)*4 */
+   uint32_t last;
+   memcpy(&last, dst + (size_t)(h - 1) * bpr + (size_t)(w - 1) * 4, 4);
+   CHECK(last == sgl_w30r_from_rgb10a2(src[(size_t)w * h - 1]));
+   CHECK(sgl_convert_rows(SGL_CONV_RGB10A2_TO_W30R, dst, w * 4 - 1, src, (size_t)w * 4, w, h) == -1); /* bpr too short */
+   CHECK(sgl_convert_rows(SGL_CONV_NONE, dst, bpr, src, (size_t)w * 4, w, h) == -1);
+
+   /* BGRA swap */
+   uint8_t rgba[8] = {1, 2, 3, 4, 5, 6, 7, 8}, bgra[8];
+   CHECK(sgl_convert_rows(SGL_CONV_RGBA8_TO_BGRA8, bgra, 8, rgba, 8, 2, 1) == 0);
+   CHECK(bgra[0] == 3 && bgra[1] == 2 && bgra[2] == 1 && bgra[3] == 4 && bgra[4] == 7 && bgra[7] == 8);
+
+   /* sampling direction honours the source bytes per row */
+   uint32_t back[4];
+   uint8_t surf[2 * 16];
+   memset(surf, 0, sizeof(surf));
+   uint32_t px = 895u << 20 | 384u << 10 | 384u;
+   memcpy(surf + 16, &px, 4); /* row 1, x 0 */
+   CHECK(sgl_w30r_rows_to_rgb10a2(back, surf, 16, 2, 2) == 0 && back[2] == (1023u | 3u << 30) && back[0] == 3u << 30);
+
+   free(src);
+   free(dst);
+   printf("sweetgl_convert host test: %d/%d %s\n", pass, total, pass == total ? "PASS" : "FAIL");
+   return pass == total ? 0 : 1;
+}

+/* attachImage copy fallback: CA's texture gets GPU storage of a renderable format; on flush the texture is read back and
+ * converted into the IOSurface (IOSurfaceLock, the surface's bytes per row). One entry per (context, texture). */
+#define SGL_MAX_SHADOW 16
+static struct sgl_shadow {
+   struct sweetgl_context *ctx;
+   GLuint tex, fbo;
+   IOSurfaceRef surf; /* CFRetain'ed */
+   uint32_t id, w, h;
+   struct sgl_rt_format rt;
+   void *stage; /* w*h*4 readback buffer */
+   bool dirty;
+} sgl_shadow[SGL_MAX_SHADOW];
+static unsigned sgl_shadow_count;
+
+struct fourcc_s {
+   char s[5];
+};
+
+static struct fourcc_s
+fourcc_str(uint32_t f)
+{
+   struct fourcc_s r;
+   for (unsigned i = 0; i < 4; i++) {
+      char c = (char)(f >> (24 - 8 * i));
+      r.s[i] = c >= 0x20 && c < 0x7f ? c : '.';
+   }
+   r.s[4] = 0;
+   return r;
+}
+
+/* true the first time a (format, geometry, kind) is seen: refusals are logged once per shape, not once per frame */
+static bool
+first_of_shape(uint32_t fmt, uint32_t w, uint32_t h, uint32_t bpr, uint32_t kind)
+{
+   static struct {
+      uint32_t fmt, w, h, bpr, kind;
+   } seen[64];
+   static pthread_mutex_t seen_lock = PTHREAD_MUTEX_INITIALIZER;
+   static unsigned n;
+   bool first = true;
+
+   pthread_mutex_lock(&seen_lock);
+   for (unsigned i = 0; i < n; i++) {
+      if (seen[i].fmt == fmt && seen[i].w == w && seen[i].h == h && seen[i].bpr == bpr && seen[i].kind == kind) {
+         first = false;
+         break;
+      }
+   }
+   if (first && n < 64) {
+      seen[n].fmt = fmt;
+      seen[n].w = w;
+      seen[n].h = h;
+      seen[n].bpr = bpr;
+      seen[n].kind = kind;
+      n++;
+   }
+   pthread_mutex_unlock(&seen_lock);
+   return first;
+}
+
+/* sgl_lock held; GL state of e->ctx current (FBO deletion) unless gl_ok is false */
+static void
+shadow_clear_locked(struct sgl_shadow *sh, bool gl_ok)
+{
+   if (!sh->ctx)
+      return;
+   if (gl_ok && sh->fbo)
+      glDeleteFramebuffers(1, &sh->fbo);
+   if (sh->surf)
+      CFRelease(sh->surf);
+   free(sh->stage);
+   memset(sh, 0, sizeof(*sh));
+   __atomic_sub_fetch(&sgl_shadow_count, 1, __ATOMIC_RELAXED);
+}

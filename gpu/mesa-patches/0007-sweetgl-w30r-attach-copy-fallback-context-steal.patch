+   pthread_mutex_lock(&sgl_lock);
+   struct sgl_shadow *sh = shadow_find_locked(ctx, tex);
+   if (sh)
+      shadow_clear_locked(sh, true);
+   pthread_mutex_unlock(&sgl_lock);

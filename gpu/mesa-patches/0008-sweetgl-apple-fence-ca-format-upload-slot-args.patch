+/* sampled surface without a format we import (fmt 0x0, 'LA08', ...): upload with CA's own (internalFormat, format, type),
+ * checked against the surface's bytes per element (sgl_upload_params); single-plane surfaces only */
+static bool
+copy_surface_ca(IOSurfaceRef s, GLenum target, unsigned long ca_ifmt, unsigned long ca_fmt, unsigned long ca_type)
+{
+   uint32_t pf = (uint32_t)IOSurfaceGetPixelFormat(s);
+   uint32_t w = (uint32_t)IOSurfaceGetWidth(s), h = (uint32_t)IOSurfaceGetHeight(s);
+   size_t bpe = IOSurfaceGetBytesPerElement(s), bpr = IOSurfaceGetBytesPerRow(s);
+   unsigned in = 0, ty = 0, row = 0;
+   bool ok = IOSurfaceGetPlaneCount(s) <= 1 &&
+             sgl_upload_params(ca_ifmt, ca_fmt, ca_type, bpe, bpr, &in, &ty, &row) == 0;
+   GLenum gerr = GL_NO_ERROR;
+
+   if (ok) {
+      GLint prev_row = 0, prev_align = 4, prev_pbo = 0;
+      glGetIntegerv(GL_UNPACK_ROW_LENGTH, &prev_row);
+      glGetIntegerv(GL_UNPACK_ALIGNMENT, &prev_align);
+      glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &prev_pbo);
+      for (unsigned i = 0; i < 8 && glGetError() != GL_NO_ERROR; i++)
+         ;
+      glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+      glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+      glPixelStorei(GL_UNPACK_ROW_LENGTH, (GLint)row);
+      IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL);
+      glTexImage2D(target, 0, (GLint)in, (GLsizei)w, (GLsizei)h, 0, (GLenum)ca_fmt, ty, IOSurfaceGetBaseAddress(s));
+      IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+      gerr = glGetError();
+      glPixelStorei(GL_UNPACK_ROW_LENGTH, prev_row);
+      glPixelStorei(GL_UNPACK_ALIGNMENT, prev_align);
+      glBindBuffer(GL_PIXEL_UNPACK_BUFFER, (GLuint)prev_pbo);
+      ok = gerr == GL_NO_ERROR;
+   }
+   if (first_of_shape(pf ^ (uint32_t)ca_fmt << 1 ^ (uint32_t)ca_type << 2, w, h, (uint32_t)bpr, 6))
+      sweetgl_log("sweetgl: texImageIOSurface: fmt 0x%x '%s' %ux%u bpr %zu bpe %zu with CA's ifmt 0x%lx fmt 0x%lx type 0x%lx -> "
+                  "%s (GL 0x%x; logged once per shape)",
+                  pf, fourcc_str(pf).s, w, h, bpr, bpe, ca_ifmt, ca_fmt, ca_type, ok ? "copied" : "refused", gerr);
+   return ok;
+}
+
+/* multi-plane surfaces (e.g. 'b3a8', 2 planes; not defined in the iOS 16.5 SDK headers): log the plane layout once so the
+ * format can be identified; they stay refused */
+static void
+log_planes_once(IOSurfaceRef s)
+{
+   size_t n = IOSurfaceGetPlaneCount(s);
+   uint32_t pf = (uint32_t)IOSurfaceGetPixelFormat(s);
+   if (n < 2 || !first_of_shape(pf, (uint32_t)IOSurfaceGetWidth(s), (uint32_t)IOSurfaceGetHeight(s),
+                                (uint32_t)IOSurfaceGetBytesPerRow(s), 7))
+      return;
+   uintptr_t b0 = (uintptr_t)IOSurfaceGetBaseAddressOfPlane(s, 0);
+   for (size_t i = 0; i < n && i < 4; i++)
+      sweetgl_log("sweetgl: surface %u fmt 0x%x '%s' plane %zu: %zux%zu bpr %zu bpe %zu elem %zux%zu offset 0x%llx",
+                  IOSurfaceGetID(s), pf, fourcc_str(pf).s, i, IOSurfaceGetWidthOfPlane(s, i), IOSurfaceGetHeightOfPlane(s, i),
+                  IOSurfaceGetBytesPerRowOfPlane(s, i), IOSurfaceGetBytesPerElementOfPlane(s, i),
+                  IOSurfaceGetElementWidthOfPlane(s, i), IOSurfaceGetElementHeightOfPlane(s, i),
+                  (unsigned long long)((uintptr_t)IOSurfaceGetBaseAddressOfPlane(s, i) - b0));
+}

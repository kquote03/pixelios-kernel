diff --git a/src/gallium/targets/sweetgl/sweetgl_convert.h b/src/gallium/targets/sweetgl/sweetgl_convert.h
index fcb5f03..33dab0b 100644
--- a/src/gallium/targets/sweetgl/sweetgl_convert.h
+++ b/src/gallium/targets/sweetgl/sweetgl_convert.h
@@ -159,4 +159,92 @@ sgl_w30r_rows_to_rgb10a2(uint32_t *dst, const void *src, size_t src_bpr, uint32_
    return 0;
 }
 
+/* Sampling fallback for surfaces without a known pixel format (fmt 0x0, 'LA08', run g6-b): upload with the
+ * (internalFormat, format, type) CA passed to texImageIOSurface (doc 33 s.2.1: attach_surface_texture maps the surface to
+ * them), checked against the surface's bytes per element. ES rules: with UNSIGNED_BYTE / packed 16-bit types the unsized
+ * internal format must equal the format (BGRA_EXT included); half float and float need a sized internal format.
+ * Returns 0 and fills *internal, *type_out, *row_len (pixels), or -1 if the combination does not fit the surface. */
+#define SGL_GL_ALPHA           0x1906
+#define SGL_GL_RGB             0x1907
+#define SGL_GL_LUMINANCE       0x1909
+#define SGL_GL_LUMINANCE_ALPHA 0x190A
+#define SGL_GL_RED             0x1903
+#define SGL_GL_RG              0x8227
+#define SGL_GL_BGRA_EXT        0x80E1
+#define SGL_GL_HALF_FLOAT      0x140B
+#define SGL_GL_HALF_FLOAT_OES  0x8D61
+#define SGL_GL_FLOAT           0x1406
+#define SGL_GL_RGBA16F         0x881A
+#define SGL_GL_RGBA32F         0x8814
+
+static inline int
+sgl_upload_params(unsigned long ca_ifmt, unsigned long ca_fmt, unsigned long ca_type, size_t bpe, size_t bpr,
+                  unsigned *internal, unsigned *type_out, unsigned *row_len)
+{
+   unsigned comps;
+   switch (ca_fmt) {
+   case SGL_GL_RGBA:
+   case SGL_GL_BGRA_EXT:
+      comps = 4;
+      break;
+   case SGL_GL_RGB:
+      comps = 3;
+      break;
+   case SGL_GL_LUMINANCE_ALPHA:
+   case SGL_GL_RG:
+      comps = 2;
+      break;
+   case SGL_GL_LUMINANCE:
+   case SGL_GL_ALPHA:
+   case SGL_GL_RED:
+      comps = 1;
+      break;
+   default:
+      return -1;
+   }
+   size_t px;
+   unsigned in, ty = (unsigned)ca_type;
+   switch (ca_type) {
+   case SGL_GL_UNSIGNED_BYTE:
+      px = comps;
+      in = (unsigned)ca_fmt;
+      break;
+   case 0x8033: /* UNSIGNED_SHORT_4_4_4_4 */
+   case 0x8034: /* UNSIGNED_SHORT_5_5_5_1 */
+      if (ca_fmt != SGL_GL_RGBA)
+         return -1;
+      px = 2;
+      in = (unsigned)ca_fmt;
+      break;
+   case 0x8363: /* UNSIGNED_SHORT_5_6_5 */
+      if (ca_fmt != SGL_GL_RGB)
+         return -1;
+      px = 2;
+      in = (unsigned)ca_fmt;
+      break;
+   case SGL_GL_HALF_FLOAT:
+   case SGL_GL_HALF_FLOAT_OES:
+      if (ca_fmt != SGL_GL_RGBA || ca_ifmt != SGL_GL_RGBA16F)
+         return -1;
+      px = 8;
+      in = SGL_GL_RGBA16F;
+      ty = SGL_GL_HALF_FLOAT; /* ES 3 spelling */
+      break;
+   case SGL_GL_FLOAT:
+      if (ca_fmt != SGL_GL_RGBA || ca_ifmt != SGL_GL_RGBA32F)
+         return -1;
+      px = 16;
+      in = SGL_GL_RGBA32F;
+      break;
+   default:
+      return -1;
+   }
+   if (bpe != px || bpr % px)
+      return -1;
+   *internal = in;
+   *type_out = ty;
+   *row_len = (unsigned)(bpr / px);
+   return 0;
+}
+
 #endif

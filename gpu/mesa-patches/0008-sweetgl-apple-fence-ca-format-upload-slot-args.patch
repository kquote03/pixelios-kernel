 static int pass, total;
 
+struct fake_sync {
+   int live, created, signalled;
+};
+
+static void *
+fake_create(void *u)
+{
+   struct fake_sync *f = u;
+   f->live++;
+   f->created++;
+   return (void *)(uintptr_t)f->created;
+}
+
+static void
+fake_destroy(void *u, void *s)
+{
+   ((struct fake_sync *)u)->live--;
+}
+
+static bool
+fake_wait(void *u, void *s, uint64_t t)
+{
+   return ((struct fake_sync *)u)->signalled != 0;
+}
+
 #define CHECK(c)                                                                                                       \
    do {                                                                                                                \
       total++;                                                                                                         \
@@ -100,6 +126,48 @@ main(void)
    memcpy(surf + 16, &px, 4); /* row 1, x 0 */
    CHECK(sgl_w30r_rows_to_rgb10a2(back, surf, 16, 2, 2) == 0 && back[2] == (1023u | 3u << 30) && back[0] == 3u << 30);
 
+   /* sampling with CA's formats, g6-b shapes: fmt 0x0 bpe 4 (600x600 bpr 2400), 'LA08' bpe 2 (230x186 bpr 480),
+    * fmt 0x0 bpe 2 (256x1 bpr 672) */
+   unsigned in = 0, ty = 0, row = 0;
+   CHECK(sgl_upload_params(SGL_GL_RGBA, SGL_GL_BGRA_EXT, SGL_GL_UNSIGNED_BYTE, 4, 2400, &in, &ty, &row) == 0 &&
+         in == SGL_GL_BGRA_EXT && ty == SGL_GL_UNSIGNED_BYTE && row == 600);
+   CHECK(sgl_upload_params(SGL_GL_LUMINANCE_ALPHA, SGL_GL_LUMINANCE_ALPHA, SGL_GL_UNSIGNED_BYTE, 2, 480, &in, &ty, &row) ==
+            0 && in == SGL_GL_LUMINANCE_ALPHA && row == 240);
+   CHECK(sgl_upload_params(SGL_GL_RGBA16F, SGL_GL_RGBA, SGL_GL_HALF_FLOAT_OES, 8, 2048, &in, &ty, &row) == 0 &&
+         in == SGL_GL_RGBA16F && ty == SGL_GL_HALF_FLOAT && row == 256);
+   CHECK(sgl_upload_params(SGL_GL_RGBA, SGL_GL_BGRA_EXT, SGL_GL_UNSIGNED_BYTE, 2, 672, &in, &ty, &row) == -1); /* bpe mismatch */
+   CHECK(sgl_upload_params(SGL_GL_RGB, SGL_GL_RGB, 0x8363, 2, 672, &in, &ty, &row) == 0 && row == 336);
+   CHECK(sgl_upload_params(SGL_GL_RGBA, SGL_GL_RGBA, SGL_GL_UNSIGNED_BYTE, 4, 2402, &in, &ty, &row) == -1); /* bpr % bpe */
+   CHECK(sgl_upload_params(0x8a65, 0x8a65, SGL_GL_UNSIGNED_BYTE, 4, 2400, &in, &ty, &row) == -1); /* Apple-only enum */
+
+   /* APPLE_fence table over a fake sync API */
+   static struct sgl_fence_table ft;
+   struct fake_sync fk = {0, 0, 0};
+   struct sgl_fence_ops ops = {fake_create, fake_destroy, fake_wait, &fk};
+   unsigned names[3];
+   sgl_fence_gen(&ft, 3, names);
+   CHECK(names[0] && names[1] && names[2] && names[0] != names[1] && names[1] != names[2]);
+   CHECK(!sgl_fence_is(&ft, names[0]));                        /* generated, not set: not a fence */
+   CHECK(sgl_fence_wait(&ft, &ops, names[0], 0) && fk.created == 0); /* never set: TRUE, no sync made */
+   CHECK(sgl_fence_set(&ft, &ops, names[0]) && sgl_fence_is(&ft, names[0]) && fk.live == 1);
+   CHECK(!sgl_fence_wait(&ft, &ops, names[0], 0));             /* pending: FALSE */
+   fk.signalled = 1;
+   CHECK(sgl_fence_wait(&ft, &ops, names[0], 0) && fk.live == 0); /* signalled: TRUE, sync released */
+   CHECK(sgl_fence_wait(&ft, &ops, names[0], 0));                /* stays TRUE */
+   fk.signalled = 0;
+   CHECK(sgl_fence_set(&ft, &ops, names[0]) && !sgl_fence_wait(&ft, &ops, names[0], 0)); /* re-set: FALSE again */
+   CHECK(sgl_fence_set(&ft, &ops, names[0]) && fk.live == 1);  /* re-set releases the old sync */
+   CHECK(!sgl_fence_set(&ft, &ops, 777));                       /* never generated */
+   unsigned del[2] = {names[0], 999};
+   sgl_fence_delete(&ft, &ops, 2, del);                         /* unused names silently ignored */
+   CHECK(fk.live == 0 && !sgl_fence_is(&ft, names[0]) && sgl_fence_wait(&ft, &ops, names[0], 0));
+   unsigned again;
+   sgl_fence_gen(&ft, 1, &again);
+   CHECK(again != 0 && again != names[1] && again != names[2]);
+   unsigned many[SGL_FENCE_MAX];
+   sgl_fence_gen(&ft, SGL_FENCE_MAX, many); /* table full: the last names are 0, no overrun */
+   CHECK(many[SGL_FENCE_MAX - 1] == 0 && many[0] != 0);
+
    free(src);
    free(dst);
    printf("sweetgl_convert host test: %d/%d %s\n", pass, total, pass == total ? "PASS" : "FAIL");

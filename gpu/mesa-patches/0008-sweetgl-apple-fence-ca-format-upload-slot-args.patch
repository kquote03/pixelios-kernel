diff --git a/src/gallium/targets/sweetgl/sweetgl_fence.h b/src/gallium/targets/sweetgl/sweetgl_fence.h
new file mode 100644
index 0000000..59d0232
--- /dev/null
+++ b/src/gallium/targets/sweetgl/sweetgl_fence.h
@@ -0,0 +1,111 @@
+/*
+ * Copyright © 2026 PixOS-Project contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * libsweetgl: GL_APPLE_fence on top of ES 3.0 sync objects. CA calls glGenFencesAPPLE/glSetFenceAPPLE/glTestFenceAPPLE...
+ * through GLI slots 463-468 (gli-slots.txt); without them every fence trapped and returned 0 (run g6-b).
+ * Semantics, Khronos registry APPLE_fence.txt (section 5.X "Fences", 6.1.11, Errors):
+ *   GenFences: "returns n previously unused fence names"; names "acquire boolean state only when they have been set".
+ *   SetFence: "sets a fence within the GL command stream and assigns the fence a status of FALSE".
+ *   TestFence/FinishFence on a name never set "act as if the state is TRUE" (Test returns TRUE, Finish does not block).
+ *   FinishFence "forces all GL commands prior to the fence to complete".
+ *   IsFence: a name "returned by GenFencesAPPLE, but not yet set via SetFenceAPPLE, is not the name of a fence".
+ *   DeleteFences: "Unused names in fences are silently ignored"; n < 0 is INVALID_VALUE.
+ * Table logic only (the GL calls are callbacks), so sweetgl_convert_host_test.c tests it on the host.
+ */
+#ifndef SWEETGL_FENCE_H
+#define SWEETGL_FENCE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+#define SGL_FENCE_MAX 1024 /* names 1..SGL_FENCE_MAX-1 */
+
+struct sgl_fence_ops {
+   void *(*create)(void *user);                    /* glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0) */
+   void (*destroy)(void *user, void *sync);        /* glDeleteSync */
+   bool (*wait)(void *user, void *sync, uint64_t timeout_ns); /* glClientWaitSync(FLUSH bit): true when signalled */
+   void *user;
+};
+
+struct sgl_fence_table {
+   struct {
+      bool used, set, done;
+      void *sync;
+   } f[SGL_FENCE_MAX];
+   unsigned next;
+};
+
+static inline void
+sgl_fence_gen(struct sgl_fence_table *t, int n, unsigned *names)
+{
+   for (int i = 0; i < n; i++) {
+      unsigned got = 0;
+      for (unsigned k = 0; k < SGL_FENCE_MAX - 1 && !got; k++) {
+         unsigned c = 1 + (t->next + k) % (SGL_FENCE_MAX - 1);
+         if (!t->f[c].used) {
+            memset(&t->f[c], 0, sizeof(t->f[c]));
+            t->f[c].used = true;
+            got = c;
+         }
+      }
+      t->next = got ? got : t->next;
+      names[i] = got; /* 0 when the table is full (the caller logs) */
+   }
+}
+
+static inline bool
+sgl_fence_valid(const struct sgl_fence_table *t, unsigned name)
+{
+   return name > 0 && name < SGL_FENCE_MAX && t->f[name].used;
+}
+
+static inline void
+sgl_fence_delete(struct sgl_fence_table *t, const struct sgl_fence_ops *ops, int n, const unsigned *names)
+{
+   for (int i = 0; i < n; i++) {
+      unsigned c = names[i];
+      if (!sgl_fence_valid(t, c))
+         continue; /* silently ignored */
+      if (t->f[c].sync)
+         ops->destroy(ops->user, t->f[c].sync);
+      memset(&t->f[c], 0, sizeof(t->f[c]));
+   }
+}
+
+/* returns false if name was not generated (the GL error case is not modelled: nothing is set) */
+static inline bool
+sgl_fence_set(struct sgl_fence_table *t, const struct sgl_fence_ops *ops, unsigned name)
+{
+   if (!sgl_fence_valid(t, name))
+      return false;
+   if (t->f[name].sync)
+      ops->destroy(ops->user, t->f[name].sync);
+   t->f[name].sync = ops->create(ops->user);
+   t->f[name].set = true;
+   t->f[name].done = t->f[name].sync == NULL; /* no sync object: report done rather than hang CA */
+   return true;
+}
+
+static inline bool
+sgl_fence_is(const struct sgl_fence_table *t, unsigned name)
+{
+   return sgl_fence_valid(t, name) && t->f[name].set;
+}
+
+/* Test (timeout 0) and Finish (bounded timeout): TRUE for a fence never set; TRUE once the sync signalled */
+static inline bool
+sgl_fence_wait(struct sgl_fence_table *t, const struct sgl_fence_ops *ops, unsigned name, uint64_t timeout_ns)
+{
+   if (!sgl_fence_valid(t, name) || !t->f[name].set || t->f[name].done)
+      return true;
+   if (ops->wait(ops->user, t->f[name].sync, timeout_ns)) {
+      t->f[name].done = true;
+      ops->destroy(ops->user, t->f[name].sync);
+      t->f[name].sync = NULL;
+   }
+   return t->f[name].done;
+}
+
+#endif
